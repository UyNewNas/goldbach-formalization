    "includes_rank_zero": true,
    "includes_repeated_prime_slots": true,
    "includes_empty_old_and_rough_blocks": true,
    "rank_and_multiplicity_kept_symbolic": true
  },
  "main_conclusions": [
    "endpoint: norm(N) * roughCount(c*N, N^(a/2)) tends to (a/2)^(-1) * c * buchstab((a/2)^(-1)) for c > 0",
    "shell_limit: norm(N) * card(shell N b c) tends to (a/2)^(-1) * (c-b) * buchstab((a/2)^(-1)) for 0 < b <= c",
    "eventually_cut_le_half_floor: eventually N^(a/2) <= N^a / 2",
    "absolute_radial_payment: forall epsilon > 0, exists fixed h in (0,1/8], eventually N, norm(N)*boundaryCount N (1-2h) (1+2h) <= epsilon",
    "absolute_profile_outer_payment: h is fixed before N, k, r and logQ; norm(N)*profileOuterMass <= epsilon when k+2+r <= the original K",
    "mem_naturalOuterTuples: under 0<N and 0<h<=1/8, membership is iff every natural coordinate is prime, the unchanged physical profile is nonzero, and N is below the complete natural product",
    "naturalOuterMass_eq_profileOuterMass: injective coordinate-value image preserves the exact profile-weighted sum for every N k r logQ h",
    "absolute_natural_outer_payment: the same exists-h/eventually-N/forall-k-r-logQ payment holds for the complete natural-prime outer-support sum of one ambient"
  ],
  "profile_mass_dictionary": {
    "width": "log(1+h)",
    "exponential_width": "exp(width) = 1+h < 2",
    "complete_product_bound_source": "finPhysicalProfile_integer_product_lt",
    "coordinate_box_source": "natural coordinate divides the complete positive natural product",
    "enumeration": "Fin (2*N+1), with every nonzero natural prime tuple represented by identical coordinate values and order",
