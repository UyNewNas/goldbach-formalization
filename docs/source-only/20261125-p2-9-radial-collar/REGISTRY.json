  "narrow_scope": "One ambient Gamma5 physical radial exterior at the original frozen cutoff and original rank ceiling; ordinary N/log N shell payment, not a marked-history/J/prime-product theorem.",
  "fixed_constants": {
    "cutoff_fqn": "ImbalancedChen.Part5OriginalH430FrozenRootRefinement.frozenLeafCutoffFloor",
    "cutoff_expression": "((11 / 384) / (101 : Real)^440) / 6",
    "rough_exponent": "frozenLeafCutoffFloor / 2",
    "rank_fqn": "ImbalancedChen.P2FiniteMarkedGamma5ActualRank.frozenSourceRankBound",
