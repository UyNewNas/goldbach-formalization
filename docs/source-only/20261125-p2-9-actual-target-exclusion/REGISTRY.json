    "conclusion": "selectedNoncoprimeMass N n dep t h B <= (aggregateCard n : Real)*noncoprimeCount N",
    "all_depth_conclusion": "allDepthSelectedNoncoprimeMass N n t h B <= 431*(aggregateCard n : Real)*noncoprimeCount N",
    "final_cutoff_hypothesis_eliminated_by": "ImbalancedChen.P2FiniteMarkedGamma5RadialRoughMass.eventually_cut_le_half_floor",
    "raw_profile_support_is_derived": true,
    "raw_profile_weight_le_one_is_derived": true,
    "actual_mark_or_prefix_bound_hypothesis_added": false
  },
  "final_quantifiers": {
    "fixed_parameter": "n : Nat, chosen before the eventual N threshold",
    "single_depth": "forall epsilon>0, eventually N, forall dep t h, 0<h -> h<=1/8 -> forall original B p, norm N * selectedNoncoprimeMass <= epsilon",
    "all_depth": "forall epsilon>0, eventually N, forall t h, 0<h -> h<=1/8 -> forall original B : (dep:Fin431)->(p:Nat)->Finset(LevelIndex ... dep.val), norm N * allDepthSelectedNoncoprimeMass <= epsilon",
