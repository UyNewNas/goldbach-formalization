  "exact_source_dictionaries": [
    "noncoprimeSlice_eq_filtered: original boundedProfileWeight noncoprime restriction equals its nonzero-profile filter sum.",
    "selectedNoncoprimeMass_eq_cells: the original originalBand p sum is partitioned by its exact RootCode and originalRootCellBand_Q.",
    "selectedNoncoprimeMass_eq_prefix_sum: full tuples carry the existing original prefixWeight, with every original p/l occurrence retained."
  ],
  "proof_chain": [
    "finPhysicalProfile_nonzero_support gives each coordinate > N^a/2 and the complete product < exp(radialWidth h)*N.",
    "For 0<h<=1/8, existing exp_radialWidth_lt_two gives the true product cap <2N.",
    "Existing eventually_cut_le_half_floor gives the actual N^(a/2) cutoff for those same profile-supported coordinates.",
    "The literal noncoprime event therefore embeds in TargetExclusion.noncoprimeTuples on the same bounded ordered-prime enumerator.",
    "Existing physicalProfile_bounds supplies weight in [0,1]; cardinal inclusion and the original fixed rank sum bound every profileNoncoprimeMass by noncoprimeCount.",
    "The original prefixWeight_le_shapeCard is applied before the fixed root-cell and Split cardinalities are charged.",
    "The source-level bound is selectedNoncoprimeMass <= aggregateCard n * noncoprimeCount.",
    "Existing absolute_noncoprime_payment pays that fixed aggregate factor with epsilon/(aggregateCard n+1).",
    "The final original remaining-depth sum over Fin431 is paid with epsilon/431 before N, width, root parameter and all selected subfamilies."
  ],
  "constants": {
    "new_constants_defined": [],
    "cutoff_fqn": "ImbalancedChen.P2FiniteMarkedGamma5RadialRoughMass.cut",
    "cutoff_expression": "N^(Part5OriginalH430FrozenRootRefinement.frozenLeafCutoffFloor / 2)",
    "rank_fqn": "ImbalancedChen.P2FiniteMarkedGamma5ActualRank.frozenSourceRankBound",
    "split_fqn": "ImbalancedChen.P2FiniteMarkedGamma5ActualRadialAggregate.Split",
    "split_domain": "Fin (K+1) x Fin (K+1), with literal k+2+r<=K indicator",
    "shape_factor_fqn": "ImbalancedChen.P2FiniteMarkedGamma5ActualRadialAggregate.shapeWords",
    "aggregate_factor_fqn": "ImbalancedChen.P2FiniteMarkedGamma5ActualRadialAggregate.aggregateCard",
    "aggregate_factor_expression": "shapeWords.card * Fintype.card (RootCode n) * Fintype.card Split",
    "all_depth_factor": 431,
    "fixed_before_N": true,
    "per_moving_prime_epsilon": false,
    "per_moving_history_position_epsilon": false,
    "factors_applied_to_ordinaryBad_or_J": false,
    "rank_and_cardinality_expanded_numerically": false
