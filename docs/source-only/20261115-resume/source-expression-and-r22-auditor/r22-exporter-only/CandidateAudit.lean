open Lean Elab Command in
run_cmd do
  let env ← getEnv
  liftIO do
    IO.println "P0_ROUND6_PHASE environment_ready"
    (← IO.getStdout).flush
  let moduleNames := env.header.moduleNames
  let modules := #[`ImbalancedChen.ActualSieveGapTailDecay,`ImbalancedChen.ActualSieveGapTailBounds,`ImbalancedChen.LogPrimeBoxIntegral,`ImbalancedChen.VariableEnvelope,`ImbalancedChen.VariableEnvelopeConsequences,`ImbalancedChen.VariableEnvelopeRegularity,`ImbalancedChen.VariableEnvelopeBoxes,`ImbalancedChen.VariableEnvelopeScaled,`ImbalancedChen.VariableEnvelopeCertificates,`ImbalancedChen.BufferedFirstCubeGeometry,`ImbalancedChen.VariableEnvelopeTailFloor,`ImbalancedChen.ActualThirdPrefixTailIntegralCore,`ImbalancedChen.ActualExtendedThirdIdealCap,`ImbalancedChen.ActualExtendedThirdOrderedIntegral,`ImbalancedChen.ActualExtendedThirdLowerFactorRegularity,`ImbalancedChen.ActualThirdOriginalCoupledRecurrence,`ImbalancedChen.ActualThirdOriginalLocalCurvature,`ImbalancedChen.SymmetricTriangleIntegral,`ImbalancedChen.Certificates.RationalLogCertificate,`ImbalancedChen.AffinePrimeGates,`ImbalancedChen.ActualExtendedThirdClosedIntegral,`ImbalancedChen.ActualExtendedThirdPhysicalCell,`ImbalancedChen.ActualExtendedThirdDyadicCoverage,`ImbalancedChen.ActualExtendedThirdGammaApproximation,`ImbalancedChen.ActualExtendedThirdFinitePhysicalKernel,`ImbalancedChen.ActualExtendedThirdStripIntegral,`ImbalancedChen.ActualExtendedThirdCompactKernelApproximation,`ImbalancedChen.Part4ActualThirdTailBound,`ImbalancedChen.ActualExtendedThirdFiniteTailIntegral,`ImbalancedChen.ActualExtendedThirdBoundaryLoss,`ImbalancedChen.ActualExtendedThirdKernelL1Convergence,`ImbalancedChen.ActualExtendedThirdFunctionalConvergence,`ImbalancedChen.Part4ActualThirdFiniteDensityReserve,`ImbalancedChen.Part4ActualThirdOriginalCompactDomain,`ImbalancedChen.Part4ActualThirdOriginalClosedSplitAggregation,`ImbalancedChen.ActualThirdOriginalBoxMoments,`ImbalancedChen.ActualThirdOriginalOrdinaryOldChord,`ImbalancedChen.ActualThirdOriginalSixTentCandidates,`ImbalancedChen.ActualThirdOriginalLiteralTentSelectorGuardBridge,`ImbalancedChen.ActualThirdOriginalSymmetricJensenLeaf,`ImbalancedChen.ActualThirdOriginalFixedpointClippedChord,`ImbalancedChen.ActualThirdOriginalRoundedNewOperations,`ImbalancedChen.ActualThirdOriginalRoundedNewMean,`ImbalancedChen.ActualThirdOriginalSymmetricClippedMean,`ImbalancedChen.ActualThirdOriginalPositive256Log,`ImbalancedChen.ActualThirdOriginalRoundedOldWeight,`ImbalancedChen.ActualThirdOriginalSixTentRoundedConsumer,`ImbalancedChen.ActualThirdOriginalPositive256LogIntegerGuards,`ImbalancedChen.ActualThirdOriginalIntegerGuardedSymmetricLeaf,`ImbalancedChen.ActualThirdOriginalSymmetricMassCeil,`ImbalancedChen.Certificates.OriginalNodeArraysV1.DataCore,`ImbalancedChen.ActualThirdOriginalSharpChord,`ImbalancedChen.ActualThirdOriginalWeights,`ImbalancedChen.ActualThirdOriginalWeightedCurvature,`ImbalancedChen.ActualThirdOriginalLiteralNodes,`ImbalancedChen.ActualThirdOriginalRationalQuery,`ImbalancedChen.Part4ActualThirdOriginalStoredNodeLocalChecker,`ImbalancedChen.Certificates.OriginalNodeArraysV1.CheckerCore,`ImbalancedChen.ActualThirdOriginalStoredNodeQueryLookup,`ImbalancedChen.ActualThirdOriginalStoredQueryAllBranches,`ImbalancedChen.ActualThirdOriginalSixTentOrdinaryMassCeil,`ImbalancedChen.ActualThirdOriginalP4AOrdinaryFiniteSelector,`ImbalancedChen.ActualThirdOriginalBelowMuBCandidate,`ImbalancedChen.ActualThirdOriginalPositive256LogRange32,`ImbalancedChen.ActualThirdOriginalBelowMuBRounded,`ImbalancedChen.ActualThirdOriginalBelowMuBMassCeil,`ImbalancedChen.ActualThirdOriginalPositive256LogRange32IntegerGuard,`ImbalancedChen.ActualThirdOriginalP4AOrdinaryBCandidateLeaf,`ImbalancedChen.ActualThirdOriginalP4AOrdinaryFiniteDispatch,`ImbalancedChen.ActualThirdOriginalP4AOrdinaryEarlyReturnLeaf,`ImbalancedChen.ActualThirdOriginalP4AOrdinaryOuterMinimum,`ImbalancedChen.ActualThirdOriginalP4AOrdinaryRawFallbackAllOld,`ImbalancedChen.ActualThirdOriginalP4AOriginalClippedGapLeaf,`ImbalancedChen.ActualThirdOriginalP4AOriginalClippedGapAssembly,`ImbalancedChen.P4AActualSquaredGapDecay,`ImbalancedChen.P4AOriginalAnchorDecay,`ImbalancedChen.ActualThirdOriginalP4AOriginalFirstDecayLeaf,`ImbalancedChen.P4AActualLowerIncrementGapBound,`ImbalancedChen.Certificates.P2OriginalThirdSecondDecay,`ImbalancedChen.P4ASixTentRange32Moments,`ImbalancedChen.ActualThirdOriginalRoundedStoredQueryIntegerConsumer,`ImbalancedChen.ActualThirdOriginalP4ASymmetricTentPrerequisites,`ImbalancedChen.ActualThirdOriginalP4ABalancedSymmetricLeaf,`ImbalancedChen.ActualThirdOriginalP4ASymmetricSafeChordDirection,`ImbalancedChen.ActualThirdOriginalP4ASymmetricBranchPermutation,`ImbalancedChen.ActualThirdOriginalP4ASymmetricPairRealRescue,`ImbalancedChen.ActualThirdOriginalP4ASixTentSymmetricLeaf,`ImbalancedChen.P4ASixTentRange32OldWeight,`ImbalancedChen.P4AClosedTreeCoordinatePropagation,`ImbalancedChen.P4AOriginalMuSplitInvariant,`ImbalancedChen.P4AOriginalSeedRange32Invariant,`ImbalancedChen.P4AOriginalRange32MassCeil,`ImbalancedChen.P4AOrdinarySixTentRange32Leaf,`ImbalancedChen.Certificates.P2OrdinaryIntegerGuard,`ImbalancedChen.Certificates.P2HistoricalThirdSelector,`ImbalancedChen.Certificates.P2HistoricalThirdMeanDispatch,`ImbalancedChen.P4ASymmetricSixTentRange32Leaf,`ImbalancedChen.P4ARange32IntegerOuterABI,`ImbalancedChen.P4AOriginalExecutableLog32,`ImbalancedChen.P4ARange32ExecutableReaderABI,`ImbalancedChen.Certificates.P2HistoricalThirdIntegerMass,`ImbalancedChen.FinitePiIntegral]
  let allowed := #[`propext, `Classical.choice, `Quot.sound]
  let mut targetIndices : Array ModuleIdx := #[]
  for moduleName in modules do
    let some idx := env.getModuleIdx? moduleName |
      throwError "Missing imported audited module {moduleName}"
    targetIndices := targetIndices.push idx
  liftIO do
    IO.println "P0_ROUND6_PHASE name_index_inventory_start"
    (← IO.getStdout).flush
  -- Traverse only name/index entries for the complete imported ownership census.
  -- ConstantInfo is queried only after selecting one of the five module indices.
  -- The index also contains IR/codegen-only names; these have no ConstantInfo
  -- and are not kernel declarations. All remaining names must match constNames.
  let names := env.const2ModIdx.fold (init := (#[] : Array Name)) fun names name idx =>
    if targetIndices.contains idx then
      if (env.find? name).isSome then names.push name else names
    else names
  liftIO do
    IO.println s!"P0_ROUND6_PHASE name_index_inventory_done {names.size}"
    (← IO.getStdout).flush
  let mut serializedModules : Array Name := #[]
  let mut serializedTotal := 0
  let mut extraCodegenTotal := 0
  for idx in List.range env.header.modules.size do
    let imported := env.header.modules[idx]!
    let loadedData := env.header.moduleData[idx]!
    let loadedRecord := Json.mkObj [
      ("module_data_index", toJson idx),
      ("module", toJson imported.module.toString),
      ("is_module", toJson loadedData.isModule),
      ("import_all", toJson imported.importAll),
      ("has_data", toJson imported.hasData),
      ("audited", toJson (modules.contains imported.module))]
    liftIO <| IO.println s!"P0_ROUND6_LOADED_MODULE {loadedRecord.compress}"
    if modules.contains imported.module then
      if serializedModules.contains imported.module then
        throwError "Duplicate serialized module inventory: {imported.module}"
      let data := env.header.moduleData[idx]!
      if data.isModule || !imported.importAll || !imported.hasData then
        throwError "Expected complete legacy module data for {imported.module}"
      let owned := names.filter fun name =>
        (env.getModuleIdxFor? name).map (fun i => moduleNames[i]!) ==
          some imported.module
      unless owned.size > 0 do
        throwError "Audited module has no declarations: {imported.module}"
      unless owned.qsort Name.lt == data.constNames.qsort Name.lt do
        -- Diagnostics only. Keep the exact original rejection below.
        let countName := fun (xs : Array Name) (n : Name) =>
          xs.foldl (fun count x => if x == n then count + 1 else count) (0 : Nat)
        let allNames := (owned ++ data.constNames).foldl
          (fun acc n => if acc.contains n then acc else acc.push n) (#[] : Array Name)
        let differentNames := allNames.filter fun n =>
          countName owned n != countName data.constNames n
        let mut differences : Array Json := #[]
        for name in differentNames.qsort Name.lt do
          let canonical := env.getModuleIdxFor? name
          let mut occurrences : Array Json := #[]
          for otherIdx in List.range env.header.modules.size do
            let otherModule := env.header.modules[otherIdx]!
            let otherData := env.header.moduleData[otherIdx]!
            let serializedCount := countName otherData.constNames name
            let extraCount := countName otherData.extraConstNames name
            if serializedCount > 0 || extraCount > 0 then
              occurrences := occurrences.push (Json.mkObj [
                ("module_data_index", toJson otherIdx),
                ("module", toJson otherModule.module.toString),
                ("serialized_count", toJson serializedCount),
                ("extra_codegen_count", toJson extraCount)])
          differences := differences.push (Json.mkObj [
            ("name", toJson name.toString),
            ("owned_count", toJson (countName owned name)),
            ("serialized_count", toJson (countName data.constNames name)),
            ("environment_has_constant", toJson (env.find? name).isSome),
            ("canonical_owner_index", toJson (canonical.map (fun i => i.toNat))),
            ("canonical_owner_module", toJson (canonical.map (fun i => moduleNames[i]!.toString))),
            ("loaded_occurrences", Json.arr occurrences)])
        let diagnostic := Json.mkObj [
          ("module_data_index", toJson idx),
          ("module", toJson imported.module.toString),
          ("owned_names", toJson (owned.map Name.toString)),
          ("serialized_names", toJson (data.constNames.map Name.toString)),
          ("extra_codegen_names", toJson (data.extraConstNames.map Name.toString)),
          ("multiplicity_differences", Json.arr differences),
          ("acceptance_rule_unchanged", toJson true)]
        liftIO do
          IO.println s!"P0_ROUND6_INVENTORY_MISMATCH {diagnostic.compress}"
          (← IO.getStdout).flush
        throwError "Serialized declarations and defining-module inventory differ for {imported.module}"
      serializedModules := serializedModules.push imported.module
      serializedTotal := serializedTotal + data.constNames.size
      extraCodegenTotal := extraCodegenTotal + data.extraConstNames.size
      let record := Json.mkObj [
        ("module", toJson imported.module.toString),
        ("is_module", toJson data.isModule),
        ("import_all", toJson imported.importAll),
        ("has_data", toJson imported.hasData),
        ("serialized_constant_names", toJson (data.constNames.map Name.toString)),
        ("environment_constant_names", toJson (owned.map Name.toString)),
        ("serialized_constant_count", toJson data.constNames.size),
        ("extra_codegen_name_count", toJson data.extraConstNames.size),
        ("extra_codegen_names", toJson (data.extraConstNames.map Name.toString))]
      liftIO <| IO.println s!"P0_ROUND6_SERIALIZED {record.compress}"
  unless serializedModules.qsort Name.lt == modules.qsort Name.lt do
    throwError "Missing Round 6 serialized module data"
  unless serializedTotal == names.size do
    throwError "Round 6 serialized total and environment total differ"
  unless modules.size == 102 && names.size == 3628 && extraCodegenTotal == 3787 do
    throwError "Exact R22 102/3628/3787 inventories changed"
  let requiredTerminal :=
    `ImbalancedChen.Certificates.P2HistoricalThirdIntegerMass.checked_ordinary_integral_upper
  unless names.contains requiredTerminal do
    throwError "Missing original ordinary integral endpoint {requiredTerminal}"
  liftIO do
    IO.println "P0_ROUND6_PHASE serialized_inventory_exact_match"
    (← IO.getStdout).flush
  let mut exportFailures : Array String := #[]
  -- This set deduplicates emitted graph records only; every root still has fresh seen/pending.
  let mut graphEmitted : NameSet := {}
  let mut counts : Array (Name × Nat) := modules.map (·, 0)
  for name in names.qsort Name.lt do
    liftIO do
      IO.println s!"P0_ROUND6_PHASE declaration_start {name}"
      (← IO.getStdout).flush
    let some info := env.checked.get.find? name | throwError "Missing current checked inventoried declaration {name}"
    let executable := info.isUnsafe || info.isPartial
    let executableKindAllowed := match info with
      | .defnInfo _ => true
      | .opaqueInfo _ => true
      | _ => false
    if executable && !executableKindAllowed then
      exportFailures := exportFailures.push s!"Unexpected unsafe/partial constant kind: {name}"
    if info.isAxiom then
      exportFailures := exportFailures.push s!"Unproved axiom declaration in audited module: {name}"
    -- Fresh worklist for this declaration; no exportedAxiomsExt/cache lookup.
    let mut pending := #[name]
    let mut seen : NameSet := {}
    let mut axioms : Array Name := #[]
    let mut unsafePartialDependencies : Array Name := #[]
    while !pending.isEmpty do
      let current := pending.back!
      pending := pending.pop
      unless seen.contains current do
        seen := seen.insert current
        let some currentInfo := env.checked.get.find? current |
          throwError "Missing current checked dependency {current} from {name}"
        let currentConstructor := match currentInfo with
          | .thmInfo _ => "thmInfo"
          | .defnInfo _ => "defnInfo"
          | .opaqueInfo _ => "opaqueInfo"
          | .quotInfo _ => "quotInfo"
          | .axiomInfo _ => "axiomInfo"
          | .inductInfo _ => "inductInfo"
          | .ctorInfo _ => "ctorInfo"
          | .recInfo _ => "recInfo"
        let currentBodyRequired := match currentInfo with
          | .thmInfo _ => true
          | .defnInfo _ => true
          | .opaqueInfo _ => true
          | _ => false
        let currentBodyPresent := (currentInfo.value? (allowOpaque := true)).isSome
        if currentBodyRequired && !currentBodyPresent then
          throwError "Missing current checked body {current} from {name}"
        let some currentOwner := env.getModuleIdxFor? current |
          throwError "Missing canonical dependency owner {current} from {name}"
        unless currentOwner.toNat < moduleNames.size do
          throwError "Invalid canonical dependency owner index {current} from {name}"
        let currentExecutableKindAllowed := match currentInfo with
          | .defnInfo _ => true
          | .opaqueInfo _ => true
          | _ => false
        if (currentInfo.isUnsafe || currentInfo.isPartial) && !currentExecutableKindAllowed then
          exportFailures := exportFailures.push s!"Unexpected unsafe/partial dependency kind {current} from {name}"
        if currentInfo.isUnsafe || currentInfo.isPartial then
          unsafePartialDependencies := unsafePartialDependencies.push current
          unless executable do
            exportFailures := exportFailures.push s!"Unsafe/partial dependency {current} reachable from safe logical declaration {name}"
        if currentInfo.isAxiom then
          axioms := axioms.push current
        -- getUsedConstantsAsSet includes type and value? (allowOpaque := true),
        -- inductive constructors and recursor groups; seen terminates cycles.
        let mut directDependencies : Array Name := #[]
        for dependency in currentInfo.getUsedConstantsAsSet do
          directDependencies := directDependencies.push dependency
          pending := pending.push dependency
        unless graphEmitted.contains current do
          graphEmitted := graphEmitted.insert current
          let graphRecord := Json.mkObj [
            ("name", toJson current.toString),
            ("canonical_owner_index", toJson currentOwner.toNat),
            ("canonical_owner_module", toJson moduleNames[currentOwner]!.toString),
            ("constant_constructor", toJson currentConstructor),
            ("is_unsafe", toJson currentInfo.isUnsafe),
            ("is_partial", toJson currentInfo.isPartial),
            ("is_axiom", toJson currentInfo.isAxiom),
            ("body_required", toJson currentBodyRequired),
            ("body_present", toJson currentBodyPresent),
            ("direct_dependencies", toJson ((directDependencies.qsort Name.lt).map Name.toString))]
          liftIO <| IO.println s!"P0_ROUND6_DEPENDENCY_NODE {graphRecord.compress}"
    for ax in axioms do
      unless allowed.contains ax do
        exportFailures := exportFailures.push s!"Forbidden transitive axiom {ax} in {name}"
    let some idx := env.getModuleIdxFor? name |
      throwError "Missing defining module for {name}"
    let moduleName := moduleNames[idx]!
    counts := counts.map fun (m, count) => (m, if m == moduleName then count + 1 else count)
    let kind := match info with
      | .thmInfo _ => "theorem"
      | .defnInfo _ => "definition"
      | .opaqueInfo _ => "opaque"
      | .quotInfo _ => "quotient"
      | .axiomInfo _ => "axiom"
      | .inductInfo _ => "inductive"
      | .ctorInfo _ => "constructor"
      | .recInfo _ => "recursor"
    if name == requiredTerminal && (kind != "theorem" || executable) then
      exportFailures := exportFailures.push s!"Original ordinary integral endpoint must be a safe theorem: {name}"
    let constantConstructor := match info with
      | .thmInfo _ => "thmInfo"
      | .defnInfo _ => "defnInfo"
      | .opaqueInfo _ => "opaqueInfo"
      | .quotInfo _ => "quotInfo"
      | .axiomInfo _ => "axiomInfo"
      | .inductInfo _ => "inductInfo"
      | .ctorInfo _ => "ctorInfo"
      | .recInfo _ => "recInfo"
    let type ← liftTermElabM do
      return (← Meta.ppExpr info.type).pretty
    let readableType ← liftTermElabM do
      withOptions (fun opts => (opts.setBool `pp.all false).setBool `pp.explicit false) do
        return (← Meta.ppExpr info.type).pretty
    if type.contains '⋯' || readableType.contains '⋯' then
      exportFailures := exportFailures.push s!"Truncated compiler type for {name}"
    let record := Json.mkObj [
      ("name", toJson name.toString),
      ("module", toJson moduleName.toString),
      ("kind", toJson kind),
      ("constant_constructor", toJson constantConstructor),
      ("canonical_owner_index", toJson idx.toNat),
      ("is_unsafe", toJson info.isUnsafe),
      ("is_partial", toJson info.isPartial),
      ("is_axiom", toJson info.isAxiom),
      ("safety_class", toJson (if executable then "executable_implementation" else "logical_safe")),
      ("kernel_replay_required", toJson (!executable)),
      ("implementation_kernel_proof_credit", toJson false),
      ("implementation_termination_credit", toJson false),
      ("unsafe_partial_dependencies", toJson (unsafePartialDependencies.map Name.toString)),
      ("type", toJson type),
      ("readable_type", toJson readableType),
      ("axiom_audit", toJson "fresh_current_checked_type_and_body"),
      ("axiom_visited_count", toJson seen.size),
      ("dependency_graph_root", toJson name.toString),
      ("axioms", toJson (axioms.map Name.toString))]
    liftIO <| IO.println s!"P0_ROUND6_DECL {record.compress}"
  for (m, count) in counts do
    unless count > 0 do
      throwError "Audited module has no declarations: {m}"
    let record := Json.mkObj [("module", toJson m.toString), ("count", toJson count)]
    liftIO <| IO.println s!"P0_ROUND6_MODULE {record.compress}"
  liftIO <| IO.println s!"P0_ROUND6_COUNT {names.size}"

  liftIO <| IO.println s!"P0_ROUND6_EXTRA_CODEGEN_COUNT {extraCodegenTotal}"
  liftIO <| IO.println s!"P0_ROUND6_DEPENDENCY_COUNT {graphEmitted.size}"
  unless exportFailures.isEmpty do
    liftIO <| IO.println s!"P0_ROUND6_EXPORT_FAILURES {(toJson exportFailures).compress}"
    throwError "P2 declaration safety/axiom/fulltype gate failed; complete available inventory retained"
