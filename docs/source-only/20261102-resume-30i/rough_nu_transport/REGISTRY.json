  "parameters": {
    "D": "N^nu",
    "w": "N^(nu*epsilon^2)",
    "z": "N^r, with physical archive r=19/96",
    "L": "N^(nu*epsilon)",
    "T": "manuscriptHalfProductCutoff kappa N = 2*N^(1-kappa)",
    "gamma": "nu*epsilon^2",
    "fixed_nu_range": "Analytic transport nu>0; actual physical caller 0<nu<=1",
    "hypotheses": [
      "0<epsilon<1/8",
      "nu*epsilon^2<=r",
      "N sufficiently large and even",
      "cap>=N^r",
      "mean: 0<b<1, kappa>0, r<(1-kappa)*b/(1+b)",
      "positive-presieve caller: r>0, etaBeta>0, etaMean>0, epsilonMax>0"
    ],
    "quantifier_order": "Fixed nu,epsilon,r and reserve before n0,N0; then all n>=n0,N>=N0,cap,OriginalData. Physical caller chooses epsilon once from H at r/nu, then n0 and one combined N0",
    "normalization": "Density singularSeries N/log N; mean singularNormalization N; physical normalize x=x*log N/singularSeries N",
    "rankin_condition": "Supplied arithmetic term C*N^a*w^(-s)*(log N)^j has effective exponent a-nu*epsilon^2*s; scalar payment requires it <1",
    "numeric_parameters_changed": false
