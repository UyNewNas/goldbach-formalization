    "exact_definition": "def properStrip {r : ℕ} (logQ logN width : ℝ) (v : Point r) : Prop :=\n  ∃ g ∈ program r, g ≠ Gate.product ∧\n    -width < margin logQ logN v g ∧ margin logQ logN v g ≤ 0"
  },
