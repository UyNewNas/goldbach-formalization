  },
  "proof_chain": [
    "Read fresh and tail coordinates using the existing slotEquiv; List.ofFn_add splits the complete coordinate list after the literal old prefix and two fresh slots.",
    "Unfold the original labelled prime carrier to obtain every-coordinate primality. Keep old-word equality, fresh target coprimality and all original raw gates as actual filter conditions.",
    "Call raw_source_inverse: decoded pair belongs to original badLabels, decoded m belongs to original roughNumbers, and m.primeFactorsList is the entire ordered tail list.",
    "If two sharp atoms decode to the same pair/m, their old ranks equal w.length and their tail ranks equal m.primeFactorsList.length.",
    "After these two dependent Fin indices are identified, the fixed old list, ordered fresh pair and canonical tail give equal full List.ofFn coordinate lists.",
    "Existing List.ofFn_injective and tupleValues_injective recover the same bounded tuple. This proves injectivity on the sigma carrier across all original bounded splits.",
    "Finset.card_le_card_of_injOn gives the cardinal upper bound; card_sigma and Nat.cast_sum identify the target cardinal with the unchanged original ordinaryBad."
  ],
  "not_hypotheses": [
    "desired sharp count inequality",
    "complete-product injection",
    "product-fibre bound",
    "canonical factorization identity",
    "pair/cofactor membership",
    "full-source rank admission",
    "original J bound",
    "smooth selected-mask construction",
    "prime-product estimate"
  ],
  "endpoint_conventions": {
    "fresh_lower": "inclusive original raw lower",
    "fresh_upper": "strict original raw upper",
    "fresh_pair": "strict q0<q1",
    "bad_wall": "inclusive Q<=d*q0^2*q1",
    "tail_lower": "inclusive original raw rough",
    "tail_order": "nondecreasing",
    "complete_product_cap": "inclusive <=N",
    "finite_coordinate_cap": "original Fin(2*N+1)"
  },
  "edge_cases": {
    "empty_old_word": "Allowed in the ambient theorem; w.prod=1. No claim that actual U4 history has empty old word.",
    "empty_tail": "Allowed, m=1 and canonical primeFactorsList=[]; its length recovers r=0.",
    "repeated_tail_primes": "Retained. Canonical nondecreasing factor list preserves multiplicity.",
    "tail_target_coprimality_added": false,
    "fresh_tail_or_old_tail_disjointness_added": false,
    "collision_or_square_error_credit": false
  },
