  "findings": [
    {
      "area": "Original row denominator",
      "result": "PASS",
      "source": "P5ActualHBGroupLogLine.lean:22-89",
      "finding": "Ordered insertion and exact wordLog split retain every original group and repeated occurrence. Own denominator is log(A*n), with A the other factors of the same original group and H the other original group logs. CompleteOtherProduct is separately identified; rho and beta are not divided by log(e*p)."
    },
    {
      "area": "Reciprocal/Mellin derivative and variation",
      "result": "PASS",
      "source": "P5OriginalGroupLogAbelVariation.lean:30-204",
      "finding": "C1 and derivative of 1/log(A*y), the original physical Mellin derivative, interval length<=U and 1/U derivative scale give the explicit endpoint-plus-integral estimate abs(H)^(-1)*((M+D)/ell+M/ell^2)*(1+abs(t)). No derivative-integral estimate is assumed."
    },
    {
      "area": "Actual occupied full-coordinate floor",
      "result": "PASS",
      "source": "P5ActualHBGroupLogLine.lean:92-257",
      "finding": "Nonzero actual rank-two upperTest gives every original group product>N^theta and N>=2. An occupied n<=2U and N^(theta/2)>=2 imply A>0 and log(A*U)>=(theta/2)*log N. All frozen logs are positive with the original row multiplicity. The eventual threshold is before all row and arithmetic data; no sharp group-product wall is inserted."
    },
    {
      "area": "Native Abel and exact finite prefix maximum",
      "result": "PASS",
      "source": "P5ActualHBGroupLogAbelPrefix.lean:24-165",
      "finding": "Exact Ioc(floor u,floor v) Abel identity retains the right endpoint and zero left prefix. prefixNorm is a defined finite supremum of signed primitive-discrepancy prefixes, not an evaluated certificate or assumed cancellation bound. The actual occupied role result derives its log floor before applying this identity."
    },
    {
      "area": "Actual roles, complete multiplier, primitive CRT and signed mean",
      "result": "PASS",
      "source": "P5ActualHBGroupLogAbelPrefix.lean:167-279",
      "finding": "Literal roughTupleWeight and roles j retain real Mobius cutoff, roughness, signs and occurrence order. Same signed Q/rho sum is reconstructed with completeOtherProduct. Given T coprime q on Q, unit multipliers use J constructed primitive residue and nonunits kill count and exact coprime mean; phi(q) is unchanged. Unit log role vanishes via its numerator."
    },
    {
      "area": "Scope separation from normalized HB SW",
      "result": "PASS_WITH_EXPLICIT_LIMITS",
      "finding": "No estimate for prefixNorm is proved. J beta-attached singleton modulus SW is not used as rough one/Mobius/log prefix cancellation. Actual mode/profile association, auxiliary k>1, all chart/scalar accounting, broader smooth ranks and full PP remain open."
    }
  ],
