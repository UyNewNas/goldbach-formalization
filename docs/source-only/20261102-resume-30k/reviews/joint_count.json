  "findings": [
    {
      "id": "literal_upper_rho",
      "status": "PASS",
      "source": "P5OriginalJointCausalOverlapSource.lean",
      "lines": "27-110",
      "conclusion": "causalRho is exactly actualSmallRoughRho R N p2 w p2 L. The fixed rough coefficient comes from odd-first-exit retention; signAttachedCoefficient attaches beta-plus to nonnegative rough coefficients and beta-minus to negative coefficients. The actual proved majorant is applied at z=cap=p2, and receiver coprimality with N converts its presieve indicator to literal quotient roughness.",
      "evidence": [
        "FiniteUpperCarrierCore.lean:19-30",
        "SignSensitiveAttachment.lean:32-48,104-106",
        "ActualSmallRoughAttachment.lean:78-100,113-135",
        "RealPhysicalUpperWeightBridge.lean:429-439,483-495",
        "ChenInitialPrimeSource.lean:184-204",
        "CurrentChenPairRosser.lean:28-45"
      ],
      "boundary": "The policy is fixed before testing q but is arbitrary. Construction and licensing of the complete adopted original history are neither assumed nor proved."
    },
    {
      "id": "full_joint_carrier",
      "status": "PASS",
      "source": "P5OriginalJointCausalOverlapSource.lean",
      "lines": "269-292",
      "conclusion": "The count is currentChenUpsilon10 plus currentChenUpsilon11 on the same E, via the actual joint selector. The entire low fourth-prime band is unmasked; the complete high interval keeps the complement on the last pair. Four ordered prime labels, quotient one, repeated residual factors and centre-prime subtraction are retained.",
      "evidence": [
        "CurrentChenUpsilon1011JointOverlapFiniteMean.lean:28-63",
        "CurrentChenUpsilon1011JointSource.lean:90-116",
        "ChenQuotientPrimeSource.lean:128-175"
      ],
      "boundary": "No separate U10/U11 endpoint or whole joint count bound is a caller premise."
    },
    {
      "id": "signed_p1_overlap",
      "status": "PASS",
      "source": "P5OriginalJointCausalOverlapSource.lean",
      "lines": "112-163",
      "conclusion": "For b=p1*p2*p3*p4 and P=P_N(p2), the actual selector proves gcd(b,P)=p1 and coprimality of b with R=P/p1. The exact effective row coefficient is rho(e)+rho(p1*e)/p1. fullDensity=effectiveDensity/phi(b), and effectiveDensity=rawDensity-overlapCorrection/p1 with overlapCorrection=sum_(e|R)rho(p1*e)/phi(p1*e).",
      "evidence": [
        "CurrentChenUpsilon1011JointOverlapFiniteMean.lean:84-161",
        "CurrentChenUpsilon10OverlapDivisorSplit.lean:64-93"
      ],
      "boundary": "The correction is signed. No positivity, multiplicativity of rho or coprimality of b with the full p2 primorial is inferred; the repeated-p1 branch is not discarded."
    },
    {
      "id": "same_physical_fibre",
      "status": "PASS",
      "source": "P5OriginalJointCausalOverlapSource.lean",
      "lines": "165-267",
      "conclusion": "Finite sigma marks and fibrewise summation preserve every signed multiplicity at physical modulus b*d. The exact same fibre coefficient occurs in the full reciprocal-totient density, AP and centre terms. Changing reference mass M to M' keeps +(M'-M)*jointEffectiveDensity.",
      "evidence": [
        "Mathlib/Algebra/BigOperators/Group/Finset/Basic.lean:255-261 (to_additive sum_fiberwise_of_maps_to)",
        "ChenQuotientSieveRemainders.lean:233-234"
      ],
      "boundary": "No squarefree physical-modulus restriction, aggregate unit bound or identification of N/log N with li(N), pi(N), or primitive prime mass is made."
    },
    {
      "id": "uniform_row_overlap",
      "status": "PASS",
      "source": "P5OriginalJointCausalOverlapPayment.lean",
      "lines": "28-96",
      "conclusion": "The actual unit bound on rho and true residual divisor lattice bound absolute overlap by the full primorial reciprocal-totient mass. The existing Euler-product/Mertens supplier gives C log p2 for every even target. Actual selector geometry supplies p1>=N^(417/5000) and p2<=N, yielding |effective-raw|<=C log N/N^(417/5000), uniformly before E, R, w and L.",
      "evidence": [
        "ActualSmallRoughAttachment.lean:113-135",
        "P4BPrimorialDivisorEnvelope.lean:97-147",
        "MathlibNt/SieveTheory/Arithmetic/MertensTheorem.lean:2094-2100",
        "CurrentChenUpsilon1011JointOverlapFiniteMean.lean:34-54"
      ],
      "boundary": "Only w<=p2 is needed for the density identity. No polynomial rough-support cap, sharp density estimate or distribution licence is assumed."
    },
    {
      "id": "full_joint_normalized_mass",
      "status": "PASS",
      "source": "P5OriginalJointCausalOverlapPayment.lean",
      "lines": "98-182",
      "conclusion": "The whole sum of 1/phi(b) is transported to the genuine four-prime cube and bounded by its complete nonnegative box mass. Actual distinctness justifies the full totient product. The existing eventual cube bound and singularSeries>=twinPrimeConstant>0 give (C*originalCubeMassBound/twinPrimeConstant)*log(N)^2/N^(417/5000), which tends to zero. One N threshold precedes every mask, tuple-policy and small-parameter function.",
      "evidence": [
        "P5ZU1011JointNearCapPrimeReserve.lean:25-59",
        "P5ZU1011JointNearCapOwnerBinding.lean:97-110",
        "P5ZU1011AdaptivePrimeMeshError.lean:118-134",
        "SingularSeries.lean:98-125",
        "PowerErrorBudget.lean:40-46"
      ],
      "boundary": "This proves the full weighted overlap error, not merely a rowwise estimate. No selected-subproduct mass or full joint density/cost endpoint is substituted."
    },
    {
      "id": "same_mask_actual_count_consumer",
      "status": "PASS",
      "source": "P5OriginalJointCausalOverlapPayment.lean",
      "lines": "184-258",
      "conclusion": "The finite count divides by positive H_N=C_N*N/log(N)^2. normalizedSignedAP=(AP_(N/log N)-centre)/H_N; actualCausalDensityExcess=normalizedRaw-nativeJoint(actualMinimum). J is consumed on exactly FullMask.P1E0E1.deletionMask(N), retaining its nativeGain, n48/fine17572 intersections and whole priority/complement/U10 functional. The final signed inequality has one negative Chen quarter and pays the overlap inside epsilon.",
      "evidence": [
        "P5OriginalJointSameMaskParentGainPayment.lean:174-246",
        "SingularSeries.lean:123-125"
      ],
      "boundary": "Neither density excess nor signed AP/centre debt is estimated or assumed small/nonnegative. Ordinary-F/Suzuki initialization is not relabelled H248/currentK. The11026 simplex source is not substituted."
    }
