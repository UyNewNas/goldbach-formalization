theorem cell01_stored_jensen_floor_sum :
    (∑ s : Fin cell01Payload.simplices.size,
      (cell01Payload.simplices[s]).jensenFloor) = 292535084187454643081 := by decide +kernel

/-- Compose the 81 previously checked floor equalities; do not repeat
their rational-floor computations inside one combined decision. -/
theorem cell01_separate_stored_floor_sum :
    (∑ s : Fin cell01Payload.simplices.size,
      q96Floor (cell01Payload.simplices[s]).jensenBound) = 292535084187454643081 := by
  calc
    (∑ s : Fin cell01Payload.simplices.size,
      q96Floor (cell01Payload.simplices[s]).jensenBound) =
        ∑ s : Fin cell01Payload.simplices.size,
          (cell01Payload.simplices[s]).jensenFloor := by
      apply Finset.sum_congr rfl
      intro s _
      exact (cell01_stored_jensen_floors s).symm
    _ = 292535084187454643081 := cell01_stored_jensen_floor_sum

