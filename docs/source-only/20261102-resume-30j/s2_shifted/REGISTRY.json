    "shifted_width": "5x",
    "shifted_endpoints": "1-a, floor(5x)-a",
    "shifted_residue": "naturalResidue(-a,p)",
    "fixed_log_exponent": 4099,
    "prime_tail": "sum_(actual p>z) 1/p^2 <= 2/z, z>=2",
    "shiu_threshold": "max(10^10,(2*hShiu.X0+32)^80)",
