        {
          "name": "continued_forward_dilation",
          "line": 23,
          "signature": "theorem continued_forward_dilation {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)\n    (hχ : χ.IsPrimitive) (B : ℕ+) (N : ℕ) [NeZero N] (hle : q^2*(B : ℕ) ∣ N)\n    (s : ℂ) (hs : 1/2 ≤ s.re) (h1 : s ≠ 1) (z : ℍ) :\n    ordinary χ s (degeneracyDiagonal B B.pos • z) =\n      ∑ a : CuspRowClass N, cuspCoefficient (NeZero.pos q) χ B N (classFrame a) s *\n        cuspFamily N (nativeCuspEquiv N a) s z"
        },
        {
          "name": "reflected_columns",
          "line": 67,
          "signature": "theorem reflected_columns (N : ℕ) [NeZero N] (t : ℝ) (ht : t ≠ 0) (a : CuspRowClass N) :\n    ∃ u : CuspRowClass N → ℂ, ∀ z : ℍ,\n      nativeColumn N t a z = ∑ b : CuspRowClass N, u b*nativeColumn N (-t) b z"
        }
      ]
