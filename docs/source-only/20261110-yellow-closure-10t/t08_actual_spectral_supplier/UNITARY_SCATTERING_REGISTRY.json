        {
          "name": "original_cusp_conjugation",
          "line": 79,
          "signature": "theorem original_cusp_conjugation (N : ℕ) [NeZero N] (g : SL(2,ℤ)) (z : ℍ)\n    (s : ℂ) (hs : 1/2 ≤ s.re) (hs1 : s ≠ 1) :\n    cuspFamily N (nativeFrameOrbit N g) (conj s) z = conj (cuspFamily N (nativeFrameOrbit N g) s z)"
        },
        {
          "name": "entry_conjugation",
          "line": 101,
          "signature": "theorem entry_conjugation (N : ℕ) [NeZero N] (hN : 0 < N) (g h : SL(2,ℤ))\n    (s : ℂ) (hs : 1/2 ≤ s.re) (hs1 : s ≠ 1) :\n    continuedEntry N hN g h (conj s) = conj (continuedEntry N hN g h s)"
        },
        {
          "name": "critical_entry_adjoint",
          "line": 113,
          "signature": "theorem critical_entry_adjoint (N : ℕ) [NeZero N] (hN : 0 < N) (g h : SL(2,ℤ)) (t : ℝ) :\n    continuedEntry N hN g h (criticalPoint (-t)) = conj (continuedEntry N hN h g (criticalPoint t))"
