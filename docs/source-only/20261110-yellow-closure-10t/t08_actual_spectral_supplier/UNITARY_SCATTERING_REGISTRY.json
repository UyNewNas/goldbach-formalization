          "line": 148,
          "signature": "theorem actual_critical_functional_equation (N : ℕ) [NeZero N] (t : ℝ) (a : CuspRowClass N)\n    (z : ℍ) : nativeColumn N t a z =\n      ∑ b, scatteringMatrix N t a b*nativeColumn N (-t) b z"
        },
