          "line": 42,
          "signature": "theorem signed_amplitude_reflection {q : ℕ} (χ : DirichletCharacter ℂ q) (n : ℤ) (s : ℂ) :\n    amplitude χ⁻¹ n (1-s) = amplitude χ n s"
