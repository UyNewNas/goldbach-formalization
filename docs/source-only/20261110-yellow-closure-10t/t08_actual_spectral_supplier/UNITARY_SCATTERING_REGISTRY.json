        {
          "name": "scale_nonzero_off_center",
          "line": 96,
          "signature": "theorem scale_nonzero_off_center {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)\n    (hχ : χ.IsPrimitive) {t : ℝ} (ht : t ≠ 0) : ordinaryScale χ (criticalPoint t) ≠ 0"
        },
