          "name": "eq_at_regular_of_initial",
          "line": 21,
          "signature": "theorem eq_at_regular_of_initial {f g : ℂ → ℂ} (hf : MeromorphicOn f ({0,1} : Set ℂ)ᶜ)\n    (hg : MeromorphicOn g ({0,1} : Set ℂ)ᶜ) (hu : ∀ w : ℂ, 1 < w.re → f w = g w)\n    {s : ℂ} (hs : s ≠ 0) (hs1 : s ≠ 1) (hfc : ContinuousAt f s) (hgc : ContinuousAt g s) :\n    f s = g s"
        },
        {
          "name": "entries_symmetric",
          "line": 45,
          "signature": "theorem entries_symmetric (N : ℕ) [NeZero N] (hN : 0 < N) (g h : SL(2,ℤ))\n    (s : ℂ) (hs : 1/2 ≤ s.re) (hs1 : s ≠ 1) :\n    continuedEntry N hN g h s = continuedEntry N hN h g s"
