          "name": "reflected_adjoint",
          "line": 170,
          "signature": "theorem reflected_adjoint (N : ℕ) [NeZero N] (t : ℝ) :\n    scatteringMatrix N (-t) = (scatteringMatrix N t).conjTranspose"
        },
        {
          "name": "actual_critical_scattering_unitary",
          "line": 177,
          "signature": "theorem actual_critical_scattering_unitary (N : ℕ) [NeZero N] (t : ℝ) :\n    scatteringMatrix N t*(scatteringMatrix N t).conjTranspose = 1 ∧\n    (scatteringMatrix N t).conjTranspose*scatteringMatrix N t = 1"
        }
