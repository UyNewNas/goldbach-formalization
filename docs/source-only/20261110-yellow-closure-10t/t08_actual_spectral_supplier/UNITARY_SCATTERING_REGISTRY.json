          "signature": "theorem ordinary_factors {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) (s : ℂ) (z : ℍ) :\n    ordinary χ s z = ordinaryScale χ s*completedPart χ s z"
        },
