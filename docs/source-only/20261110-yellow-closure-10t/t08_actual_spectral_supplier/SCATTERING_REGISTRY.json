          "signature": "theorem continuedEntry_regularity (N : ℕ) [NeZero N] (hN : 0 < N) (g h : SL(2,ℤ)) :\n    MeromorphicOn (continuedEntry N hN g h) ({0,1} : Set ℂ)ᶜ ∧\n      ∀ s : ℂ, 1/2 ≤ s.re → s ≠ 1 → DifferentiableAt ℂ (continuedEntry N hN g h) s"
