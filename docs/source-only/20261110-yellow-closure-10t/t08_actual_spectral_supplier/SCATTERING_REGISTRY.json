      "terminals": [
        {
          "name": "positive_denominator",
          "line": 225,
          "signature": "theorem positive_denominator (N : ℕ) (hN : 0 < N) (g h : SL(2,ℤ))\n    (c : ℕ+) (s : ℂ) (hs : 1 < s.re) (y : ℝ) (hy : 0 < y) (x : ℝ) :\n    let Z := scaledPoint (cuspWidth N h) (cuspWidth_pos N hN h) (horizontalPoint y hy x)\n    widthFactor N g s * (∑' d : ℤ,\n      if framedRow N g h (c : ℤ) d then latticeSeed Z s ![(c : ℤ),d] else 0) =\n      outgoingRow N g h c s y x"
        },
        {
          "name": "parabolic_residue_expansion",
          "line": 275,
          "signature": "theorem parabolic_residue_expansion (N : ℕ) [NeZero N] (hN : 0 < N) (g h : SL(2,ℤ))\n    (s : ℂ) (hs : 1 < s.re) (y : ℝ) (hy : 0 < y) (x : ℝ) :\n    cuspEisenstein N g s (normalizedScaling N hN h • horizontalPoint y hy x) =\n      incoming N g h s y + ∑' c : ℕ+, outgoingRow N g h c s y x"
        }
      ]
    },
