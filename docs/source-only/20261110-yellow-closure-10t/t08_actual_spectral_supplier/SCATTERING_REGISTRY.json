        {
          "name": "actual_constant_term",
          "line": 70,
          "signature": "theorem actual_constant_term (N : ℕ) [NeZero N] (hN : 0 < N) (g h : SL(2,ℤ))\n    (u : ℂ) (hu : 1/2 ≤ u.re) (hu1 : u ≠ 1) (y : ℝ) (hy : 0 < y) :\n    (∫ x in (0 : ℝ)..1, cuspFamily N (nativeFrameOrbit N g) u\n      (normalizedScaling N hN h • horizontalPoint y hy x)) =\n        incoming N g h u y + continuedEntry N hN g h u*(y : ℂ)^(1-u)"
        },
        {
          "name": "critical_native_constant_term",
          "line": 112,
          "signature": "theorem critical_native_constant_term (N : ℕ) [NeZero N] (hN : 0 < N) (g h : SL(2,ℤ))\n    (t y : ℝ) (hy : 0 < y) :\n    (∫ x in (0 : ℝ)..1, cuspFamily N (nativeFrameOrbit N g) (criticalPoint t)\n      (normalizedScaling N hN h • horizontalPoint y hy x)) =\n      incoming N g h (criticalPoint t) y + continuedEntry N hN g h (criticalPoint t)*\n        (y : ℂ)^(1-criticalPoint t)"
