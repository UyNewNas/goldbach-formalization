        {
          "name": "actualPowerFourier_zero",
          "line": 60,
          "signature": "theorem actualPowerFourier_zero (y : ℝ) (hy : 0 < y) (s : ℂ) (hs : 1 < s.re) :\n    actualPowerFourier y 0 s = gammaFactor s*(y : ℂ)^(1-s)"
        },
        {
          "name": "positive_row_mean",
          "line": 93,
          "signature": "theorem positive_row_mean (N : ℕ) (g h : SL(2,ℤ)) (c : ℕ+) (s : ℂ) (hs : 1 < s.re)\n    (y : ℝ) (hy : 0 < y) :\n    (∫ x in (0 : ℝ)..1, outgoingRow N g h c s y x) =\n      scatteringDirichletTerm N g h s c * actualPowerFourier y 0 s"
        },
        {
          "name": "horocycle_row_norms_summable",
          "line": 113,
          "signature": "theorem horocycle_row_norms_summable (N : ℕ) (hN : 0 < N) (g h : SL(2,ℤ)) (s : ℂ)\n    (hs : 1 < s.re) (y : ℝ) (hy : 0 < y) :\n    Summable (fun c : ℕ+ => ∫ x in Ioc (0 : ℝ) 1, ‖outgoingRow N g h c s y x‖)"
        },
        {
          "name": "parabolic_constant_term",
          "line": 160,
          "signature": "theorem parabolic_constant_term (N : ℕ) [NeZero N] (hN : 0 < N) (g h : SL(2,ℤ))\n    (s : ℂ) (hs : 1 < s.re) (y : ℝ) (hy : 0 < y) :\n    (∫ x in (0 : ℝ)..1, cuspEisenstein N g s (normalizedScaling N hN h • horizontalPoint y hy x)) =\n      incoming N g h s y + scatteringEntry N g h s * (y : ℂ)^(1-s)"
        },
        {
          "name": "cuspFamily_initial_constant_term",
          "line": 203,
          "signature": "theorem cuspFamily_initial_constant_term (N : ℕ) [NeZero N] (hN : 0 < N) (g h : SL(2,ℤ))\n    (s : ℂ) (hs : 1 < s.re) (y : ℝ) (hy : 0 < y) :\n    (∫ x in (0 : ℝ)..1, cuspFamily N (nativeFrameOrbit N g) s\n      (normalizedScaling N hN h • horizontalPoint y hy x)) =\n      incoming N g h s y + scatteringEntry N g h s * (y : ℂ)^(1-s)"
        }
