      "terminals": [
        {
          "name": "gamma_inverse_strip",
          "line": 35,
          "signature": "theorem gamma_inverse_strip :\n    ∃ B : ℝ, 0 ≤ B ∧ ∀ s : ℂ, 1/2 ≤ s.re → s.re ≤ 3/2 → 1 ≤ |s.im| →\n      ‖(Complex.Gamma s)⁻¹‖ ≤ B*Real.exp (Real.pi*|s.im|)"
        },
        {
          "name": "original_ordinary_factors",
          "line": 88,
          "signature": "theorem original_ordinary_factors {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) :\n    ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℂ, 1/2 < s.re → s.re ≤ 3/2 → 1 ≤ |s.im| →\n      (s.re-1/2)*‖uncompletionFactor χ s‖ ≤ C*Real.exp (Real.pi*|s.im|) ∧\n      (s.re-1/2)*‖principalFactor s‖ ≤ C*Real.exp (Real.pi*|s.im|)"
        }
      ]
