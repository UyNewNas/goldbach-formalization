          "name": "reciprocal_le_zeta",
          "line": 41,
          "signature": "theorem reciprocal_le_zeta {q : ℕ} [NeZero q] (η : DirichletCharacter ℂ q)\n    (u : ℂ) (hu : 1 < u.re) : ‖reciprocalL η u‖ ≤ ‖riemannZeta (u.re : ℂ)‖"
        },
        {
          "name": "relative_reciprocal_bound",
          "line": 72,
          "signature": "theorem relative_reciprocal_bound :\n    ∃ C : ℝ, 0 ≤ C ∧ ∀ (q : ℕ) [NeZero q] (η : DirichletCharacter ℂ q) (s : ℂ),\n      1/2 < s.re → s.re ≤ 3/2 → (s.re-1/2)*‖reciprocalL η (2*s)‖ ≤ C"
        }
      ]
    },
