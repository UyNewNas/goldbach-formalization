          "name": "residue_is_physical",
          "line": 77,
          "signature": "theorem residue_is_physical (N : ℕ) [NeZero N] (h g : SL(2,ℤ)) (ψ φ : SmoothHeightSeed) :\n    residue N ψ φ = inner ℂ (frameZeroSeedL2 N (NeZero.pos N) h ψ.toHeightSeed)\n      ((ℂ ∙ constantL2 N).starProjection (frameZeroSeedL2 N (NeZero.pos N) g φ.toHeightSeed))"
