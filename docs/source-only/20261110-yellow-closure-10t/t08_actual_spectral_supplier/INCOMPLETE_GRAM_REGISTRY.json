        {
          "name": "finite_contour",
          "line": 196,
          "signature": "theorem finite_contour (N : ℕ) [NeZero N] (g h : SL(2,ℤ)) (ψ φ : SmoothHeightSeed) (T : ℝ) :\n    edge N g h ψ φ T =\n      (∫ t : ℝ in (-T)..T,gramIntegrand N g h ψ φ (1/2) t) -\n      (∫ t : ℝ in (-T)..T,gramIntegrand N g h ψ φ (3/2) t) +\n      residue N ψ φ * (4*(Real.arctan (2*T) : ℂ))"
        },
        {
          "name": "physical_contour_limit",
          "line": 225,
          "signature": "theorem physical_contour_limit (N : ℕ) [NeZero N] (g h : SL(2,ℤ)) (ψ φ : SmoothHeightSeed) :\n    let V := frameZeroSeedL2 N (NeZero.pos N) h ψ.toHeightSeed\n    let W := frameZeroSeedL2 N (NeZero.pos N) g φ.toHeightSeed\n    Tendsto (fun T : ℝ => (2*Real.pi)⁻¹ • edge N g h ψ φ T) atTop\n      (𝓝 ((4*Real.pi)⁻¹ • (∫ t : ℝ,physicalProduct N h g ψ φ t) -\n        inner ℂ V W + inner ℂ V ((ℂ ∙ constantL2 N).starProjection W)))"
