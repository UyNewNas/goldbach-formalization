        {
          "name": "native_regular_profile",
          "line": 64,
          "signature": "theorem native_regular_profile {N : ℕ} [NeZero N] (a : NativeCusps N) (s : ℂ)\n    (h₀ : s ≠ 0) (h₁ : s ≠ 1) :\n    Continuous (cuspFamily N a s) ∧ ∀ (γ : CongruenceSubgroup.Gamma0 N) (z : ℍ),\n      cuspFamily N a s (γ • z) = cuspFamily N a s z"
        },
        {
          "name": "descended_projection",
          "line": 92,
          "signature": "@[simp] theorem descended_projection {N : ℕ} [NeZero N] (a : NativeCusps N)\n    (s : ℂ) (h₀ : s ≠ 0) (h₁ : s ≠ 1) (z : ℍ) :\n    descended a s h₀ h₁ (orbitProjection N z) = cuspFamily N a s z"
        },
        {
          "name": "descended_continuous_measurable",
          "line": 96,
          "signature": "theorem descended_continuous_measurable {N : ℕ} [NeZero N] (a : NativeCusps N)\n    (s : ℂ) (h₀ : s ≠ 0) (h₁ : s ≠ 1) :\n    Continuous (descended a s h₀ h₁) ∧ Measurable (descended a s h₀ h₁)"
        },
        {
          "name": "descended_critical",
          "line": 102,
          "signature": "theorem descended_critical {N : ℕ} [NeZero N] (a : NativeCusps N) (t : ℝ)\n    (h₀ : criticalPoint t ≠ 0) (h₁ : criticalPoint t ≠ 1) :\n    descended a (criticalPoint t) h₀ h₁ = quotientProfile ((youngCuspEquiv N).symm a) t"
        }
      ]
    },
