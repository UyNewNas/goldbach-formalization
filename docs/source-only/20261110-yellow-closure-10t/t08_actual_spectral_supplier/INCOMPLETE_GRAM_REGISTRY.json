        {
          "name": "physical_boundary",
          "line": 90,
          "signature": "theorem physical_boundary (N : ℕ) [NeZero N] (g h : SL(2,ℤ)) (ψ : SmoothHeightSeed) (t : ℝ) :\n    let U := quotientProfile ((youngCuspEquiv N).symm (nativeFrameOrbit N g)) t\n    Integrable (fun u => star (zeroPoincare N h ψ.toHeightSeed u)*U u) (carrierPushforward N) ∧\n    (∫ u,star (zeroPoincare N h ψ.toHeightSeed u)*U u ∂carrierPushforward N) =\n      boundaryColumn N h ψ (frameIndex N g) t"
