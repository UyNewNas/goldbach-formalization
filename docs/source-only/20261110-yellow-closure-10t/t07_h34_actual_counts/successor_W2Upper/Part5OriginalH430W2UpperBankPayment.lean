theorem all36_four_original_pair_measures (j : Fin 36) (k : Fin 4) (i : Fin 200) :
    (weightAt (weights j k) i.val : ℝ)/(2^80 : ℝ) ≤ pairIntegralAtom (originalW2At j) k (.inl i) :=
  checked_pair_weight j k i (checked_all j k)

private theorem weighted_list (old : Table) (xs : List (ℕ × ℤ)) :
    (xs.map (fun w => read old true w.1 * w.2)).sum =
      ∑ i : Fin 200, old true i * weightAt xs i.val := by
  classical
  have one (w : ℕ × ℤ) :
      (∑ i : Fin 200, old true i * (if w.1 = i.val then w.2 else 0)) =
        read old true w.1 * w.2 := by
    by_cases hw : w.1 < 200
    · let b : Fin 200 := ⟨w.1,hw⟩
      rw [Finset.sum_eq_single b]
      · simp [b,read,hw]
      · intro i _ hib
        have hne : w.1≠i.val := fun h => hib (Fin.ext h.symm)
        simp [hne]
      · simp
    · rw [read,dif_neg hw,zero_mul]
      apply Finset.sum_eq_zero
      intro i _
      have hne : w.1≠i.val := fun h => hw (h.symm ▸ i.isLt)
      simp [hne]
  induction xs with
  | nil => simp [weightAt]
  | cons a xs ih =>
    simp only [List.map_cons,List.sum_cons,weightAt] at ih ⊢
    simp_rw [mul_add]
    rw [Finset.sum_add_distrib,one,ih]

private theorem weight_sum (j : Fin 36) (i : Fin 200) :
    weightAt (grouped j) i.val = ∑ k : Fin 4,weightAt (weights j k) i.val := by
  simp [grouped,weightAt,Fin.sum_univ_succ] <;> ring

/-- Each original occurrence, including repeated cells in separate Gamma rows, is read
on the preceding H. One factor Q80 scales the archived mass and the other scales H. -/
theorem archive_upper_cells (old : Table) (j : Fin 36) :
    archivedChannel old j true = ∑ i : Fin 200,
      (((∑ k : Fin 4,weightAt (weights j k) i.val : ℤ) : ℝ)/(2^80 : ℝ)/5) *
        floorValue (old true) i := by
  unfold archivedChannel
  dsimp only
  rw [← original_lists j,weighted_list,Int.cast_sum]
  simp_rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro i _
  rw [weight_sum,Int.cast_mul]
  unfold floorValue
  ring

theorem immutable_w2_pair_invoice (j : Fin 36) (g : Fin 430) :
    archivedChannel (iterate g.val) j true ≤ integralPairs j g := by
  have hp (i : Fin 200) : 0≤floorValue (precedingH g) i :=
    div_nonneg (by exact_mod_cast iterate_nonneg g.val true i) (by positivity)
  have hk (i : Fin 201) : 0≤floorKnotValue (precedingH g) i := by
    unfold floorKnotValue
    split_ifs <;> first | exact hp _ | exact le_min (hp _) (hp _)
  have atom (i : Fin 200) :
      ((∑ k : Fin 4,weightAt (weights j k) i.val : ℤ) : ℝ)/(2^80 : ℝ)/5 ≤
        dynamicIdeal (.inr j) (.inl (.inl i)) := by
    rw [Int.cast_sum,Finset.sum_div]
    exact div_le_div_of_nonneg_right (Finset.sum_le_sum (fun k _ =>
      all36_four_original_pair_measures j k i)) (by norm_num : (0 : ℝ) ≤ 5)
  rw [archive_upper_cells,integralPairs,Fintype.sum_sum_type]
  apply le_trans (Finset.sum_le_sum (fun i _ => mul_le_mul_of_nonneg_right (atom i) (hp i)))
  apply le_add_of_nonneg_right
  apply Finset.sum_nonneg
  intro i _
  apply mul_nonneg _ (hk i)
  exact div_nonneg (Finset.sum_nonneg (fun k _ =>
      MeasureTheory.integral_nonneg_of_ae (Filter.Eventually.of_forall pairKernel_nonneg))) (by norm_num)

/-- A single original Gamma lane is paid on the preceding H, before division by five.
The table's 201 knot atoms use their actual adjacent minima. -/
theorem immutable_each_original_pair (j : Fin 36) (k : Fin 4) (g : Fin 430) :
    (∑ i : Fin 200,((weightAt (weights j k) i.val : ℝ)/(2^80 : ℝ))*
      floorValue (precedingH g) i) ≤ pairOldIntegral (originalW2At j) k (precedingH g) := by
  have hp (i : Fin 200) : 0≤floorValue (precedingH g) i :=
    div_nonneg (by exact_mod_cast iterate_nonneg g.val true i) (by positivity)
  have hk (i : Fin 201) : 0≤floorKnotValue (precedingH g) i := by
    unfold floorKnotValue
    split_ifs <;> first | exact hp _ | exact le_min (hp _) (hp _)
  rw [← pairIntegralAtom_value (originalRepairedW2Bank_geometry _ (originalW2At_mem j)),
    Fintype.sum_sum_type]
  apply le_trans (Finset.sum_le_sum (fun i _ =>
    mul_le_mul_of_nonneg_right (all36_four_original_pair_measures j k i) (hp i)))
  apply le_add_of_nonneg_right
  exact Finset.sum_nonneg (fun i _ => mul_nonneg
    (MeasureTheory.integral_nonneg_of_ae (Filter.Eventually.of_forall pairKernel_nonneg)) (hk i))

/-- Physical coefficient on the two direct W2 pair windows or the [0,0] and
[0,1] mother-word windows, with both target square gates and the same Q.
The two successive Euler factors keep the actual previously present primes. -/
def physicalUpperWindow (N : ℕ) (Q L : ℝ) (d : ℕ) (j : Fin 36) (k : Fin 4) (g : Fin 430) : ℝ :=
  windowOccurrence N Q L d (originalW2At j) k fun a b =>
    (localPrimeFactor d a * localPrimeFactor (d*a) b) *
      pairTest (originalW2At j) k (precedingH g) (normalizedLog N L ![a,b])

theorem physicalUpperWindow_eq_profile {N d : ℕ} {Q L : ℝ} (hN : 1<N) (hd : 0<d)
    (hL : 0<L) (hQ : Q=(d : ℝ)*(N : ℝ)^L) (j : Fin 36) (k : Fin 4) (g : Fin 430) :
    physicalUpperWindow N Q L d j k g =
      truePairOldProfile N L d (originalW2At j) k (precedingH g) := by
  unfold physicalUpperWindow
  rw [all_four_window_occurrences_reindex hN hd hL hQ
    (originalRepairedW2Bank_geometry _ (originalW2At_mem j))]
  unfold truePairOldProfile truePairTest
  apply Finset.sum_congr rfl
  intro x _
  have hh : (![x 0,x 1] : Fin 2 → ℕ)=x := by
    funext i
    fin_cases i <;> rfl
  by_cases hx : normalizedLog N L x ∈ pairHalf (originalW2At j) k
  · simp only [if_pos hx,indicator_of_mem hx,hh]
  · simp only [if_neg hx,indicator_of_notMem hx,mul_zero]

/-- The integral comparison on each lane also pays its actual, arithmetically
weighted mother carrier, uniformly in all 430 old tables before N and Q.
The current count state and its separate signed base are not an input here. -/
theorem uniform_original_four_windows {lo hi ε : ℝ} (hlo : 0<lo) (hhi : lo≤hi) (he : 0<ε) :
    ∃ T : ℕ, 2≤T ∧ ∀ N : ℕ, T≤N → ∀ L∈Icc lo hi, ∀ d : ℕ, 0<d →
    ∀ Q : ℝ, Q=(d : ℝ)*(N : ℝ)^L → ∀ (j : Fin 36) (k : Fin 4) (g : Fin 430),
      (∑ i : Fin 200,((weightAt (weights j k) i.val : ℝ)/(2^80 : ℝ))*floorValue (precedingH g) i) ≤
        physicalUpperWindow N Q L d j k g + ε := by
  have hf (g : Fin 430) : ∀ᶠ N : ℕ in atTop, ∀ L ∈ Icc lo hi, ∀ d : ℕ,
      ∀ j : Fin 36, ∀ k : Fin 4,
        |truePairOldProfile N L d (originalW2At j) k (precedingH g)-
          pairOldIntegral (originalW2At j) k (precedingH g)| < ε := by
    obtain ⟨T,hT⟩ := all36_four_true_old_H_profiles hlo hhi he (precedingH g)
    exact eventually_atTop.mpr ⟨T,hT⟩
  obtain ⟨T,hT⟩ := eventually_atTop.mp (eventually_all.mpr hf)
  refine ⟨max 2 T,le_max_left _ _,?_⟩
  intro N hN L hL d hd Q hQ j k g
  have hh := ((abs_lt.mp (hT N ((le_max_right _ _).trans hN) g L hL d j k)).1)
  rw [physicalUpperWindow_eq_profile (by omega) hd (hlo.trans_le hL.1) hQ]
  linarith only [immutable_each_original_pair j k g,hh]


/-- The preceding upper table is integrated over the four native, unmodified
two-prime domains with the actual scalar lookup at every point. -/
theorem integralPairs_eq_original_four (j : Fin 36) (g : Fin 430) :
    integralPairs j g = (∑ k : Fin 4,
      P2OriginalBankOldProfilePassage.pairOldIntegral (originalW2At j) k (precedingH g))/5 := by
  have hg := originalRepairedW2Bank_geometry _ (originalW2At_mem j)
  have h : (∑ b : FloorAtom, (∑ k : Fin 4,pairIntegralAtom (originalW2At j) k b)*
      floorAtomValue (precedingH g) b) =
      ∑ k : Fin 4, P2OriginalBankOldProfilePassage.pairOldIntegral
        (originalW2At j) k (precedingH g) := by
    simp_rw [Finset.sum_mul]
    rw [Finset.sum_comm]
    simp_rw [pairIntegralAtom_value hg]
  change (∑ b : FloorAtom, ((∑ k : Fin 4,pairIntegralAtom (originalW2At j) k b)/5)*
      floorAtomValue (precedingH g) b) = _
  simp_rw [div_mul_eq_mul_div]
  rw [← Finset.sum_div,h]

theorem immutable_w2_upper_le_original_four (j : Fin 36) (g : Fin 430) :
    archivedChannel (iterate g.val) j true ≤ (∑ k : Fin 4,
      P2OriginalBankOldProfilePassage.pairOldIntegral (originalW2At j) k (precedingH g))/5 :=
  (immutable_w2_pair_invoice j g).trans_eq (integralPairs_eq_original_four j g)

theorem pair_invoice_nonpos (g : Fin 430) (a : Original106Action) :
    bankPairArchive g a - bankPairIntegral g a ≤ 0 := by
  cases a with
  | inl a => simp [bankPairArchive,bankPairIntegral]
  | inr j => exact sub_nonpos.mpr (immutable_w2_pair_invoice j g)

/-- Existing h34 corrected 106-action upper error, now with only the original
signed base after all four same-Q W2 pair lanes, the three W2 singleton lanes,
the W1 lane and the two fixed anchor channels have been accounted for. -/
theorem uniform_corrected_bank_base_only {ε : ℝ} (hε : 0<ε) :
    ∃ T : ℕ, 4 ≤ T ∧ ∀ N : ℕ, T ≤ N →
    ∀ (n : ℕ) (k : Root) (t : ℝ) (p : ℕ) (g : Fin 430),
      0 ≤ t → t ≤ 1/12 → 1/((n : ℝ)+1) ≤ 11/384 →
      (p.Prime ∧ p.Coprime N) → P2EnhancedLowerPrimeChildCarriers.physicalPrime N p ∈ rootBand k →
      actualBankSourceGap N n k t p g +
        (∑ a : Original106Action, correctionOn N n k t p g (selectedLevel N n k t p g a)) +
        selectedBankRoundingLoss N n k t p g ≤
      (∑ a : Original106Action, ∑ l ∈ selectedLevel N n k t p g a,
          occurrenceScale N n k t p g l * baseValue a) +
        ε * actualBankTheta N n k t p g := by
  obtain ⟨T,hT,h⟩ := uniform_corrected_bank_after_singletons hε
  refine ⟨T,hT,?_⟩
  intro N hN n k t p g ht ht' hn hp hb
  apply (h N hN n k t p g ht ht' hn hp hb).trans
  apply add_le_add_right
  apply Finset.sum_le_sum
  intro a _
  apply Finset.sum_le_sum
  intro l _
  exact mul_le_mul_of_nonneg_left (add_le_of_nonpos_right (pair_invoice_nonpos g a))
    (occurrenceScale_nonneg N n k t p g l (hT.trans hN) ht ht' hn hp hb)

