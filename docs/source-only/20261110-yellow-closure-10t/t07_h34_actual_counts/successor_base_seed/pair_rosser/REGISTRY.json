  "theorem_statements": [
    {
      "file": "Part5OriginalH430BankAfterPairRosser.lean",
      "full_name": "ImbalancedChen.Part5OriginalH430BankAfterPairRosser.all106_after_pair_Rosser",
      "line": 41,
      "full_statement": "theorem all106_after_pair_Rosser {ε : ℝ} (he : 0<ε) :\n    ∃ T : ℕ,4≤T ∧ ∀ N : ℕ,T≤N → Even N → ∀ (n : ℕ) (r : Root) (t : ℝ) (p : ℕ),\n      0≤t → t≤1/12 → 1/((n:ℝ)+1)≤11/384 → p∈originalBand N r → ∀ g : Fin 430,\n      0≤markedPairExcess N n r t p g ∧\n      (∑ a : Original106Action,∑ l∈selectedLevel N n r t p g a,levelMark l*physicalDefect l)+\n          selectedBankRoundingLoss N n r t p g+markedPairExcess N n r t p g ≤\n        (∑ a : Original106Action,∑ l∈selectedLevel N n r t p g a,levelMark l*\n          afterPairs N (rootQ N n r t p) (wordLevel l) (wordProduct l) g a)+ε*actualBankTheta N n r t p g"
    },
