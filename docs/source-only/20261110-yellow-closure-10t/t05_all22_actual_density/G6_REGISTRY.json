  "terminals": {
    "ImbalancedChen.P4AOriginalThirdFallbackOccurrence.original_increment": {
      "source": "P4AOriginalThirdFallbackOccurrence.lean",
      "line": 142,
      "signature": "theorem original_increment (e : ℚ) (q : ℕ) (a : ℝ) (he : 0 ≤ (e : ℝ))\n    (hsmall : (e : ℝ) ≤ 11/64000) (N : ℕ) (hN : 1 ≤ (N : ℝ)) :\n    -normalize N (thirdIncrement e q a N) =\n      ∑ p ∈ candidateTuples (data e q a) N, (∏ i, weight (p i)) *\n        normalize N (saving (data e q a) N (List.ofFn p).reverse)"
    },
    "ImbalancedChen.P4AOriginalThirdFallbackChartIntegral.original_sixth_slot_le_chartSum": {
      "source": "P4AOriginalThirdFallbackChartIntegral.lean",
      "line": 188,
      "signature": "theorem original_sixth_slot_le_chartSum : currentUpperEighteenGains 5 ≤ chartSum"
    },
    "ImbalancedChen.P4AOriginalThirdFallbackJacobian.slot_le_physical_images": {
      "source": "P4AOriginalThirdFallbackJacobian.lean",
      "line": 110,
      "signature": "theorem slot_le_physical_images : currentUpperEighteenGains 5 ≤ ∑ c : Cell, ∫ p in region c,kernel p"
    },
    "ImbalancedChen.P4AOriginalThirdFallbackActualGain.exists_actual_gain": {
      "source": "P4AOriginalThirdFallbackActualGain.lean",
      "line": 139,
      "signature": "theorem exists_actual_gain (eps : ℝ) (heps : 0 < eps) :\n    ∃ e0 : ℝ,0 < e0 ∧ ∀ e : ℚ,0 < (e : ℝ) → (e : ℝ) < e0 →\n    ∃ q0 : ℕ,0 < q0 ∧ ∀ q : ℕ,q0 ≤ q → ∀ a : ℝ,a ≤ 1/800 →\n    ∀ᶠ N : ℕ in atTop,Even N →\n      currentUpperEighteenGains 5-eps < -normalize N (thirdIncrement e q a N)"
    },
    "ImbalancedChen.P4AOriginalThirdFallbackPaidDensity.exists_joined_ordinary": {
      "source": "P4AOriginalThirdFallbackPaidDensity.lean",
      "line": 68,
      "signature": "theorem exists_joined_ordinary (eta eMax : ℝ) (heta : 0 < eta) (heMax : 0 < eMax) :\n    Joined eMax (fun r n e q a N =>\n      normalize N (rawRoot (tree r n e q a N) N) < beforeEight n e q a N-(savedGain : ℝ)+eta)"
    },
    "ImbalancedChen.P4AOriginalThirdFallbackPaidDensity.exists_joined_positive_presieve": {
      "source": "P4AOriginalThirdFallbackPaidDensity.lean",
      "line": 78,
      "signature": "theorem exists_joined_positive_presieve (nu eta betaMax eMax : ℝ)\n    (hnu : 0 < nu) (heta : 0 < eta) (hMax : 0 < betaMax) (heMax : 0 < eMax) :\n    ∃ beta : ℝ, 0 < beta ∧ beta < 1/8 ∧ beta < betaMax ∧ beta^2 ≤ (19/96 : ℝ)/nu ∧\n    Joined eMax (fun r n e q a N =>\n      let w := (N : ℝ)^(nu*beta^2)\n      let L := (N : ℝ)^(nu*beta)\n      1 < w ∧ w ≤ cutoff N ∧ normalize N (physical (tree r n e q a N) N N w (cutoff N) L) <\n        beforeEight n e q a N-(savedGain : ℝ)+eta)"
    },
    "ImbalancedChen.P4AOriginalThirdFallbackPaidDensity.exists_paid_density_and_count": {
      "source": "P4AOriginalThirdFallbackPaidDensity.lean",
      "line": 97,
      "signature": "theorem exists_paid_density_and_count (eta eMax : ℝ) (heta : 0 < eta) (heMax : 0 < eMax) :\n    ∃ r0 : ℕ, ∀ r : ℕ, r0 ≤ r → ∃ n0 : ℕ, ∀ n : ℕ, n0 ≤ n →\n    ∃ a0 : ℝ, 0 < a0 ∧ a0 ≤ 1/800 ∧ ∀ a : ℝ, 0 < a → a ≤ a0 →\n    ∃ e0 : ℝ, 0 < e0 ∧ e0 ≤ eMax ∧ ∀ e : ℚ, 0 < (e : ℝ) → (e : ℝ) < e0 →\n    ∀ qMin mMin : ℕ, ∃ q0 : ℕ, 0 < q0 ∧ qMin ≤ q0 ∧ ∀ q : ℕ, q0 ≤ q →\n      mMin ≤ (data e q a).m ∧\n      (P4ASameRhoCompact.originalOrdinaryRoot + actualExtendedThirdFiniteFunctional (e : ℝ) (data e q a).m ≤\n        (∑ i, currentUpperEighteenPositive i) + originalDensityReserve/4) ∧\n      ∀ nu betaMax : ℝ, 0 < nu → 0 < betaMax → ∃ beta : ℝ, 0 < beta ∧ beta < 1/8 ∧\n        beta < betaMax ∧ nu*beta^2 < 19/96 ∧ nu*beta < 1/1000 ∧\n      ∃ tau0 : ℝ, 0 < tau0 ∧ ∀ tau : ℝ, 0 < tau → tau ≤ tau0 →\n        (∀ N : ℕ, 2 ≤ N → ∀ x : ℕ,\n          rho r n e q a N ((N : ℝ)^(nu*beta^2)) tau ((N : ℝ)^(nu*beta)) x ≠ 0 →\n            (x : ℝ) < (N : ℝ)^(599/1000 : ℝ)) ∧\n        (∀ᶠ N : ℕ in atTop, Even N →\n          let w := (N : ℝ)^(nu*beta^2)\n          let L := (N : ℝ)^(nu*beta)\n          physicalDensitySum (moduli N w) (rho r n e q a N w tau L) < upper r n e q a N w eta) ∧\n        ∀ b kappa : ℝ, 0 < b → b < 1 → (19/96 : ℝ) < (1-kappa)*(b/(1+b)) →\n          ∀ᶠ N : ℕ in atTop, Even N →\n            let w := (N : ℝ)^(nu*beta^2)\n            let L := (N : ℝ)^(nu*beta)\n            let T := manuscriptHalfProductCutoff kappa N\n            (RealB b N : ℝ) ≤ ((realHalfProductSource b N T).card : ℝ) * upper r n e q a N w eta +\n              realPhysicalDistributionError b N T (moduli N w) (rho r n e q a N w tau L) +\n                (Nat.ceil (cutoff N) : ℝ) + (T+1)"
    }
  },
  "remaining_original_duties": [
    "G1 and the old3 baseline to genuine finite four-positive functional, including its ordinary source and four positive endpoints.",
    "The actual fourth integral, enlarged fifth requantization and actual sixth signed frontiers with the original G4, G7-G14 assignment, all attained on the common parameters.",
    "The original remaining 3u_d/4, alongside the already furnished four-positive u_d/4. The free eta is cofinal; no new fixed reserve was charged by G6.",
    "Uniform distribution of this same tagged upper rho on the same Q gives the little-o error in the RealB inequality. The finite upper bound and nonzero-q< N^0.599 do not imply that asymptotic estimate.",
    "Combine these facts at every requested outer tolerance, eventually every even N, to supply hdensity/hUpper at the original E/K without new endpoint fields."
  ],
