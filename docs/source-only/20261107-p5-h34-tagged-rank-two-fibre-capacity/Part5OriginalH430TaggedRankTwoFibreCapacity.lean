open Part5OriginalH430ActualRankTwoFrontierSupport
open Part5OriginalH430RankTwoFrontierConverse

/-- Real original receipts that passed the first stage and have at
least one actual retained prime divisor of their integer quotient. -/
def retainedReceipts
    (N cap precision : ℕ) (tau z0 : ℝ) (lower : Bool) :
    Finset TaggedReceiver :=
  ((originalTagged N).filter
    (selectedOriginalRootStage N cap precision tau z0 lower)).filter
    (hasRetainedOriginalSecond N cap precision tau z0 lower)

/-- A deterministic-in-logic, noncomputable witness factor per retained
original q occurrence. This only chooses an existing retained factor;
it does not manufacture one or grant a count/historical payment. -/
def chosenSecondFactor
    (N cap precision : ℕ) (tau z0 : ℝ) (lower : Bool)
    (z : TaggedReceiver) : ℕ :=
  if h : hasRetainedOriginalSecond N cap precision tau z0 lower z then
    Classical.choose h
  else 0

theorem chosen_second_factor_spec
    (N cap precision : ℕ) (tau z0 : ℝ) (lower : Bool)
    (z : TaggedReceiver)
    (h : hasRetainedOriginalSecond N cap precision tau z0 lower z) :
    (chosenSecondFactor N cap precision tau z0 lower z).Prime ∧
    chosenSecondFactor N cap precision tau z0 lower z ∣
      arithmeticQuotientPrime z ∧
    retainedOriginalSecond N cap precision tau z0 lower z
      (chosenSecondFactor N cap precision tau z0 lower z) := by
  simpa [chosenSecondFactor, h] using (Classical.choose_spec h)

/-- Tag/p/ell uses the same Sum/Pair carrier but its second coordinate
means ell, NEVER the original arithmetic quotient q. This preserves
the separate U3 and U4 channels, even at overlapping p. -/
def chosenRankTwoKey
    (N cap precision : ℕ) (tau z0 : ℝ) (lower : Bool)
    (z : TaggedReceiver) : TaggedReceiver :=
  match z with
  | .inl v => .inl ⟨v.1, chosenSecondFactor N cap precision tau z0 lower z⟩
  | .inr v => .inr ⟨v.1, chosenSecondFactor N cap precision tau z0 lower z⟩

/-- Only the keys actually generated by the original retained q set. -/
def observedRankTwoKeys
    (N cap precision : ℕ) (tau z0 : ℝ) (lower : Bool) :
    Finset TaggedReceiver :=
  (retainedReceipts N cap precision tau z0 lower).image
    (chosenRankTwoKey N cap precision tau z0 lower)

/-- The FULL q/tag fibre of a chosen (tag,p,ell) key. Nothing is
deduplicated before this exact finite filter is formed. -/
def keyReceiptFibre
    (N cap precision : ℕ) (tau z0 : ℝ) (lower : Bool)
    (key : TaggedReceiver) : Finset TaggedReceiver :=
  (retainedReceipts N cap precision tau z0 lower).filter
    (fun z => chosenRankTwoKey N cap precision tau z0 lower z = key)

/-- Pick one REAL q receipt in each nonempty key fibre. The picker
is only a ledger representative, not an owner in the manuscript's
full/selected/inherited historical recursion. -/
def keyRepresentative
    (N cap precision : ℕ) (tau z0 : ℝ) (lower : Bool)
    (key : TaggedReceiver) : TaggedReceiver :=
  if hk : key ∈ observedRankTwoKeys N cap precision tau z0 lower then
    Classical.choose (Finset.mem_image.mp hk)
  else key

theorem key_representative_spec
    (N cap precision : ℕ) (tau z0 : ℝ) (lower : Bool)
    (key : TaggedReceiver)
    (hk : key ∈ observedRankTwoKeys N cap precision tau z0 lower) :
    keyRepresentative N cap precision tau z0 lower key ∈
      retainedReceipts N cap precision tau z0 lower ∧
    chosenRankTwoKey N cap precision tau z0 lower
      (keyRepresentative N cap precision tau z0 lower key) = key := by
  unfold keyRepresentative
  rw [dif_pos hk]
  exact Classical.choose_spec (Finset.mem_image.mp hk)

theorem representative_mem_key_fibre
    (N cap precision : ℕ) (tau z0 : ℝ) (lower : Bool)
    (key : TaggedReceiver)
    (hk : key ∈ observedRankTwoKeys N cap precision tau z0 lower) :
    keyRepresentative N cap precision tau z0 lower key ∈
      keyReceiptFibre N cap precision tau z0 lower key := by
  exact Finset.mem_filter.mpr
    (key_representative_spec N cap precision tau z0 lower key hk)

/-- Every member of an actual key fibre retains a genuine quotient
prime factor, original roughness window and REAL rank-two frontier
state of its corresponding tag/p-dependent physical Q. Sharing a key
does not replicate that history mass. -/
theorem key_receipt_has_actual_rank_two_frontier
    (N cap precision : ℕ) (tau z0 : ℝ) (lower : Bool)
    (key z : TaggedReceiver)
    (hz : z ∈ keyReceiptFibre N cap precision tau z0 lower key) :
    ∃ ell : ℕ, ∃ d : FirstExitDepthState ℕ,
      ell.Prime ∧ ell ∣ arithmeticQuotientPrime z ∧
      (N : ℝ) ^ Part5OriginalUpsilon5CausalDictionary.a ≤ (ell : ℝ) ∧
      (ell : ℝ) < (arithmeticPrime z : ℝ) ∧
      d ∈ firstExitDepthFrontier 2
        (ordinaryRosserRetainedPolicy lower
          (originalPhysicalQ N precision tau z))
        (fun r : ℕ => 1 / ((r : ℝ) - 1))
        [] true 1 (roughPrimeUniverse N cap 0 z0) ∧
      d.selectedPrefix = [ell, arithmeticPrime z] ∧
      d.positive = true ∧
      d.mass = historicalFirstRootMass (arithmeticPrime z) *
        (1 / ((ell : ℝ) - 1)) ∧
      chosenRankTwoKey N cap precision tau z0 lower z = key := by
  have hr : z ∈ retainedReceipts N cap precision tau z0 lower :=
    (Finset.mem_filter.mp hz).1
  have hroot : z ∈
      (originalTagged N).filter
        (selectedOriginalRootStage N cap precision tau z0 lower) :=
    (Finset.mem_filter.mp hr).1
  have horig : z ∈ originalTagged N :=
    (Finset.mem_filter.mp hroot).1
  have hret : hasRetainedOriginalSecond
      N cap precision tau z0 lower z :=
    (Finset.mem_filter.mp hr).2
  have hspec := chosen_second_factor_spec
    N cap precision tau z0 lower z hret
  let ell : ℕ := chosenSecondFactor N cap precision tau z0 lower z
  have hwin := retained_original_second_window_and_policy
    N cap precision tau z0 lower horig hspec.1 hspec.2.1 hspec.2.2
  obtain ⟨d, hd, hp, hsign, hmass⟩ :=
    retained_original_second_in_actual_rank_two_frontier
      N cap precision tau z0 lower z ell hspec.2.2
  exact ⟨ell, d, hspec.1, hspec.2.1, hwin.1, hwin.2.1,
    hd, hp, hsign, hmass, (Finset.mem_filter.mp hz).2⟩

/-- Exact weighted reindexing over distinct ACTUAL (tag,p,ell)
bookkeeping keys. Crucially the inner sum is still over EVERY q
receipt, rather than over one presumed historical mark. -/
theorem chosen_key_weighted_partition
    {M : Type*} [AddCommMonoid M]
    (N cap precision : ℕ) (tau z0 : ℝ) (lower : Bool)
    (w : TaggedReceiver → M) :
    (∑ z ∈ retainedReceipts N cap precision tau z0 lower, w z) =
    ∑ key ∈ observedRankTwoKeys N cap precision tau z0 lower,
      ∑ z ∈ keyReceiptFibre N cap precision tau z0 lower key, w z := by
  classical
  calc
    (∑ z ∈ retainedReceipts N cap precision tau z0 lower, w z) =
      ∑ z ∈ retainedReceipts N cap precision tau z0 lower,
        ∑ key ∈ observedRankTwoKeys N cap precision tau z0 lower,
          if chosenRankTwoKey N cap precision tau z0 lower z = key
            then w z else 0 := by
              apply Finset.sum_congr rfl
              intro z hz
              have hk : chosenRankTwoKey N cap precision tau z0 lower z ∈
                  observedRankTwoKeys N cap precision tau z0 lower :=
                Finset.mem_image.mpr ⟨z, hz, rfl⟩
              rw [Finset.sum_ite_eq]
              simp [hk]
    _ = ∑ key ∈ observedRankTwoKeys N cap precision tau z0 lower,
          ∑ z ∈ retainedReceipts N cap precision tau z0 lower,
            if chosenRankTwoKey N cap precision tau z0 lower z = key
              then w z else 0 := by
                rw [Finset.sum_comm]
    _ = ∑ key ∈ observedRankTwoKeys N cap precision tau z0 lower,
          ∑ z ∈ keyReceiptFibre N cap precision tau z0 lower key,
            w z := by
              apply Finset.sum_congr rfl
              intro key hk
              simp only [keyReceiptFibre, Finset.sum_filter]

/-- A key contributes exactly ONE representative q plus its complete
remaining q fibre. This is a finite identity, NOT a claim that the
representative can be paid by full/selected/inherited history. -/
theorem key_fibre_signed_split
    {M : Type*} [AddCommMonoid M]
    (N cap precision : ℕ) (tau z0 : ℝ) (lower : Bool)
    (key : TaggedReceiver)
    (hk : key ∈ observedRankTwoKeys N cap precision tau z0 lower)
    (w : TaggedReceiver → M) :
    (∑ z ∈ keyReceiptFibre N cap precision tau z0 lower key, w z) =
      w (keyRepresentative N cap precision tau z0 lower key) +
      (∑ z ∈
        (keyReceiptFibre N cap precision tau z0 lower key).erase
          (keyRepresentative N cap precision tau z0 lower key), w z) := by
  exact (Finset.add_sum_erase
    (keyReceiptFibre N cap precision tau z0 lower key) w
    (representative_mem_key_fibre
      N cap precision tau z0 lower key hk)).symm

/-- The signed source splits into ONE representative per distinct
tagged rank-two key and all surplus original q occurrences.
This applies to arbitrary signed q/tag weights, not just cardinals.
It grants NO paid historical capacity to the representatives. -/
theorem retained_source_representative_and_surplus
    {M : Type*} [AddCommMonoid M]
    (N cap precision : ℕ) (tau z0 : ℝ) (lower : Bool)
    (w : TaggedReceiver → M) :
    (∑ z ∈ retainedReceipts N cap precision tau z0 lower, w z) =
      (∑ key ∈ observedRankTwoKeys N cap precision tau z0 lower,
        w (keyRepresentative N cap precision tau z0 lower key)) +
      (∑ key ∈ observedRankTwoKeys N cap precision tau z0 lower,
        ∑ z ∈
          (keyReceiptFibre N cap precision tau z0 lower key).erase
            (keyRepresentative N cap precision tau z0 lower key), w z) := by
  calc
    _ = ∑ key ∈ observedRankTwoKeys N cap precision tau z0 lower,
          ∑ z ∈ keyReceiptFibre N cap precision tau z0 lower key, w z :=
      chosen_key_weighted_partition N cap precision tau z0 lower w
    _ = ∑ key ∈ observedRankTwoKeys N cap precision tau z0 lower,
          (w (keyRepresentative N cap precision tau z0 lower key) +
            ∑ z ∈
              (keyReceiptFibre N cap precision tau z0 lower key).erase
                (keyRepresentative N cap precision tau z0 lower key), w z) := by
      apply Finset.sum_congr rfl
      intro key hk
      exact key_fibre_signed_split N cap precision tau z0 lower key hk w
    _ = _ := Finset.sum_add_distrib

/-- Exact NATURAL cardinal capacity gap: there is one proposed
representative per distinct tagged (p,ell) key, while EVERY further
original q in that fibre remains a separate unpaid source receipt.
No sharing across tags or any signed Euler correction is paid here. -/
theorem retained_source_capacity_card
    (N cap precision : ℕ) (tau z0 : ℝ) (lower : Bool) :
    (retainedReceipts N cap precision tau z0 lower).card =
      (observedRankTwoKeys N cap precision tau z0 lower).card +
      ∑ key ∈ observedRankTwoKeys N cap precision tau z0 lower,
        ((keyReceiptFibre N cap precision tau z0 lower key).erase
          (keyRepresentative N cap precision tau z0 lower key)).card := by
  simpa using
    (retained_source_representative_and_surplus
      (M := ℕ) N cap precision tau z0 lower (fun _ => (1 : ℕ)))

/-- Bind the exact non-duplicating tagged-key ledger to the WHOLE
original U3+U4 signed count-source five-lane equality. All cutoff,
Rosser-rejected and no-factor receipts remain in the expression. -/
theorem original_source_with_tagged_key_surplus_and_unpaid
    (N cap precision : ℕ) (tau z0 : ℝ) (lower : Bool)
    (hzcap : z0 ≤ (cap : ℝ)) (w : TaggedReceiver → ℝ) :
    (∑ z ∈ originalTagged N, w z) =
    (((∑ key ∈ observedRankTwoKeys N cap precision tau z0 lower,
        w (keyRepresentative N cap precision tau z0 lower key)) +
      (∑ key ∈ observedRankTwoKeys N cap precision tau z0 lower,
        ∑ z ∈
          (keyReceiptFibre N cap precision tau z0 lower key).erase
            (keyRepresentative N cap precision tau z0 lower key), w z) +
      (∑ z ∈ (originalTagged N).filter
        (selectedOriginalRootStage N cap precision tau z0 lower),
        if hasPostRootPrimeFactor z ∧
          ¬ hasRetainedOriginalSecond N cap precision tau z0 lower z
          then w z else 0) +
      (∑ z ∈ (originalTagged N).filter
        (selectedOriginalRootStage N cap precision tau z0 lower),
        if ¬ hasPostRootPrimeFactor z then w z else 0)) +
      (∑ z ∈ rootCutoffBlocked (originalTagged N) z0, w z)) +
      (∑ z ∈ physicalPolicyBlocked N precision tau z0 lower, w z) := by
  have h := original_count_source_five_unpaid_lanes
    N cap precision tau z0 lower hzcap w
  have hfirst :
      (∑ z ∈ (originalTagged N).filter
        (selectedOriginalRootStage N cap precision tau z0 lower),
        if hasRetainedOriginalSecond N cap precision tau z0 lower z
          then w z else 0) =
      (∑ z ∈ retainedReceipts N cap precision tau z0 lower, w z) := by
    simp only [retainedReceipts, Finset.sum_filter]
  rw [hfirst,
    retained_source_representative_and_surplus
      N cap precision tau z0 lower w] at h
  exact h

end
