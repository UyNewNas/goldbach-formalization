/-- This analytic implication consumes original rational row geometry;
its conclusion is the original complete pointwise support region. -/
theorem original_zero_gates_imply_pointwiseSupport (raw : FifthWireRow)
    (hc : correlatedRawBoxGateCheck 0 raw = true) (t : Fin 5 → ℝ)
    (ht : t ∈ rawClosedBox raw) :
    t ∈ pointwiseSupport (maskSlots 5 raw.mask.toNat) := by
  have hs := correlatedRawBoxGateCheck_support_gates 0 raw hc t ht
  intro g hg
  cases g with
  | half => simpa only [gateAffine, halfGate_eval, Rat.cast_zero] using hs.1
  | full j => simpa only [gateAffine, fullGate_eval, Rat.cast_zero] using hs.2.1 j
  | selected j =>
      have hj : j ∉ maskSlots 5 raw.mask.toNat := of_decide_eq_true hg
      simpa only [gateAffine, selectedGate_eval, Rat.cast_zero] using hs.2.2 j hj

/-- The old unpaid fifth pointwise-invalid CORE is absent on the same
full independent typed archive. This does not remove owner/history or
new-parent errors, and has no credit until the finite proposals compile. -/
theorem archive_rejectedInvalidCore_empty (i : ArchiveIndex) (e : ℚ) (q : ℕ) (chi omega : ℝ) :
    rejectedInvalidCore i e q chi omega = ∅ := by
  apply eq_empty_iff_forall_not_mem.mpr
  intro t ht
  have hp := gateRejected_subset_parent i e q chi omega ht.1
  have hclosed : t ∈ rawClosedBox (archiveRow i) := fun k => ⟨(hp.1 k).1, (hp.1 k).2.le⟩
  exact ht.2 (original_zero_gates_imply_pointwiseSupport (archiveRow i)
    (archiveRow_original_zero_gates i) t hclosed)

theorem archive_invalidCoreCost_zero (i : ArchiveIndex) (e : ℚ) (q : ℕ) (chi omega : ℝ) :
    invalidCoreCost i e q chi omega = 0 := by
  simp only [invalidCoreCost, archive_rejectedInvalidCore_empty, measure_empty,
    ENNReal.toReal_zero, mul_zero]

theorem full_archive_invalidCoreBankCost_zero (e : ℚ) (q : ℕ) (chi omega : ℝ) :
    invalidCoreBankCost (Finset.univ : Finset ArchiveIndex) e q chi omega = 0 := by
  unfold invalidCoreBankCost
  exact Finset.sum_eq_zero (fun i _ => archive_invalidCoreCost_zero i e q chi omega)

end
