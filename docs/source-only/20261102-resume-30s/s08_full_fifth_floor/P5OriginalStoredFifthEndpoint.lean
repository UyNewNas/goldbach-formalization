private theorem indexed_list_sum {α : Type*} (xs : List α) (f : α → ℤ) :
    (∑ i : Fin xs.length, f xs[i.val]) = (xs.map f).sum := by
  rw [← List.sum_ofFn]
  have h : List.ofFn (fun i : Fin xs.length => xs[i.val]) = xs := List.ofFn_getElem
  simpa only [List.map_ofFn, Function.comp_def] using
    congrArg (fun ys : List α => (ys.map f).sum) h

/-- Only the source position is transported between the typed archive
and its independently stored checkpoint array. Their common length is
proved by their existing separate shape declarations. -/
theorem indexed_stored_new_sum :
    (∑ i : ArchiveIndex, (storedAt i).newQ80) = 12151684267250930159476 := by
  have hlength : Data.P1HistoricalFifthSavedTableData.rows.toList.length =
      P5SubdivisionStoredParentArchive.rows.toList.length := by
    rw [P1HistoricalFifthTypedArchiveShape.rows_toList_length,
      Array.length_toList, P5SubdivisionStoredParentArchive.rows_size]
  have hindex : (∑ i : ArchiveIndex, (storedAt i).newQ80) =
      ∑ j : Fin P5SubdivisionStoredParentArchive.rows.toList.length,
        (P5SubdivisionStoredParentArchive.rows.toList[j.val]).newQ80 := by
    exact Fintype.sum_equiv (finCongr hlength) _ _ (fun _ => rfl)
  rw [hindex, indexed_list_sum, original_stored_rows_new_sum, authorRetainedSum_eq]

/-- The original exact selected fifth replacement endpoint, with its
one Q80 denominator and no Chen quarter, owner multiplier or added old
saving. This is an arithmetic equality, not yet an integral certificate. -/
theorem original_stored_fifth_endpoint :
    (∑ i : ArchiveIndex, (storedNewQ i : ℝ)) =
      (3037921066812732539869 / 302231454903657293676544 : ℝ) := by
  have hz : (∑ i : ArchiveIndex, ((storedAt i).newQ80 : ℝ)) =
      12151684267250930159476 := by
    exact_mod_cast indexed_stored_new_sum
  simp only [storedNewQ, Rat.cast_div, Rat.cast_intCast]
  rw [← Finset.sum_div, hz]
  norm_num [dyadicScale]

