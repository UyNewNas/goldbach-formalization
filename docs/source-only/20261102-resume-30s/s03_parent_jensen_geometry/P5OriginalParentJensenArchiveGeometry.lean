theorem archiveRow_original_parent_geometry (i : ArchiveIndex) :
    ParentGeometryFacts (archiveRow i) :=
  rows_original_parent_geometry _ (archiveRow_source_member i)

noncomputable section
open Set
open scoped Classical

/-- All actual original parent endpoints are positive, using the inherited
lower-key theorem rather than another full-table arithmetic check. -/
theorem archiveRow_parent_lower_pos (i : ArchiveIndex) (k : Fin 5) :
    0 < ((archiveRow i).lower k : ℝ) := by
  have hk := (archiveRow_baseGeometry i).2.2.1 k
  have hpos : (0 : ℚ) < (archiveRow i).lo k := by exact_mod_cast (lt_of_lt_of_le (by norm_num : (0 : ℤ) < 1) hk)
  have hq : (0 : ℚ) < (archiveRow i).lower k := by
    simp only [FifthWireRow.lower, archiveRow_grid]
    exact div_pos hpos (by norm_num)
  exact Rat.cast_pos.mpr hq

/-- Full original32-vertex statement, at every original source index. -/
theorem archiveRow_parent_vertex_gap_sum (i : ArchiveIndex) :
    ((archiveRow i).vertexGapSum : ℝ) = ∑ w : Word, (32 * 400 : ℝ) *
      frozenGap (sourcePicks (archiveRow i)) (archiveRow i)
        (parentVertex (archiveRow i) (wordChoice w)) :=
  parent_vertex_gap_sum _ (archiveRow_original_parent_geometry i)

theorem archiveRow_parent_picks_eq_original_integer (i : ArchiveIndex) (I : OldMask) :
    sourcePicks (archiveRow i) I = P5OriginalChildIntegerWireBinding.originalPick (archiveRow i) I :=
  parent_picks_eq_original_integer _ (archiveRow_original_parent_geometry i) I

/-- The ORIGINAL A/B licenses the complete closed parent, with no child
ratio replacement and no hnew/whole-box premise at the exported boundary. -/
theorem archiveRow_parent_new_ratio (i : ArchiveIndex) (t : Fin 5 → ℝ)
    (ht : t ∈ rawClosedBox (archiveRow i)) :
    residual (rawCandidate 0 (archiveRow i) t) t ≤ (parentBQ (archiveRow i) : ℝ) :=
  parent_new_ratio _ (archiveRow_original_parent_geometry i)
    (archiveRow_parent_lower_pos i) t ht

theorem archiveRow_parentEQ_eq (i : ArchiveIndex) :
    (parentEQ (archiveRow i) : ℝ) =
      ((∑ w : Word, frozenGap (sourcePicks (archiveRow i)) (archiveRow i)
        (parentVertex (archiveRow i) (wordChoice w))) / 32) /
          ((archiveRow i).upper 4 : ℝ) := by
  apply parentEQ_eq _ (archiveRow_grid i) (archiveRow_original_parent_geometry i)
  exact lt_of_lt_of_le (by norm_num : (0 : ℤ) < 1) ((archiveRow_baseGeometry i).2.2.1 4)

/-- Scalar range and genuine32-vertex interpretation on the SAME row;
there is no new parent Jensen licence or archive-fact assumption. -/
theorem each_original_parent_geometry (i : ArchiveIndex) :
    ParentScalarFacts (archiveRow i) ∧ ParentGeometryFacts (archiveRow i) :=
  ⟨archiveRow_original_parent_scalars i, archiveRow_original_parent_geometry i⟩

end
