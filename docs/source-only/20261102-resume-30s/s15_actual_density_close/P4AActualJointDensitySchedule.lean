/-- Precision and cutoff first, then a positive buffer interval, any
smaller rational buffer, an arbitrary prior mesh resolution, one aligned
mesh threshold, any later aligned mesh, the finite fallback, and finally N.
Every displayed error is the existing independently defined actual source.
No final-policy equality or total-density estimate is a premise. -/
theorem exists_joint_original_density_schedule
    (eta eMax : ℝ) (heta : 0 < eta) (heMax : 0 < eMax) :
    ∃ a0 : ℝ, 0 < a0 ∧ a0 ≤ 1 / 800 ∧ a0 < (19 / 96 : ℝ) ∧
      ∀ a : ℝ, 0 < a → a ≤ a0 →
      ∃ e0 : ℝ, 0 < e0 ∧ e0 ≤ eMax ∧ e0 ≤ 3 / 51200 ∧
      ∀ e : ℚ, 0 < (e : ℝ) → (e : ℝ) < e0 →
      ∀ qMin mMin : ℕ,
      ∃ q0 : ℕ, 0 < q0 ∧ qMin ≤ q0 ∧
        e ≤ archiveGateMargin / 4 ∧
        ∀ q : ℕ, q0 ≤ q →
          let s := originalSchedule e q ((e : ℝ) / 20) a
          let d := s.data
          mMin ≤ d.m ∧
          P4ACatalogFiveHistoricalCoverage.meshStep d.m ≤ d.chi ∧
          P4ACatalogFiveHistoricalCoverage.meshStep d.m ≤ a / 2 ∧
          actualExtendedThirdFiniteFunctional (e : ℝ) d.m ≤
            originalCompactThirdCorrection +
              (319683857488126290909150567 / 2^111 : ℝ) +
                originalDensityReserve / 4 ∧
          (P4ASameRhoCompact.originalOrdinaryRoot +
              actualExtendedThirdFiniteFunctional (e : ℝ) d.m ≤
            (∑ i, currentUpperEighteenPositive i) + originalDensityReserve / 4) ∧
          (∑ i : ArchiveIndex,
            indexedActualReserve64 i e q ((e : ℝ) / 20) a) < eta / 2 ∧
          |∑ i : ArchiveIndex,
            (indexedIntegral i e q ((e : ℝ) / 20) a e -
              parentIntegral (archiveRow i))| < eta / 2 ∧
          (10051 / 1000000 : ℝ) <
            archiveFifthIntegral originalRows4 originalAdmission4 e q ((e : ℝ) / 20) a ∧
          ∃ m : ℕ, ∃ buffer : ℚ, 0 < (buffer : ℝ) ∧
            (buffer : ℝ) ≤ 2 * (d.e : ℝ) ∧
            (∀ N : ℝ, 1 ≤ N →
              ∀ (weight : ℕ → ℝ) (T : Bool → List ℕ → ℝ) (carrier : List ℕ),
              (signedTest (bufferedThirdPolicy d m buffer N) weight T [] true 1 carrier -
                  signedTest (fourthPolicy d m buffer N) weight T [] true 1 carrier =
                signedTest (old3 d N) weight T [] true 1 carrier -
                  signedTest (original4 d N) weight T [] true 1 carrier) ∧
              (signedTest (fourthPolicy d m buffer N) weight T [] true 1 carrier -
                  signedTest (fifthPolicy s m buffer N) weight T [] true 1 carrier =
                signedTest (original4 d N) weight T [] true 1 carrier -
                  signedTest (original5 d N) weight T [] true 1 carrier)) ∧
            ∃ N0 : ℕ, 2 ≤ N0 ∧ ∀ N : ℕ, N0 ≤ N → Even N →
              catalogFiveCapError d m buffer a N < eta / 2 ∧
              (640339 / 15210735000 : ℝ) - eta / 2 < normalizedActualSaving d N ∧
              catalogFiveCapError d m buffer a N +
                (∑ i : ArchiveIndex,
                  indexedActualReserve64 i e q ((e : ℝ) / 20) a) < eta := by
  have heta2 : 0 < eta / 2 := half_pos heta
  obtain ⟨ac, hac, hacrho, hcatalog⟩ :=
    exists_actual_original_catalog_five_schedule (eta / 2) heta2
  have hmargin : (0 : ℝ) <
      (3037921066812732539869 / 302231454903657293676544 : ℝ) -
        10051 / 1000000 := by norm_num
  obtain ⟨er, her, hermax, harchive⟩ :=
    exists_refinable_actual_archive_payment
      (min (eta / 2)
        ((3037921066812732539869 / 302231454903657293676544 : ℝ) -
          10051 / 1000000)) (lt_min heta2 hmargin)
  obtain ⟨et, het, _hetmax, mt, hthird⟩ :=
    exists_original_finite_positive_endpoint
  let a0 : ℝ := min ac (1 / 800)
  have ha0 : 0 < a0 := lt_min hac (by norm_num)
  refine ⟨a0, ha0, min_le_right _ _, (min_le_left _ _).trans_lt hacrho, ?_⟩
  intro a ha haa0
  have haac : a ≤ ac := haa0.trans (min_le_left _ _)
  have haw : a ≤ 1 / 800 := haa0.trans (min_le_right _ _)
  obtain ⟨ec, hec, hdata⟩ := hcatalog a ha haac
  let e0 : ℝ := min eMax (min er (min et ec))
  have he0 : 0 < e0 :=
    lt_min heMax (lt_min her (lt_min het hec))
  have he0er : e0 ≤ er := (min_le_right _ _).trans (min_le_left _ _)
  have he0et : e0 ≤ et :=
    (min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _))
  have he0ec : e0 ≤ ec :=
    (min_le_right _ _).trans ((min_le_right _ _).trans (min_le_right _ _))
  refine ⟨e0, he0, min_le_left _ _, he0er.trans hermax, ?_⟩
  intro e he hee qMin mMin
  have heer : (e : ℝ) < er := hee.trans_le he0er
  have heet : (e : ℝ) ≤ et := (hee.trans_le he0et).le
  have heec : (e : ℝ) < ec := hee.trans_le he0ec
  have heQ : (0 : ℚ) < e := by exact_mod_cast he
  obtain ⟨qc, _hqc, hcatalogq⟩ := hdata e heQ heec
  obtain ⟨q0, hq0, hqMin, hem, _hbudget, hpaid⟩ :=
    harchive e he heer a ha haw (max qMin qc) (max mMin mt)
  refine ⟨q0, hq0, (le_max_left _ _).trans hqMin, hem, ?_⟩
  intro q hq
  dsimp only
  let s := originalSchedule e q ((e : ℝ) / 20) a
  let d := s.data
  obtain ⟨hm, hstep, hrough, _hempty, _hhistory, _hgate, _howners,
      hreserve0, hliteral0⟩ := hpaid q hq
  have hreserve := hreserve0.trans_le (min_le_left _ _)
  have hliteral := hliteral0.trans_le (min_le_left _ _)
  have hreserveMargin := hreserve0.trans_le (min_le_right _ _)
  have hfifth := original_fifth_endpoint_sub_reserve e heQ.le q ((e : ℝ) / 20) a ha
    (haac.trans_lt hacrho)
  have hsafe : (10051 / 1000000 : ℝ) <
      archiveFifthIntegral originalRows4 originalAdmission4 e q ((e : ℝ) / 20) a := by
    linarith only [hfifth, hreserveMargin]
  have hmMin : mMin ≤ d.m := (le_max_left _ _).trans hm
  have hmt : mt ≤ d.m := (le_max_right _ _).trans hm
  have hthird' := hthird (e : ℝ) he.le heet d.m hmt
  have hmesh : P4ACatalogFiveHistoricalCoverage.meshStep d.m ≤ d.chi := hstep
  have hrough' : P4ACatalogFiveHistoricalCoverage.meshStep d.m ≤ a / 2 := hrough
  have hqcq : qc ≤ q := ((le_max_right _ _).trans hqMin).trans hq
  obtain ⟨m, buffer, hb, hbe, hgains, N0, hN0, hcost⟩ :=
    hcatalogq q hqcq
  refine ⟨hmMin, hmesh, hrough', hthird'.1, hthird'.2, hreserve, hliteral, hsafe,
    m, buffer, hb, hbe, hgains, N0, hN0, ?_⟩
  intro N hN hEven
  have hC := hcost N hN hEven
  exact ⟨hC.1, hC.2, by linarith only [hC.1, hreserve]⟩

end
