  "original_consumer": "P5OriginalU5CausalFinite.pairSupport and P5OriginalU5CausalFinite.rho N epsilon of the existing explicit original-root warmPlan canonical continuation. The complete modulus is (p.2*p.1)*k, including actual beta primes. The production rho policy parameter is instantiated; no independently fixed original policy is equated to it.",
  "parameters": {
    "a": "417/5000",
    "h": "19/125",
    "mu": "25/128",
    "Lambda": "153/256",
    "spectral_exponent": "7/32",
    "W": "Lambda-(3/8)*a",
    "physical_root": "W-2*b",
    "auxiliary_theta": "W-b/2",
    "delta": "b/4",
    "complete_gate_exponent": "theta-2*delta=W-b",
    "epsilon": "0<epsilon<1/8",
    "small_attachment": "(34/125)*epsilon<=b",
    "buffer": "0<b<=1/1000",
    "root_gap": "A(t)+2*b<=W",
    "factor_capacity": "1<=A<=N^(1/3)",
    "critical_only_residue": "1+3*kappa with kappa<=b",
    "completed_monomial_residue": "1"
  },
  "eliminated_obligations": [
    "Identify strict W root decision with the independently defined original piecewise L5/L6 level and exact SourceForm.wSlot 2 cutoff endpoint; no fake selected critical product.",
    "Exclude strict root W on original U6 domain from the real piecewise guard and t>=h, without excluding later W sources.",
    "Derive first-bin, second-square, capacity positivity and both critical upper exponents from original U5 triangle and original root gap allocation.",
    "Derive final cap equality and exact auxiliary level from primitive actual all-inherit decisions, not from a supplied final-cap identity.",
    "Derive actual U5 beta head-square, small-level buffer and late small-prime cutoff from the literal production allocation; use G actual accepted native word and both complete square systems.",
    "Construct complete deterministic W factors of the entire signed native modulus in both true success/overflow cases, preserve occurrence trace and positive natural products, and prove all three fixed-residue arithmetic monomials."
  ],
  "true_premises": [
    "Actual original U5 pairSupport membership, N>=2 and nonzero literal production rho for the explicit existing canonical warmPlan continuation.",
    "Strict raw original root-W test is true; positive buffer fits its original A(t) gap; these select a proper source crop, not a full-domain theorem.",
    "Original epsilon and small-level allocation stated in parameters; no final support/gate/partition/monomial hypothesis occurs in native_U5_inherited_W.",
    "The conclusion is conditional on Inherits for the actual extracted word. That recursive predicate checks every actual planChoice; no proof of exhaustive inherited coverage is claimed.",
    "Per-integer-word deterministic factors are constructed. Uniform endpoint-box assignment is not an input or conclusion."
  ],
  "remaining_internal_obligations": [
    "Full independently adopted L5/L6 mixed W/tent policy/source/query association and all branch coverage; canonical subfamily is not full adoption.",
