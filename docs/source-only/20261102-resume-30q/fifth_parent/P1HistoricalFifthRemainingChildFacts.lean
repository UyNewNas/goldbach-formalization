def remainingChildFacts (raw : FifthWireRow) : Prop :=
  ownerLicenseCheck raw = false → ∀ c : ChildIndex, SourceChildFacts raw c

instance remainingChildFactsDecidable (raw : FifthWireRow) :
    Decidable (remainingChildFacts raw) := by
  unfold remainingChildFacts
  infer_instance

