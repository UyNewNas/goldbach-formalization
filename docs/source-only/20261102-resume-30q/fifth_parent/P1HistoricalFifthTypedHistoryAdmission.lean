/-- The actual producer's separate ordering and third-history admission.
The archived fifth selected mask and saved Jensen statistics are unchanged. -/
def originalHistoryAdmission (raw : FifthWireRow) : Prop :=
  rawKeyOrdered raw ∧ 0 < producerThirdGap400 raw

