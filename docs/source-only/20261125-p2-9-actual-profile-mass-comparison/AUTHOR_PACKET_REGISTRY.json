    "right_base": "norm N * (sum dep:Fin431, sum p in originalBand N U4, sum l in B dep p, levelMark l * ordinaryBad N (rootQ N n U4 t p) (wordProduct l))",
    "right_error": "epsilon",
    "original_base_coefficient": 1,
