  "current_parent_scope": "P3 prescribed negative Bruhat geometry and physical Euler regularity; neither full prescribed Kuznetsov trace nor all-cost 7/32",
  "positive_arguments": "forall ell : D4→Int, Y>0, q>0, OriginalAbelOrbit.induced (H_ab ell Y) q = spectralTest ell Y q. In particular at every q=4*pi*sqrt(p*abs(h))/(c*sqrt(z)) with original p>0, h<0, c>0, z>0. No negative-q extension is used.",
  "physical_conjugation": "H positive heights; rank one psi(a)*star(phi(b)) with exterior star on frozen test. Direct positive first-height measure kills the zero and negative chart.",
  "exact_parameters": {
    "alpha": "4*pi^2",
    "lambda": "1",
    "ratio": "(1/2)*log(a/b)",
    "radial_floor": "(Y/(64*pi))^2, uniform in ell and jet order for each Y>0",
    "resolvent": "K(u)=if u>0 then exp(-u)/sqrt(u) else 0",
    "radial_density": "f=pi^{-1}K*(F_prime+F), h(p)=p*sqrt(p)*f(p)",
    "mixed_derivatives": "all i,j in Nat and A>=0, C exists for fixed ell,Y,i,j,A, physical (a*d_a)^i(b*d_b)^j and log derivatives bounded by C exp(-A*(abs(log a)+abs(log b))). No uniform seminorm price in Y is inferred."
  },
