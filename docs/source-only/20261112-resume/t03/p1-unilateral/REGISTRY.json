    {
      "line": 36,
      "theorem": "admitted_fifth_cube",
      "content": "Recover the odd product bound b5*p5^2<D from either true policy at the rank-five negative gate, with its respective D<=N^(299/500)."
    },
    {
      "line": 83,
      "theorem": "stopped_extension",
      "content": "All subsequently selected factors of the actual stopped terminal come from its ordered remaining suffix."
    },
    {
      "line": 126,
      "theorem": "actual_fifth_terminal_full_modulus",
      "content": "Every terminal of a true fifth admission before rank eight has rough modulus below N^(299/500). For every sign-selected nonzero beta(a), a*b<N^(3/5) whenever epsilon<=1/500."
    },
    {
      "line": 168,
      "theorem": "no_sixth_unilateral",
      "content": "At the positive sixth query immediately below a BOTH fifth, each original gate is true."
    },
    {
      "line": 233,
      "theorem": "actual_event_zero",
      "content": "Every occurrence left in the actual fifth/sixth list at each shared fourth parent has value zero for X>=N^(3/5)."
    },
    {
      "line": 274,
      "theorem": "actual_exclusive_invoice_zero",
      "content": "The absolute invoice of exactly these original events vanishes."
    },
    {
      "line": 286,
      "theorem": "actual_stopped_difference_zero",
      "content": "The original same-parameter signed rawStopped minus licensedStopped equals zero."
    },
