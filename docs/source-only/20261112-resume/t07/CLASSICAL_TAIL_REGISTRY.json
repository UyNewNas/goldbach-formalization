        {
          "name": "classical_geometry",
          "kind": "theorem",
          "private": false,
          "line": 41,
          "declaration": "theorem classical_geometry {N n m p : ℕ} {τ : ℝ}\n    (hN : 2 ≤ N) (hτ : 0 ≤ τ) (hτ' : τ ≤ 1/12)\n    (hn : 1/((n:ℝ)+1) ≤ 11/384) (hp : p ∈ classicalBand N) :\n    1 < rootQ N n .U3 τ p / (p : ℝ) ∧ cutoffAt N n m p τ ≤ (N:ℝ)^a ∧\n      rootQ N n .U3 τ p ≤ (N:ℝ)^(1/2-τ)"
        },
        {
          "name": "pooled_support",
          "kind": "theorem",
          "private": false,
          "line": 67,
          "declaration": "theorem pooled_support {N n m : ℕ} {τ : ℝ}\n    (hN : 2 ≤ N) (hτ : 0 ≤ τ) (hτ' : τ ≤ 1/12)\n    (hn : 1/((n:ℝ)+1) ≤ 11/384) :\n    (∀ p ∈ classicalBand N, activeDivisors N n m p τ ⊆\n      (sieveProduct N (Nat.ceil ((N:ℝ)^a))).divisors) ∧\n    (∀ p ∈ classicalBand N, ∀ r ∈ activeDivisors N n m p τ,\n      p*r ≤ ⌊(N:ℝ)^(1/2-τ)⌋₊)"
        }
      ]
    },
