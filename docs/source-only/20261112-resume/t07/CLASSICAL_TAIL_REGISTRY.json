      "declarations": [
        {
          "name": "primeError",
          "kind": "def",
          "private": true,
          "line": 23,
          "declaration": "private def primeError (N k : ℕ) : ℝ :="
        },
        {
          "name": "primeError_bound",
          "kind": "theorem",
          "private": true,
          "line": 28,
          "declaration": "private theorem primeError_bound {N k : ℕ} (hN : 0 < N) (hk : 0 < k)\n    (hcop : k.Coprime N) (hlog : 1 ≤ Real.log (N:ℝ)) :\n    |primeError N k| ≤ |chenQuotientPrimeAPError N (trueLogarithmicIntegral N) k| +\n      (3 / Real.log 2) * Real.log (N : ℝ)"
        },
        {
          "name": "abs_row_le_active",
          "kind": "theorem",
          "private": true,
          "line": 58,
          "declaration": "private theorem abs_row_le_active (N n m p : ℕ) (τ : ℝ) :\n    |signedAP N p (rootQ N n .U3 τ p) (cutoffAt N n m p τ)| ≤\n      ∑ r ∈ activeDivisors N n m p τ, |primeError N (p*r)|"
        },
        {
          "name": "classical_tail_AP_log_saving",
          "kind": "theorem",
          "private": false,
          "line": 86,
          "declaration": "theorem classical_tail_AP_log_saving {τ : ℝ} (hτ : 0 < τ) (hτ' : τ ≤ 1/12)\n    (K : ℕ) (hK : 0 < K) :\n    ∃ C : ℝ, 0 < C ∧ ∀ᶠ N : ℕ in atTop, ∀ n m : ℕ,\n      1/((n:ℝ)+1) ≤ 11/384 →\n      (∑ p ∈ classicalBand N, |signedAP N p (rootQ N n .U3 τ p) (cutoffAt N n m p τ)|) ≤\n        C * (N:ℝ) / Real.log (N:ℝ)^K"
        }
      ]
    },
