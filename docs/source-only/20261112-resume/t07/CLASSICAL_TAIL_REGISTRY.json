          "private": false,
          "line": 22,
          "declaration": "def U3Upper (N n m : ℕ) (τ ε : ℝ) : ℝ :="
        },
        {
          "name": "original_U3_signed_split",
          "kind": "theorem",
          "private": false,
          "line": 31,
          "declaration": "theorem original_U3_signed_split {N n m : ℕ} {τ : ℝ} (ε : ℝ)\n    (hN : 2 ≤ N) (hτ : 0 ≤ τ) (hτ' : τ ≤ 1/12) (hn : 1/((n:ℝ)+1) ≤ 11/384) :\n    bandUpper N n m .U3 τ ε = U3Upper N n m τ ε +\n      ∑ p ∈ classicalBand N, signedAP N p (rootQ N n .U3 τ p) (cutoffAt N n m p τ)"
        },
        {
          "name": "original_U34_with_classical_root_AP_paid",
          "kind": "theorem",
          "private": false,
          "line": 59,
          "declaration": "theorem original_U34_with_classical_root_AP_paid {τ ε : ℝ}\n    (hτ : 0 < τ) (hτ' : τ ≤ 1/12) (he : 0 < ε) (K : ℕ) (hK : 0 < K) :\n    ∃ C : ℝ, 0 < C ∧ ∀ᶠ N : ℕ in atTop, Even N → ∀ n m : ℕ,\n      1/((n:ℝ)+1) ≤ 11/384 →\n      currentChenUpsilon3 N + currentChenUpsilon4 N ≤\n        U3Upper N n m τ ε + bandUpper N n m .U4 τ ε + C*(N:ℝ)/Real.log (N:ℝ)^K"
        }
      ]
