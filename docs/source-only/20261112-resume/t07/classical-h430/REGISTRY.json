        },
        {
          "name": "cubeCredit_nonneg",
          "kind": "theorem",
          "private": false,
          "line": 117,
          "declaration": "theorem cubeCredit_nonneg {N n p : ℕ} {τ : ℝ}\n    (hN : 2 ≤ N) (hτ : 0 ≤ τ) (hτ' : τ ≤ 1/12)\n    (hn : 1/((n:ℝ)+1) ≤ 11/384) (hp : p ∈ classicalBand N) :\n    0 ≤ cubeCredit N n p τ"
        },
        {
          "name": "original_classical_credit",
          "kind": "theorem",
          "private": false,
          "line": 128,
          "declaration": "theorem original_classical_credit {N n m p : ℕ} {τ : ℝ}\n    (hN : 2 ≤ N) (hτ : 0 ≤ τ) (hτ' : τ ≤ 1/12)\n    (hn : 1/((n:ℝ)+1) ≤ 11/384) (hp : p ∈ classicalBand N) :\n    let Q := rootQ N n .U3 τ p\n    let w := queryAt (keyAt N n m .U3 τ p)\n    let z := cutoffAt N n m p τ\n    surplus N p Q z + firstPrimeMass N Q w p = cubeCredit N n p τ ∧\n      ((originalReceiver N p).card:ℝ) + cubeCredit N n p τ = model true N Q p z + signedAP N p Q z"
        }
      ]
