          "name": "same_prime_density",
          "kind": "theorem",
          "private": true,
          "line": 24,
          "declaration": "private theorem same_prime_density {N n p : ℕ} {τ : ℝ} (hp : p.Prime) (hc : p.Coprime N)\n    (z : ℝ) : let Q := rootQ N n .U3 τ p\n    actualSmallRosserPlusDensity (p*N) ⌈z⌉₊ z (Q/p) =\n      ordinaryRosserMainSum true N p (P2ActualMarkedCountState.rootLevel Q p) z"
        },
        {
          "name": "beta_bounds",
          "kind": "theorem",
          "private": true,
          "line": 50,
          "declaration": "private theorem beta_bounds {N n p : ℕ} {τ : ℝ}\n    (hN : 2 ≤ N) (hτ : 0 ≤ τ) (hτ' : τ ≤ 1/12)\n    (hn : 1/((n:ℝ)+1) ≤ 11/384) (hp : p ∈ classicalBand N) :\n    Real.log (rootQ N n .U3 τ p / (p:ℝ)) / Real.log ((p*N:ℕ):ℝ) ∈ Icc (11/768:ℝ) 1"
        },
        {
          "name": "classical_root_main_close",
          "kind": "theorem",
          "private": false,
          "line": 82,
          "declaration": "theorem classical_root_main_close {ε : ℝ} (he : 0 < ε) :\n    ∀ᶠ N : ℕ in atTop, Even N → ∀ (n m : ℕ) (τ : ℝ),\n      0 ≤ τ → τ ≤ 1/12 → 1/((n:ℝ)+1) ≤ 11/384 → ∀ p ∈ classicalBand N,\n      let Q := rootQ N n .U3 τ p\n      |model true N Q p (cutoffAt N n m p τ) - thetaAtom N Q p| ≤ ε*thetaAtom N Q p"
        }
      ],
