          "kind": "theorem",
          "private": false,
          "line": 35,
          "declaration": "theorem actual_classical_and_clamp_distance {τ ε : ℝ}\n    (hτ : 0 < τ) (hτ' : τ ≤ 1/12) (he : 0 < ε) :\n    ∀ᶠ N : ℕ in atTop, Even N → ∀ n : ℕ, 1/((n:ℝ)+1) ≤ 11/384 →\n      (∑ p ∈ classicalBand N, |rootDifference N n p τ|) ≤ ε * classicalMass N n τ ∧\n      (∑ p ∈ clampPrimes N, |rootDifference N n p τ|) ≤ ε * clampMass N n τ"
        },
        {
          "name": "archived_classical_H430_gap",
          "kind": "theorem",
          "private": false,
          "line": 74,
          "declaration": "theorem archived_classical_H430_gap {τ ε : ℝ} (hτ : 0 < τ) (hτ' : τ ≤ 1/12) (he : 0 < ε) :\n    ∀ᶠ N : ℕ in atTop, Even N → ∀ n : ℕ, 1/((n:ℝ)+1) ≤ 11/384 →\n      (∑ p ∈ classicalBand N,\n        let s := frozenQuery n .U3 τ (physicalPrime N p)\n        let θ := thetaAtom N (rootQ N n .U3 τ p) p\n        |(((originalReceiver N p).card:ℝ) - (upperAmplitude s - H430 s)*θ) -\n          (H430 s*θ - cubeCredit N n p τ)|) ≤ ε*classicalMass N n τ"
        },
        {
          "name": "selected_classical_H430_gap",
          "kind": "theorem",
          "private": false,
          "line": 97,
          "declaration": "theorem selected_classical_H430_gap {τ ε : ℝ} (hτ : 0 < τ) (hτ' : τ ≤ 1/12) (he : 0 < ε) :\n    ∀ᶠ N : ℕ in atTop, Even N → ∀ n m : ℕ, 1/((n:ℝ)+1) ≤ 11/384 →\n      (∑ p ∈ classicalBand N,\n        let c := keyAt N n m .U3 τ p\n        let θ := thetaAtom N (rootQ N n .U3 τ p) p\n        |(((originalReceiver N p).card:ℝ) - (P5CanonicalUpperCancellation.upperA (queryAt c) -\n          ownerFloor c)*θ) -\n          (requestValue (iterate 430) (rootRequest N n .U3 τ p)*θ - cubeCredit N n p τ)|) ≤\n        ε*classicalMass N n τ"
        },
