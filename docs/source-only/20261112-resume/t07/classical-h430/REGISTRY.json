          "line": 137,
          "declaration": "theorem selected_clamp_price_lower {N n p : ℕ} {τ : ℝ}\n    (hN : 2 ≤ N) (hτ : 0 ≤ τ) (hτ' : τ ≤ 1/12) (hp : p ∈ clampPrimes N) :\n    (1/50:ℝ) ≤ requestValue (iterate 430) (rootRequest N n .U3 τ p)"
        },
        {
          "name": "archive_clamp_charge_positive",
          "kind": "theorem",
          "private": false,
          "line": 166,
          "declaration": "theorem archive_clamp_charge_positive :\n    let c := ((37052565421922458792801:ℝ)/(2:ℝ)^80)*(4*Real.log (834/833:ℝ))\n    0 < c ∧ ∀ᶠ N : ℕ in atTop, ∀ (n : ℕ) (τ : ℝ), 0 ≤ τ → τ ≤ 1/12 →\n      1/((n:ℝ)+1) ≤ 11/384 → c*singularNormalization N ≤ H430 2 * clampMass N n τ"
        },
        {
          "name": "actual_clamp_H430_gap",
          "kind": "theorem",
          "private": false,
          "line": 185,
          "declaration": "theorem actual_clamp_H430_gap {τ ε : ℝ} (hτ : 0 < τ) (hτ' : τ ≤ 1/12) (he : 0 < ε) :\n    ∀ᶠ N : ℕ in atTop, Even N → ∀ n : ℕ, 1/((n:ℝ)+1) ≤ 11/384 →\n      |((∑ p ∈ clampPrimes N, ((originalReceiver N p).card:ℝ)) -\n          (1-H430 2)*clampMass N n τ) -\n        (H430 2*clampMass N n τ - ∑ p ∈ clampPrimes N, cubeCredit N n p τ)| ≤\n        ε*clampMass N n τ"
