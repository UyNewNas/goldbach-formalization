          "kind": "theorem",
          "private": true,
          "line": 38,
          "declaration": "private theorem frozen_receiver_shell {N p : ℕ} {Q w : ℝ} (hp : p ∈ classicalBand N)\n    (hz : cutoff Q p w ≤ (N:ℝ)^a) :\n    (frozenCount N p (receiver N) (cutoff Q p w):ℝ) =\n      ((originalReceiver N p).card:ℝ) + firstPrimeMass N Q w p"
        },
        {
          "name": "physical_marked_class",
          "kind": "theorem",
          "private": false,
          "line": 55,
          "declaration": "theorem physical_marked_class {N n m : ℕ} {τ : ℝ} (c : RootKey n m)\n    (hN : 2 ≤ N) (hτ : 0 ≤ τ) (hτ' : τ ≤ 1/12) (hn : 1/((n:ℝ)+1) ≤ 11/384) :\n    let B := (classicalBand N).filter (fun p => keyAt N n m .U3 τ p = c)\n    let Q := (N:ℝ)^(clampLevel n τ)\n    markedPhi N Q B id (fun _ => 1) (fun _ => receiver N) (queryAt c) =\n        (∑ p ∈ B, ((originalReceiver N p).card:ℝ)) + ∑ p ∈ B, firstPrimeMass N Q (queryAt c) p ∧\n      Theta N Q B (fun _ => 1) = ∑ p ∈ B, thetaAtom N (rootQ N n .U3 τ p) p"
        },
        {
          "name": "original_class_zero_theta_iff_empty",
          "kind": "theorem",
          "private": false,
          "line": 79,
          "declaration": "theorem original_class_zero_theta_iff_empty {N n m : ℕ} {τ : ℝ} (c : RootKey n m)\n    (hN : 4 ≤ N) (hτ : 0 ≤ τ) (hτ' : τ ≤ 1/12) (hn : 1/((n:ℝ)+1) ≤ 11/384) :\n    let B := (classicalBand N).filter (fun p => keyAt N n m .U3 τ p = c)\n    Theta N ((N:ℝ)^(clampLevel n τ)) B (fun _ => 1) = 0 ↔ B = ∅"
        },
        {
