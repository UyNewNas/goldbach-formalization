          "declaration": "theorem surplus_nonneg {N p : ℕ} {Q z : ℝ} (hD : 1 < rootLevel Q p)\n    (hz : z ≤ (rootLevel Q p : ℝ)) : 0 ≤ surplus N p Q z :="
        },
        {
          "name": "true_quotient_zero_surplus",
          "kind": "theorem",
          "private": false,
          "line": 53,
          "declaration": "theorem true_quotient_zero_surplus {N p q : ℕ} {Q z : ℝ}\n    (hD : 1 < rootLevel Q p) (hp : ChenPrimeRough z p)\n    (hq : q ∈ chenSiftedQuotientPrimeSource N p z) :\n    ∃ ell ∈ (goldbachDivisible N p).filter (receiver N),\n      (N-ell)/p = q ∧ primeSurplus N p Q z ell = 0"
        },
        {
          "name": "frozen_count_plus_surplus",
          "kind": "theorem",
          "private": false,
          "line": 77,
          "declaration": "theorem frozen_count_plus_surplus {N p : ℕ} (Q z : ℝ) (hp : p.Coprime N) :\n    (frozenCount N p (receiver N) z : ℝ) + surplus N p Q z =\n      model true N Q p z + signedAP N p Q z"
        }
