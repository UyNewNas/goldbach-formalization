          "kind": "theorem",
          "private": false,
          "line": 35,
          "declaration": "theorem primeSurplus_nonneg {N p : ℕ} {Q z : ℝ} (hD : 1 < rootLevel Q p)\n    (hz : z ≤ (rootLevel Q p : ℝ)) (ell : ℕ) : 0 ≤ primeSurplus N p Q z ell"
        },
