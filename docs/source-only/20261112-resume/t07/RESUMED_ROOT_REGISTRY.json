      "declarations": [
        {
          "name": "queryAt_le_six",
          "kind": "theorem",
          "private": true,
          "line": 32,
          "declaration": "private theorem queryAt_le_six {n m : ℕ} (c : RootKey n m) : queryAt c ≤ 6"
        },
        {
          "name": "box_geometry",
          "kind": "theorem",
          "private": true,
          "line": 44,
          "declaration": "private theorem box_geometry {N n m p : ℕ} {k : Root} {τ : ℝ} {c : RootKey n m}\n    (hN : 2 ≤ N) (hτ : 0 ≤ τ) (hτ' : τ ≤ 1 / 12)\n    (hn : 1 / ((n : ℝ) + 1) ≤ 11 / 384) (hp : p ∈ rootFibre N n m k τ c) :\n    let Q := cellQ N n c.1\n    let s := queryAt c\n    2 ≤ s ∧ s ≤ 6 ∧ 1 < Q / (p : ℝ) ∧\n      (N : ℝ) ^ ((11 / 384 : ℝ) / 6) ≤ cutoff Q p s ∧\n      cutoff Q p s ≤ (N : ℝ) ^ a ∧ p ≤ N"
        },
        {
          "name": "original_box_balance",
          "kind": "theorem",
          "private": false,
          "line": 88,
          "declaration": "theorem original_box_balance {N n m : ℕ} (k : Root) (τ : ℝ) (c : RootKey n m)\n    (hN : 2 ≤ N) (hτ : 0 ≤ τ) (hτ' : τ ≤ 1 / 12)\n    (hn : 1 / ((n : ℝ) + 1) ≤ 11 / 384) :\n    let B := rootFibre N n m k τ c\n    let Q := cellQ N n c.1\n    let s := queryAt c\n    ((∑ p ∈ B, ((originalReceiver N p).card : ℝ)) +\n      ∑ p ∈ B, firstPrimeMass N Q s p) + (∑ p ∈ B, surplus N p Q (cutoff Q p s)) =\n      ∑ p ∈ B, (model true N Q p (cutoff Q p s) + signedAP N p Q (cutoff Q p s))"
        },
        {
          "name": "original_closed_owner_difference",
          "kind": "theorem",
          "private": false,
          "line": 108,
          "declaration": "theorem original_closed_owner_difference {N n m : ℕ} (k : Root) (τ : ℝ) (c : RootKey n m)\n    (hN : 2 ≤ N) (hτ : 0 ≤ τ) (hτ' : τ ≤ 1 / 12)\n    (hn : 1 / ((n : ℝ) + 1) ≤ 11 / 384) :\n    let B := rootFibre N n m k τ c\n    let Q := cellQ N n c.1\n    let s := queryAt c\n    (∑ p ∈ B, ((originalReceiver N p).card : ℝ)) -\n        (upperA s - ownerFloor c) * Theta N Q B (fun _ => 1) =\n      (∑ p ∈ B, (model true N Q p (cutoff Q p s) + signedAP N p Q (cutoff Q p s) -\n        upperA s * thetaAtom N Q p - surplus N p Q (cutoff Q p s) - firstPrimeMass N Q s p)) +\n      ∑ p ∈ B, thetaAtom N (rootQ N n k τ p) p *\n        requestValue (iterate 430) (rootRequest N n k τ p)"
        },
        {
          "name": "original_quotient_zero_box_surplus",
          "kind": "theorem",
          "private": false,
          "line": 132,
          "declaration": "theorem original_quotient_zero_box_surplus {N n m p q : ℕ} {k : Root} {τ : ℝ}\n    {c : RootKey n m} (hN : 2 ≤ N) (hτ : 0 ≤ τ) (hτ' : τ ≤ 1 / 12)\n    (hn : 1 / ((n : ℝ) + 1) ≤ 11 / 384)\n    (hp : p ∈ rootFibre N n m k τ c) (hq : q ∈ originalReceiver N p) :\n    let Q := cellQ N n c.1\n    ∃ ell ∈ (goldbachDivisible N p).filter (receiver N), (N-ell)/p = q ∧\n      primeSurplus N p Q (cutoff Q p (queryAt c)) ell = 0"
        },
        {
          "name": "bandUpper",
          "kind": "def",
          "private": false,
          "line": 150,
          "declaration": "def bandUpper (N n m : ℕ) (k : Root) (τ ε : ℝ) : ℝ :="
        },
        {
          "name": "original_U34_at_signed_root_AP",
          "kind": "theorem",
          "private": false,
          "line": 162,
          "declaration": "theorem original_U34_at_signed_root_AP {ε : ℝ} (he : 0 < ε) :\n    ∃ T : ℕ, 4 ≤ T ∧ ∀ N : ℕ, T ≤ N → Even N → ∀ (n m : ℕ) (τ : ℝ),\n      0 ≤ τ → τ ≤ 1 / 12 → 1 / ((n : ℝ) + 1) ≤ 11 / 384 →\n      currentChenUpsilon3 N + currentChenUpsilon4 N ≤\n        bandUpper N n m .U3 τ ε + bandUpper N n m .U4 τ ε"
        }
      ]
