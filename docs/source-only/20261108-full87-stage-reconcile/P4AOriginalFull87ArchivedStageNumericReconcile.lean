/-- Per-record replacement identity, not merely aggregate consistency. -/
theorem history_each_refinement_exact :
    ∀ r ∈ historyRows, r.final = r.before + r.increment := by
  intro r hr
  simp only [historyRows, List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h
  all_goals subst r
  all_goals norm_num

