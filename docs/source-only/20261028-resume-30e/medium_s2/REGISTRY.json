  "external_primitive": {
    "name": "PrimitiveShiuTauBoundary 1 (1/10) (1/10)",
    "module": "ImbalancedChen.Part3MediumPrimitiveShiuWindowGate",
    "scope": "Original classical primitive moving-residue Shiu count; native windows, primitive residue and margin are proved in imported C source. No internal medium/packet/S2 conclusion is a premise."
  },
  "actual_obligations_removed": [
    "Actual strict-receiver keyKept equals independently defined lambdaTrim on its own d window.",
    "Actual primitive paired S2 equals deleted restored expression with separate other-rough and single-zero corrections.",
    "All three common-key mixed tail terms remain and are exactly identified with the native arithmetic packet.",
    "Entire actual primitive paperPsi q support is estimated directly at level Q1*D/2; no direct transplantation of the old D q window.",
    "Actual m carrier and supported rough/d coefficient fibers are reindexed by proved finite equalities.",
    "Uniform arbitrary-log smooth-tail payment is transferred to actual primitiveS2 plus its two retained named corrections at V(D)."
  ],
  "scale_audit": {
    "normalizer": "V(D)=M*N^2/(Q1*D), D=2^key.d",
    "native_q_support": "Q1/2 <= q <= 5Q1/2 with gcd(q,a)=1",
    "native_level": "Y=Q1*D/2",
    "native_physical_cap": "floor(10*Q1*Q2*Q3)",
    "free_n2_count": "at most 2N",
    "H_divisor_exponent": 4,
    "Shiu_and_collapsed_divisor_exponent": 5,
    "fixed_log_power": 6,
    "returned_constant": "46080*A_Sh*uniformEulerConstant(1)",
    "whole_d_family_before_summing": true,
    "per_exact_d_remainders_summed": false,
    "old_q_window_bound_silently_transferred": false
  },
  "assumptions": [
    "MediumAdmissible for the original atom; actual primitive source/carriers and paperPsi from frozen independent sources.",
    "Original named PrimitiveShiuTauBoundary 1 (1/10) (1/10).",
    "Requested A >= 0 and one threshold chosen before all atoms, keys, residues.",
    "Explicit native physical range cap <= floor(x^(4/5))."
  ],
  "remaining": [
