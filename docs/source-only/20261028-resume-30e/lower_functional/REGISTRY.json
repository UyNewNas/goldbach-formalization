  "original_algorithm_lines": "certify_sharp_248_four_min.py ordered_weights lines83-90: r=2-i,s=j-3, incomplete J moments and signed alternating T; rows137-154: same Z used for baseline, omega cost and stored floor.",
  "weighted_formulas": {
    "L": "log(b/a)",
    "zwTie_r0s1": "1/a-(1+L)/b = (1/a)*J1",
    "uzTie_r1s0": "(L-1)/a+1/b = (1/a)*(L*J0-J1)",
    "uzwTie_r1s1": "(L-2)/a+(L+2)/b = (1/a)*(L*J1-J2)",
    "J0": "1-a/b",
    "J1": "1-(a/b)*(1+L)",
    "J2": "2-(a/b)*(L^2+2*L+2)",
    "outer_factors": "Actual log(tHi/tLo), and independent u or w log where applicable; no ordinary-volume factorial is used for the weighted z block."
  },
