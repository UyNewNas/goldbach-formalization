      "Z": "beforeHBCutoff cutoffOrder [cj]",
      "Y": "Z^(2*halfOrder X0+1)",
      "D": "Nat.floor (X0^(1199/2000 : Real))",
      "Q": "remainingModuli levelB N (trueDDeltaSupport old fresh N cap w z)"
    },
    "outputs": [
      "1 <= Real.log X0",
      "1 <= D",
      "every q in unchanged historical Q satisfies q <= D",
      "pairCost * (M*(U+V)*Y) * log(X0)^extraLog <= X0/log(X0)^accuracy",
      "pairCost * (M*Y^2) * log(X0)^extraLog <= X0/log(X0)^accuracy",
      "(M*(U+V)*Y) * log(X0)^extraLog <= X0/log(X0)^accuracy",
      "(M*Y^2) * log(X0)^extraLog <= X0/log(X0)^accuracy"
    ],
    "pairCost": "pairCost ((Real.log X0)^smoothOrder)^(-1) U V ((Real.log X0)^frequencyOrder)",
