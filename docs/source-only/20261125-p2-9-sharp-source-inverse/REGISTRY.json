  "exact_inputs": [
    "N d r : Nat, Q : Real, qs : Fin 2 -> Nat, rs : Fin r -> Nat",
    "0 < d",
    "forall i, (qs i).Prime and (qs i).Coprime N",
    "forall i, (rs i).Prime",
    "forall g in P2FiniteMarkedGamma5LogExtension.program r, P2FiniteMarkedGamma5LogExtension.raw N Q d qs rs g"
  ],
  "exact_conclusions": [
    "let l := [qs 0, qs 1]; l in P2EnhancedBadGamma5ArithmeticGeometry.badLabels N Q d",
    "let m := (List.ofFn rs).prod; m in roughNumbers ((N : Real)/(d*l.prod : Nat)) (P2EnhancedTwentyOneSameQWeighted.cutoff Q d (227/50))",
    "m.primeFactorsList = List.ofFn rs"
  ],
