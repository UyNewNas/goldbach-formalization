/-!
SOURCE ONLY / UNCOMPILED / ZERO FORMAL CREDIT.

The arithmetic histories below are generated by the existing integer
singleFamily/pairFamily constructors. They are not arbitrary families
equipped with a support assertion. A root is the literal N-deleted prime
box; each later prime is chosen from the original child carrier with the
previous prime ceiling. Paths remain external marks. This module does
not identify the collection of paths selected by immutable H247/H248/H430.
In particular the W2 ordinary collision-free child is not equated to the
unrestricted N-window mother of Q10.
-/

namespace ImbalancedChen.P2CausalPrimeHistorySource
noncomputable section
open Finset Wu2008DoubleSieve
open P2EnhancedLowerPrimeChildCarriers P2EnhancedLowerPrimeChildGeometry
open P2EnhancedLowerPrimeChildMarks P5OriginalActionMassBound
open P2EnhancedSwitchedTrueNormalization
open scoped Classical BigOperators

structure PrimeBox (r : ℕ) where
  lower : Fin r → ℝ
  upper : Fin r → ℝ

def rootFamily {r : ℕ} (N : ℕ) (box : PrimeBox r) :
    Finset (Fin r → Fin (N+1)) :=
  univ.filter fun t => ∀ j, (t j).val ∈
    primeWindow N ((N : ℝ)^(box.lower j)) ((N : ℝ)^(box.upper j))

theorem mem_rootFamily {r N : ℕ} {box : PrimeBox r}
    {t : Fin r → Fin (N+1)} : t ∈ rootFamily N box ↔
    ∀ j, (t j).val ∈
      primeWindow N ((N : ℝ)^(box.lower j)) ((N : ℝ)^(box.upper j)) := by
  simp only [rootFamily, mem_filter, mem_univ, true_and]

/-- Every constructor reads only the previous tuple. There are no
independent future coordinates in its inherited physical ceiling. -/
inductive History (r : ℕ) : ℕ → Type where
  | root : History r r
  | single {k : ℕ} (old : History r k) (rule : SingleRule) : History r (k+1)
  | pair {k : ℕ} (old : History r k) (bank : Fin 36) (piece : Fin 4) : History r (k+2)

def History.depth {r : ℕ} : {k : ℕ} → History r k → ℕ
  | _, .root => 0
  | _, .single h _ => h.depth+1
  | _, .pair h _ _ => h.depth+1

def History.scalar {r : ℕ} : {k : ℕ} → History r k → ℝ
  | _, .root => 1
  | _, .single h rule => h.scalar*singleEdgeScalar rule
  | _, .pair h _ _ => h.scalar/5

theorem History.scalar_nonneg {r k : ℕ} (h : History r k) : 0 ≤ h.scalar := by
  induction h with
  | root => norm_num [History.scalar]
  | single h rule ih => exact mul_nonneg ih (singleEdgeScalar_nonneg rule)
  | pair h bank piece ih => exact div_nonneg ih (by norm_num)

def History.ceiling {r N : ℕ} (chi : ℝ) :
    {k : ℕ} → History r k → (Fin k → Fin (N+1)) → ℝ
  | _, .root, _ => chi
  | k+1, .single _ _, t => physicalPrime N (t (Fin.last k)).val
  | k+2, .pair _ _ _, t => physicalPrime N (t (Fin.last (k+1))).val

/-- This is the actual finite child operation on all retained parent
tuples. Equality of products never identifies parent histories. -/
def History.family {r : ℕ} (N : ℕ) (Q chi : ℝ) (box : PrimeBox r) :
    {k : ℕ} → History r k → Finset (Fin k → Fin (N+1))
  | _, .root => rootFamily N box
  | _, .single h rule =>
      (h.family N Q chi box).biUnion fun old =>
        singleFamily rule N Q old (h.ceiling chi old)
  | _, .pair h bank piece =>
      (h.family N Q chi box).biUnion fun old =>
        pairFamily bank piece N Q old (h.ceiling chi old)

/-- The original labelled root, recovered by prefix projection rather
than by factoring the final integer product. -/
def History.rootTuple {r N : ℕ} : {k : ℕ} → History r k →
    (Fin k → Fin (N+1)) → (Fin r → Fin (N+1))
  | _, .root, t => t
  | _, .single h _, t => h.rootTuple (fun i => t i.castSucc)
  | _, .pair h _ _, t => h.rootTuple (fun i => t i.castSucc.castSucc)

@[simp] theorem rootTuple_single {r k N : ℕ} (h : History r k) (rule : SingleRule)
    (old : Fin k → Fin (N+1)) (p : Fin (N+1)) :
    (History.single h rule).rootTuple (singleTuple old p) = h.rootTuple old := by
  simp [History.rootTuple,singleTuple]

@[simp] theorem rootTuple_pair {r k N : ℕ} (h : History r k) (bank : Fin 36) (piece : Fin 4)
    (old : Fin k → Fin (N+1)) (p : Fin (N+1) × Fin (N+1)) :
    (History.pair h bank piece).rootTuple (pairTuple old p) = h.rootTuple old := by
  simp [History.rootTuple,pairTuple]

theorem mem_single_family {r k N : ℕ} {Q chi : ℝ} {box : PrimeBox r}
    {h : History r k} {rule : SingleRule} {t : Fin (k+1) → Fin (N+1)} :
    t ∈ (History.single h rule).family N Q chi box ↔
      ∃ old ∈ h.family N Q chi box, ∃ p ∈
        singleChildren rule N Q (oldWord old) (h.ceiling chi old),
          singleTuple old p = t := by
  simp only [History.family, singleFamily, mem_biUnion, mem_image]

theorem mem_pair_family {r k N : ℕ} {Q chi : ℝ} {box : PrimeBox r}
    {h : History r k} {bank : Fin 36} {piece : Fin 4}
    {t : Fin (k+2) → Fin (N+1)} :
    t ∈ (History.pair h bank piece).family N Q chi box ↔
      ∃ old ∈ h.family N Q chi box, ∃ p ∈
        pairChildren bank piece N Q (oldWord old) (h.ceiling chi old),
          pairTuple old p = t := by
  simp only [History.family, pairFamily, mem_biUnion, mem_image]

theorem History.rootTuple_mem {r k N : ℕ} {Q chi : ℝ} {box : PrimeBox r}
    (h : History r k) {t : Fin k → Fin (N+1)}
    (ht : t ∈ h.family N Q chi box) : h.rootTuple t ∈ rootFamily N box := by
  induction h generalizing t with
  | root => exact ht
  | single h rule ih =>
      obtain ⟨old,ho,p,hp,rfl⟩ := mem_single_family.mp ht
      simpa only [rootTuple_single] using ih ho
  | pair h bank piece ih =>
      obtain ⟨old,ho,p,hp,rfl⟩ := mem_pair_family.mp ht
      simpa only [rootTuple_pair] using ih ho

/-- Any actual ancestor lookup on the root tuple sees the literal same
input. The statement preserves a lookup; it does not assert its licence. -/
theorem root_lookup_single {r k N : ℕ} (h : History r k) (rule : SingleRule)
    (old : Fin k → Fin (N+1)) (p : Fin (N+1)) {A : Type*}
    (lookup : (Fin r → Fin (N+1)) → A) :
    lookup ((History.single h rule).rootTuple (singleTuple old p)) =
      lookup (h.rootTuple old) := by rw [rootTuple_single]

theorem root_lookup_pair {r k N : ℕ} (h : History r k) (bank : Fin 36) (piece : Fin 4)
    (old : Fin k → Fin (N+1)) (p : Fin (N+1) × Fin (N+1)) {A : Type*}
    (lookup : (Fin r → Fin (N+1)) → A) :
    lookup ((History.pair h bank piece).rootTuple (pairTuple old p)) =
      lookup (h.rootTuple old) := by rw [rootTuple_pair]

theorem singleFamilies_disjoint {k N : ℕ} (rule : SingleRule) (Q : ℝ)
    (old other : Fin k → Fin (N+1)) (chi chi' : ℝ) (hne : old ≠ other) :
    Disjoint (singleFamily rule N Q old chi) (singleFamily rule N Q other chi') := by
  apply disjoint_left.mpr
  intro t ht hu
  obtain ⟨p,hp,he⟩ := mem_image.mp ht
  obtain ⟨q,hq,hf⟩ := mem_image.mp hu
  apply hne
  funext i
  have h := congrFun (he.trans hf.symm) i.castSucc
  simpa only [singleTuple,Fin.snoc_castSucc] using h

theorem pairFamilies_disjoint {k N : ℕ} (bank : Fin 36) (piece : Fin 4) (Q : ℝ)
    (old other : Fin k → Fin (N+1)) (chi chi' : ℝ) (hne : old ≠ other) :
    Disjoint (pairFamily bank piece N Q old chi) (pairFamily bank piece N Q other chi') := by
  apply disjoint_left.mpr
  intro t ht hu
  obtain ⟨p,hp,he⟩ := mem_image.mp ht
  obtain ⟨q,hq,hf⟩ := mem_image.mp hu
  apply hne
  funext i
  have h := congrFun (he.trans hf.symm) i.castSucc.castSucc
  simpa only [pairTuple,Fin.snoc_castSucc] using h

/-- The biUnion constructor has disjoint tuple fibres over its previous
tuples. Hence it loses no incoming occurrence before product pushforward. -/
theorem single_family_sum {r k N : ℕ} (Q chi : ℝ) (box : PrimeBox r)
    (h : History r k) (rule : SingleRule) (F : (Fin (k+1) → Fin (N+1)) → ℝ) :
    (∑ t ∈ (History.single h rule).family N Q chi box, F t) =
      ∑ old ∈ h.family N Q chi box,
        ∑ t ∈ singleFamily rule N Q old (h.ceiling chi old), F t := by
  unfold History.family
  exact sum_biUnion (fun old _ other _ hne =>
    singleFamilies_disjoint rule Q old other _ _ hne)

theorem pair_family_sum {r k N : ℕ} (Q chi : ℝ) (box : PrimeBox r)
    (h : History r k) (bank : Fin 36) (piece : Fin 4)
    (F : (Fin (k+2) → Fin (N+1)) → ℝ) :
    (∑ t ∈ (History.pair h bank piece).family N Q chi box, F t) =
      ∑ old ∈ h.family N Q chi box,
        ∑ t ∈ pairFamily bank piece N Q old (h.ceiling chi old), F t := by
  unfold History.family
  exact sum_biUnion (fun old _ other _ hne =>
    pairFamilies_disjoint bank piece Q old other _ _ hne)

theorem oldWord_product {r N : ℕ} (t : Fin r → Fin (N+1)) :
    parentProduct (oldWord t) = Part3.labelledProduct t := by
  simp [parentProduct, oldWord, Part3.labelledProduct, List.prod_ofFn]

theorem tuple_prefixExponent {r N : ℕ} (hN : 1 < N)
    (t : Fin r → Fin (N+1)) (hp : ∀ j, 0 < (t j).val) :
    prefixExponent N (Part3.labelledProduct t) =
      ∑ j, physicalPrime N (t j).val := by
  unfold prefixExponent physicalPrime Part3.labelledProduct
  rw [Nat.cast_prod, Real.log_prod (fun j _ => (Nat.cast_pos.mpr (hp j)).ne')]
  exact Finset.sum_div _ _ _

theorem tuple_level {r N : ℕ} (hN : 1 < N) (nu : ℝ)
    (t : Fin r → Fin (N+1)) (hp : 0 < Part3.labelledProduct t) :
    physicalLevel N ((N : ℝ)^nu) (oldWord t) =
      residualExponent N (Part3.labelledProduct t) nu := by
  unfold physicalLevel residualLevel
  rw [oldWord_product, residual_log hN hp]
  have hl : Real.log (N : ℝ) ≠ 0 := (Real.log_pos (by exact_mod_cast hN)).ne'
  field_simp [hl]

theorem root_slot_bounds {r N : ℕ} (hN : 1 < N) {box : PrimeBox r}
    {t : Fin r → Fin (N+1)} (ht : t ∈ rootFamily N box) (j : Fin r) :
    (t j).val.Prime ∧ ¬ (t j).val ∣ N ∧
      box.lower j ≤ physicalPrime N (t j).val ∧
      physicalPrime N (t j).val ≤ box.upper j := by
  have hw := mem_primeWindow.mp (mem_rootFamily.mp ht j)
  have hNr : (0 : ℝ) < N := Nat.cast_pos.mpr (by omega)
  have hlog : 0 < Real.log (N : ℝ) := Real.log_pos (by exact_mod_cast hN)
  have hl := Real.log_le_log (Real.rpow_pos_of_pos hNr _) hw.2.2.1
  have hu := Real.log_le_log (Nat.cast_pos.mpr hw.1.pos) hw.2.2.2.le
  rw [Real.log_rpow hNr] at hl hu
  refine ⟨hw.1, hw.1.coprime_iff_not_dvd.mp hw.2.1, ?_, ?_⟩
  · exact (le_div_iff₀ hlog).mpr (by nlinarith only [hl])
  · exact (div_le_iff₀ hlog).mpr (by nlinarith only [hu])

/-- Uniform new-prime floor, proved from the literal BH/W1/W2 domain.
The Buchstab endpoint w=5 accounts for the common factor six. -/
theorem single_new_floor {rule : SingleRule} {N : ℕ} {Q chi : ℝ}
    {old : List ℕ} {p : Fin (N+1)}
    (hp : p ∈ singleChildren rule N Q old chi) :
    physicalLevel N Q old/6 ≤ physicalPrime N p.val := by
  have hm := mem_singleChildren.mp hp
  have hL := (parentWindow_logs hm.2.1).2.2
  cases rule with
  | buchstab up s =>
      have hbound : buchstabArgument Q old p.val ≤ 5 := by
        cases up <;> exact hm.2.2.1.2.2
      have hlp : 0 < Real.log (p.val : ℝ) :=
        Real.log_pos (by exact_mod_cast hm.1.1.one_lt)
      have hraw := (div_le_iff₀ hlp).mp hbound
      have hlN := (parentWindow_logs hm.2.1).1
      dsimp [buchstabArgument] at hraw
      have hraw' : Real.log (residualLevel Q old)/6 ≤ Real.log (p.val : ℝ) := by
        linarith only [hraw]
      have hdiv := div_le_div_of_nonneg_right hraw' hlN.le
      unfold physicalLevel physicalPrime
      convert hdiv using 1 <;> ring
  | w1 target anchor =>
      have ha : 0 < W1Anchor anchor ∧ W1Anchor anchor ≤ 5 := by
        have h0 : (0 : ℝ) ≤ anchor.val := Nat.cast_nonneg _
        have h9 : (anchor.val : ℝ) ≤ 9 := by exact_mod_cast (show anchor.val ≤ 9 by omega)
        dsimp [W1Anchor]
        constructor <;> linarith only [h0,h9]
      have hu : 1/W1Anchor anchor < relativePrime Q old p.val := hm.2.2.1.1
      have hlo : (1/6 : ℝ) ≤ relativePrime Q old p.val :=
        (by norm_num : (1/6 : ℝ) ≤ 1/5).trans
          ((one_div_le_one_div_of_le ha.1 ha.2).trans hu.le)
      have hg := mul_le_mul_of_nonneg_left hlo hL.le
      rw [relativePrime_physical hm.2.1] at hg
      simpa only [mul_one_div] using hg
  | w2 bank piece =>
      have hg := originalRepairedW2Bank_geometry _ (originalW2At_mem bank)
      have hu := W2_singleton_left (show relativePrime Q old p.val ∈
        W2SingletonDomain (originalW2At bank) piece from hm.2.2.1)
      have hlo : (1/6 : ℝ) ≤ relativePrime Q old p.val :=
        (by norm_num : (1/6 : ℝ) ≤ 1/5).trans (hg.1.trans hu.le)
      have hh := mul_le_mul_of_nonneg_left hlo hL.le
      rw [relativePrime_physical hm.2.1] at hh
      simpa only [mul_one_div] using hh

theorem pair_new_floor {bank : Fin 36} {piece : Fin 4} {N : ℕ}
    {Q chi : ℝ} {old : List ℕ} {p : Fin (N+1) × Fin (N+1)}
    (hp : p ∈ pairChildren bank piece N Q old chi) :
    physicalLevel N Q old/6 ≤ physicalPrime N p.1.val ∧
      physicalLevel N Q old/6 ≤ physicalPrime N p.2.val := by
  have hm := mem_pairChildren.mp hp
  have hL := (parentWindow_logs hm.2.1).2.2
  have hg := (P5OriginalFeedbackDomains.W2PairDomain_geometry
    (originalRepairedW2Bank_geometry _ (originalW2At_mem bank)) piece hm.2.2.2.1).1
  have hb (j : Fin 2) : (1/6 : ℝ) ≤ pairPoint Q old p.1.val p.2.val j :=
    (by norm_num : (1/6 : ℝ) ≤ 1/5).trans (hg.1 j)
  have hs := mul_le_mul_of_nonneg_left (hb 0) hL.le
  have hl := mul_le_mul_of_nonneg_left (hb 1) hL.le
  dsimp [pairPoint] at hs hl
  rw [relativePrime_physical hm.2.1] at hs hl
  exact ⟨by simpa only [mul_one_div] using hs, by simpa only [mul_one_div] using hl⟩

theorem single_level_floor {rule : SingleRule} {N : ℕ} {Q chi : ℝ}
    {old : List ℕ} {p : Fin (N+1)}
    (hp : p ∈ singleChildren rule N Q old chi) :
    physicalLevel N Q old/101 ≤ physicalLevel N Q (singleWord old p.val) := by
  rw [(single_actual_residual hp).2.2]
  have hL := (parentWindow_logs (mem_singleChildren.mp hp).2.1).2.2
  have hs := single_residual_square hp
  linarith only [hL,hs]

theorem pair_level_floor {bank : Fin 36} {piece : Fin 4} {N : ℕ}
    {Q chi : ℝ} {old : List ℕ} {p : Fin (N+1) × Fin (N+1)}
    (hp : p ∈ pairChildren bank piece N Q old chi) :
    physicalLevel N Q old/101 ≤ physicalLevel N Q (pairWord old p.1.val p.2.val) := by
  have hm := mem_pairChildren.mp hp
  have hL := (parentWindow_logs hm.2.1).2.2
  have hg := (P5OriginalFeedbackDomains.W2PairDomain_geometry
    (originalRepairedW2Bank_geometry _ (originalW2At_mem bank)) piece hm.2.2.2.1).2
  have hh := mul_le_mul_of_nonneg_left hg hL.le
  have hs := relativePrime_physical hm.2.1 (p := p.1.val)
  have hl := relativePrime_physical hm.2.1 (p := p.2.val)
  dsimp [pairPoint] at hh
  rw [(pair_actual_residual hp).2.2]
  nlinarith only [hh,hs,hl,hL]

def floorAt (eta : ℝ) (n : ℕ) : ℝ := eta/(101 : ℝ)^n

theorem floorAt_pos {eta : ℝ} (he : 0 < eta) (n : ℕ) : 0 < floorAt eta n :=
  div_pos he (pow_pos (by norm_num) _)

theorem floorAt_succ (eta : ℝ) (n : ℕ) : floorAt eta (n+1) = floorAt eta n/101 := by
  simp only [floorAt,pow_succ,div_div]

theorem floorAt_step {eta : ℝ} (he : 0 < eta) (n : ℕ) :
    floorAt eta (n+1) ≤ floorAt eta n := by
  rw [floorAt_succ]
  exact div_le_self (floorAt_pos he n).le (by norm_num)

def TupleFacts {k : ℕ} (N : ℕ) (nu eta : ℝ) (t : Fin k → Fin (N+1)) : Prop :=
  (∀ j, (t j).val.Prime ∧ ¬ (t j).val ∣ N ∧ eta ≤ physicalPrime N (t j).val) ∧
  6*eta ≤ physicalLevel N ((N : ℝ)^nu) (oldWord t) ∧
  2*nu ≤ 1+prefixExponent N (Part3.labelledProduct t)

theorem product_pos {k N : ℕ} {t : Fin k → Fin (N+1)}
    (hp : ∀ j, (t j).val.Prime) : 0 < Part3.labelledProduct t := by
  unfold Part3.labelledProduct
  exact prod_pos (fun j _ => (hp j).pos)

theorem single_tuple_level {k N : ℕ} (Q : ℝ)
    (old : Fin k → Fin (N+1)) (p : Fin (N+1)) :
    physicalLevel N Q (oldWord (singleTuple old p)) =
      physicalLevel N Q (singleWord (oldWord old) p.val) := by
  unfold physicalLevel residualLevel
  rw [oldWord_product, singleTuple_product]
  rfl

theorem pair_tuple_level {k N : ℕ} (Q : ℝ)
    (old : Fin k → Fin (N+1)) (p : Fin (N+1) × Fin (N+1)) :
    physicalLevel N Q (oldWord (pairTuple old p)) =
      physicalLevel N Q (pairWord (oldWord old) p.1.val p.2.val) := by
  unfold physicalLevel residualLevel
  rw [oldWord_product, pairTuple_product]
  rfl

theorem single_prefixExponent {k N : ℕ} (old : Fin k → Fin (N+1))
    (p : Fin (N+1)) (ho : 0 < Part3.labelledProduct old) (hp : 0 < p.val) :
    prefixExponent N (Part3.labelledProduct (singleTuple old p)) =
      prefixExponent N (Part3.labelledProduct old)+physicalPrime N p.val := by
  rw [singleTuple_product, (singleWord_history (oldWord old) p.val).2.2, oldWord_product]
  unfold prefixExponent physicalPrime
  rw [Nat.cast_mul, Real.log_mul (Nat.cast_pos.mpr ho).ne' (Nat.cast_pos.mpr hp).ne']
  exact add_div _ _ _

theorem pair_prefixExponent {k N : ℕ} (old : Fin k → Fin (N+1))
    (p : Fin (N+1) × Fin (N+1)) (ho : 0 < Part3.labelledProduct old)
    (hs : 0 < p.1.val) (hl : 0 < p.2.val) :
    prefixExponent N (Part3.labelledProduct (pairTuple old p)) =
      prefixExponent N (Part3.labelledProduct old)+
        physicalPrime N p.2.val+physicalPrime N p.1.val := by
  rw [pairTuple_product, (pairWord_history (oldWord old) p.1.val p.2.val).2.2,
    oldWord_product]
  unfold prefixExponent physicalPrime
  rw [Nat.cast_mul, Nat.cast_mul,
    Real.log_mul (mul_pos (Nat.cast_pos.mpr ho) (Nat.cast_pos.mpr hl)).ne'
      (Nat.cast_pos.mpr hs).ne',
    Real.log_mul (Nat.cast_pos.mpr ho).ne' (Nat.cast_pos.mpr hl).ne']
  ring

/-- Root support comes from fixed box faces, including the independent
half-level gate 2nu <= 1+sum lower. It does not come from positive L. -/
theorem root_facts {r N : ℕ} (hN : 1 < N) {box : PrimeBox r} {nu eta : ℝ}
    (hlo : ∀ j, eta ≤ box.lower j)
    (hres : 6*eta ≤ nu-∑ j, box.upper j)
    (halpha : 2*nu ≤ 1+∑ j, box.lower j)
    {t : Fin r → Fin (N+1)} (ht : t ∈ rootFamily N box) :
    TupleFacts N nu eta t := by
  have hd := root_slot_bounds hN ht
  have hp : 0 < Part3.labelledProduct t := product_pos (fun j => (hd j).1)
  have hloSum := sum_le_sum (s := (univ : Finset (Fin r))) (fun j _ => (hd j).2.2.1)
  have hhiSum := sum_le_sum (s := (univ : Finset (Fin r))) (fun j _ => (hd j).2.2.2)
  refine ⟨fun j => ⟨(hd j).1,(hd j).2.1,(hlo j).trans (hd j).2.2.1⟩, ?_, ?_⟩
  · rw [tuple_level hN nu t hp]
    unfold residualExponent
    rw [tuple_prefixExponent hN t (fun j => (hd j).1.pos)]
    linarith only [hres,hhiSum]
  · rw [tuple_prefixExponent hN t (fun j => (hd j).1.pos)]
    linarith only [halpha,hloSum]

theorem single_facts {k N : ℕ} {nu eta chi : ℝ} (he : 0 < eta)
    {old : Fin k → Fin (N+1)} (hold : TupleFacts N nu eta old)
    {rule : SingleRule} {p : Fin (N+1)}
    (hp : p ∈ singleChildren rule N ((N : ℝ)^nu) (oldWord old) chi) :
    TupleFacts N nu (eta/101) (singleTuple old p) := by
  have hm := mem_singleChildren.mp hp
  have hx := single_new_floor hp
  have hxeta : eta ≤ physicalPrime N p.val := by linarith only [hold.2.1,hx]
  have het : eta/101 ≤ eta := div_le_self he.le (by norm_num)
  have hpN : ¬ p.val ∣ N := hm.1.1.coprime_iff_not_dvd.mp
    (Nat.coprime_mul_iff_right.mp hm.1.2).1
  refine ⟨?_, ?_, ?_⟩
  · intro j
    refine Fin.lastCases ?_ (fun i => ?_) j
    · simpa only [singleTuple,Fin.snoc_last] using ⟨hm.1.1,hpN,het.trans hxeta⟩
    · simpa only [singleTuple,Fin.snoc_castSucc] using
        ⟨(hold.1 i).1,(hold.1 i).2.1,het.trans (hold.1 i).2.2⟩
  · rw [single_tuple_level]
    have hf := single_level_floor hp
    linarith only [hold.2.1,hf]
  · rw [single_prefixExponent old p (product_pos (fun j => (hold.1 j).1)) hm.1.1.pos]
    linarith only [hold.2.2,hxeta,he]

theorem pair_facts {k N : ℕ} {nu eta chi : ℝ} (he : 0 < eta)
    {old : Fin k → Fin (N+1)} (hold : TupleFacts N nu eta old)
    {bank : Fin 36} {piece : Fin 4} {p : Fin (N+1) × Fin (N+1)}
    (hp : p ∈ pairChildren bank piece N ((N : ℝ)^nu) (oldWord old) chi) :
    TupleFacts N nu (eta/101) (pairTuple old p) := by
  have hm := mem_pairChildren.mp hp
  have hx := pair_new_floor hp
  have hs : eta ≤ physicalPrime N p.1.val := by linarith only [hold.2.1,hx.1]
  have hl : eta ≤ physicalPrime N p.2.val := by linarith only [hold.2.1,hx.2]
  have het : eta/101 ≤ eta := div_le_self he.le (by norm_num)
  have hsN : ¬ p.1.val ∣ N := hm.1.1.1.coprime_iff_not_dvd.mp
    (Nat.coprime_mul_iff_right.mp hm.1.1.2).1
  have hlN : ¬ p.2.val ∣ N := hm.1.2.1.coprime_iff_not_dvd.mp
    (Nat.coprime_mul_iff_right.mp hm.1.2.2).1
  refine ⟨?_, ?_, ?_⟩
  · intro j
    refine Fin.lastCases ?_ (fun i => ?_) j
    · simpa only [pairTuple,Fin.snoc_last] using ⟨hm.1.1.1,hsN,het.trans hs⟩
    · refine Fin.lastCases ?_ (fun i => ?_) i
      · simpa only [pairTuple,Fin.snoc_castSucc,Fin.snoc_last] using
          ⟨hm.1.2.1,hlN,het.trans hl⟩
      · simpa only [pairTuple,Fin.snoc_castSucc] using
          ⟨(hold.1 i).1,(hold.1 i).2.1,het.trans (hold.1 i).2.2⟩
  · rw [pair_tuple_level]
    have hf := pair_level_floor hp
    linarith only [hold.2.1,hf]
  · rw [pair_prefixExponent old p (product_pos (fun j => (hold.1 j).1))
      hm.1.1.1.pos hm.1.2.1.pos]
    linarith only [hold.2.2,hs,hl,he]

/-- Fixed floors survive the actual recursively generated arithmetic
family. The residual has factor six to supply the seed cutoff 227/50.
There is no all-leaf support hypothesis in this theorem. -/
theorem History.family_facts {r k N : ℕ} (hN : 1 < N) {box : PrimeBox r}
    {nu eta chi : ℝ} (he : 0 < eta)
    (hlo : ∀ j, eta ≤ box.lower j)
    (hres : 6*eta ≤ nu-∑ j, box.upper j)
    (halpha : 2*nu ≤ 1+∑ j, box.lower j)
    (h : History r k) {t : Fin k → Fin (N+1)}
    (ht : t ∈ h.family N ((N : ℝ)^nu) chi box) :
    TupleFacts N nu (floorAt eta h.depth) t := by
  induction h generalizing t with
  | root => simpa [History.family,History.depth,floorAt] using root_facts hN hlo hres halpha ht
  | single h rule ih =>
      obtain ⟨old,ho,p,hp,rfl⟩ := mem_single_family.mp ht
      simpa only [History.depth,floorAt_succ] using
        single_facts (floorAt_pos he _) (ih ho) hp
  | pair h bank piece ih =>
      obtain ⟨old,ho,p,hp,rfl⟩ := mem_pair_family.mp ht
      simpa only [History.depth,floorAt_succ] using
        pair_facts (floorAt_pos he _) (ih ho) hp

theorem facts_trueAlpha {k N : ℕ} (hN : 1 < N) {nu eta : ℝ} (he : 0 < eta)
    {t : Fin k → Fin (N+1)} (h : TupleFacts N nu eta t) :
    0 < Part3.labelledProduct t ∧
      6*eta ≤ residualExponent N (Part3.labelledProduct t) nu ∧
      2 ≤ trueAlpha N ((N : ℝ)^nu) (Part3.labelledProduct t) := by
  have hp := product_pos (fun j => (h.1 j).1)
  have hres := h.2.1
  rw [tuple_level hN nu t hp] at hres
  have hpos : 0 < residualExponent N (Part3.labelledProduct t) nu := by
    linarith only [hres,he]
  exact ⟨hp,hres,(trueAlpha_ge_two_iff hN hp hpos).mpr h.2.2⟩

end
