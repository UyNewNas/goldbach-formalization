+def interiorCandidate (c : CellRecord) : QPoint := fun j =>
+  (∑ k : Fin 9, simplexVertices c (c.simplices.getD 0 default) k j) / 9
+
+end
+end ImbalancedChen.P2OriginalSaving16OriginalArchive
