    "quantifier_order": "Fixed kap0/zeta, then eventually physical N, then every kap/B/K/cj/j/n/ordered bs (or literal Row and its unchanged F).",
    "actual_support_input": "originalChart (actualLicence kap B N) N kap0 [cj] [n] != 0",
    "derived_support": [
      "Extra eta: N^(1-kap0) < n",
      "Existing profile_nonzero_support: R(cj)/2 <= n <= 2*R(cj)",
      "Hence every live R(cj) grows uniformly with N"
    ],
    "derived_power_reserves": [
      "8192 < R(cj)^(1-18*zeta)",
      "4 < R(cj)^(3*zeta/4)"
    ],
    "existing_numeric_supplier_instantiation": {
      "X": "R(cj)",
      "a": "1",
      "C": "2",
      "R": "R(cj)",
      "y": "hbCutoff(cj)",
      "cube": "hbCutoff(cj)^3=2*R(cj)"
    },
    "five_derived_gates": [
      "1 <= originalMediumLow zeta [cj]",
      "1 <= originalMediumHigh zeta [cj]",
      "64*(originalMediumLow zeta [cj])^6 < n",
      "n < (originalMediumHigh zeta [cj])^3",
      "hbCutoff cj <= originalMediumHigh zeta [cj]"
    ],
    "additional_original_source_conditions": [
      "j belongs to range 3",
      "The original blockCoefficient (beforeHBCutoff K [cj]) (hbCutoff cj) j n bs is nonzero",
      "firstMedium on the original windows is none",
      "The original longBlocks occurrence count is not one"
    ],
    "conclusion": "The same longBlocks list has exactly two occurrences, each long role in roles(j).zip(bs) is one or logarithm.",
