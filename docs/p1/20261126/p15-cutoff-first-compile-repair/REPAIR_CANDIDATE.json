    },
    {
      "name": "active_chart_argument_upper",
      "visibility": "public",
      "statement": "theorem active_chart_argument_upper\n    (K : ℕ) (chi : ℝ → ℝ) {N k : ℕ} {astar : ℝ}\n    {js ps : List ℕ} (hN : 1 ≤ N) (hk : k ≤ K)\n    (hlen : js.length = k)\n    (hwin : List.Forall₂\n      (fun j p => psi chi ((p : ℝ) / R j) ≠ 0 ∧\n        R j / 2 ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * R j) js ps)\n    (hsource : ∀ p ∈ ps,\n      (N : ℝ) ^ astar ≤ (p : ℝ) ∧ (p : ℝ) ≤ N) :\n    argument K (scales js) ≤\n      (2 : ℝ) ^ (8 * K + 2) * (N : ℝ) ^ K "
    },
    {
      "name": "active_chart_argument_lower",
      "visibility": "public",
      "statement": "theorem active_chart_argument_lower\n    (K : ℕ) (chi : ℝ → ℝ) {N k : ℕ} {astar : ℝ}\n    {js ps : List ℕ} (hk : 1 ≤ k) (hlen : js.length = k)\n    (hwin : List.Forall₂\n      (fun j p => psi chi ((p : ℝ) / R j) ≠ 0 ∧\n        R j / 2 ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * R j) js ps)\n    (hsource : ∀ p ∈ ps,\n      (N : ℝ) ^ astar ≤ (p : ℝ) ∧ (p : ℝ) ≤ N)\n    (hA : 1 ≤ (N : ℝ) ^ astar / 2) :\n    (N : ℝ) ^ astar / 2 ≤ argument K (scales js) "
    },
    {
      "name": "uniform_chart_cutoff_of_scalar_threshold",
      "visibility": "public",
      "statement": "theorem uniform_chart_cutoff_of_scalar_threshold\n    (K N : ℕ) (astar : ℝ) (hastar : 0 < astar)\n    (hN : 1 < N) (js : List ℕ)\n    (hhigh : argument K (scales js) ≤\n      (2 : ℝ) ^ (8*K+2) * (N : ℝ) ^ K)\n    (hcap : (2 : ℝ) ^ (8*K+2) ≤ N)\n    (hmin : Real.exp (Real.exp 3) ≤ argument K (scales js))\n    (hsubpower :\n      (argument K (scales js)) ^\n        (2 / (Real.log (Real.log (argument K (scales js)))) ^ 3) ≤\n      (argument K (scales js)) ^ (astar / (2 * (K + 1)))) :\n    beforeHBCutoff K js < (N : ℝ) ^ astar "
    },
    {
      "name": "independent_test_chart_cutoff_eventual",
      "visibility": "public",
      "statement": "theorem independent_test_chart_cutoff_eventual\n    (K : ℕ) (astar : ℝ) (hastar : 0 < astar) :\n    ∃ N0 : ℕ, ∀ N : ℕ, N0 ≤ N →\n      ∀ (k : ℕ) (hk1 : 1 ≤ k) (hkK : k ≤ K)\n        (chi : ℝ → ℝ) (js ps : List ℕ),\n        js.length = k →\n        List.Forall₂\n          (fun j p => psi chi ((p : ℝ) / R j) ≠ 0 ∧\n            R j / 2 ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * R j) js ps →\n        (∀ p ∈ ps, (N : ℝ) ^ astar ≤ (p : ℝ) ∧ (p : ℝ) ≤ N) →\n        beforeHBCutoff K js < (N : ℝ) ^ astar "
    }
