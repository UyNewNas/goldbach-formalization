      "name": "active_psi_scale_each",
      "visibility": "public",
      "statement": "theorem active_psi_scale_each (chi : ℝ → ℝ) {astar : ℝ}\n    {N : ℕ} {js ps : List ℕ}\n    (hwin : List.Forall₂\n      (fun j p => psi chi ((p : ℝ) / R j) ≠ 0 ∧\n        R j / 2 ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * R j) js ps)\n    (hsource : ∀ p ∈ ps,\n      (N : ℝ) ^ astar ≤ (p : ℝ) ∧ (p : ℝ) ≤ N) :\n    ∀ j ∈ js,\n      (N : ℝ) ^ astar / 2 ≤ R j ∧ R j ≤ 2 * N "
    },
