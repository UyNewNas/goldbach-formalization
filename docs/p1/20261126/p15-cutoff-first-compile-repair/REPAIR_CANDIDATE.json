      "name": "scales_prod_upper",
      "visibility": "private",
      "statement": "private theorem scales_prod_upper (N : ℕ) (js : List ℕ)\n    (h : ∀ j ∈ js, R j ≤ 2 * (N : ℝ)) :\n    (scales js).prod ≤ (2 * (N : ℝ)) ^ js.length "
