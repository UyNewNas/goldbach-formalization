+def read_command(c, run, name, argv):
+    path = run / (name + '-command.json'); log = run / (name + '.log')
+    require(fp(path) is not None and fp(log) is not None, 'successful original command/log missing')
+    record = c.ag.api.read_json(path)
+    require(record['exit_code'] == 0 and record['argv'] == list(map(str, argv)) and
+            record['cwd'] == str(PROJECT) and record['log'] == str(log) and
+            fp(log) == {'bytes': record['log_bytes'], 'sha256': record['log_sha256']} and
+            all(record[key] == value for key, value in c.ag.ops.diagnostics(log).items()),
+            'successful command scope/log/diagnostic binding differs')
+    return record
+
