+private theorem rem_subset_sum_canonical (m : ℕ) (t : Point) :
+    subsetSum m t = ∑ j : Fin 6,
+      if decide (m / 2 ^ j.val % 2 = 1) then t (Fin.ofNat 8 j.val) else 0 := by
+  unfold subsetSum
+  apply Finset.sum_congr rfl
+  intro j _
+  rw [rem_castCoord j]
