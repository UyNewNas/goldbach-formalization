+private theorem rem_castCoord (j : Fin 6) :
+    j.castSucc.castSucc = Fin.ofNat 8 j.val := by
+  apply Fin.ext
+  change j.val = j.val % 8
+  exact (Nat.mod_eq_of_lt (lt_trans j.isLt (by decide : 6 < 8))).symm
