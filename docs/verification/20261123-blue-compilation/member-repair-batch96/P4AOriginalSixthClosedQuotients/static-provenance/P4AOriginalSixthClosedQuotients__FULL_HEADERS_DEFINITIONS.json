    {
      "name": "window_threshold",
      "kind": "theorem",
      "private": false,
      "before_complete_raw_header": "theorem window_threshold (eta : ℝ) (heta : 0 < eta) :\n    ∃ N0 : ℕ, 2 ≤ N0 ∧ ∀ N : ℕ, N0 ≤ N → Even N →\n      ∀ (p : Fin 6 → ℕ), (∀ i, 0 < p i) → ∀ L : ℝ,\n      let t := actualPrimeTupleLog N p\n      low ≤ t 5 → t 5 ≤ high → t 5 ≤ L - Certificates.P2OriginalSixthElevenLogSemantics.S6 t → L - Certificates.P2OriginalSixthElevenLogSemantics.S6 t ≤ 3 * t 5 →\n      ∀ cap : ℕ, p 5 ≤ cap →\n        |actualSmallRosserPlusDensity N cap (p 5 : ℝ) ((N : ℝ)^L / (∏ i, p i : ℕ)) *\n          Real.log (N : ℝ) / singularSeries N - 4 / (L - Certificates.P2OriginalSixthElevenLogSemantics.S6 t)| < eta :=",
      "before_header_sha256": "ea660b67033c0e33f600953021e6af52123c84c49f5a6890fde8a9993579d23f",
      "after_complete_raw_header": "theorem window_threshold (eta : ℝ) (heta : 0 < eta) :\n    ∃ N0 : ℕ, 2 ≤ N0 ∧ ∀ N : ℕ, N0 ≤ N → Even N →\n      ∀ (p : Fin 6 → ℕ), (∀ i, 0 < p i) → ∀ L : ℝ,\n      let t := actualPrimeTupleLog N p\n      low ≤ t 5 → t 5 ≤ high → t 5 ≤ L - Certificates.P2OriginalSixthElevenLogSemantics.S6 t → L - Certificates.P2OriginalSixthElevenLogSemantics.S6 t ≤ 3 * t 5 →\n      ∀ cap : ℕ, p 5 ≤ cap →\n        |actualSmallRosserPlusDensity N cap (p 5 : ℝ) ((N : ℝ)^L / (∏ i, p i : ℕ)) *\n          Real.log (N : ℝ) / singularSeries N - 4 / (L - Certificates.P2OriginalSixthElevenLogSemantics.S6 t)| < eta :=",
      "after_header_sha256": "ea660b67033c0e33f600953021e6af52123c84c49f5a6890fde8a9993579d23f",
      "raw_header_exact": true,
