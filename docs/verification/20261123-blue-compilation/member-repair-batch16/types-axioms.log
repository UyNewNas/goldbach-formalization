ImbalancedChen.P5CausalRhoQuotientBridge.quotient_main_and_AP_errors : ∀ (retainEven : List.{0} Nat → Bool)
  (N cap b : Nat) (w z L M : Real) (hwz : @LE.le.{0} Real Real.instLE w z) (hb : ImbalancedChen.ChenPrimeRough z b),
  @Eq.{1} Real
    (@Finset.sum.{0, 0} Nat Real Real.instAddCommMonoid
      (ImbalancedChen.actualLowerSmallRoughModuli retainEven N cap w z) fun (d : Nat) =>
      @HMul.hMul.{0, 0, 0} Real Real Real (@instHMul.{0} Real Real.instMul)
        (ImbalancedChen.actualLowerSmallRoughRho retainEven N cap w z L d)
        (@HSub.hSub.{0, 0, 0} Real Real Real (@instHSub.{0} Real Real.instSub)
          (ImbalancedChen.chenPrimeAPCount N N (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) b d))
          (ImbalancedChen.chenCentrePrimeAPCount N N
            (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) b d))))
    (@HSub.hSub.{0, 0, 0} Real Real Real (@instHSub.{0} Real Real.instSub)
      (@HAdd.hAdd.{0, 0, 0} Real Real Real (@instHAdd.{0} Real Real.instAdd)
        (@HMul.hMul.{0, 0, 0} Real Real Real (@instHMul.{0} Real Real.instMul)
          (@HDiv.hDiv.{0, 0, 0} Real Real Real (@instHDiv.{0} Real (@DivInvMonoid.toDiv.{0} Real Real.instDivInvMonoid))
            M (@Nat.cast.{0} Real Real.instNatCast (Nat.totient b)))
          (ImbalancedChen.physicalDensitySum (ImbalancedChen.actualLowerSmallRoughModuli retainEven N cap w z)
            (ImbalancedChen.actualLowerSmallRoughRho retainEven N cap w z L)))
        (@Finset.sum.{0, 0} Nat Real Real.instAddCommMonoid
          (ImbalancedChen.actualLowerSmallRoughModuli retainEven N cap w z) fun (d : Nat) =>
          @HMul.hMul.{0, 0, 0} Real Real Real (@instHMul.{0} Real Real.instMul)
            (ImbalancedChen.actualLowerSmallRoughRho retainEven N cap w z L d)
            (ImbalancedChen.chenQuotientPrimeAPError N M
              (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) b d))))
      (@Finset.sum.{0, 0} Nat Real Real.instAddCommMonoid
        (ImbalancedChen.actualLowerSmallRoughModuli retainEven N cap w z) fun (d : Nat) =>
        @HMul.hMul.{0, 0, 0} Real Real Real (@instHMul.{0} Real Real.instMul)
          (ImbalancedChen.actualLowerSmallRoughRho retainEven N cap w z L d)
          (ImbalancedChen.chenCentrePrimeAPCount N N
            (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) b d))))
