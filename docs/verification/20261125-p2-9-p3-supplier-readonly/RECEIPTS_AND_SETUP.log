{"kind": "extra_inventory", "path": "/workspace/goldbach-p3/.lake/p3-workspace-27f68009", "files": [{"path": "/workspace/goldbach-p3/.lake/p3-workspace-27f68009/chart-sum-70e8f69c.zip", "bytes": 32571}, {"path": "/workspace/goldbach-p3/.lake/p3-workspace-27f68009/proper-power-60cf3d49.zip", "bytes": 49455}]}
{"kind": "existing_verifier_source", "path": "/workspace/goldbach-p3/.lake/p3-third-verification/verify.py", "sha256": "38c523ff6fd6453a135ce8b0ee810b6f4302060aa6476a7ab713da5d9b87f400", "text": "from __future__ import annotations\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport runpy\nimport shutil\nimport subprocess\nimport sys\nimport time\n\nproject = Path.cwd()\nsys.path.insert(0, str(project / \"verification\"))\napi = runpy.run_path(\"verification/verify_part3_distribution.py\")\nbase_dir = project / \".lake/p3-final-closed-verification\"\nbase = json.loads((base_dir / \"report.json\").read_text())\nout = project / \".lake/p3-third-verification\"\nout.mkdir(parents=True, exist_ok=True)\noverlay = out / \"objects\"\nroot = overlay / \"ImbalancedChen\"\nroot.mkdir(parents=True, exist_ok=True)\nstate_path = out / \"prepare-state.json\"\nstate = json.loads(state_path.read_text()) if state_path.is_file() else {}\nenv = os.environ.copy()\nenv[\"LEAN_PATH\"] = str(overlay) + \":\" + env[\"LEAN_PATH\"]\nlean = Path(shutil.which(\"lean\")).resolve()\nchecker = Path(shutil.which(\"leanchecker\")).resolve()\nassert lean.parent == checker.parent == Path(env[\"LEAN_SYSROOT\"]).resolve() / \"bin\"\nmodules = list(api[\"MODULES\"])\nold_modules = base[\"modules\"]\nassert base[\"status\"] == \"PASSED\" and modules[:len(old_modules)] == old_modules\nassert base[\"axiom_union\"] == [\"Classical.choice\", \"Quot.sound\", \"propext\"]\nnew = modules[len(old_modules):]\n\ndef sha(p: Path) -> str:\n    return hashlib.sha256(p.read_bytes()).hexdigest()\n\ndef rel(m: str) -> str:\n    return m.replace(\".\", \"/\")\n\ndef save(path: Path, data):\n    path.write_text(json.dumps(data, indent=2) + \"\\n\")\n\ndef clean():\n    assert not subprocess.check_output(\n        [\"git\", \"status\", \"--porcelain\", \"--untracked-files=all\"], text=True).strip()\n\ndef run(cmd, label, cwd=overlay):\n    cmd = list(map(str, cmd))\n    print(\"START\", label, flush=True)\n    then = time.monotonic()\n    path = out / (label + \".log\")\n    with path.open(\"w\") as f:\n        f.write(\"command=\" + json.dumps(cmd) + \"\\n\")\n        f.flush()\n        code = subprocess.run(cmd, cwd=cwd, env=env, stdout=f, stderr=subprocess.STDOUT).returncode\n    rec = dict(name=label, command=cmd, exit_code=code, elapsed_seconds=round(time.monotonic() - then, 3))\n    log = path.read_text(errors=\"replace\").split(\"\\n\", 1)[1]\n    if code:\n        raise RuntimeError(f\"{label}: exit {code}\\n{log[-20000:]}\")\n    print(\"PASS\", label, flush=True)\n    return rec, log\n\nstage, version = run([lean, \"--version\"], \"lean-version\")\nassert \"version 4.33.0-rc1\" in version and base[\"lean_version\"] == version.strip()\nfor m in old_modules:\n    p = rel(m) + \".lean\"\n    assert sha(project / p) == base[\"source_sha256\"][p], p\nfor obj in (project / \".lake/build/lib/lean/ImbalancedChen\").glob(\"*.olean*\"):\n    dest = root / obj.name\n    if obj.is_file() and not dest.exists():\n        shutil.copyfile(obj, dest)\nobjects = dict(base[\"overlay_olean_sha256\"])\nfor p, digest in objects.items():\n    src, dest = base_dir / \"objects\" / p, overlay / p\n    assert sha(src) == digest, src\n    if not dest.is_file() or sha(dest) != digest:\n        shutil.copyfile(src, dest)\n\nredone = False\nfor module in new:\n    stem = module.rsplit(\".\", 1)[1]\n    relative = rel(module)\n    p = relative + \".lean\"\n    src, dest = project / p, overlay / p\n    digest = sha(src)\n    record = state.get(module)\n    if (not redone and record and record[\"source\"] == digest\n            and all((overlay / name).is_file() and sha(overlay / name) == value\n                    for name, value in record[\"objects\"].items())):\n        objects.update(record[\"objects\"])\n        continue\n    redone = True\n    shutil.copyfile(src, dest)\n    olean = overlay / (relative + \".olean\")\n    parts = [Path(str(olean) + ext) for ext in (\"\", \".server\", \".private\")]\n    for part in parts:\n        part.unlink(missing_ok=True)\n    strict, _ = run([lean, \"-t0\", \"-DwarningAsError=true\", \"-o\", relative + \".olean\", p],\n                    stem + \"-strict\")\n    assert olean.is_file()\n    replay, log = run([checker, \"--verbose\", module], stem + \"-replay\")\n    assert f\"replaying {module}\" in log.splitlines()\n    assert sha(dest) == sha(src) == digest\n    current = {str(part.relative_to(overlay)): sha(part) for part in parts if part.is_file()}\n    state[module] = {\"source\": digest, \"objects\": current, \"stages\": [strict, replay]}\n    save(state_path, state)\n    objects.update(current)\n\nserialized = subprocess.run([str(lean), \"--run\", \"/tmp/P3DumpSerialized.lean\",\n    *[str(overlay / (rel(m) + \".olean\")) for m in modules]],\n    cwd=overlay, env=env, text=True, capture_output=True, check=True).stdout\nowners = {}\nfor line in serialized.splitlines():\n    owner, declaration = line.split(\"\\t\", 1)\n    if declaration in owners:\n        raise RuntimeError(f\"Duplicate serialized name {declaration} in {owners[declaration]} and {owner}\")\n    owners[declaration] = owner\nprint(f\"PASS unique ownership across {len(owners)} declarations\", flush=True)\n\nif len(sys.argv) == 1:\n    exit(0)\nexpected = sys.argv[1]\nclean()\nhead = subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], text=True).strip()\nassert head == expected\nsubprocess.run([\"git\", \"merge-base\", \"--is-ancestor\", base[\"head_commit\"], head], check=True)\nfor entry in json.loads((project / \"lake-manifest.json\").read_text())[\"packages\"]:\n    path = str(project / \".lake/packages\" / entry[\"name\"])\n    assert subprocess.check_output([\"git\", \"-C\", path, \"rev-parse\", \"HEAD\"], text=True).strip() == entry[\"rev\"]\n    assert not subprocess.check_output([\"git\", \"-C\", path, \"status\", \"--porcelain\",\n                                        \"--untracked-files=all\"], text=True).strip()\nsource_rec = out / \"source-check\"\nsubprocess.run([sys.executable, api[\"__file__\"], \"--source-only\", \"--output-dir\", source_rec], check=True)\nsources = json.loads((source_rec / \"report.json\").read_text())[\"source_sha256\"]\nreport = {\n    \"status\": \"RUNNING\", \"head_commit\": head, \"modules\": modules, \"lean_version\": version.strip(),\n    \"base_verified_head\": base[\"head_commit\"], \"base_receipt\": str(base_dir / \"report.json\"),\n    \"base_receipt_sha256\": sha(base_dir / \"report.json\"), \"source_sha256\": sources,\n    \"strictly_rechecked_modules\": new, \"object_root\": \"objects\", \"overlay_olean_sha256\": objects,\n    \"tool_paths\": {\"lean\": str(lean), \"leanchecker\": str(checker), \"sysroot\": env[\"LEAN_SYSROOT\"]},\n    \"stages\": [stage] + [r for m in new for r in state[m][\"stages\"]],\n}\nsave(out / \"report.json\", report)\ntry:\n    outcome, log = run([lean, \"-t0\", \"-DwarningAsError=true\", api[\"AUDIT\"]], \"axioms\", project)\n    records, counts = api[\"validate_inventory\"](log)\n    assert len(records) == len(owners)\n    assert set(owners) == {r[\"name\"] for r in records}\n    for p, digest in sources.items():\n        assert sha(project / p) == digest, p\n    for p, digest in objects.items():\n        assert sha(overlay / p) == digest, p\n    clean()\n    assert subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], text=True).strip() == head\n    (out / \"declarations.json\").write_text(json.dumps(records, indent=2) + \"\\n\")\n    (out / \"theorem-types.txt\").write_text(f\"head_commit={head}\\n\\n\" + \"\\n\\n\".join(\n        r[\"name\"] + \" :\\n\" + r[\"type\"] + \"\\naxioms=\" + \",\".join(r[\"axioms\"])\n        for r in records if r[\"kind\"] == \"theorem\") + \"\\n\")\n    report[\"stages\"].append(outcome)\n    report.update(status=\"PASSED\", working_tree=\"\", declaration_count=len(records), module_counts=counts,\n                  axiom_union=sorted({a for r in records for a in r[\"axioms\"]}),\n                  declarations_sha256=sha(out / \"declarations.json\"))\n    save(out / \"report.json\", report)\n    shutil.copyfile(__file__, out / \"verify.py\")\n    print(f\"PASS: {len(records)} declarations across {len(modules)} modules at {head}\", flush=True)\nexcept BaseException as exc:\n    report.update(status=\"FAILED\", error=str(exc))\n    save(out / \"report.json\", report)\n    raise\n"}
{"kind": "declarations_shape", "path": "/workspace/goldbach-p3/.lake/p3-third-verification/declarations.json", "sha256": "66b2a3d0eaf4793a13e52c514aa706d6bc5ee2f4651b5d8ea3e720d9164d13e8", "type": "list", "count": 1719, "keys": null, "first": {"axioms": ["propext", "Classical.choice", "Quot.sound"], "kind": "definition", "level_parameters": [], "module": "ImbalancedChen.Part3CurrentLowerDistribution", "name": "ImbalancedChen.Part3CurrentLowerRows", "type": "Nat \u2192\n  Nat \u2192\n    (Nat \u2192 Finset.{0} Nat) \u2192\n      (Nat \u2192 Finset.{0} Nat) \u2192 (Prod.{0, 0} Nat Nat \u2192 Finset.{0} Nat) \u2192 (Prod.{0, 0} Nat Nat \u2192 Finset.{0} Nat) \u2192 Prop"}, "module_matches": []}
{"kind": "existing_verifier_source", "path": "/workspace/goldbach-p3/.lake/p3-fourth-verification/verify.py", "sha256": "74cf2ed603a376adf4ee91f9f9b431ba32c7601b8e90bfd1fa4db8a9510572eb", "text": "from __future__ import annotations\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport runpy\nimport shutil\nimport subprocess\nimport sys\nimport time\n\nproject = Path.cwd()\nsys.path.insert(0, str(project / \"verification\"))\napi = runpy.run_path(\"verification/verify_part3_distribution.py\")\nbase_dir = project / \".lake/p3-third-verification\"\nbase = json.loads((base_dir / \"report.json\").read_text())\nout = project / \".lake/p3-fourth-verification\"\nout.mkdir(parents=True, exist_ok=True)\noverlay = out / \"objects\"\nroot = overlay / \"ImbalancedChen\"\nroot.mkdir(parents=True, exist_ok=True)\nstate_path = out / \"prepare-state.json\"\nstate = json.loads(state_path.read_text()) if state_path.is_file() else {}\nenv = os.environ.copy()\nenv[\"LEAN_PATH\"] = str(overlay) + \":\" + env[\"LEAN_PATH\"]\nlean = Path(shutil.which(\"lean\")).resolve()\nchecker = Path(shutil.which(\"leanchecker\")).resolve()\nassert lean.parent == checker.parent == Path(env[\"LEAN_SYSROOT\"]).resolve() / \"bin\"\nmodules = list(api[\"MODULES\"])\nold_modules = base[\"modules\"]\nassert base[\"status\"] == \"PASSED\" and modules[:len(old_modules)] == old_modules\nassert base[\"axiom_union\"] == [\"Classical.choice\", \"Quot.sound\", \"propext\"]\nnew = modules[len(old_modules):]\n\ndef sha(p: Path) -> str:\n    return hashlib.sha256(p.read_bytes()).hexdigest()\n\ndef rel(m: str) -> str:\n    return m.replace(\".\", \"/\")\n\ndef save(path: Path, data):\n    path.write_text(json.dumps(data, indent=2) + \"\\n\")\n\ndef clean():\n    assert not subprocess.check_output(\n        [\"git\", \"status\", \"--porcelain\", \"--untracked-files=all\"], text=True).strip()\n\ndef run(cmd, label, cwd=overlay):\n    cmd = list(map(str, cmd))\n    print(\"START\", label, flush=True)\n    then = time.monotonic()\n    path = out / (label + \".log\")\n    with path.open(\"w\") as f:\n        f.write(\"command=\" + json.dumps(cmd) + \"\\n\")\n        f.flush()\n        code = subprocess.run(cmd, cwd=cwd, env=env, stdout=f, stderr=subprocess.STDOUT).returncode\n    rec = dict(name=label, command=cmd, exit_code=code, elapsed_seconds=round(time.monotonic() - then, 3))\n    log = path.read_text(errors=\"replace\").split(\"\\n\", 1)[1]\n    if code:\n        raise RuntimeError(f\"{label}: exit {code}\\n{log[-20000:]}\")\n    print(\"PASS\", label, flush=True)\n    return rec, log\n\nstage, version = run([lean, \"--version\"], \"lean-version\")\nassert \"version 4.33.0-rc1\" in version and base[\"lean_version\"] == version.strip()\nfor m in old_modules:\n    p = rel(m) + \".lean\"\n    assert sha(project / p) == base[\"source_sha256\"][p], p\nfor obj in (project / \".lake/build/lib/lean/ImbalancedChen\").glob(\"*.olean*\"):\n    dest = root / obj.name\n    if obj.is_file() and not dest.exists():\n        shutil.copyfile(obj, dest)\nobjects = dict(base[\"overlay_olean_sha256\"])\nfor p, digest in objects.items():\n    src, dest = base_dir / \"objects\" / p, overlay / p\n    assert sha(src) == digest, src\n    if not dest.is_file() or sha(dest) != digest:\n        shutil.copyfile(src, dest)\n\nredone = False\nfor module in new:\n    stem = module.rsplit(\".\", 1)[1]\n    relative = rel(module)\n    p = relative + \".lean\"\n    src, dest = project / p, overlay / p\n    digest = sha(src)\n    record = state.get(module)\n    if (not redone and record and record[\"source\"] == digest\n            and all((overlay / name).is_file() and sha(overlay / name) == value\n                    for name, value in record[\"objects\"].items())):\n        objects.update(record[\"objects\"])\n        continue\n    redone = True\n    shutil.copyfile(src, dest)\n    olean = overlay / (relative + \".olean\")\n    parts = [Path(str(olean) + ext) for ext in (\"\", \".server\", \".private\")]\n    for part in parts:\n        part.unlink(missing_ok=True)\n    strict, _ = run([lean, \"-t0\", \"-DwarningAsError=true\", \"-o\", relative + \".olean\", p],\n                    stem + \"-strict\")\n    assert olean.is_file()\n    replay, log = run([checker, \"--verbose\", module], stem + \"-replay\")\n    assert f\"replaying {module}\" in log.splitlines()\n    assert sha(dest) == sha(src) == digest\n    current = {str(part.relative_to(overlay)): sha(part) for part in parts if part.is_file()}\n    state[module] = {\"source\": digest, \"objects\": current, \"stages\": [strict, replay]}\n    save(state_path, state)\n    objects.update(current)\n\nserialized = subprocess.run([str(lean), \"--run\", \"/tmp/P3DumpSerialized.lean\",\n    *[str(overlay / (rel(m) + \".olean\")) for m in modules]],\n    cwd=overlay, env=env, text=True, capture_output=True, check=True).stdout\nowners = {}\nfor line in serialized.splitlines():\n    owner, declaration = line.split(\"\\t\", 1)\n    if declaration in owners:\n        raise RuntimeError(f\"Duplicate serialized name {declaration} in {owners[declaration]} and {owner}\")\n    owners[declaration] = owner\nprint(f\"PASS unique ownership across {len(owners)} declarations\", flush=True)\n\nif len(sys.argv) == 1:\n    exit(0)\nexpected = sys.argv[1]\nclean()\nhead = subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], text=True).strip()\nassert head == expected\nsubprocess.run([\"git\", \"merge-base\", \"--is-ancestor\", base[\"head_commit\"], head], check=True)\nfor entry in json.loads((project / \"lake-manifest.json\").read_text())[\"packages\"]:\n    path = str(project / \".lake/packages\" / entry[\"name\"])\n    assert subprocess.check_output([\"git\", \"-C\", path, \"rev-parse\", \"HEAD\"], text=True).strip() == entry[\"rev\"]\n    assert not subprocess.check_output([\"git\", \"-C\", path, \"status\", \"--porcelain\",\n                                        \"--untracked-files=all\"], text=True).strip()\nsource_rec = out / \"source-check\"\nsubprocess.run([sys.executable, api[\"__file__\"], \"--source-only\", \"--output-dir\", source_rec], check=True)\nsources = json.loads((source_rec / \"report.json\").read_text())[\"source_sha256\"]\nreport = {\n    \"status\": \"RUNNING\", \"head_commit\": head, \"modules\": modules, \"lean_version\": version.strip(),\n    \"base_verified_head\": base[\"head_commit\"], \"base_receipt\": str(base_dir / \"report.json\"),\n    \"base_receipt_sha256\": sha(base_dir / \"report.json\"), \"source_sha256\": sources,\n    \"strictly_rechecked_modules\": new, \"object_root\": \"objects\", \"overlay_olean_sha256\": objects,\n    \"tool_paths\": {\"lean\": str(lean), \"leanchecker\": str(checker), \"sysroot\": env[\"LEAN_SYSROOT\"]},\n    \"stages\": [stage] + [r for m in new for r in state[m][\"stages\"]],\n}\nsave(out / \"report.json\", report)\ntry:\n    outcome, log = run([lean, \"-t0\", \"-DwarningAsError=true\", api[\"AUDIT\"]], \"axioms\", project)\n    records, counts = api[\"validate_inventory\"](log)\n    assert len(records) == len(owners)\n    assert set(owners) == {r[\"name\"] for r in records}\n    for p, digest in sources.items():\n        assert sha(project / p) == digest, p\n    for p, digest in objects.items():\n        assert sha(overlay / p) == digest, p\n    clean()\n    assert subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], text=True).strip() == head\n    (out / \"declarations.json\").write_text(json.dumps(records, indent=2) + \"\\n\")\n    (out / \"theorem-types.txt\").write_text(f\"head_commit={head}\\n\\n\" + \"\\n\\n\".join(\n        r[\"name\"] + \" :\\n\" + r[\"type\"] + \"\\naxioms=\" + \",\".join(r[\"axioms\"])\n        for r in records if r[\"kind\"] == \"theorem\") + \"\\n\")\n    report[\"stages\"].append(outcome)\n    report.update(status=\"PASSED\", working_tree=\"\", declaration_count=len(records), module_counts=counts,\n                  axiom_union=sorted({a for r in records for a in r[\"axioms\"]}),\n                  declarations_sha256=sha(out / \"declarations.json\"))\n    save(out / \"report.json\", report)\n    shutil.copyfile(__file__, out / \"verify.py\")\n    print(f\"PASS: {len(records)} declarations across {len(modules)} modules at {head}\", flush=True)\nexcept BaseException as exc:\n    report.update(status=\"FAILED\", error=str(exc))\n    save(out / \"report.json\", report)\n    raise\n"}
