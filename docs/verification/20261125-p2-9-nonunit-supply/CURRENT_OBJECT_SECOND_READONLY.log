 {"path": "/workspace/p29-native-supply-20261125/supply-bindings/driver.py", "bytes": 14803, "sha256": "e69342648b202a39e8f30b1a4547fd7b9cf1c1cc14aef077a00cabed3c86c9cc", "uncompressed_bytes": 14803, "uncompressed_sha256": "e69342648b202a39e8f30b1a4547fd7b9cf1c1cc14aef077a00cabed3c86c9cc", "text": "import pathlib,json,hashlib,os,gzip,shlex,datetime,uuid,shutil,tarfile\nP=pathlib.Path\nOUT=P('/workspace/p29-native-supply-20261125')\nPKG=P('/workspace/blue-member-build/.lake/packages/goldbach')\nMODS=[\"MathlibNt.SieveTheory.LiLiuPrereqBuchstabFunction\",\"MathlibNt.SieveTheory.LiLiuPrereqBuchstabCount\",\"MathlibNt.SieveTheory.LiLiuPrereqBuchstabPNT\",\"MathlibNt.SieveTheory.LiLiuPrereqBuchstabBase\",\"MathlibNt.SieveTheory.LiLiuPrereqBuchstabBaseEstimate\",\"MathlibNt.SieveTheory.LiLiuPrereqBuchstabBounds\",\"MathlibNt.SieveTheory.LiLiuPrereqBuchstabIntegral\",\"MathlibNt.SieveTheory.LiLiuPrereqBuchstabPrimeSums\",\"MathlibNt.SieveTheory.LiLiuPrereqBuchstabUniformAbel\",\"MathlibNt.SieveTheory.LiLiuPrereqBuchstabBands\",\"MathlibNt.SieveTheory.LiLiuPrereqBuchstabUniform\",\"MathlibNt.SieveTheory.LiLiuPrereqBuchstabUniformFixedCompat\"]\nTOOL=P('/workspace/blue-build-tools/validate_member_native_generic_extension.py')\nEXPECTED_RESULT_SHA='93af0b6bd8f0de92616927a13bf884ad1fb493fbd39fcc88c4d03b13ed579955'\ndef sha(p):return hashlib.sha256(P(p).read_bytes()).hexdigest()\ndef stamp(p):\n s=P(p).stat();return [s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns]\ndef j(p):return json.loads(P(p).read_text())\ndef save(p,x):\n p=P(p);p.parent.mkdir(parents=True,exist_ok=True)\n with p.open('x')as f:json.dump(x,f,indent=2);f.write('\\n')\ndef ident(p):\n p=P(p);s=stamp(p);v={'path':str(p),'bytes':s[2],'sha256':sha(p),'stat_snapshot':s};assert stamp(p)==s;return v\nassert sha(OUT/'VALIDATION_RESULTS.json')==EXPECTED_RESULT_SHA\nvalidation=j(OUT/'VALIDATION_RESULTS.json')\nassert validation['result']=='PASS_EXACT_MODULE_REPLAY_FULL_OWNED_DECLARATION_TYPES_AND_STANDARD_AXIOMS'\nassert validation['modules']==MODS and validation['sources_and_outputs_unchanged']\nbefore=j(OUT/'SOURCE_AND_OUTPUTS_BEFORE.json');after=j(OUT/'SOURCE_AND_OUTPUTS_AFTER.json');assert before==after\nE=OUT/'supply-bindings'\nif E.exists():E=OUT/('supply-bindings-'+uuid.uuid4().hex[:8])\nE.mkdir();(E/'driver.py').write_text(SOURCE_TEXT)\nsaved=[];current={};checks=[];blockers=[]\ndef retain(path,rel,compress=False):\n path=P(path);dest=E/rel;dest.parent.mkdir(parents=True,exist_ok=True);data=path.read_bytes()\n if compress:\n  with dest.open('xb')as f:f.write(gzip.compress(data,mtime=0))\n else:\n  with dest.open('xb')as f:f.write(data)\n rec={'original_path':str(path),'original_bytes':len(data),'original_sha256':hashlib.sha256(data).hexdigest(),'saved_path':str(dest),'encoding':'gzip' if compress else 'identity','saved_bytes':dest.stat().st_size,'saved_sha256':sha(dest)}\n saved.append(rec);return rec\n# Independently verify and retain every source/output covered by the accepted tool.\nfor path,expected in before.items():\n rec=ident(path);assert rec['sha256']==expected['sha256'] and rec['bytes']==expected['bytes'],path\n current[path]=rec\n p=P(path);relative=p.relative_to(PKG)\n compress=p.name.endswith('.setup.json')\n retain(p,'native-assets/'+str(relative)+('.gz' if compress else ''),compress)\n# Preserve sidecar facets required by the original portable-family method.\nfor m in MODS:\n rel=m.replace('.','/')\n for stem,suf in [('.lake/build/lib/lean','.olean.hash'),('.lake/build/lib/lean','.ilean.hash'),('.lake/build/ir','.c.hash')]:\n  path=PKG/stem/(rel+suf)\n  if path.is_file():current[str(path)]=ident(path);retain(path,'native-assets/'+str(path.relative_to(PKG)))\n# Accepted physical memo authority, current bytes checked against the accepted summary.\nQ=P('/workspace/artifacts/member-to-p6-fresh-native-20261123')\nassert sha(Q/'SUMMARY.json')=='540f51c6e77be34ca3b1a5aa3dffb3bace8bb1fa56c3f20cda793c701bc23bb4'\nsummary=j(Q/'SUMMARY.json');batch=next(x for x in summary['batches']if x['name']=='final16')\nfor name in ['QUALIFICATION.json','PHYSICAL_INPUTS.json','IMPORT_BINDINGS.json','ACTUAL_COMMAND_BINDING.json']:\n rec=batch['evidence'][name];assert sha(rec['path'])==rec['sha256']\n retain(rec['path'],'memo-authority/final16-'+name+'.gz',True)\nretain(Q/'SUMMARY.json','memo-authority/SUMMARY.json')\nretain(Q/'INDEPENDENT_REVIEW.json','memo-authority/INDEPENDENT_REVIEW.json')\nmemo_path=P(batch['evidence']['PHYSICAL_INPUTS.json']['path'])\nmemo={x['identity']['path']:x for x in j(memo_path)['files']}\n# Both producer guard states and exact historical guard log prefixes.\nstates={};guardrows={}\nfor label,path,expected in [\n ('member','/workspace/blue-build-tools/member-runtime-evidence/state.json','9f0688f701d861e3af832a1ab17d8d0fab41c1d30a3261f24922cae058e7b152'),\n ('runtime','/workspace/blue-build-tools/runtime-evidence/state.json','e474b9cb4b9e4d9cc4cc0c3ba58b29b0096f1bdec6f104d2e41a17f521ca232b')]:\n assert sha(path)==expected\n state=j(path);states[state['shadow']]=(label,state)\n retain(path,'producer-evidence/'+label+'-state.json')\n log=P(state['log']);raw=log.read_bytes()\n outlog=E/'producer-evidence'/(label+'-guard-prefix.jsonl.gz');outlog.write_bytes(gzip.compress(raw,mtime=0))\n parsed=[(i+1,json.loads(line))for i,line in enumerate(raw.splitlines())if line.strip()]\n guardrows[state['shadow']]=parsed\n checks.append({'kind':'guard_log_prefix','path':str(log),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'saved_path':str(outlog),'saved_sha256':sha(outlog)})\n for p,expectedsha in {**state['runtime_sha256'],**state['input_sha256'],**state['action_script_sha256']}.items():\n  st=stamp(p);prior=memo.get(p)\n  got=prior['identity']['sha256']if prior and prior['stat_snapshot']==st else sha(p)\n  assert got==expectedsha and stamp(p)==st,p\n  checks.append({'kind':'pinned_runtime_or_config','path':p,'bytes':st[2],'sha256':got,'stat_snapshot':st,'authority':'accepted_stable_memo'if prior and prior[