+def checked_gaps_manifest(here, manifest, pins):
+    """Authenticate the entire predecessor workflow before invoking any of its code."""
+    need(manifest['schema'] == 'p26_cell05_all_row_gaps_workflow_v1', 'Unexpected Gaps workflow schema')
+    files = manifest['files']
+    names = set()
+    for row in files:
+        raw = row['relative_path']
+        rel = Path(raw)
+        need(raw == str(rel) and not rel.is_absolute() and '..' not in rel.parts and
+             rel.name != '__init__.py' and raw not in names, 'Unsafe or duplicate Gaps workflow member')
+        names.add(raw)
+        checked_bytes(here / rel, row)
+    required = {'run_gaps.py', 'CONFIG.json', 'owned-audits/P2OriginalSaving19Cell05AllRowGaps.lean'}
+    need(required <= names, 'Incomplete Gaps workflow')
+    for path in here.rglob('*'):
+        canonical(path)
+        need(path.name != '__pycache__' and path.suffix not in {'.pyc', '.pyo', '.so'} and
+             (path.suffix != '.py' or str(path.relative_to(here)) in names), 'Unpinned Gaps executable')
+    for relative, key in [('run_gaps.py', 'driver'), ('CONFIG.json', 'configuration')]:
+        row = next(r for r in files if r['relative_path'] == relative)
+        need(all(row[k] == pins[key][k] for k in ('bytes','sha256')), 'Predecessor workflow binding differs')
