import ImbalancedChen.ActualExtendedThirdCompactUpperRho
import ImbalancedChen.ActualExtendedThirdGammaApproximation
import ImbalancedChen.ActualExtendedThirdLeastWinningIndex
import ImbalancedChen.ActualSmallRoughAttachment
import ImbalancedChen.CurrentChenPairHarmonicMean
import ImbalancedChen.CurrentChenQuotientUpperRosser
import ImbalancedChen.CurrentChenSinglePrimeHarmonicMean
import ImbalancedChen.CurrentChenSinglePrimeUpperFiniteMean
import ImbalancedChen.CurrentChenUpsilon5FiniteMean
import ImbalancedChen.CurrentChenUpsilon6FiniteMean
import ImbalancedChen.CurrentChenUpsilon6OrdinaryMean
import ImbalancedChen.CurrentChenUpsilon9HarmonicMean
import ImbalancedChen.Part3SharedFirstFactorDispersion
import ImbalancedChen.Part3SharedFirstFactorLargePairedGCDNonzero
import ImbalancedChen.Part3SharedFirstFactorLargeSupportedDeletion
import ImbalancedChen.Part3SharedFirstFactorPrimitiveUVPayment
import ImbalancedChen.Part3TransposedZeroCovariance
import Lean.Meta.InferType

/-! SOURCEONLY / UNEXECUTED. ROOT's original single queue must run this.
Exact old map: 29f9fa967fc846081a507a23cb5b419857537f75c1cad48c9db6bfffae9326fd.
Read EACH serialized ConstantInfo copy, not a merged env.find? representative.
Original per-module stock/ALL/type/axiom evidence remains unchanged. -/

set_option pp.all true
set_option pp.proofs true
set_option pp.deepTerms true
set_option pp.universes true
set_option pp.explicit true
set_option pp.fullNames true
set_option pp.privateNames true
set_option pp.maxSteps 1000000

open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let expected : Array (Name × Name) := #[
    (`ImbalancedChen.ActualExtendedThirdCompactUpperRho, `ImbalancedChen.actualPrimeTupleLog.eq_1),
    (`ImbalancedChen.ActualExtendedThirdGammaApproximation, `ImbalancedChen.actualExtendedThirdFullGamma.eq_1),
    (`ImbalancedChen.ActualExtendedThirdGammaApproximation, `ImbalancedChen.actualExtendedThirdPhysicalGamma.eq_1),
    (`ImbalancedChen.ActualExtendedThirdLeastWinningIndex, `ImbalancedChen.actualExtendedThirdFullGamma.eq_1),
    (`ImbalancedChen.ActualExtendedThirdLeastWinningIndex, `ImbalancedChen.actualExtendedThirdPhysicalGamma.eq_1),
    (`ImbalancedChen.ActualSmallRoughAttachment, `ImbalancedChen.actualSmallRosserPlusDensity.eq_1),
    (`ImbalancedChen.CurrentChenPairHarmonicMean, `ImbalancedChen.actualPrimeTupleLog.eq_1),
    (`ImbalancedChen.CurrentChenPairHarmonicMean, `ImbalancedChen.currentChenPairLogProfile.eq_1),
    (`ImbalancedChen.CurrentChenQuotientUpperRosser, `ImbalancedChen.actualSmallRosserPlusDensity.eq_1),
    (`ImbalancedChen.CurrentChenSinglePrimeHarmonicMean, `ImbalancedChen.actualPrimeTupleLog.eq_1),
    (`ImbalancedChen.CurrentChenSinglePrimeHarmonicMean, `ImbalancedChen.currentChenPairLogProfile.eq_1),
    (`ImbalancedChen.CurrentChenSinglePrimeUpperFiniteMean, `ImbalancedChen.chenQuotientRosserD.eq_1),
    (`ImbalancedChen.CurrentChenSinglePrimeUpperFiniteMean, `ImbalancedChen.chenSelectedCentreCost.eq_1),
    (`ImbalancedChen.CurrentChenSinglePrimeUpperFiniteMean, `ImbalancedChen.part3CurrentLowerAPError.eq_1),
    (`ImbalancedChen.CurrentChenSinglePrimeUpperFiniteMean, `ImbalancedChen.part3CurrentLowerCentreCost.eq_1),
    (`ImbalancedChen.CurrentChenUpsilon5FiniteMean, `ImbalancedChen.chenQuotientRosserD.eq_1),
    (`ImbalancedChen.CurrentChenUpsilon5FiniteMean, `ImbalancedChen.chenSelectedCentreCost.eq_1),
    (`ImbalancedChen.CurrentChenUpsilon5FiniteMean, `ImbalancedChen.part3CurrentLowerAPError.eq_1),
    (`ImbalancedChen.CurrentChenUpsilon5FiniteMean, `ImbalancedChen.part3CurrentLowerCentreCost.eq_1),
    (`ImbalancedChen.CurrentChenUpsilon6FiniteMean, `ImbalancedChen.chenQuotientRosserD.eq_1),
    (`ImbalancedChen.CurrentChenUpsilon6FiniteMean, `ImbalancedChen.chenSelectedCentreCost.eq_1),
    (`ImbalancedChen.CurrentChenUpsilon6FiniteMean, `ImbalancedChen.part3CurrentLowerAPError.eq_1),
    (`ImbalancedChen.CurrentChenUpsilon6FiniteMean, `ImbalancedChen.part3CurrentLowerCentreCost.eq_1),
    (`ImbalancedChen.CurrentChenUpsilon6OrdinaryMean, `ImbalancedChen.actualPrimeTupleLog.eq_1),
    (`ImbalancedChen.CurrentChenUpsilon9HarmonicMean, `ImbalancedChen.actualPrimeTupleLog.eq_1),
    (`ImbalancedChen.Part3SharedFirstFactorDispersion, `ImbalancedChen.Part3.ComplexCRT.Compatible.eq_1),
    (`ImbalancedChen.Part3SharedFirstFactorLargePairedGCDNonzero, `ImbalancedChen.Part3.MediumAtom.q1SliceAtom.eq_1),
    (`ImbalancedChen.Part3SharedFirstFactorLargeSupportedDeletion, `ImbalancedChen.Part3.MediumAtom.q1SliceAtom.eq_1),
    (`ImbalancedChen.Part3SharedFirstFactorPrimitiveUVPayment, `ImbalancedChen.Part3.MediumAtom.q1SliceAtom.eq_1),
    (`ImbalancedChen.Part3TransposedZeroCovariance, `ImbalancedChen.Part3.ComplexCRT.Compatible.eq_1)
  ]
  let mut seen : Array (Name × Name) := #[]
  let mut names : Array Name := #[]
  let mut modules : Array Name := #[]
  for (moduleName, name) in expected do
    if seen.contains (moduleName, name) then throwError "Repeated requested pair"
    seen := seen.push (moduleName, name)
    unless names.contains name do names := names.push name
    unless modules.contains moduleName do modules := modules.push moduleName
    let mut moduleFound := false
    let mut copies := 0
    for i in List.range env.header.modules.size do
      let imported := env.header.modules[i]!
      if imported.module == moduleName then
        if moduleFound then throwError "Repeated serialized module {moduleName}"
        moduleFound := true
        let data := env.header.moduleData[i]!
        if data.isModule || !imported.importAll || !imported.hasData then
          throwError "Incomplete legacy serialized data for {moduleName}"
        unless data.constNames.size == data.constants.size do
          throwError "Serialized name/ConstantInfo length mismatch"
        for j in List.range data.constNames.size do
          if data.constNames[j]! == name then
            copies := copies + 1
            let info := data.constants[j]!
            unless info.name == name do throwError "Serialized ConstantInfo name mismatch"
            let theoremKind := match info with
              | .thmInfo _ => true
              | _ => false
            unless theoremKind do throwError "Non-theorem serialized copy {moduleName}:{name}"
            if info.isUnsafe || info.isPartial || info.isAxiom then
              throwError "Unsafe/partial/axiom serialized copy"
            let isProp ← liftTermElabM do Meta.isProp info.type
            unless isProp do throwError "Non-Prop serialized type {moduleName}:{name}"
            let type ← liftTermElabM do return (← Meta.ppExpr info.type).pretty
            if type.contains '⋯' then throwError "Truncated serialized type"
            let row := Json.mkObj [
              ("module", toJson moduleName.toString), ("name", toJson name.toString),
              ("serialized_index", toJson j), ("kind", toJson "theorem"),
              ("isProp", toJson isProp),
              ("level_params", toJson (info.levelParams.map Name.toString)),
              ("unsafe", toJson info.isUnsafe), ("partial", toJson info.isPartial),
              ("axiom", toJson info.isAxiom), ("type", toJson type)]
            liftIO <| IO.println s!"P3_DUP_META {row.compress}"
    unless moduleFound && copies == 1 do
      throwError "Missing/nonunique serialized copy {moduleName}:{name}"
  unless seen.size == 30 && names.size == 11 && modules.size == 17 do
    throwError "Exact duplicate map coverage mismatch"
  let summary := Json.mkObj [
    ("entries", toJson seen.size), ("distinct_names", toJson names.size),
    ("serialized_modules", toJson modules.size)]
  liftIO <| IO.println s!"P3_DUP_META_SUMMARY {summary.compress}"
