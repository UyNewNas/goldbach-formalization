"""SOURCEONLY ROOT adoption candidate for the after229 three-module P3 batch.
Requires final ROOT-produced proposal, independent review, finite capture, and
factual observations as explicit path/SHA inputs. Writes one fresh acceptance.
"""
from pathlib import Path
import argparse
import collections
import datetime
import hashlib
import json
import runpy

ROOT = Path('/mnt/e/timot/Documents/FilesForGPT/Myath/goldbach-proof-continuation')
STATE = ROOT / '.lake/proof-continuation'
BASELINE_REL = '.lake/proof-continuation/source-reviews/20261024d-root-after226-three-terminal-acceptance.json'
BASELINE_SHA = '4526bf2a1fa10b336af0964d2322793de349d903bb7814d650b9ac6c2d3d5377'
PUBLICATION_REL = '.lake/proof-continuation/publication-integrity/20261024d-root229-GITHUB-PUBLICATION.json'
PUBLICATION_SHA = '6e5f6b76b6cc733f531838537087ade1f332fd3f1fdcb83bc8ba4950a628aead'
COLLECTOR_REL = '.lake/proof-continuation/source-reviews/drafts/20261024d-after229-three-small-P3-record-append-V2-SOURCEONLY.py.txt'
COLLECTOR_SHA = 'f2c0cfda4fcaffa3dbc644d0990cc7ff543dfd863fa4979195c75f8f5923478d'
COLLECTOR_PEER_REL = '.lake/proof-continuation/source-reviews/drafts/20261024d-after229-three-small-P3-record-append-V2-independent-source-peer-CP-SOURCEONLY.json'
COLLECTOR_PEER_SHA = 'c7de395eb6347628ca0be52175263c2925a08401045c26eb8e63a3bcb6ba8af3'
REVIEWER_REL = '.lake/proof-continuation/source-reviews/drafts/20261024d-after229-independent-terminal-review-V1-SOURCEONLY.py.txt'
REVIEWER_SHA = 'f3015e798b5a29010f159655113c6326281937abbfa6f68da9a2a3c79223a47b'
REVIEWER_PEER_REL = '.lake/proof-continuation/source-reviews/drafts/20261024d-after229-independent-terminal-review-V1-independent-source-peer-CP-SOURCEONLY.json'
REVIEWER_PEER_SHA = '67f29b432461acc426825db456ec30adce6566cdbc601efdc57486da4c665215'
CAPTURE_BUILDER_REL = '.lake/proof-continuation/rounds/20261024f-root-after229-finite-capture-V2-SOURCEONLY.py.txt'
CAPTURE_BUILDER_SHA = 'c482a3ff93f6516ecb878537d351839ced72dc6e3775f6b3f8a65fbc708715d7'
TARGET_MODULES = (
    'ImbalancedChen.Part3ActualCompletedZeroDifferencePayment',
    'ImbalancedChen.Part3ActualZeroTagFreeEpsilonPayment',
    'ImbalancedChen.Part3ActualNonzeroChartEpsilonTagPayment',
)
STD3 = {'propext', 'Classical.choice', 'Quot.sound'}
OUTPUT_REL = '.lake/proof-continuation/source-reviews/20261024e-root-after229-three-P3-terminal-acceptance.json'
PINNED = {}

def need(ok, why):
    if not ok:
        raise ValueError(why)

def sha(path):
    with Path(path).open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()

def local_path(raw):
    need(isinstance(raw, str) and raw, 'path string required')
    name = raw.replace('\\', '/')
    win = 'E:/timot/Documents/FilesForGPT/Myath/goldbach-proof-continuation/'
    if name == win[:-1]:
        p = ROOT
    elif name.startswith(win):
        p = ROOT / name[len(win):]
    else:
        need(not (len(name) >= 3 and name[1:3] == ':/'), 'foreign Windows drive path rejected')
        candidate = Path(name)
        p = candidate if candidate.is_absolute() else ROOT / candidate
    p = p.resolve(strict=True)
    need(p.is_file() and p.is_relative_to(ROOT), 'repository file path required')
    return p

def pair(raw, expected):
    need(isinstance(expected, str) and len(expected) == 64 and set(expected) <= set('0123456789abcdef'), 'lowercase SHA256 required')
    p = local_path(raw)
    need(sha(p) == expected, 'input SHA mismatch: ' + raw)
    need(p not in PINNED or PINNED[p] == expected, 'conflicting input SHA references')
    PINNED[p] = expected
    return {'path': raw.replace('\\', '/'), 'sha256': expected}

def bind(ref):
    need(isinstance(ref, dict) and set(ref) == {'path', 'sha256'}, 'exact path/SHA pair required')
    p = pair(ref['path'], ref['sha256'])
    return p

def read(ref):
    p = bind(ref)
    return json.loads(local_path(ref['path']).read_text(encoding='utf-8'))

def parse_targets(values):
    result = {}
    for value in values:
        need(isinstance(value, str) and value.count('=') == 1, '--target-source must be MODULE=SHA256')
        module, digest = value.split('=', 1)
        need(module in TARGET_MODULES and module not in result and len(digest) == 64
             and set(digest) <= set('0123456789abcdef'), 'unknown/duplicate target or malformed source SHA')
        result[module] = digest
    need(set(result) == set(TARGET_MODULES), 'exactly three final target source hashes required')
    return result

def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root', required=True)
    parser.add_argument('--proposal', required=True)
    parser.add_argument('--proposal-sha256', required=True)
    parser.add_argument('--intake', required=True)
    parser.add_argument('--intake-sha256', required=True)
    parser.add_argument('--terminal-review', required=True)
    parser.add_argument('--terminal-review-sha256', required=True)
    parser.add_argument('--terminal-review-cp', required=True)
    parser.add_argument('--terminal-review-cp-sha256', required=True)
    parser.add_argument('--capture', required=True)
    parser.add_argument('--capture-sha256', required=True)
    parser.add_argument('--witness', required=True)
    parser.add_argument('--witness-sha256', required=True)
    parser.add_argument('--baseline-acceptance-sha256', required=True)
    parser.add_argument('--target-source', action='append', required=True)
    parser.add_argument('--acceptance-output', required=True)
    args = parser.parse_args(argv)

    need(Path(args.root).resolve(strict=True) == ROOT.resolve(strict=True), 'fixed WSL repository required')
    targets = parse_targets(args.target_source)
    need(args.baseline_acceptance_sha256 == BASELINE_SHA, 'exact ROOT229 baseline acceptance SHA required')
    acceptance_out = args.acceptance_output.replace('\\', '/')
    need(acceptance_out == OUTPUT_REL, 'exact after229 ROOT acceptance output path required')

    proposal_ref = pair(args.proposal, args.proposal_sha256)
    intake_ref = pair(args.intake, args.intake_sha256)
    review_ref = pair(args.terminal_review, args.terminal_review_sha256)
    review_cp_ref = pair(args.terminal_review_cp, args.terminal_review_cp_sha256)
    capture_ref = pair(args.capture, args.capture_sha256)
    witness_ref = pair(args.witness, args.witness_sha256)
    proposal = read(proposal_ref)
    intake = read(intake_ref)
    review = read(review_ref)
    capture = read(capture_ref)
    witness = read(witness_ref)
    baseline_ref = {'path': BASELINE_REL, 'sha256': BASELINE_SHA}
    baseline = read(baseline_ref)
    publication_ref = {'path': PUBLICATION_REL, 'sha256': PUBLICATION_SHA}
    publication = read(publication_ref)
    collector_ref = pair(COLLECTOR_REL, COLLECTOR_SHA)
    collector_peer_ref = pair(COLLECTOR_PEER_REL, COLLECTOR_PEER_SHA)
    reviewer_source_ref = pair(REVIEWER_REL, REVIEWER_SHA)
    reviewer_peer_ref = pair(REVIEWER_PEER_REL, REVIEWER_PEER_SHA)
    collector_peer = read(collector_peer_ref)
    reviewer_peer = read(reviewer_peer_ref)

    # Reuse V2's finite path resolver so repository sources, exact runtime
    # provider files, and only the three named native Lean tools are admitted.
    collector_path = local_path(COLLECTOR_REL)
    finite_ns = runpy.run_path(str(collector_path), run_name='after229_adoption_import_only')
    need(tuple(finite_ns.get('TARGET_MODULES', ())) == TARGET_MODULES
         and callable(finite_ns.get('FinitePaths')), 'reviewed finite-path API changed')
    finite_paths = finite_ns['FinitePaths'](ROOT)
    finite_paths.prepare(set(intake['current_module_files']))
    approved_native_roles = {'lean', 'lean_real', 'leanchecker'}
    need(set(intake['tools']) == {'audit_runner', 'audit_template', 'lean', 'lean_real', 'leanchecker', 'runtime'},
         'exact finite audited tool roles required')
    external_tool_paths = set()
    for role, ref in intake['tools'].items():
        need(isinstance(ref, dict) and set(ref) == {'path', 'sha256'}, 'tool ref schema mismatch')
        tool_path = finite_paths.bound_path(ref['path'], external_tool=role in approved_native_roles)
        need(sha(tool_path) == ref['sha256'], 'tool input hash mismatch: ' + role)
        if role in approved_native_roles:
            external_tool_paths.add(tool_path)

    def finite_capture_path(name):
        candidate = finite_paths.normalize(name).resolve(strict=True)
        return finite_paths.bound_path(name, external_tool=candidate in external_tool_paths)

    need(baseline['status'] == 'ROOT_AFTER226_THREE_TERMINAL_ACCEPTED'
         and [baseline[k] for k in ('owned_modules', 'declarations', 'distinct_constant_fullnames', 'original_receipts')] == [229, 6310, 6291, 161]
         and publication['status'] == 'ROOT_AFTER226_THREE_GITHUB_PUBLISHED_AND_REMOTE_BRANCH_VERIFIED'
         and publication['rootAcceptance'] == baseline_ref
         and (publication['owned_modules'], publication['complete_declaration_records'], publication['distinct_constant_fullnames'], publication['original_owned_receipts']) == (229, 6310, 6291, 161)
         and publication['pushed'] is True and publication['remote_branch_verified'] is True,
         'exact published ROOT229 baseline binding required')
    need(collector_peer['status'] == 'PASS_SOURCEONLY_AFTER229_THREE_RECORD_APPEND_V2_NARROW_STATIC_PEER'
         and collector_peer['reviewed_collector_sha256'] == COLLECTOR_SHA
         and reviewer_peer['status'] == 'STATIC_SOURCE_REVIEW_PASS_BOUNDED_NOT_EXECUTED_NOT_ROOT_ACCEPTANCE'
         and reviewer_peer['reviewed']['reviewer']['sha256'] == REVIEWER_SHA,
         'static source peer refs/status must match the reviewed candidates')
    need(intake['schema'] == 'after229-three-finite-record-append-draft-input-v1'
         and intake['targets'] == targets and set(intake['strict_producers']) == set(TARGET_MODULES)
         and intake['baseline_acceptance'] == baseline_ref and len(intake['audit_receipts']) == 1,
         'final intake exact target, baseline, and single audit triple')
    need(proposal['status'] == 'SOURCEONLY_RECORD_APPEND_PROPOSAL_REQUIRES_SEPARATE_TERMINAL_VERIFICATION'
         and proposal['complete_original_evidence_intake'] == intake_ref
         and proposal['baseline_acceptance'] == baseline_ref
         and proposal['collector_source']['sha256'] == COLLECTOR_SHA
         and local_path(proposal['collector_source']['path']) == local_path(COLLECTOR_REL)
         and proposal['root_acceptance'] is None and proposal['proof_credit'] == 0,
         'proposal source/intake/baseline/status binding')
    need(review['status'] == 'FINITE_RECORD_STAGE_TERMINAL_REVIEW_PASS_NOT_ROOT_ACCEPTANCE'
         and review['reviewed_collector_sha256'] == COLLECTOR_SHA
         and review['root_target_source_hashes'] == targets
         and review['root_acceptance'] is None and review['proof_credit'] == 0
         and review['main_1_plus_1_75'] == 'OPEN'
         and set(review['strict_producers']) == set(TARGET_MODULES)
         and all(status == 'PASS' for status in review['strict_producers'].values())
         and review['original_audit_groups'] == 1 and review['original_stock_replays'] == 3
         and review['original_ALL_stages'] == 1 and review['current_owned_module_slot_sets_rehashed'] == 232
         and review['external_closure_replayed'] is False and review['project_import_closure_replayed'] is False
         and review['unconditional_main_proved'] is False,
         'independent terminal review did not pass the exact final target batch')
    need(capture['status'] == 'ROOT_AFTER229_CURRENT_NORMAL_IMPORT_BINDINGS_CAPTURED'
         and capture['baseline_acceptance'] == baseline_ref and capture['baseline_publication'] == publication_ref
         and capture['collector'] == collector_ref and capture['collector_source_peer'] == collector_peer_ref
         and capture['terminal_reviewer_source'] == reviewer_source_ref
         and capture['terminal_reviewer_source_peer'] == reviewer_peer_ref
         and capture['intake'] == intake_ref and capture['proposal'] == proposal_ref
         and capture['terminal_review'] == review_ref and capture['terminal_review_cp'] == review_cp_ref
         and capture['target_source_sha256'] == targets and capture['currentOwnedModuleSlotSetsRehashed'] == 232,
         'finite capture refs/current-slot count do not bind final proposal and review')
    need(witness['status'] == 'ROOT_REPORTED_ACTUAL_TOOL_RESULTS_BOUND_TO_FINITE_PROPOSAL'
         and witness['intake'] == intake_ref and witness['proposal'] == proposal_ref
         and witness['collector'] == collector_ref and witness['terminal_review'] == review_ref
         and witness['terminal_review_cp'] == review_cp_ref
         and witness['normal_import_trust_capture'] == capture_ref
         and witness['target_source_sha256'] == targets
         and witness['actual_root_observations'] == capture['actual_root_observations'],
         'factual witness/capture/proposal references do not align')
    observations_ref = witness['actual_root_observations']
    observations = read(observations_ref)
    need(observations['schema'] == 'ROOT_AFTER229_ACTUAL_TOOL_OBSERVATIONS_V1'
         and observations['targets'] == targets and observations['status'] == 'ROOT_OBSERVED_ACTUAL_COMMAND_RESULTS'
         and witness['observed_tool_results'] == observations,
         'ROOT observation input lacks actual target/result binding')
    need(set(observations['strict_producers']) == set(targets), 'observation strict producer set mismatch')
    for module, obs in observations['strict_producers'].items():
        need(set(obs) == {'terminalChunk', 'exitCode', 'receipt', 'stdout'}
             and isinstance(obs['terminalChunk'], str) and obs['terminalChunk'].strip()
             and type(obs['exitCode']) is int and obs['exitCode'] == 0
             and obs['receipt'] == intake['strict_producers'][module]['receipt']
             and obs['stdout'] == intake['strict_producers'][module]['stdout'],
             'factual strict observation/ref mismatch')
    need(set(observations['original_stock_all']) == {'terminalChunk', 'exitCode', 'receipt'}
         and isinstance(observations['original_stock_all']['terminalChunk'], str)
         and observations['original_stock_all']['terminalChunk'].strip()
         and type(observations['original_stock_all']['exitCode']) is int
         and observations['original_stock_all']['exitCode'] == 0
         and observations['original_stock_all']['receipt'] == intake['audit_receipts'][0]['ref'],
         'factual stock+ALL observation/ref mismatch')
    need(set(observations['intake_constructor']) == {'terminalChunk', 'exitCode', 'output'}
         and isinstance(observations['intake_constructor']['terminalChunk'], str) and observations['intake_constructor']['terminalChunk'].strip()
         and type(observations['intake_constructor']['exitCode']) is int and observations['intake_constructor']['exitCode'] == 0
         and observations['intake_constructor']['output'] == intake_ref,
         'factual intake-constructor observation/ref mismatch')
    need(set(observations['record_collector']) == {'terminalChunk', 'exitCode', 'output'}
         and isinstance(observations['record_collector']['terminalChunk'], str) and observations['record_collector']['terminalChunk'].strip()
         and type(observations['record_collector']['exitCode']) is int and observations['record_collector']['exitCode'] == 0
         and observations['record_collector']['output'] == proposal_ref,
         'factual record-collector observation/ref mismatch')
    need(set(observations['terminal_reviewer']) == {'terminalChunk', 'exitCode', 'stdout', 'cp'}
         and isinstance(observations['terminal_reviewer']['terminalChunk'], str) and observations['terminal_reviewer']['terminalChunk'].strip()
         and type(observations['terminal_reviewer']['exitCode']) is int and observations['terminal_reviewer']['exitCode'] == 0
         and observations['terminal_reviewer']['stdout'] == review_ref
         and observations['terminal_reviewer']['cp'] == review_cp_ref,
         'factual terminal-review observation/ref mismatch')

    census = read(proposal['candidate_census'])
    rows = read(proposal['complete_declarations'])
    old_census = read(baseline['current_census'])
    old_rows = read(baseline['complete_declarations'])
    targets_set = set(targets)
    need(set(census['modules']) == set(old_census['modules']) | targets_set
         and len(census['modules']) == 232 and not targets_set & set(old_census['modules']),
         'exact append-only 229+3 module set required')
    need({m: v for m, v in census['modules'].items() if m not in targets_set} == old_census['modules']
         and [r for r in rows if r['module'] not in targets_set] == old_rows,
         'all old 229 census entries/6310 declaration records must deep-equal')
    new_rows = [r for r in rows if r['module'] in targets_set]
    new_counts = {m: sum(r['module'] == m for r in new_rows) for m in TARGET_MODULES}
    derived = review['artifact_derived_counts']
    need(all(count > 0 for count in new_counts.values())
         and new_counts == derived['new_records_by_module']
         and new_counts == capture['newRecordCountsByModule']
         and derived['owned_modules'] == len(census['modules'])
         and derived['declarations'] == len(rows)
         and derived['distinct_constant_fullnames'] == len({r['name'] for r in rows})
         and derived['new_record_delta'] == len(new_rows)
         and derived['old_entries_deep_equal'] is True and derived['old_records_deep_equal'] is True,
         'all new module counts/totals must be artifact-derived and match peer/capture artifacts')
    need(len(rows) == len(old_rows) + len(new_rows)
         and len({r['name'] for r in new_rows}) == len(new_rows)
         and not {r['name'] for r in old_rows} & {r['name'] for r in new_rows}
         and len({(r['module'], r['name']) for r in rows}) == len(rows),
         'new fullname collision/duplicate identity')
    for row in rows:
        need(isinstance(row['type'], str) and row['type'] and '\u22ef' not in row['type']
             and not row['type'].endswith('...')
             and all(row[k] is False for k in ('unsafe', 'partial', 'axiom'))
             and isinstance(row['axioms'], list) and set(row['axioms']) <= STD3,
             'type/safety/std3 guard on complete records')
    audit_ref = intake['audit_receipts'][0]['ref']
    audit = read(audit_ref)
    need(audit['status'] == 'PASS_OWNED_REPLAY_AND_COMPLETE_TYPES_AXIOMS'
         and audit['targets'] == targets and audit['declaration_counts'] == new_counts
         and audit['inputs_before'] == audit['inputs_after'], 'actual single stock+ALL audit does not match final records')
    stock_stages = [s for s in audit['stages'] if s['kind'] == 'stock_replay']
    full_stages = [s for s in audit['stages'] if s['kind'] == 'full_inventory_type_axioms']
    need(len(stock_stages) == 3 and len(full_stages) == 1
         and {s['module'] for s in stock_stages} == targets_set,
         'exact three stock and one ALL audit stages required')

    capture_files = capture['files']
    need(isinstance(capture_files, list) and capture['ownedModules'] == 232
         and capture['completeDeclarationRecords'] == len(rows)
         and capture['distinctConstantFullnames'] == len({r['name'] for r in rows}),
         'capture totals must match proposal artifacts dynamically')
    captured_paths = set()
    captured_hashes = {}
    for item in capture_files:
        need(isinstance(item, dict) and set(item) == {'path', 'sha256', 'bytes'},
             'finite capture file entry schema mismatch')
        bound_path = finite_capture_path(item['path'])
        need(item['bytes'] == bound_path.stat().st_size, 'capture file byte count mismatch')
        need(sha(bound_path) == item['sha256'], 'finite capture path SHA mismatch: ' + item['path'])
        need(bound_path not in captured_paths, 'duplicate finite capture path')
        captured_paths.add(bound_path)
        captured_hashes[bound_path] = item['sha256']
    need(capture['sourceAndObjectBeforeAfterHashesEqual'] is True
         and capture['allPresentAndAbsentObjectSlotsChecked'] is True
         and capture['external_closure_replayed'] is False
         and capture['project_import_closure_replayed'] is False
         and capture['trust_mode'] == 'NORMAL_IMPORTED_ENVIRONMENT_TRUST',
         'finite normal-import capture scope/slot flags mismatch')
    capture_pair = capture_ref
    witness_pair = witness_ref
    capture_builder_ref = pair(capture['capture_builder']['path'], capture['capture_builder']['sha256'])
    need(capture_builder_ref == capture['capture_builder']
         and local_path(capture_builder_ref['path']) == local_path(CAPTURE_BUILDER_REL)
         and capture_builder_ref['sha256'] == CAPTURE_BUILDER_SHA,
         'exact reviewed V2 capture builder reference required')
    review_path = bind(review_ref)
    reviewcp_path = bind(review_cp_ref)
    capture_path = bind(capture_pair)
    witness_path = bind(witness_pair)

    old_receipts = {str(local_path(entry['owned_receipt'])) for entry in old_census['modules'].values()}
    all_receipts = {str(local_path(entry['owned_receipt'])) for entry in census['modules'].values()}
    new_receipts = all_receipts - old_receipts
    need(len(old_receipts) == baseline['original_receipts']
         and len(all_receipts) == census['original_owned_receipts_rehashed'],
         'unique owned receipt path counts do not reconcile')
    historical_name_counts = collections.Counter(row['name'] for row in old_rows)
    added_fullnames = {row['name'] for row in new_rows}
    need(not set(historical_name_counts) & added_fullnames, 'new fullnames collide with historical fullnames')
    adoption_source_path = Path(__file__).resolve(strict=True)
    adoption_source_ref = pair(str(adoption_source_path), sha(adoption_source_path))
    for pinned_path, expected_sha in PINNED.items():
        need(sha(pinned_path) == expected_sha, 'ROOT input changed before adoption write: ' + str(pinned_path))
    for captured_path, expected_sha in captured_hashes.items():
        need(sha(captured_path) == expected_sha, 'finite capture file changed before adoption write: ' + str(captured_path))
    finite_paths.finish()
    output = ROOT / OUTPUT_REL
    need(output.resolve().parent == (ROOT / '.lake/proof-continuation/source-reviews').resolve()
         and not output.exists(), 'fresh exact ROOT after229 acceptance path required')
    result = {
        'status': 'ROOT_AFTER229_THREE_P3_TERMINAL_ACCEPTED',
        'created_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
        'previous_root_acceptance': baseline_ref,
        'collector_acceptance_proposal': proposal_ref,
        'current_census': proposal['candidate_census'],
        'complete_declarations': proposal['complete_declarations'],
        'complete_original_evidence_intake': intake_ref,
        'collector_source': collector_ref,
        'collector_source_peer': collector_peer_ref,
        'terminal_independent_review': review_ref,
        'terminal_independent_execution_cp': review_cp_ref,
        'terminal_independent_source_peer': reviewer_peer_ref,
        'normal_import_trust_capture': capture_ref,
        'finite_capture_source': capture_builder_ref,
        'execution_witness': witness_ref,
        'actual_root_observations': observations_ref,
        'root_adoption_source': adoption_source_ref,
        'actual_audits': {'next3': audit_ref},
        'strict_producers': intake['strict_producers'],
        'targets': targets,
        'owned_modules': len(census['modules']),
        'declarations': len(rows),
        'distinct_constant_fullnames': len({row['name'] for row in rows}),
        'original_receipts': len(all_receipts),
        'added_modules': len(targets),
        'added_complete_serialized_declarations': len(new_rows),
        'added_distinct_constant_fullnames': len(added_fullnames),
        'added_original_receipts': len(new_receipts),
        'actual_new_module_record_counts': dict(new_counts),
        'historical_duplicate_names': sum(1 for count in historical_name_counts.values() if count > 1),
        'historical_duplicate_record_excess': len(old_rows) - len(historical_name_counts),
        'new_fullname_collisions': 0,
        'stock_replays_passed': len(stock_stages),
        'all_inventory_modules': len(audit['declaration_counts']),
        'all_old_entries_and_records_deep_equal': True,
        'all_complete_types_safety_std3_and_current_slots_verified': True,
        'trust_mode': 'NORMAL_IMPORTED_ENVIRONMENT_TRUST',
        'scope': capture['scope'],
        'terminal_peer_scope': review['normal_import_trust_scope'],
        'terminal_peer_shared_gate_disclosed': review['collector_gate_reuse'],
        'external_closure_replayed': False,
        'project_import_closure_replayed': False,
        'unconditional_main_proved': False,
        'main_1_plus_1_75': 'OPEN',
        'weighted_estimate': 30,
    }
    with output.open('x', encoding='utf-8', newline='\n') as stream:
        json.dump(result, stream, indent=2, sort_keys=True)
        stream.write('\n')
    print(json.dumps({'status': result['status'], 'acceptance': {'path': OUTPUT_REL, 'sha256': sha(output)},
                      'owned_modules': result['owned_modules'], 'declarations': result['declarations'],
                      'distinct_constant_fullnames': result['distinct_constant_fullnames'],
                      'original_receipts': result['original_receipts']}, sort_keys=True))

if __name__ == '__main__':
    main()
