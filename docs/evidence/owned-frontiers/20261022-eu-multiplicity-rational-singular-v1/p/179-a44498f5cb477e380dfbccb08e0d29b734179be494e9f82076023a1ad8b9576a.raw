-def verify_census(reference):
-    """Portable independent verifier; no importing old top-level operator scripts."""
-    census = read(bound(reference))
-    require(census['status'] == 'ALL_CURRENT_OWNED_SOURCES_OBJECTS_COMPLETE_TYPES_AXIOMS_EXACT', 'Census status')
-    require(not census['external_closure_replayed'] and not census['unconditional_main_proved'], 'Census claims')
-    total, receipts = 0, set()
-    for module, entry in census['modules'].items():
-        require(sha(ROOT / (module.replace('.', '/') + '.lean')) == entry['source_sha256'], 'Census source')
-        rp = bound({'path': entry['owned_receipt'], 'sha256': entry['owned_receipt_sha256']})
-        receipt, records, _ = validate_records(rp, module, entry['source_sha256'], entry['object_parts'])
-        require(sha(rp.parent / 'declarations.json') == entry['declarations_json_sha256'], 'Census declaration hash')
-        require(len(records) == entry['complete_serialized_declarations'], 'Census complete count')
-        total += len(records)
-        receipts.add(str(rp.resolve()))
-    counts = {'owned_modules': len(census['modules']), 'declarations': total, 'original_receipts': len(receipts)}
-    require(counts == {'owned_modules': census['owned_modules'], 'declarations': census['complete_serialized_declarations'],
-        'original_receipts': census['original_owned_receipts_rehashed']}, 'Census totals')
-    return census, counts
-
-
-def written_names(module):
-    review = read(REVIEWS[module][0])
-    rows = review['all_written_types_and_proofs_reviewed'] if module.endswith('NormalizationGrowth') else review['declarations']
-    return {'ImbalancedChen.' + row['name'] for row in rows}
-
