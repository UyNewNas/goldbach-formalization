-def native_union_check(prepared_refs):
-    """Hash each root-bound native source and explicit five-slot path once.
-
-    Checks the UNION of all three graphs at EVERY stage boundary; no counts or
-    slots are sampled. Root-bound capture references retain the complete maps.
-    """
-    expected, absent_sources = {}, set()
-
-    def add(value, digest):
-        key = str(path(value))
-        require(key not in expected or expected[key] == digest, 'Conflicting native bindings')
-        expected[key] = digest
-
-    for module, reference in prepared_refs.items():
-        require(module in TARGETS, 'Foreign preparation target')
-        stable = read(bound(reference))['stable_inputs']
-        for row in stable['foreign_graph'].values():
-            if row['source_path'] is not None:
-                add(row['source_path'], row['source_sha256'])
-            else:
-                absent_sources.update(row['absent_source_candidates'])
-            stem = row['object_path'][:-len('.olean')]
-            require(set(row['all_five_slots']) == set(PARTS), 'Incomplete slot keys')
-            for suffix, digest in row['all_five_slots'].items():
-                add(stem + suffix, digest)
-        for name, digest in stable['native_bins'].items():
-            add('/home/slava/codex-lean-ve/lean-4.33.0-rc1-linux/bin/' + name, digest)
-        registry = stable['registry']
-        add(STATE / 'verified-remote-producers.json', registry['sha256'] if registry else None)
-        old = stable['old_cache']
-        add(ROOT.parent / 'goldbach-integration/.lake/takeover-p0/cache' / (module + '.json'), old['sha256'] if old else None)
-        stem = str(ROOT.parent / 'goldbach-integration/.lake/takeover-p0/direct/lib/lean' / module.replace('.', '/'))
-        for suffix, digest in stable['old_object_all_five_slots'].items():
-            add(stem + suffix, digest)
-    for value in absent_sources:
-        require(not path(value).is_file(), 'Previously unresolved native source appeared')
-    for value, digest in expected.items():
-        p = path(value)
-        require((sha(p) if p.is_file() else None) == digest, 'Native/old/registry input changed: ' + value)
-    encoded = json.dumps({'paths': expected, 'absent_sources': sorted(absent_sources)}, sort_keys=True).encode()
-    return {'status': 'ALL_NATIVE_SOURCES_FIVE_SLOTS_EXACT', 'map_sha256': hashlib.sha256(encoded).hexdigest(),
-        'prepared': prepared_refs, 'paths_checked': len(expected), 'absent_source_paths_checked': len(absent_sources)}
-
-
-def validate_records(receipt_path, module, expected_source, expected_parts=None):
-    """Independent complete receipt validation, matching original verifier checks."""
-    rp = path(receipt_path)
-    receipt = read(rp)
-    require(receipt['status'] == 'PASS_OWNED_REPLAY_AND_COMPLETE_TYPES_AXIOMS', 'Owned replay failed')
-    require(receipt['inputs_before'] == receipt['inputs_after'], 'Owned inputs changed')
-    require(not receipt['external_closure_replay_claimed'] and not receipt['unconditional_main_claimed'], 'Inflated claim')
-    require(receipt['targets'][module] == expected_source, 'Owned source mismatch')
-    pieces = receipt['inputs_before']['owned_object_parts'][module]
-    if expected_parts is not None:
-        require(pieces == expected_parts, 'Owned/strict objects differ')
-    require(pieces == {k: v for k, v in all_slots(STATE / 'lib/lean' / (module.replace('.', '/') + '.olean')).items() if v is not None}, 'Current owned objects changed')
-    inventory_stages = [s for s in receipt['stages'] if s['kind'] == 'full_inventory_type_axioms']
-    require(len(inventory_stages) == 1 and inventory_stages[0]['exit_code'] == 0, 'Incomplete type stage')
-    require(sha(rp.parent / 'declarations.log') == inventory_stages[0]['log_sha256'], 'Inventory log hash')
-    inventories, emitted = {}, {}
-    for line in (rp.parent / 'declarations.log').read_text().splitlines():
-        if line.startswith('P0_QUEUE_INVENTORY '):
-            item = json.loads(line.split(' ', 1)[1])
-            require(item['module'] not in inventories, 'Duplicate inventory')
-            inventories[item['module']] = item
-        if line.startswith('P0_QUEUE_DECL '):
-            item = json.loads(line.split(' ', 1)[1])
-            require(item['name'] not in emitted, 'Duplicate emitted name')
-            emitted[item['name']] = item
-    records_all = read(rp.parent / 'declarations.json')
-    require(len(records_all) == len(emitted), 'Emitted/JSON record count differs')
-    require({r['name']: r for r in records_all} == emitted, 'Emitted/JSON records differ')
-    records = [row for row in records_all if row['module'] == module]
-    names = [row['name'] for row in records]
-    require(len(names) == len(set(names)) > 0, 'Duplicate/empty records')
-    require(len(records) == receipt['declaration_counts'][module], 'Declaration count differs')
-    for row in records:
-        require(row['type'] and '⋯' not in row['type'], 'Truncated type')
-        require(not (row['unsafe'] or row['partial'] or row['axiom']), 'Unsafe/partial/axiom')
-        require(set(row['axioms']) <= AXIOMS, 'Forbidden axiom')
-    inv = inventories[module]
-    require(len(inv['serialized']) == len(set(inv['serialized'])) == len(names), 'Serialized duplicate/count')
-    require(len(inv['environment']) == len(set(inv['environment'])) == len(names), 'Environment duplicate/count')
-    require(set(names) == set(inv['serialized']) == set(inv['environment']), 'Complete inventory mismatch')
-    stocks = [s for s in receipt['stages'] if s['kind'] == 'stock_replay' and s['module'] == module]
-    require(len(stocks) == 1, 'Stock invocation count')
-    stock = stocks[0]['result']
-    require(stock['status'] == 'PASS' and stock['returncode'] == 0, 'Stock failed')
-    require(sha(rp.parent / ('replay-' + module + '.log')) == stock['log_sha256'], 'Stock log hash')
-    return receipt, records, inv
-
