-
-def require(condition, message):
-    if not condition:
-        raise ValueError(message)
-
-
-def now():
-    return datetime.datetime.now(datetime.timezone.utc).isoformat()
-
-
-def path(value):
-    value = str(value).replace('\\', '/')
-    if os.name == 'nt' and value.startswith('/mnt/') and len(value) > 7:
-        value = value[5].upper() + ':/' + value[7:]
-    elif os.name != 'nt' and len(value) >= 3 and value[0].isascii() and value[0].isalpha() and value[1:3] == ':/':
-        value = '/mnt/' + value[0].lower() + '/' + value[3:]
-    p = Path(value)
-    if p.is_absolute():
-        return p
-    return (ROOT if value.startswith('.lake/') else STATE) / p
-
-
-def sha(value):
-    with path(value).open('rb') as stream:
-        return hashlib.file_digest(stream, 'sha256').hexdigest()
-
-
-def read(value):
-    return json.loads(path(value).read_text(encoding='utf-8'))
-
-
-def ref(value):
-    p = path(value).resolve()
-    return {'path': str(p), 'sha256': sha(p)}
-
-
-def bound(reference):
-    require(isinstance(reference, dict) and set(reference) == {'path', 'sha256'}, 'Exact path+SHA reference required')
-    require(sha(reference['path']) == reference['sha256'], 'Hash mismatch: ' + str(reference['path']))
-    return path(reference['path'])
-
-
-def write_new(value, data):
-    p = path(value)
-    p.parent.mkdir(parents=True, exist_ok=True)
-    with p.open('x', encoding='utf-8', newline='\n') as stream:
-        stream.write(json.dumps(data, indent=2, ensure_ascii=False) + '\n')
-    return ref(p)
-
-
-def load(name, value):
-    spec = importlib.util.spec_from_file_location(name, path(value))
-    module = importlib.util.module_from_spec(spec)
-    spec.loader.exec_module(module)
-    return module
-
-
-def protected():
-    for name, digest in PROTECTED.items():
-        require(sha(name) == digest, 'Canonical tool changed: ' + name)
-    for name, (review, digest) in REVIEWS.items():
-        require(sha(review) == digest, 'Source review changed: ' + name)
-        require(sha(ROOT / (name.replace('.', '/') + '.lean')) == TARGETS[name], 'Target source changed')
-
-
-def all_slots(obj):
-    stem = str(obj)[:-len('.olean')]
-    return {suffix: sha(stem + suffix) if Path(stem + suffix).is_file() else None for suffix in PARTS}
-
-
-def artifacts():
-    files = list((STATE / 'cache').glob('*.json'))
-    files += [p for p in (STATE / 'lib/lean').rglob('*') if p.is_file()]
-    return {p.relative_to(STATE).as_posix(): sha(p) for p in sorted(files)}
-
-
-def frozen_sources():
-    files = sorted((ROOT / 'ImbalancedChen').rglob('*.lean'))
-    require(len(files) == 562, 'Actual source path inventory changed')
-    return {p.relative_to(ROOT).as_posix(): sha(p) for p in files}
-
-
-def unchanged_non_target(before, after, target=None):
-    allowed = set()
-    if target:
-        stem = 'lib/lean/' + target.replace('.', '/')
-        allowed = {'cache/' + target + '.json'} | {stem + suffix for suffix in PARTS}
-    require({p: h for p, h in before.items() if p not in allowed} ==
-            {p: h for p, h in after.items() if p not in allowed}, 'Non-active-target cache/object mutation')
-
-
-def physical_idle():
-    lock = Path('/mnt/e/timot/Documents/FilesForGPT/Myath/goldbach-integration/.lake/takeover-p0/locks/compiler-0.lock')
-    st = lock.stat()
-    identity = f'{os.major(st.st_dev):02x}:{os.minor(st.st_dev):02x}:{st.st_ino}'
-    processes = []
-    for proc in Path('/proc').iterdir():
-        if not proc.name.isdigit():
-            continue
-        try:
-            exe = (proc / 'exe').resolve()
-            if exe.name in ('lean', 'lean.real', 'leanchecker', 'lake'):
-                processes.append({'pid': int(proc.name), 'exe': str(exe),
-                    'cmdline': (proc / 'cmdline').read_bytes().replace(b'\0', b' ').decode(errors='replace')})
-        except (FileNotFoundError, ProcessLookupError):
-            continue
-    locks = [line for line in Path('/proc/locks').read_text().splitlines() if identity in line]
-    require(not processes and not locks, 'Heavy slot not physically idle')
-    return {'observed_utc': now(), 'original_lock_path': str(lock),
-        'original_lock_identity': [os.major(st.st_dev), os.minor(st.st_dev), st.st_ino],
-        'compiler_processes': processes, 'matching_proc_locks': locks, 'no_lock_acquired': True}
-
