+def decompressed_tar_fingerprint(path, compression):
+    require(compression in {'gz', 'xz'}, 'Unsupported retained tar compression')
+    opener = gzip.open if compression == 'gz' else lzma.open
+    h = hashlib.sha256(); size = 0
+    with opener(path, 'rb') as source:
+        for data in iter(lambda: source.read(1048576), b''):
+            h.update(data); size += len(data)
+    return {'bytes': size, 'sha256': h.hexdigest()}
+
+def recompress_gzip_tar_to_xz(source_path, destination_path):
+    # Copy the decompressed tar stream itself, including headers and padding.
+    # No tar members or package metadata are regenerated here.
+    h = hashlib.sha256(); size = 0
+    with gzip.open(source_path, 'rb') as source:
+        with lzma.open(destination_path, 'xb', format=lzma.FORMAT_XZ,
+                       check=lzma.CHECK_CRC64, preset=XZ_PRESET) as destination:
+            for data in iter(lambda: source.read(1048576), b''):
+                h.update(data); size += len(data); destination.write(data)
+    tar = {'bytes': size, 'sha256': h.hexdigest()}
+    require(decompressed_tar_fingerprint(destination_path, 'xz') == tar,
+            'XZ round trip differs from the original gzip tar bytes')
+    return {'path': str(destination_path), 'bytes': Path(destination_path).stat().st_size,
+            'sha256': digest(destination_path), 'compression': 'xz',
+            'preset': XZ_PRESET, 'check': 'CRC64', 'tar': tar,
+            'lossless_tar_recompression_verified': True}
+
