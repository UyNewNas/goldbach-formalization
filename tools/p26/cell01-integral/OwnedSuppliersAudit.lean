      `ImbalancedChen.P2OriginalSaving19MomentParseDecodeBridge] do
    let some idx := env.getModuleIdx? moduleName | throwError "Missing target module"
    let names := byModule[idx.toNat]!
    let mut serialized : Array Name := #[]
    let mut serializedData : ModuleData := default
    let mut found := false
    for i in List.range env.header.modules.size do
      let imported := env.header.modules[i]!
      if imported.module == moduleName then
        if found then throwError "Duplicate module"
        found := true
        let data := env.header.moduleData[i]!
        if data.isModule || !imported.importAll || !imported.hasData then
          throwError "Incomplete imported legacy data"
        serialized := data.constNames
        serializedData := data
    unless found && serializedData.constants.map ConstantInfo.name == serialized do
      throwError "Incomplete serialized declaration data for {moduleName}"
    let shared := serialized.filter fun n => !names.contains n
    unless names.qsort Name.lt == (serialized.filter fun n => !shared.contains n).qsort Name.lt do
      throwError "Complete serialized/environment inventory mismatch for {moduleName}"
    for name in shared do
      let some raw := serializedData.constants.find? (fun ci => ci.name == name)
        | throwError "Missing serialized shared declaration {name}"
      let some actual := env.find? name | throwError "Missing canonical shared declaration {name}"
      let some ownerIdx := env.getModuleIdxFor? name | throwError "Missing canonical owner {name}"
      let owner := env.header.moduleNames[ownerIdx.toNat]!
      unless owner != moduleName && (`ImbalancedChen).isPrefixOf owner do
        throwError "Unexpected shared owner for {name}"
      let (.thmInfo original, .thmInfo canonical) := (raw, actual)
        | throwError "Only shared theorems are permitted: {name}"
      unless original.name == canonical.name && original.type == canonical.type &&
          original.levelParams == canonical.levelParams && original.all == canonical.all do
        throwError "Shared theorem metadata differs: {name}"
      let aliasName := Name.str `p26Cell01SharedProofBodyCheck (moduleName.toString ++ "::" ++ name.toString)
      unless (env.toKernelEnv.find? aliasName).isNone do throwError "Non-fresh check name"
      let declaration := Declaration.thmDecl { original with name := aliasName, all := [aliasName] }
      let checked ← match env.toKernelEnv.addDeclCore 0 0 declaration (cancelTk? := none) with
        | .ok checked => pure checked
        | .error ex => throwError "Shared proof kernel rejection: {← ex.toMessageData {} |>.toString}"
      unless (checked.find? aliasName).isSome do throwError "Missing checked shared proof"
      let axioms ← withEnv (Environment.ofKernelEnv checked) (collectAxioms aliasName)
      for ax in axioms do
        unless #[`propext, `Classical.choice, `Quot.sound].contains ax do
          throwError "Forbidden shared-proof axiom {ax}"
      let type ← liftTermElabM do return (← Meta.ppExpr raw.type).pretty
      if type.contains '⋯' then throwError "Truncated shared type"
      let record := Json.mkObj [("name", toJson name.toString), ("module", toJson moduleName.toString),
        ("canonical_module", toJson owner.toString), ("type", toJson type),
        ("identical_body", toJson (original.value == canonical.value)),
        ("identical_metadata", toJson true), ("proof_body_kernel_checked", toJson true),
        ("unsafe", toJson raw.isUnsafe), ("partial", toJson raw.isPartial),
        ("axiom", toJson raw.isAxiom), ("axioms", toJson (axioms.map Name.toString))]
      liftIO <| IO.println s!"P26_CELL01_SUPPLIER_AUDIT_SHARED {record.compress}"
    liftIO <| IO.println s!"P26_CELL01_SUPPLIER_AUDIT_INVENTORY {(Json.mkObj [("module", toJson moduleName.toString), ("serialized", toJson (serialized.map Name.toString)), ("environment", toJson (names.map Name.toString)), ("shared", toJson (shared.map Name.toString))]).compress}"
    for name in names.qsort Name.lt do
      let some info := env.find? name | throwError "Missing inventoried declaration"
      if info.isUnsafe || info.isPartial || info.isAxiom then
        throwError "Unsafe/partial/axiom target {name}"
      let axioms ← collectAxioms name
      for ax in axioms do
        unless #[`propext, `Classical.choice, `Quot.sound].contains ax do
          throwError "Forbidden transitive axiom {ax} in {name}"
      let type ← liftTermElabM do return (← Meta.ppExpr info.type).pretty
      if type.contains '⋯' then throwError "Truncated type"
      let record := Json.mkObj [("name", toJson name.toString),
        ("module", toJson moduleName.toString), ("type", toJson type),
        ("unsafe", toJson info.isUnsafe), ("partial", toJson info.isPartial),
        ("axiom", toJson info.isAxiom), ("axioms", toJson (axioms.map Name.toString))]
      liftIO <| IO.println s!"P26_CELL01_SUPPLIER_AUDIT_DECL {record.compress}"
    liftIO <| IO.println s!"P26_CELL01_SUPPLIER_AUDIT_COMPLETE {(Json.mkObj [("module", toJson moduleName.toString), ("count", toJson names.size), ("shared_count", toJson shared.size), ("serialized_count", toJson serialized.size)]).compress}"
