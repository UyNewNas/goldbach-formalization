/-- Exact transport from the bounded selectors to the original raw lookup. -/
theorem all_raw_row_data_checks (r : Fin 144) :
    RowDataChecksFor
      (fun (i : Fin 9) (j : Fin 8) =>
        ((concreteGeometry01.vertices[
          (concreteGeometry01.rows[r.val]!).vertexIds[i.val]!]!)[j.val]!))
      (concreteGeometry01.rows[r.val]!) := by
  have hv :
      (fun (i : Fin 9) (j : Fin 8) =>
        ((concreteGeometry01.vertices[
          (concreteGeometry01.rows[r.val]!).vertexIds[i.val]!]!)[j.val]!)) =
      boundedRowVertex r := by
    funext i j
    exact raw_vertex_no_fallback r i j
  rw [hv, row_lookup_no_fallback r]
  exact all_bounded_row_data_checks r

