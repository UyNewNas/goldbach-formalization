+def bind_recorded_runtime(command, run):
+    need(command.cache_root == run['cache_root'], 'MCP supplier cache differs')
+    need(command.wall_seconds == run['wall_limit_seconds']
+         and command.rss_gib * 1024**3 == run['rss_limit_bytes']
