theorem crossing_v_peak :
    crossing.lx + crossing.ly < 25/128 ∧ 25/128 < crossing.ux + crossing.uy := by norm_num

theorem crossing_bounds : crossing.lower = 3777/6400 ∧ crossing.upper = 153/256 := by norm_num

theorem crossing_nonempty : ∃ x y z : ℝ, crossing.ValidPoint x y z :=
  (RationalBox.feasible_iff crossing).mp (by norm_num)

theorem crossing_strict_check : crossing.marginCheck (1/10) = true := by norm_num

theorem crossing_whole_box_margin :
    ∀ x y z : ℝ, crossing.ValidPoint x y z → 0 < original x y z - 3*x - (1/10 : ℚ) :=
  (RationalBox.marginCheck_sound crossing_strict_check).2

theorem sorting_box_crosses_plane :
    sortingCrossing.lx < sortingCrossing.uy ∧ sortingCrossing.ly < sortingCrossing.ux := by norm_num

theorem sorting_bounds :
    sortingCrossing.lower = 3777/6400 ∧ sortingCrossing.upper = 3801/6400 := by norm_num

theorem sorting_nonempty : ∃ x y z : ℝ, sortingCrossing.ValidPoint x y z :=
  (RationalBox.feasible_iff sortingCrossing).mp (by norm_num)

theorem zero_z_bounds : zeroZ.lower = 153/256 ∧ zeroZ.upper = 153/256 := by norm_num

theorem zero_z_nonempty : ∃ x y z : ℝ, zeroZ.ValidPoint x y z :=
  (RationalBox.feasible_iff zeroZ).mp (by norm_num)

theorem zero_width_at_sorting_boundary :
    diagonalPoint.width = 0 ∧ diagonalPoint.lower = 153/256 ∧
    diagonalPoint.upper = 153/256 ∧ diagonalPoint.feasible = true := by norm_num

theorem zero_width_strict_margin_passes : diagonalPoint.marginCheck (1/256) = true := by norm_num

theorem strict_equality_rejected : diagonalPoint.marginCheck (3/256) = false := by norm_num

theorem empty_well_formed : emptyOrdered.WellFormed := by norm_num [RationalBox.WellFormed]

theorem empty_has_positive_raw_test : 0 < emptyOrdered.lower - 3*emptyOrdered.ux := by norm_num

theorem empty_rejected : emptyOrdered.feasible = false ∧ emptyOrdered.marginCheck 0 = false := by norm_num

theorem empty_has_no_ordered_point : ¬ ∃ x y z : ℝ, emptyOrdered.ValidPoint x y z := by
  intro h
  have hf := (RationalBox.feasible_iff emptyOrdered).mpr h
  have he : emptyOrdered.feasible = false := by norm_num
  rw [he] at hf
  contradiction

theorem reversed_rejected :
    reversedEndpoints.feasible = false ∧ reversedEndpoints.marginCheck 0 = false := by norm_num

