TAKEOVER_P4_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.ActualUpperCountingInputs","name":"ImbalancedChen.attachedUpperCoefficient_majorant","type":"∀ {nu r epsilon : ℝ},\n  0 < nu →\n    0 < epsilon →\n      epsilon ≤ 1 →\n        epsilon ^ 2 ≤ r →\n          ∀ (retain : ℕ → List ℕ → Bool) (cap : ℕ → ℕ) {N : ℕ},\n            2 ≤ N →\n              ↑N ^ (nu * r) ≤ ↑(cap N) →\n                ∀ (n : ℕ),\n                  (if n.Coprime (ImbalancedChen.sieveProduct N ⌈↑N ^ (nu * r)⌉₊) then 1 else 0) ≤\n                    ImbalancedChen.physicalDivisorSum (ImbalancedChen.attachedUpperModuli nu r epsilon retain cap N)\n                      (ImbalancedChen.attachedUpperCoefficient nu r epsilon retain cap N) n"}
TAKEOVER_P4_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"ImbalancedChen.ActualUpperCountingInputs","name":"ImbalancedChen.attachedUpperModuli","type":"ℝ → ℝ → ℝ → (ℕ → List ℕ → Bool) → (ℕ → ℕ) → ℕ → Finset ℕ"}
TAKEOVER_P4_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.ActualUpperCountingInputs","name":"ImbalancedChen.eventually_RealB_le_currentK_log_of_actual_density_distribution","type":"∀ {b kappa nu r : ℝ},\n  0 < b →\n    b < 1 →\n      0 < kappa →\n        0 < nu →\n          0 < r →\n            nu * r < 1 →\n              nu * r < (1 - kappa) * (b / (1 + b)) →\n                ∀ (epsilon : ℝ → ℝ) (retain : ℝ → ℕ → List ℕ → Bool) (cap : ℝ → ℕ → ℕ),\n                  (∀ (delta : ℝ), 0 < delta → 0 < epsilon delta ∧ epsilon delta ≤ 1 ∧ epsilon delta ^ 2 ≤ r) →\n                    (∀ (delta : ℝ), 0 < delta → ∀ᶠ (N : ℕ) in Filter.atTop, ↑N ^ (nu * r) ≤ ↑(cap delta N)) →\n                      (∀ (delta : ℝ),\n                          0 < delta →\n                            ∀ᶠ (N : ℕ) in Filter.atTop,\n                              Even N →\n                                ImbalancedChen.physicalDensitySum\n                                    (ImbalancedChen.attachedUpperModuli nu r (epsilon delta) (retain delta) (cap delta)\n                                      N)\n                                    (ImbalancedChen.attachedUpperCoefficient nu r (epsilon delta) (retain delta)\n                                      (cap delta) N) ≤\n                                  (ImbalancedChen.currentK + delta) * (ImbalancedChen.singularSeries N / Real.log ↑N)) →\n                        (∀ (delta : ℝ),\n                            0 < delta →\n                              ∀ᶠ (N : ℕ) in Filter.atTop,\n                                Even N →\n                                  |ImbalancedChen.realPhysicalDistributionError b N\n                                        (ImbalancedChen.manuscriptHalfProductCutoff kappa N)\n                                        (ImbalancedChen.attachedUpperModuli nu r (epsilon delta) (retain delta)\n                                          (cap delta) N)\n                                        (ImbalancedChen.attachedUpperCoefficient nu r (epsilon delta) (retain delta)\n                                          (cap delta) N)| ≤\n                                    delta * ImbalancedChen.singularNormalization N) →\n                          ∀ (tolerance : ℝ),\n                            0 < tolerance →\n                              ∀ᶠ (N : ℕ) in Filter.atTop,\n                                Even N →\n                                  ↑(ImbalancedChen.RealB b N) ≤\n                                    (ImbalancedChen.currentK * Real.log (1 / b) + tolerance) *\n                                      ImbalancedChen.singularNormalization N"}
TAKEOVER_P4_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.ActualUpperCountingInputs","name":"ImbalancedChen.eventually_attachedUpper_coprimeCorrection_eq_zero","type":"∀ {b kappa nu r epsilon : ℝ},\n  0 < b →\n    0 < nu →\n      0 ≤ r →\n        epsilon ^ 2 ≤ r →\n          nu * r < (1 - kappa) * (b / (1 + b)) →\n            ∀ (retain : ℕ → List ℕ → Bool) (cap : ℕ → ℕ),\n              ∀ᶠ (N : ℕ) in Filter.atTop,\n                ImbalancedChen.realPhysicalCoprimeCorrection b N (ImbalancedChen.manuscriptHalfProductCutoff kappa N)\n                    (ImbalancedChen.attachedUpperModuli nu r epsilon retain cap N)\n                    (ImbalancedChen.attachedUpperCoefficient nu r epsilon retain cap N) =\n                  0"}
TAKEOVER_P4_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.ActualUpperCountingInputs","name":"ImbalancedChen.eventually_manuscript_sieve_gate","type":"∀ {b kappa theta : ℝ},\n  0 < b →\n    0 ≤ theta →\n      theta < (1 - kappa) * (b / (1 + b)) →\n        ∀ᶠ (N : ℕ) in Filter.atTop,\n          0 < ImbalancedChen.manuscriptHalfProductCutoff kappa N ∧\n            ↑⌈↑N ^ theta⌉₊ ≤ ImbalancedChen.manuscriptHalfProductCutoff kappa N ^ (b / (1 + b))"}
TAKEOVER_P4_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.ActualCompilerDensityReserve","name":"ImbalancedChen.exists_actualCompiledRho_density_budget","type":"∃ B,\n  0 < B ∧\n    ∀ (nu : ℝ),\n      0 < nu →\n        ∀ (epsilon : ℝ),\n          0 < epsilon →\n            epsilon < 1 / 8 →\n              ∃ N₀,\n                2 ≤ N₀ ∧\n                  ∀ (N : ℕ),\n                    N₀ ≤ N →\n                      Even N →\n                        ∀ (cap : ℕ),\n                          ↑N ^ (nu * epsilon ^ 2) ≤ ↑cap →\n                            ∀ (rough : Finset ℕ),\n                              (∀ d ∈ rough, ImbalancedChen.RoughPrimeSupportedAt (↑N ^ (nu * epsilon ^ 2)) d) →\n                                ∀ (compiled raw : ℕ → ℝ) (rawBound reserve : ℝ),\n                                  have w := ↑N ^ (nu * epsilon ^ 2);\n                                  have L := ↑N ^ (nu * epsilon);\n                                  have small := ImbalancedChen.actualSmallRosserSupport N cap w;\n                                  have density := fun c =>\n                                    ImbalancedChen.physicalDensitySum (ImbalancedChen.smallRoughModuli small rough)\n                                      (ImbalancedChen.smallRoughRho small rough c\n                                        (ImbalancedChen.actualSmallRosserMinus N cap w L)\n                                        (ImbalancedChen.actualSmallRosserPlus N cap w L));\n                                  density raw ≤ rawBound * (ImbalancedChen.singularSeries N / Real.log ↑N) →\n                                    (ImbalancedChen.reciprocalTotientDensity rough fun d => |compiled d - raw d|) ≤\n                                        reserve * (nu * epsilon ^ 2) / B →\n                                      rawBound + reserve ≤ ImbalancedChen.currentK →\n                                        density compiled ≤\n                                          ImbalancedChen.currentK * (ImbalancedChen.singularSeries N / Real.log ↑N)"}
TAKEOVER_P4_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.ActualCompilerDensityReserve","name":"ImbalancedChen.exists_actualCompiledRho_density_difference_bound","type":"∃ C K,\n  0 < C ∧\n    1 < K ∧\n      ∀ (epsilon : ℝ),\n        0 < epsilon →\n          epsilon < 1 / 8 →\n            ∃ D₀,\n              2 ≤ D₀ ∧\n                ∀ (D : ℝ),\n                  D₀ ≤ D →\n                    ∀ (N cap : ℕ),\n                      Even N →\n                        ∀ (rough : Finset ℕ),\n                          (∀ d ∈ rough, ImbalancedChen.RoughPrimeSupportedAt (D ^ epsilon ^ 2) d) →\n                            ∀ (compiled raw : ℕ → ℝ),\n                              have w := D ^ epsilon ^ 2;\n                              have L := D ^ epsilon;\n                              have small := ImbalancedChen.actualSmallRosserSupport N cap w;\n                              have density := fun c =>\n                                ImbalancedChen.physicalDensitySum (ImbalancedChen.smallRoughModuli small rough)\n                                  (ImbalancedChen.smallRoughRho small rough c\n                                    (ImbalancedChen.actualSmallRosserMinus N cap w L)\n                                    (ImbalancedChen.actualSmallRosserPlus N cap w L));\n                              |density compiled - density raw| ≤\n                                ImbalancedChen.actualSmallEulerProduct N cap w *\n                                    (1 + ImbalancedChen.actualSmallRosserDensityError C K D epsilon) *\n                                  ImbalancedChen.reciprocalTotientDensity rough fun d => |compiled d - raw d|"}
TAKEOVER_P4_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.ActualCompilerDensityReserve","name":"ImbalancedChen.exists_actualCompiledRho_normalized_density_difference_bound","type":"∃ B,\n  0 < B ∧\n    ∀ (epsilon : ℝ),\n      0 < epsilon →\n        epsilon < 1 / 8 →\n          ∃ D₀,\n            2 ≤ D₀ ∧\n              ∀ (D : ℝ),\n                D₀ ≤ D →\n                  ∀ (N cap : ℕ),\n                    0 < N →\n                      Even N →\n                        D ^ epsilon ^ 2 ≤ ↑cap →\n                          ∀ (rough : Finset ℕ),\n                            (∀ d ∈ rough, ImbalancedChen.RoughPrimeSupportedAt (D ^ epsilon ^ 2) d) →\n                              ∀ (compiled raw : ℕ → ℝ),\n                                have w := D ^ epsilon ^ 2;\n                                have L := D ^ epsilon;\n                                have small := ImbalancedChen.actualSmallRosserSupport N cap w;\n                                have density := fun c =>\n                                  ImbalancedChen.physicalDensitySum (ImbalancedChen.smallRoughModuli small rough)\n                                    (ImbalancedChen.smallRoughRho small rough c\n                                      (ImbalancedChen.actualSmallRosserMinus N cap w L)\n                                      (ImbalancedChen.actualSmallRosserPlus N cap w L));\n                                |density compiled - density raw| ≤\n                                  (B / epsilon ^ 2 *\n                                      ImbalancedChen.reciprocalTotientDensity rough fun d => |compiled d - raw d|) *\n                                    (ImbalancedChen.singularSeries N / Real.log D)"}
TAKEOVER_P4_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.ActualCompilerDensityReserve","name":"ImbalancedChen.exists_actualCompiledRho_target_density_difference_bound","type":"∃ B,\n  0 < B ∧\n    ∀ (nu : ℝ),\n      0 < nu →\n        ∀ (epsilon : ℝ),\n          0 < epsilon →\n            epsilon < 1 / 8 →\n              ∃ N₀,\n                2 ≤ N₀ ∧\n                  ∀ (N : ℕ),\n                    N₀ ≤ N →\n                      Even N →\n                        ∀ (cap : ℕ),\n                          ↑N ^ (nu * epsilon ^ 2) ≤ ↑cap →\n                            ∀ (rough : Finset ℕ),\n                              (∀ d ∈ rough, ImbalancedChen.RoughPrimeSupportedAt (↑N ^ (nu * epsilon ^ 2)) d) →\n                                ∀ (compiled raw : ℕ → ℝ),\n                                  have w := ↑N ^ (nu * epsilon ^ 2);\n                                  have L := ↑N ^ (nu * epsilon);\n                                  have small := ImbalancedChen.actualSmallRosserSupport N cap w;\n                                  have density := fun c =>\n                                    ImbalancedChen.physicalDensitySum (ImbalancedChen.smallRoughModuli small rough)\n                                      (ImbalancedChen.smallRoughRho small rough c\n                                        (ImbalancedChen.actualSmallRosserMinus N cap w L)\n                                        (ImbalancedChen.actualSmallRosserPlus N cap w L));\n                                  |density compiled - density raw| ≤\n                                    (B / (nu * epsilon ^ 2) *\n                                        ImbalancedChen.reciprocalTotientDensity rough fun d => |compiled d - raw d|) *\n                                      (ImbalancedChen.singularSeries N / Real.log ↑N)"}
TAKEOVER_P4_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.ActualCompilerDensityReserve","name":"_private.ImbalancedChen.ActualCompilerDensityReserve.0.ImbalancedChen.abs_slopes_le_of_density_sandwich","type":"∀ {V E lo hi : ℝ},\n  0 ≤ V → 0 ≤ E → V * (1 - E) ≤ lo → lo ≤ V → V ≤ hi → hi ≤ V * (1 + E) → |lo| ≤ V * (1 + E) ∧ |hi| ≤ V * (1 + E)"}
