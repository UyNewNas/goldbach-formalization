      "name": "DirichletCharacter.lFunction_entire_of_ne_one",
      "type": "∀ {q : ℕ} [inst : NeZero q] {χ : DirichletCharacter ℂ q}, χ ≠ 1 → Differentiable ℂ (DirichletCharacter.LFunction χ)",
