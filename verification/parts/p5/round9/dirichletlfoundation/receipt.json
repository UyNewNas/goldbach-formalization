      "type": "∀ {q : ℕ} [inst : NeZero q] {χ : DirichletCharacter ℂ q},\n  χ ≠ 1 → Differentiable ℂ (DirichletCharacter.completedLFunction χ)",
      "type_status": "COMPILER_CONFIRMED_FROM_ELABORATED_ENVIRONMENT"
    },
    {
      "name": "DirichletCharacter.LSeries_twist_vonMangoldt_eq_neg_logDeriv_LFunction",
      "type": "∀ {q : ℕ} [inst : NeZero q] (χ : DirichletCharacter ℂ q) {s : ℂ},\n  1 < s.re →\n    LSeries ((fun n => χ ↑n) * fun n => ↑(ArithmeticFunction.vonMangoldt n)) s =\n      -deriv (DirichletCharacter.LFunction χ) s / DirichletCharacter.LFunction χ s",
      "type_status": "COMPILER_CONFIRMED_FROM_ELABORATED_ENVIRONMENT"
    },
    {
      "name": "DirichletCharacter.continuousOn_neg_logDeriv_LFunction",
      "type": "∀ {q : ℕ} [inst : NeZero q] {χ : DirichletCharacter ℂ q},\n  χ ≠ 1 →\n    ContinuousOn (fun s => -deriv (DirichletCharacter.LFunction χ) s / DirichletCharacter.LFunction χ s)\n      {s | DirichletCharacter.LFunction χ s ≠ 0}",
      "type_status": "COMPILER_CONFIRMED_FROM_ELABORATED_ENVIRONMENT"
    }
