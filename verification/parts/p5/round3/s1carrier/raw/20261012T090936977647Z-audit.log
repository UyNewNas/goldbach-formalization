CHEN_P5_S1CARRIER_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier","name":"MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1ProdPrimes_primeFactors","type":"∀ (N : ℕ) (z : ℝ),\n  (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1ProdPrimes N z).primeFactors =\n    MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1SiftingPrimes N z"}
