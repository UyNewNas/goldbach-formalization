CHEN_P5_S1CARRIER_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier","name":"MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1_mod_mem_unitResidues","type":"∀ {N d : ℕ} {z : ℝ},\n  d ∣ MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1ProdPrimes N z →\n    N % d ∈ AnalyticNumberTheory.Sieve.unitResidues d"}
