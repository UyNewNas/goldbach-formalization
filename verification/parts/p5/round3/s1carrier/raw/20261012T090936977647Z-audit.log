CHEN_P5_S1CARRIER_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier","name":"BoundingSieve.mk.congr_simp","type":"∀ (support support_1 : Finset ℕ),\n  support = support_1 →\n    ∀ (prodPrimes prodPrimes_1 : ℕ) (e_prodPrimes : prodPrimes = prodPrimes_1)\n      (prodPrimes_squarefree : Squarefree prodPrimes) (weights weights_1 : ℕ → ℝ) (e_weights : weights = weights_1)\n      (weights_nonneg : ∀ (n : ℕ), 0 ≤ weights n) (totalMass totalMass_1 : ℝ),\n      totalMass = totalMass_1 →\n        ∀ (nu nu_1 : ArithmeticFunction ℝ) (e_nu : nu = nu_1) (nu_mult : nu.IsMultiplicative)\n          (nu_pos_of_prime : ∀ (p : ℕ), Nat.Prime p → p ∣ prodPrimes → 0 < nu p)\n          (nu_lt_one_of_prime : ∀ (p : ℕ), Nat.Prime p → p ∣ prodPrimes → nu p < 1),\n          { support := support, prodPrimes := prodPrimes, prodPrimes_squarefree := prodPrimes_squarefree,\n              weights := weights, weights_nonneg := weights_nonneg, totalMass := totalMass, nu := nu,\n              nu_mult := nu_mult, nu_pos_of_prime := nu_pos_of_prime, nu_lt_one_of_prime := nu_lt_one_of_prime } =\n            { support := support_1, prodPrimes := prodPrimes_1, prodPrimes_squarefree := ⋯, weights := weights_1,\n              weights_nonneg := ⋯, totalMass := totalMass_1, nu := nu_1, nu_mult := ⋯, nu_pos_of_prime := ⋯,\n              nu_lt_one_of_prime := ⋯ }"}
CHEN_P5_S1CARRIER_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier","name":"MathlibNt.SieveTheory.BombieriVinogradov.standardPrimeAPError.eq_1","type":"∀ (x q l : ℕ),\n  MathlibNt.SieveTheory.BombieriVinogradov.standardPrimeAPError x q l =\n    ↑(MathlibNt.SieveTheory.BombieriVinogradov.primesInAP x q l) -\n      MathlibNt.SieveTheory.BombieriVinogradov.trueLogarithmicIntegral ↑x / ↑q.totient"}
CHEN_P5_S1CARRIER_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier","name":"MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1BoundingSieve","type":"(N : ℕ) → Even N → ℝ → ℝ → BoundingSieve"}
CHEN_P5_S1CARRIER_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier","name":"MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1BoundingSieve_mainSum_eq_totientSum","type":"∀ {N : ℕ} (hEven : Even N) (ε z : ℝ) (μ : ℕ → ℝ),\n  BoundingSieve.mainSum μ =\n    ∑ d ∈ (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1ProdPrimes N z).divisors, μ d / ↑d.totient"}
CHEN_P5_S1CARRIER_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier","name":"MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1BoundingSieve_multSum_eq_primesInAP","type":"∀ {N : ℕ} (hEven : Even N) {ε z : ℝ} {d : ℕ},\n  0 ≤ ε →\n    2 ≤ MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1Endpoint N ε →\n      BoundingSieve.multSum d =\n        ↑(MathlibNt.SieveTheory.BombieriVinogradov.primesInAP\n            (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1Endpoint N ε) d (N % d))"}
CHEN_P5_S1CARRIER_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier","name":"MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1BoundingSieve_nu_eq_inv_totient","type":"∀ {N : ℕ} (hEven : Even N) {ε z : ℝ} {d : ℕ},\n  d ∣ MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1ProdPrimes N z →\n    (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1BoundingSieve N hEven ε z).nu d = 1 / ↑d.totient"}
CHEN_P5_S1CARRIER_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier","name":"MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1BoundingSieve_rem_eq_standardPrimeAPError","type":"∀ {N : ℕ} (hEven : Even N) {ε z : ℝ},\n  0 ≤ ε →\n    2 ≤ MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1Endpoint N ε →\n      ∀ {d : ℕ},\n        d ∣ MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1ProdPrimes N z →\n          BoundingSieve.rem d =\n            MathlibNt.SieveTheory.BombieriVinogradov.standardPrimeAPError\n              (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1Endpoint N ε) d (N % d)"}
CHEN_P5_S1CARRIER_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier","name":"MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1BoundingSieve_siftedSum_eq","type":"∀ {N : ℕ} (hEven : Even N) (ε z : ℝ),\n  BoundingSieve.siftedSum =\n    ↑(MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1\n        (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.goldbachDifferenceCarrier N ε) N z)"}
