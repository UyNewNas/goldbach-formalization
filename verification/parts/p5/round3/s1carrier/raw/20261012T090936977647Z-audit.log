CHEN_P5_S1CARRIER_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier","name":"MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.mem_goldbachPrimeCarrier_iff_prime_le_goldbachS1Endpoint","type":"∀ {N p : ℕ} {ε : ℝ},\n  0 ≤ ε →\n    2 ≤ MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1Endpoint N ε →\n      (p ∈ MathlibNt.SieveTheory.LiLiuOnePlusOneNine.goldbachPrimeCarrier N ε ↔\n        Nat.Prime p ∧ p ≤ MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1Endpoint N ε)"}
CHEN_P5_S1CARRIER_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier","name":"MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.mem_goldbachS1SiftingPrimes_iff","type":"∀ {N : ℕ} {z : ℝ} {p : ℕ},\n  p ∈ MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1SiftingPrimes N z ↔\n    p < ⌈z⌉₊ ∧ Nat.Prime p ∧ ¬p ∣ N"}
CHEN_P5_S1CARRIER_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier","name":"MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.prime_dvd_goldbachS1ProdPrimes_iff","type":"∀ {N : ℕ} {z : ℝ} {p : ℕ},\n  Nat.Prime p → (p ∣ MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1ProdPrimes N z ↔ ↑p < z ∧ ¬p ∣ N)"}
CHEN_P5_S1CARRIER_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier","name":"_private.MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier.0.MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.S1Carrier_multiples_card_eq_primeCarrier_modEq","type":"∀ {N d : ℕ} {ε : ℝ},\n  0 ≤ ε →\n    {n ∈ MathlibNt.SieveTheory.LiLiuOnePlusOneNine.goldbachDifferenceCarrier N ε | d ∣ n}.card =\n      {p ∈ MathlibNt.SieveTheory.LiLiuOnePlusOneNine.goldbachPrimeCarrier N ε | p ≡ N [MOD d]}.card"}
CHEN_P5_S1CARRIER_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier","name":"_private.MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier.0.MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.S1Carrier_primeCarrier_modEq_card_eq_primesInAP","type":"∀ {N d : ℕ} {ε : ℝ},\n  0 ≤ ε →\n    2 ≤ MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1Endpoint N ε →\n      {p ∈ MathlibNt.SieveTheory.LiLiuOnePlusOneNine.goldbachPrimeCarrier N ε | p ≡ N [MOD d]}.card =\n        MathlibNt.SieveTheory.BombieriVinogradov.primesInAP\n          (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1Endpoint N ε) d (N % d)"}
CHEN_P5_S1CARRIER_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier","name":"_private.MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier.0.MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.S1Carrier_primeFactors_prod_eq_self","type":"∀ {S : Finset ℕ}, (∀ p ∈ S, Nat.Prime p) → (S.prod id).primeFactors = S"}
CHEN_P5_S1CARRIER_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"MathlibNt.SieveTheory.LiLiuGoldbachS1Carrier","name":"MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1BoundingSieve._proof_1","type":"∀ (n : ℕ), 0 ≤ 1"}
