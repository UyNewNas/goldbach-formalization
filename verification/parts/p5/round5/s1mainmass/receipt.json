  "public_theorems": [
    {
      "name": "MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1_strictEndpoint_mainMass_lower",
      "type": "∀ (ε η : ℝ),\n  0 < ε →\n    ε < 1 →\n      0 < η →\n        ∃ N₀,\n          2 ≤ N₀ ∧\n            ∀ (N : ℕ),\n              N₀ ≤ N →\n                have m := ⌈(1 - ε) * ↑N⌉₊ - 1;\n                2 ≤ m ∧\n                  m ≤ N ∧\n                    (1 - ε - η) * (↑N / Real.log ↑N) ≤\n                      MathlibNt.SieveTheory.BombieriVinogradov.trueLogarithmicIntegral ↑m",
      "type_status": "COMPILER_CONFIRMED_FROM_ELABORATED_ENVIRONMENT"
    }
