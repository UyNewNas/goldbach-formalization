VE_AUDIT_DECL {"axioms":["propext"],"kind":"definition","module":"ImbalancedChen.VariableEnvelopeBoxes","name":"ImbalancedChen.VariableEnvelope.maxSeven","type":"{α : Type u_1} → [LinearOrder α] → α → α → α → α → α → α → α → α"}
VE_AUDIT_DECL {"axioms":["propext"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeBoxes","name":"ImbalancedChen.VariableEnvelope.maxSeven_le_iff","type":"∀ {α : Type u_1} [inst : LinearOrder α] {a b c d e f g t : α},\n  ImbalancedChen.VariableEnvelope.maxSeven a b c d e f g ≤ t ↔ a ≤ t ∧ b ≤ t ∧ c ≤ t ∧ d ≤ t ∧ e ≤ t ∧ f ≤ t ∧ g ≤ t"}
VE_AUDIT_DECL {"axioms":["propext"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeBoxes","name":"ImbalancedChen.VariableEnvelope.maxSeven_mono","type":"∀ {α : Type u_1} [inst : LinearOrder α] {a b c d e f g a' b' c' d' e' f' g' : α},\n  a ≤ a' →\n    b ≤ b' →\n      c ≤ c' →\n        d ≤ d' →\n          e ≤ e' →\n            f ≤ f' →\n              g ≤ g' →\n                ImbalancedChen.VariableEnvelope.maxSeven a b c d e f g ≤\n                  ImbalancedChen.VariableEnvelope.maxSeven a' b' c' d' e' f' g'"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeBoxes","name":"ImbalancedChen.VariableEnvelope.maxSeven_sub_le","type":"∀ {a b c d e f g a' b' c' d' e' f' g' δ : ℚ},\n  a' - a ≤ δ →\n    b' - b ≤ δ →\n      c' - c ≤ δ →\n        d' - d ≤ δ →\n          e' - e ≤ δ →\n            f' - f ≤ δ →\n              g' - g ≤ δ →\n                ImbalancedChen.VariableEnvelope.maxSeven a' b' c' d' e' f' g' -\n                    ImbalancedChen.VariableEnvelope.maxSeven a b c d e f g ≤\n                  δ"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeBoxes","name":"ImbalancedChen.VariableEnvelope.maxSeven_v_eq_original","type":"∀ {x y z : ℝ},\n  ImbalancedChen.VariableEnvelope.Ordered x y z →\n    ImbalancedChen.VariableEnvelope.maxSeven (ImbalancedChen.VariableEnvelope.v x) (ImbalancedChen.VariableEnvelope.v y)\n        (ImbalancedChen.VariableEnvelope.v (x + y)) (ImbalancedChen.VariableEnvelope.v (x + y + z))\n        (ImbalancedChen.VariableEnvelope.v (x + z)) (ImbalancedChen.VariableEnvelope.v (y + z))\n        (ImbalancedChen.VariableEnvelope.B z) =\n      ImbalancedChen.VariableEnvelope.original x y z"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelope","name":"ImbalancedChen.VariableEnvelope.max_psi_eq","type":"∀ {b a t : ℝ}, 0 ≤ b → (b ≤ a → t ≤ a) → max b (ImbalancedChen.VariableEnvelope.psi a t) = max b a"}
