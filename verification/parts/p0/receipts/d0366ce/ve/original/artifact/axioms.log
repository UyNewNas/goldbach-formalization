VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeConsequences","name":"ImbalancedChen.VariableEnvelope.cutoff_597","type":"8 / 3 * (ImbalancedChen.VariableEnvelope.cap - 597 / 1000) = 7 / 4000"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeScaled","name":"ImbalancedChen.VariableEnvelope.floorDiv_bounds","type":"∀ (n d : ℤ), 0 < d → ↑(n / d) ≤ ↑n / ↑d ∧ ↑n / ↑d < ↑(n / d) + 1"}
