VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeConsequences","name":"ImbalancedChen.VariableEnvelope.ordered_mu","type":"ImbalancedChen.VariableEnvelope.Ordered ImbalancedChen.VariableEnvelope.mu ImbalancedChen.VariableEnvelope.mu\n  ImbalancedChen.VariableEnvelope.mu"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"ImbalancedChen.VariableEnvelope","name":"ImbalancedChen.VariableEnvelope.original","type":"ℝ → ℝ → ℝ → ℝ"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeRegularity","name":"ImbalancedChen.VariableEnvelope.original_abs_sub_le","type":"∀ {x y z x' y' z' d : ℝ},\n  ImbalancedChen.VariableEnvelope.Ordered x y z →\n    ImbalancedChen.VariableEnvelope.Ordered x' y' z' →\n      |x - x'| ≤ d →\n        |y - y'| ≤ d →\n          |z - z'| ≤ d →\n            |ImbalancedChen.VariableEnvelope.original x y z - ImbalancedChen.VariableEnvelope.original x' y' z'| ≤\n              9 / 2 * d"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelope","name":"ImbalancedChen.VariableEnvelope.original_eq_six","type":"∀ {x y z : ℝ},\n  ImbalancedChen.VariableEnvelope.Ordered x y z →\n    ImbalancedChen.VariableEnvelope.original x y z = ImbalancedChen.VariableEnvelope.six x y z"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeConsequences","name":"ImbalancedChen.VariableEnvelope.original_le_cap","type":"∀ {x y z : ℝ},\n  ImbalancedChen.VariableEnvelope.Ordered x y z →\n    ImbalancedChen.VariableEnvelope.original x y z ≤ ImbalancedChen.VariableEnvelope.cap"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeRegularity","name":"ImbalancedChen.VariableEnvelope.original_lipschitz_max","type":"∀ {x y z x' y' z' : ℝ},\n  ImbalancedChen.VariableEnvelope.Ordered x y z →\n    ImbalancedChen.VariableEnvelope.Ordered x' y' z' →\n      |ImbalancedChen.VariableEnvelope.original x y z - ImbalancedChen.VariableEnvelope.original x' y' z'| ≤\n        9 / 2 * max |x - x'| (max |y - y'| |z - z'|)"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeConsequences","name":"ImbalancedChen.VariableEnvelope.original_margin","type":"∀ {x y z : ℝ},\n  ImbalancedChen.VariableEnvelope.Ordered x y z → 3 / 256 ≤ ImbalancedChen.VariableEnvelope.original x y z - 3 * x"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeConsequences","name":"ImbalancedChen.VariableEnvelope.original_margin_eq_on_mu","type":"∀ {y z : ℝ},\n  ImbalancedChen.VariableEnvelope.Ordered ImbalancedChen.VariableEnvelope.mu y z →\n    ImbalancedChen.VariableEnvelope.original ImbalancedChen.VariableEnvelope.mu y z -\n        3 * ImbalancedChen.VariableEnvelope.mu =\n      3 / 256"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeConsequences","name":"ImbalancedChen.VariableEnvelope.original_margin_pos","type":"∀ {x y z : ℝ},\n  ImbalancedChen.VariableEnvelope.Ordered x y z → 0 < ImbalancedChen.VariableEnvelope.original x y z - 3 * x"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeConsequences","name":"ImbalancedChen.VariableEnvelope.original_margin_sharp","type":"ImbalancedChen.VariableEnvelope.original ImbalancedChen.VariableEnvelope.mu ImbalancedChen.VariableEnvelope.mu\n      ImbalancedChen.VariableEnvelope.mu -\n    3 * ImbalancedChen.VariableEnvelope.mu =\n  3 / 256"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeConsequences","name":"ImbalancedChen.VariableEnvelope.original_mu","type":"ImbalancedChen.VariableEnvelope.original ImbalancedChen.VariableEnvelope.mu ImbalancedChen.VariableEnvelope.mu\n    ImbalancedChen.VariableEnvelope.mu =\n  ImbalancedChen.VariableEnvelope.cap"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeConsequences","name":"ImbalancedChen.VariableEnvelope.original_mu_left","type":"∀ {y z : ℝ},\n  ImbalancedChen.VariableEnvelope.Ordered ImbalancedChen.VariableEnvelope.mu y z →\n    ImbalancedChen.VariableEnvelope.original ImbalancedChen.VariableEnvelope.mu y z =\n      ImbalancedChen.VariableEnvelope.cap"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelope","name":"ImbalancedChen.VariableEnvelope.pair_gate_margin","type":"∀ {x s r : ℝ},\n  x ≤ ImbalancedChen.VariableEnvelope.mu →\n    r ≤ x →\n      ImbalancedChen.VariableEnvelope.v x ≤ ImbalancedChen.VariableEnvelope.v s →\n        3 / 256 ≤ ImbalancedChen.VariableEnvelope.v s - (s + 2 * r)"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"ImbalancedChen.VariableEnvelope","name":"ImbalancedChen.VariableEnvelope.psi","type":"ℝ → ℝ → ℝ"}
