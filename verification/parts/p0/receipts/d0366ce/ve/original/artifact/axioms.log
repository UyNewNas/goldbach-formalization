VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"ImbalancedChen.VariableEnvelopeRegularity","name":"ImbalancedChen.VariableEnvelope.qB","type":"ℚ → ℚ"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"ImbalancedChen.VariableEnvelopeRegularity","name":"ImbalancedChen.VariableEnvelope.qC","type":"ℚ → ℚ"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"ImbalancedChen.VariableEnvelopeRegularity","name":"ImbalancedChen.VariableEnvelope.qV","type":"ℚ → ℚ"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"ImbalancedChen.VariableEnvelopeRegularity","name":"ImbalancedChen.VariableEnvelope.qVHi","type":"ℚ → ℚ → ℚ"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeRegularity","name":"ImbalancedChen.VariableEnvelope.qVHi_sub_qVLo_le","type":"∀ {l u : ℚ},\n  l ≤ u → ImbalancedChen.VariableEnvelope.qVHi l u - ImbalancedChen.VariableEnvelope.qVLo l u ≤ 3 / 2 * (u - l)"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"ImbalancedChen.VariableEnvelopeRegularity","name":"ImbalancedChen.VariableEnvelope.qVLo","type":"ℚ → ℚ → ℚ"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeRegularity","name":"ImbalancedChen.VariableEnvelope.qVLo_le_v","type":"∀ {l u : ℚ} {t : ℝ}, ↑l ≤ t → t ≤ ↑u → ↑(ImbalancedChen.VariableEnvelope.qVLo l u) ≤ ImbalancedChen.VariableEnvelope.v t"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeRegularity","name":"ImbalancedChen.VariableEnvelope.qV_eq_qA","type":"∀ {t : ℚ}, t ≤ 25 / 128 → ImbalancedChen.VariableEnvelope.qV t = ImbalancedChen.VariableEnvelope.qA t"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeRegularity","name":"ImbalancedChen.VariableEnvelope.qV_eq_qC","type":"∀ {t : ℚ}, 25 / 128 ≤ t → ImbalancedChen.VariableEnvelope.qV t = ImbalancedChen.VariableEnvelope.qC t"}
VE_AUDIT_DECL {"axioms":[],"kind":"definition","module":"ImbalancedChen.VariableEnvelopeScaled","name":"ImbalancedChen.VariableEnvelope.scaledBHi","type":"ℤ → ℤ → ℤ"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeScaled","name":"ImbalancedChen.VariableEnvelope.scaledBHi_rounding","type":"∀ (D l : ℤ),\n  0 < D →\n    ↑D * ↑(ImbalancedChen.VariableEnvelope.qB (↑l / ↑D)) ≤ ↑(ImbalancedChen.VariableEnvelope.scaledBHi D l) ∧\n      ↑(ImbalancedChen.VariableEnvelope.scaledBHi D l) ≤ ↑D * ↑(ImbalancedChen.VariableEnvelope.qB (↑l / ↑D)) + 1"}
VE_AUDIT_DECL {"axioms":[],"kind":"definition","module":"ImbalancedChen.VariableEnvelopeScaled","name":"ImbalancedChen.VariableEnvelope.scaledBLo","type":"ℤ → ℤ → ℤ"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeScaled","name":"ImbalancedChen.VariableEnvelope.scaledBLo_rounding","type":"∀ (D u : ℤ),\n  0 < D →\n    ↑(ImbalancedChen.VariableEnvelope.scaledBLo D u) ≤ ↑D * ↑(ImbalancedChen.VariableEnvelope.qB (↑u / ↑D)) ∧\n      ↑D * ↑(ImbalancedChen.VariableEnvelope.qB (↑u / ↑D)) ≤ ↑(ImbalancedChen.VariableEnvelope.scaledBLo D u) + 1"}
VE_AUDIT_DECL {"axioms":[],"kind":"definition","module":"ImbalancedChen.VariableEnvelopeScaled","name":"ImbalancedChen.VariableEnvelope.scaledVHi","type":"ℤ → ℤ → ℤ → ℤ → ℤ"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeScaled","name":"ImbalancedChen.VariableEnvelope.scaledVHi_rounding","type":"∀ (D M l u : ℤ),\n  0 < D →\n    128 * M = 25 * D →\n      ↑D * ↑(ImbalancedChen.VariableEnvelope.qVHi (↑l / ↑D) (↑u / ↑D)) ≤\n          ↑(ImbalancedChen.VariableEnvelope.scaledVHi D M l u) ∧\n        ↑(ImbalancedChen.VariableEnvelope.scaledVHi D M l u) ≤\n          ↑D * ↑(ImbalancedChen.VariableEnvelope.qVHi (↑l / ↑D) (↑u / ↑D)) + 1"}
VE_AUDIT_DECL {"axioms":[],"kind":"definition","module":"ImbalancedChen.VariableEnvelopeScaled","name":"ImbalancedChen.VariableEnvelope.scaledVLo","type":"ℤ → ℤ → ℤ → ℤ"}
VE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.VariableEnvelopeScaled","name":"ImbalancedChen.VariableEnvelope.scaledVLo_rounding","type":"∀ (D l u : ℤ),\n  0 < D →\n    ↑(ImbalancedChen.VariableEnvelope.scaledVLo D l u) ≤\n        ↑D * ↑(ImbalancedChen.VariableEnvelope.qVLo (↑l / ↑D) (↑u / ↑D)) ∧\n      ↑D * ↑(ImbalancedChen.VariableEnvelope.qVLo (↑l / ↑D) (↑u / ↑D)) ≤\n        ↑(ImbalancedChen.VariableEnvelope.scaledVLo D l u) + 1"}
VE_AUDIT_DECL {"axioms":[],"kind":"definition","module":"ImbalancedChen.VariableEnvelopeScaled","name":"ImbalancedChen.VariableEnvelope.scaledVPointHi","type":"ℤ → ℤ → ℤ"}
