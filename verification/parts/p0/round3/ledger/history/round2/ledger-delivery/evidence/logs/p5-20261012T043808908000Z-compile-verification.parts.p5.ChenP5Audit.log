CHEN_P5_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenMeanLedger","name":"ImbalancedChen.chenPairedElevenWeight_eq_unselected","type":"∀ (n : ℕ) (N A H D C : ℝ) (E : ℕ × ℕ → Prop),\n  ImbalancedChen.chenPairedElevenWeight n N A H D C E =\n    3 * ↑(ImbalancedChen.chenY1 n A) + ↑(ImbalancedChen.chenY2 n H) - ↑(ImbalancedChen.chenY3 n A C) -\n                    ↑(ImbalancedChen.chenY4 n A D) +\n                  ↑(ImbalancedChen.chenY5 n A H) +\n                ↑(ImbalancedChen.chenY6Selected n A H D fun t => ¬E t) -\n              2 * ↑(ImbalancedChen.chenY7 n N D) -\n            ↑(ImbalancedChen.chenY8 n N A C) -\n          ↑(ImbalancedChen.chenY9 n N H D) -\n        ↑(ImbalancedChen.chenY10 n A H) -\n      ↑(ImbalancedChen.chenY11Selected n A H D fun t => ¬E t)"}
CHEN_P5_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"ImbalancedChen.CurrentChenMeanLedger","name":"ImbalancedChen.chenY10PrimeSelector","type":"ℕ → ℝ → ℝ → Finset ((ℕ × ℕ) × ℕ × ℕ)"}
CHEN_P5_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenMeanLedger","name":"ImbalancedChen.chenY10Tuples_eq_selector_filter","type":"∀ {N P : ℕ},\n  P ∈ ImbalancedChen.chenAdditivePrimeCarrier N →\n    ∀ (A H : ℝ),\n      ImbalancedChen.chenY10Tuples (N - P) A H =\n        {t ∈ ImbalancedChen.chenY10PrimeSelector N A H |\n          ImbalancedChen.ChenQuotient (t.1.1 * t.1.2 * t.2.1 * t.2.2) (↑t.1.2) (N - P)}"}
