CHEN_P5_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenMeanLedger","name":"ImbalancedChen.chenY9Tuples_eq_selector_filter","type":"∀ {N P : ℕ},\n  P ∈ ImbalancedChen.chenAdditivePrimeCarrier N →\n    ∀ (H D : ℝ),\n      ImbalancedChen.chenY9Tuples (N - P) (↑N) H D =\n        {t ∈ ImbalancedChen.chenY9PrimeSelector N H D |\n          ImbalancedChen.ChenQuotient (t.1 * t.2) (√(↑N / (↑t.1 * ↑t.2))) (N - P)}"}
CHEN_P5_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenMeanLedger","name":"ImbalancedChen.chen_prime_dvd_receiver_mem_additiveCarrier","type":"∀ {N P p : ℕ},\n  P ∈ ImbalancedChen.chenAdditivePrimeCarrier N →\n    Nat.Prime p → p ∣ N - P → p ∈ ImbalancedChen.chenAdditivePrimeCarrier N"}
CHEN_P5_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenMeanLedger","name":"ImbalancedChen.chen_sum_quotient_tuple_card_moving_cutoff","type":"∀ {α : Type u_1} [DecidableEq α] (N : ℕ) (T : Finset α) (b : α → ℕ) (z : α → ℝ),\n  ∑ P ∈ ImbalancedChen.chenAdditivePrimeCarrier N, ↑{t ∈ T | ImbalancedChen.ChenQuotient (b t) (z t) (N - P)}.card =\n    ∑ t ∈ T, ↑(ImbalancedChen.chenSiftedQuotientPrimeSource N (b t) (z t)).card"}
CHEN_P5_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenMeanLedger","name":"ImbalancedChen.currentChenPairedPrimeSum_eq_upsilon","type":"∀ (N : ℕ) (E : ℕ × ℕ → Prop),\n  ImbalancedChen.currentChenPairedPrimeSum N E =\n    3 * ImbalancedChen.currentChenUpsilon1 N + ImbalancedChen.currentChenUpsilon2 N -\n                      ImbalancedChen.currentChenUpsilon3 N -\n                    ImbalancedChen.currentChenUpsilon4 N +\n                  ImbalancedChen.currentChenUpsilon5 N +\n                ImbalancedChen.currentChenUpsilon6 N E -\n              2 * ImbalancedChen.currentChenUpsilon7 N -\n            ImbalancedChen.currentChenUpsilon8 N -\n          ImbalancedChen.currentChenUpsilon9 N -\n        ImbalancedChen.currentChenUpsilon10 N -\n      ImbalancedChen.currentChenUpsilon11 N E"}
CHEN_P5_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenMeanLedger","name":"ImbalancedChen.currentChenPairedPrimeSum_ge_of_joint_last_bounds","type":"∀ (N : ℕ) (E : ℕ × ℕ → Prop) (l₁ l₂ u₃ u₄ l₅ l₆ u₇ u₈ u₉ u₁₀₁₁ : ℝ),\n  l₁ ≤ ImbalancedChen.currentChenUpsilon1 N →\n    l₂ ≤ ImbalancedChen.currentChenUpsilon2 N →\n      ImbalancedChen.currentChenUpsilon3 N ≤ u₃ →\n        ImbalancedChen.currentChenUpsilon4 N ≤ u₄ →\n          l₅ ≤ ImbalancedChen.currentChenUpsilon5 N →\n            l₆ ≤ ImbalancedChen.currentChenUpsilon6 N E →\n              ImbalancedChen.currentChenUpsilon7 N ≤ u₇ →\n                ImbalancedChen.currentChenUpsilon8 N ≤ u₈ →\n                  ImbalancedChen.currentChenUpsilon9 N ≤ u₉ →\n                    ImbalancedChen.currentChenUpsilon10 N + ImbalancedChen.currentChenUpsilon11 N E ≤ u₁₀₁₁ →\n                      3 * l₁ + l₂ - u₃ - u₄ + l₅ + l₆ - 2 * u₇ - u₈ - u₉ - u₁₀₁₁ ≤\n                        ImbalancedChen.currentChenPairedPrimeSum N E"}
CHEN_P5_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenMeanLedger","name":"ImbalancedChen.currentChenPairedPrimeSum_ge_of_normalized_joint_last_bounds","type":"∀ (N : ℕ) (E : ℕ × ℕ → Prop) (b₁ b₂ b₃ b₄ b₅ b₆ b₇ b₈ b₉ b₁₀₁₁ delta : ℝ),\n  (b₁ - delta) * ImbalancedChen.singularNormalization N ≤ ImbalancedChen.currentChenUpsilon1 N →\n    (b₂ - delta) * ImbalancedChen.singularNormalization N ≤ ImbalancedChen.currentChenUpsilon2 N →\n      ImbalancedChen.currentChenUpsilon3 N ≤ (b₃ + delta) * ImbalancedChen.singularNormalization N →\n        ImbalancedChen.currentChenUpsilon4 N ≤ (b₄ + delta) * ImbalancedChen.singularNormalization N →\n          (b₅ - delta) * ImbalancedChen.singularNormalization N ≤ ImbalancedChen.currentChenUpsilon5 N →\n            (b₆ - delta) * ImbalancedChen.singularNormalization N ≤ ImbalancedChen.currentChenUpsilon6 N E →\n              ImbalancedChen.currentChenUpsilon7 N ≤ (b₇ + delta) * ImbalancedChen.singularNormalization N →\n                ImbalancedChen.currentChenUpsilon8 N ≤ (b₈ + delta) * ImbalancedChen.singularNormalization N →\n                  ImbalancedChen.currentChenUpsilon9 N ≤ (b₉ + delta) * ImbalancedChen.singularNormalization N →\n                    ImbalancedChen.currentChenUpsilon10 N + ImbalancedChen.currentChenUpsilon11 N E ≤\n                        (b₁₀₁₁ + 2 * delta) * ImbalancedChen.singularNormalization N →\n                      (3 * b₁ + b₂ - b₃ - b₄ + b₅ + b₆ - 2 * b₇ - b₈ - b₉ - b₁₀₁₁ - 14 * delta) *\n                          ImbalancedChen.singularNormalization N ≤\n                        ImbalancedChen.currentChenPairedPrimeSum N E"}
CHEN_P5_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenMeanLedger","name":"ImbalancedChen.currentChenPairedPrimeSum_ge_of_normalized_term_bounds","type":"∀ (N : ℕ) (E : ℕ × ℕ → Prop) (b₁ b₂ b₃ b₄ b₅ b₆ b₇ b₈ b₉ b₁₀ b₁₁ delta : ℝ),\n  (b₁ - delta) * ImbalancedChen.singularNormalization N ≤ ImbalancedChen.currentChenUpsilon1 N →\n    (b₂ - delta) * ImbalancedChen.singularNormalization N ≤ ImbalancedChen.currentChenUpsilon2 N →\n      ImbalancedChen.currentChenUpsilon3 N ≤ (b₃ + delta) * ImbalancedChen.singularNormalization N →\n        ImbalancedChen.currentChenUpsilon4 N ≤ (b₄ + delta) * ImbalancedChen.singularNormalization N →\n          (b₅ - delta) * ImbalancedChen.singularNormalization N ≤ ImbalancedChen.currentChenUpsilon5 N →\n            (b₆ - delta) * ImbalancedChen.singularNormalization N ≤ ImbalancedChen.currentChenUpsilon6 N E →\n              ImbalancedChen.currentChenUpsilon7 N ≤ (b₇ + delta) * ImbalancedChen.singularNormalization N →\n                ImbalancedChen.currentChenUpsilon8 N ≤ (b₈ + delta) * ImbalancedChen.singularNormalization N →\n                  ImbalancedChen.currentChenUpsilon9 N ≤ (b₉ + delta) * ImbalancedChen.singularNormalization N →\n                    ImbalancedChen.currentChenUpsilon10 N ≤ (b₁₀ + delta) * ImbalancedChen.singularNormalization N →\n                      ImbalancedChen.currentChenUpsilon11 N E ≤ (b₁₁ + delta) * ImbalancedChen.singularNormalization N →\n                        (3 * b₁ + b₂ - b₃ - b₄ + b₅ + b₆ - 2 * b₇ - b₈ - b₉ - b₁₀ - b₁₁ - 14 * delta) *\n                            ImbalancedChen.singularNormalization N ≤\n                          ImbalancedChen.currentChenPairedPrimeSum N E"}
CHEN_P5_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenMeanLedger","name":"ImbalancedChen.currentChenPairedPrimeSum_ge_of_term_bounds","type":"∀ (N : ℕ) (E : ℕ × ℕ → Prop) (l₁ l₂ u₃ u₄ l₅ l₆ u₇ u₈ u₉ u₁₀ u₁₁ : ℝ),\n  l₁ ≤ ImbalancedChen.currentChenUpsilon1 N →\n    l₂ ≤ ImbalancedChen.currentChenUpsilon2 N →\n      ImbalancedChen.currentChenUpsilon3 N ≤ u₃ →\n        ImbalancedChen.currentChenUpsilon4 N ≤ u₄ →\n          l₅ ≤ ImbalancedChen.currentChenUpsilon5 N →\n            l₆ ≤ ImbalancedChen.currentChenUpsilon6 N E →\n              ImbalancedChen.currentChenUpsilon7 N ≤ u₇ →\n                ImbalancedChen.currentChenUpsilon8 N ≤ u₈ →\n                  ImbalancedChen.currentChenUpsilon9 N ≤ u₉ →\n                    ImbalancedChen.currentChenUpsilon10 N ≤ u₁₀ →\n                      ImbalancedChen.currentChenUpsilon11 N E ≤ u₁₁ →\n                        3 * l₁ + l₂ - u₃ - u₄ + l₅ + l₆ - 2 * u₇ - u₈ - u₉ - u₁₀ - u₁₁ ≤\n                          ImbalancedChen.currentChenPairedPrimeSum N E"}
