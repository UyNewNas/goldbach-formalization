CHEN_P5_INITIAL_SOURCE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenInitialSource","name":"ImbalancedChen.currentChen_goldbachS1_le_sifted_add_primeFactors","type":"∀ (N : ℕ) (tau A z : ℝ),\n  N ≠ 0 →\n    0 ≤ tau →\n      A ≤ z →\n        ↑(MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.goldbachS1\n              (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.goldbachDifferenceCarrier N tau) N z) ≤\n          ↑(ImbalancedChen.chenSiftedPrimeSource N A).card + ↑N.primeFactors.card"}
CHEN_P5_INITIAL_SOURCE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenInitialSource","name":"ImbalancedChen.currentChen_initial_sieve_coefficient","type":"33 / 2 * Real.exp (-Real.eulerMascheroniConstant) *\n    MathlibNt.SieveTheory.SwitchingPrinciple.dimensionOneLowerLinearSieveFactor 4 =\n  33 / 4 * Real.log 3"}
CHEN_P5_INITIAL_SOURCE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenInitialSource","name":"ImbalancedChen.currentChen_singularSeries_eq_liuSingularSeries","type":"∀ (N : ℕ), ImbalancedChen.singularSeries N = MathlibNt.SieveTheory.SingularSeries.liuSingularSeries N"}
CHEN_P5_INITIAL_SOURCE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenInitialSource","name":"ImbalancedChen.currentChen_twinPrimeConstant_eq_liuUniversalProduct","type":"ImbalancedChen.twinPrimeConstant = MathlibNt.SieveTheory.SingularSeries.liuUniversalProduct"}
CHEN_P5_INITIAL_SOURCE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenInitialSource","name":"ImbalancedChen.eventually_currentChen_primeFactors_negligible","type":"∀ (epsilon : ℝ),\n  0 < epsilon → ∀ᶠ (N : ℕ) in Filter.atTop, ↑N.primeFactors.card ≤ epsilon * ImbalancedChen.singularNormalization N"}
CHEN_P5_INITIAL_SOURCE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenInitialSource","name":"ImbalancedChen.currentChen_goldbachS1_le_sifted_add_primeFactors._proof_1_1","type":"∀ (N : ℕ) (tau A z : ℝ),\n  {n ∈\n            Finset.filter (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.literalHPoint N 1 z)\n              (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.goldbachDifferenceCarrier N tau) |\n          ¬n.Coprime N}.card ≤\n      N.primeFactors.card →\n    {n ∈\n              Finset.filter (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.literalHPoint N 1 z)\n                (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.goldbachDifferenceCarrier N tau) |\n            n.Coprime N}.card ≤\n        (ImbalancedChen.chenSiftedPrimeSource N A).card →\n      {n ∈\n                  Finset.filter (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.literalHPoint N 1 z)\n                    (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.goldbachDifferenceCarrier N tau) |\n                n.Coprime N}.card +\n            {a ∈\n                  Finset.filter (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.literalHPoint N 1 z)\n                    (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.goldbachDifferenceCarrier N tau) |\n                ¬a.Coprime N}.card =\n          (Finset.filter (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.literalHPoint N 1 z)\n              (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.goldbachDifferenceCarrier N tau)).card →\n        ¬(Finset.filter (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.GoldbachBig.literalHPoint N 1 z)\n                  (MathlibNt.SieveTheory.LiLiuOnePlusOneNine.goldbachDifferenceCarrier N tau)).card ≤\n              (ImbalancedChen.chenSiftedPrimeSource N A).card + N.primeFactors.card →\n          False"}
CHEN_P5_INITIAL_SOURCE_AUDIT_DECL {"axioms":["propext","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenInitialSource","name":"ImbalancedChen.eventually_currentChen_primeFactors_negligible._proof_1_1","type":"∀ (N : ℕ), 1 ≤ N → N = 0 → False"}
CHEN_P5_INITIAL_SOURCE_AUDIT_DECL {"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"ImbalancedChen.CurrentChenInitialSource","name":"ImbalancedChen.singularSeries.eq_1","type":"∀ (N : ℕ),\n  ImbalancedChen.singularSeries N =\n    ImbalancedChen.twinPrimeConstant * ∏ p ∈ ImbalancedChen.oddPrimeDivisors N, (↑p - 1) / (↑p - 2)"}
