      "complete_header_as_written": "theorem sharedGeneralD_paired_fourier\n    {p r s s' w N1 N2 : \u2115}\n    (hp : 0 < p) (hr : 0 < r) (hs : 0 < s) (hs' : 0 < s') (hw : 0 < w)\n    (hN1 : 0 < N1) (hN2 : 0 < N2)\n    (hc : ComplexCRT.Compatible (p * (r * s)) (p * w) N1 N2)\n    (hc' : ComplexCRT.Compatible (p * (r * s')) (p * w) N1 N2)\n    (hsame : (r * s').gcd w = (r * s).gcd w) (a h h' : \u2124) :\n    let D := (r * s).gcd w\n    let d := r.gcd D\n    let q := D / d\n    let r0 := r / d\n    let t := s / q\n    let t' := s' / q\n    let g := N1.gcd N2\n    let d1 := CanonicalReciprocalData.supportedPart (N1 / g) g\n    let n1 := CanonicalReciprocalData.coprimePart (N1 / g) g\n    let n2 := N2 / g\n    let A := g * d1\n    let w0 := w / D\n    let b := A * n2 * r0\n    let c := n1 * w0\n    let zeta := c * p * D * r0\n    let K := (p * D) * r0 * w0\n    let L := (p * (r * s)).lcm (p * w)\n    let L' := (p * (r * s')).lcm (p * w)\n    let f : \u2124 := ((d1 : \u2124) * n1 - n2) / (p * D : \u2115)\n    let k : \u2124 := h * (t' : \u2124) - h' * (t : \u2124)\n    let z := t * t'\n    0 < K \u2227 0 < A \u2227 0 < c \u2227\n      s = q * t \u2227 s' = q * t' \u2227\n      b.Coprime c \u2227 zeta.Coprime A \u2227\n      t.Coprime (A * c) \u2227 t'.Coprime (A * c) \u2227\n      L = K * t \u2227 L' = K * t' \u2227\n      fourier h\n        (((ComplexCRT.residue (p * (r * s)) (p * w) N1 N2 a : \u211d) / L : \u211d) :\n          UnitAddCircle) *\n        star (fourier h'\n          (((ComplexCRT.residue (p * (r * s')) (p * w) N1 N2 a : \u211d) / L' : \u211d) :\n            UnitAddCircle)) =\n        fourier 1\n          (((-(a : \u211d) * (k : \u211d) *\n            (CanonicalReciprocalPhase.wPhaseInverse (zeta * z) A : \u211d) / A) : \u211d) :\n              UnitAddCircle) *\n          fourier 1 ((((a : \u211d) * (k : \u211d) /\n            ((N1 : \u211d) * K * z)) : \u211d) : UnitAddCircle) *\n          fourier 1\n            ((((a : \u211d) * (f : \u211d) * (k : \u211d) *\n              (CanonicalReciprocalPhase.wPhaseInverse (b * z) c : \u211d) / c) : \u211d) :\n                UnitAddCircle) := by",
