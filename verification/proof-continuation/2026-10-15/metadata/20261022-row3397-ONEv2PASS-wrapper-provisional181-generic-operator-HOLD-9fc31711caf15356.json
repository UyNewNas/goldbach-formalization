          "first": 94,
          "header_last": 100,
          "complete_source_header": "private theorem atom_factor (d : MediumAtom) (Z : \u211d) (p r s w N1 N2 : \u2115) (h : \u2124) :\n    let L := (p * (r * s)).lcm (p * w)\n    (poissonSmoothLowPass ((d.V / (L : \u211d)) * (h : \u211d) / Z) : \u2102) *\n        poissonNonzeroFrequency (d.V / (L : \u211d))\n          ((ComplexCRT.residue (p * (r * s)) (p * w) N1 N2 d.residue : \u211d) /\n            (L : \u211d)) h =\n      amplitude d Z p r s w h * character p r s w N1 N2 d.residue h := by\n",
          "normalized_lf_header_sha256": "1046963647d59c3231e83349d40743dfbc0fb63e2c7c045520ef87156abfa950",
          "generated_type_checked": false
        },
        {
          "name": "ImbalancedChen.Part3.SharedGeneralDRowAdapter.character_gram_four_branches",
          "visibility": "private",
          "kind": "theorem",
          "first": 109,
          "header_last": 123,
          "complete_source_header": "private theorem character_gram_four_branches\n    {p r s s' w N1 N2 : \u2115}\n    (hp : 0 < p) (hr : 0 < r) (hs : 0 < s) (hs' : 0 < s') (hw : 0 < w)\n    (hN1 : 0 < N1) (hN2 : 0 < N2)\n    (hc : ComplexCRT.Compatible (p * (r * s)) (p * w) N1 N2)\n    (hc' : ComplexCRT.Compatible (p * (r * s')) (p * w) N1 N2)\n    (hsame : (r * s').gcd w = (r * s).gcd w) (a h h' : \u2124)\n    (lambda mu alpha beta : \u2102) :\n    (lambda * ((alpha * character p r s w N1 N2 a h).re : \u2102)) *\n        star (mu * ((beta * character p r s' w N1 N2 a h').re : \u2102)) =\n      (lambda * star mu) / 4 *\n        (alpha * star beta * packet p r s s' w N1 N2 a h h' +\n          alpha * beta * packet p r s s' w N1 N2 a h (-h') +\n          star alpha * star beta * packet p r s s' w N1 N2 a (-h) h' +\n          star alpha * beta * packet p r s s' w N1 N2 a (-h) (-h')) := by\n",
          "normalized_lf_header_sha256": "04a3b328d0cd3bbc756d7c3d10a3f059493ff7c01f3c2185d4c494c7e1bcd222",
          "generated_type_checked": false
