      "complete_source_header": "theorem MediumAtom.card_sharedPrimitiveLargeGCDPairs_le\n    {d : MediumAtom} (hU : 1 ≤ d.U) {Y : ℝ} (hY : 1 ≤ Y)\n    {p : ℕ} (hp : 0 < p) :\n    ((sharedPrimitiveLargeGCDPairs d.transposedAtom.betaCarrier p Y).card : ℝ) ≤\n      8 * d.U ^ 2 / ((p : ℝ) * Y) + 2 * d.U * (1 + Real.log (2 * d.U))"
