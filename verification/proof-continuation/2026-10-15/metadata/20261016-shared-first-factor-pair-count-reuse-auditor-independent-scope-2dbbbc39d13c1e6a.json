      "complete_source_header": "theorem card_sharedPrimitiveLargeGCDPairs_le\n    {T Y : ℝ} (hT : 1 ≤ T) (hY : 1 ≤ Y) {p : ℕ} (hp : 0 < p)\n    (N : Finset ℕ) (hN : N ⊆ Ioc 0 (Nat.floor T)) :\n    ((sharedPrimitiveLargeGCDPairs N p Y).card : ℝ) ≤\n      2 * T ^ 2 / ((p : ℝ) * Y) + T * (1 + Real.log T)"
