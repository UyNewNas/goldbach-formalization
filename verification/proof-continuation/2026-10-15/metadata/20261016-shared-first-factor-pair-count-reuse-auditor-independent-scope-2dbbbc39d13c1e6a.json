      "complete_source_header": "private theorem card_le_sum_divisible (T Y : ℝ) (N : Finset ℕ) (p : ℕ)\n    (hN : N ⊆ Ioc 0 (Nat.floor T)) :\n    (sharedPrimitiveLargeGCDPairs N p Y).card ≤\n      ∑ g ∈ (Ioc 0 (Nat.floor T)).filter (fun g ↦ Y < (g : ℝ) ∧ g.Coprime p),\n        (divisibleCongruentPairs (Nat.floor T) p g).card"
