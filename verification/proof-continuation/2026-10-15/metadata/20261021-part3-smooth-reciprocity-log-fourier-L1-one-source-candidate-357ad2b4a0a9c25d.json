    "all_public_private_complete_literal_headers": [
      {
        "line_1based": 21,
        "private": false,
        "complete_literal_header": "def CommonSmoothCutoff.smoothReciprocityLogSchwartzWeight\n    {d : ℕ} (a b c : EuclideanSpace ℝ (Fin d))\n    (Q : EuclideanSpace ℝ (Fin d) → ℂ)\n    (hQ : ContDiff ℝ ∞ Q) (hQc : HasCompactSupport Q) (Z u₀ rho₀ : ℝ) :\n    𝓢(EuclideanSpace ℝ (Fin d), ℂ)",
        "header_utf8_sha256": "d977b82a4cc5a6d2e64480283c7917b99bba475c8afecc46d71cde88ab327c6b"
      },
      {
        "line_1based": 29,
        "private": false,
        "complete_literal_header": "@[simp] theorem CommonSmoothCutoff.smoothReciprocityLogSchwartzWeight_apply\n    {d : ℕ} (a b c : EuclideanSpace ℝ (Fin d))\n    (Q : EuclideanSpace ℝ (Fin d) → ℂ)\n    (hQ : ContDiff ℝ ∞ Q) (hQc : HasCompactSupport Q) (Z u₀ rho₀ : ℝ)\n    (t : EuclideanSpace ℝ (Fin d)) :\n    smoothReciprocityLogSchwartzWeight a b c Q hQ hQc Z u₀ rho₀ t =\n      smoothReciprocityLogWeight a b c Q Z u₀ rho₀ t",
        "header_utf8_sha256": "1ef9c888d646fa444a28dba8e1022f3867a4bd0bf359414e23a07cbbc50995b9"
      },
      {
        "line_1based": 39,
        "private": true,
        "complete_literal_header": "private def tau : ℝ",
        "header_utf8_sha256": "5377a7c6f1d38a2a3e0b6fccba97a32595b35f165b8700f587bc57ea08602e54"
      },
      {
        "line_1based": 41,
        "private": true,
        "complete_literal_header": "private theorem tau_nonneg : 0 ≤ tau",
        "header_utf8_sha256": "14a82ff2141f22bdeeae9e86e01463ece7e1aff5e48606eb1a1300ebb3017231"
      },
      {
        "line_1based": 45,
        "private": true,
        "complete_literal_header": "private theorem word_norm_le {n : ℕ}\n    (f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ))\n    (m : Fin n → EuclideanSpace ℝ (Fin d))\n    (hm : ∀ i, ‖m i‖ ≤ 1) (x : EuclideanSpace ℝ (Fin d)) (B : ℝ)\n    (hB : ‖iteratedFDeriv ℝ n f x‖ ≤ B) : ‖∂^{m} f x‖ ≤ B",
        "header_utf8_sha256": "66e92447e390f114478a831c661cc92b358d46e191f8974548fd94e7f209d97f"
      },
      {
        "line_1based": 54,
        "private": true,
        "complete_literal_header": "private theorem laplacian_sq_sum\n    (e : OrthonormalBasis (Fin d) ℝ (EuclideanSpace ℝ (Fin d)))\n    (f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) :\n    Δ (Δ f) = ∑ i : Fin d, ∑ j : Fin d,\n      ∂_{e i} (∂_{e i} (∂_{e j} (∂_{e j} f)))",
        "header_utf8_sha256": "251e4de59dbab5fa86d4b4fcd3f863920b69cccc6d6761da5996feb948258faa"
      },
      {
        "line_1based": 62,
        "private": true,
        "complete_literal_header": "private theorem laplacian_norm_le\n    (f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (x : EuclideanSpace ℝ (Fin d))\n    (B : ℝ) (hB : ‖iteratedFDeriv ℝ 2 f x‖ ≤ B) :\n    ‖Δ f x‖ ≤ (d : ℝ) * B",
        "header_utf8_sha256": "5e667f49c1bb13ed5bf83de81e214c5c0960241c831e2762f792ddcea3d5872f"
      },
      {
        "line_1based": 80,
        "private": true,
        "complete_literal_header": "private theorem laplacian_sq_norm_le\n    (f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (x : EuclideanSpace ℝ (Fin d))\n    (B : ℝ) (hB : ‖iteratedFDeriv ℝ 4 f x‖ ≤ B) :\n    ‖Δ (Δ f) x‖ ≤ (d : ℝ) ^ 2 * B",
        "header_utf8_sha256": "8dcae5c79e78db802e29aee3457f1df40a225fdff969a4d28764c5040f52d164"
      },
      {
        "line_1based": 104,
        "private": true,
        "complete_literal_header": "private theorem normalizedFourth_apply\n    (f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (x : EuclideanSpace ℝ (Fin d)) :\n    normalizedFourth f x = (f x - tau • Δ f x) -\n      tau • (Δ f x - tau • Δ (Δ f) x)",
        "header_utf8_sha256": "24d0831cd70ca24f3e4b028d5a559336941cc875fb169e0766a1e063bfe2d29c"
      },
      {
        "line_1based": 117,
        "private": true,
        "complete_literal_header": "private theorem normalizedFourth_norm_le\n    (f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (x : EuclideanSpace ℝ (Fin d))\n    (B : ℝ) (hjet : ∀ j : ℕ, j ≤ 4 → ‖iteratedFDeriv ℝ j f x‖ ≤ B) :\n    ‖normalizedFourth f x‖ ≤ (1 + tau * d) ^ 2 * B",
        "header_utf8_sha256": "8c42e48a5549ee06420f6c5b6b477a87b1d427e65e66800196896ffcb9a002df"
      },
      {
        "line_1based": 144,
        "private": true,
        "complete_literal_header": "private theorem normalizedFourth_zero_off_support\n    (f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (x : EuclideanSpace ℝ (Fin d))\n    (hx : x ∉ tsupport f) : normalizedFourth f x = 0",
        "header_utf8_sha256": "3e528bd9b44ebae0ff274d7e7b06d4718be3683b7d7d83f49586d327e81a802c"
      },
      {
        "line_1based": 171,
        "private": true,
        "complete_literal_header": "private theorem normalizedFourth_sqrt_integral_le\n    (f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ))\n    (K : Set (EuclideanSpace ℝ (Fin d))) (hK : IsCompact K)\n    (hsupport : tsupport f ⊆ K) (B : ℝ) (hB : 0 ≤ B)\n    (hbound : ∀ x, ‖normalizedFourth f x‖ ≤ B) :\n    Real.sqrt (∫ x, ‖normalizedFourth f x‖ ^ 2) ≤ B * Real.sqrt (volume.real K)",
        "header_utf8_sha256": "31213d3144543845235706b4f19bb2a89b0cd1352e30c0e202c4a203a4d487e0"
      },
      {
        "line_1based": 200,
        "private": false,
        "complete_literal_header": "theorem CommonSmoothCutoff.smoothReciprocityLogWeight_fourier_integral_norm_uniform\n    {d : ℕ} (hd : d < 8) (a b c : EuclideanSpace ℝ (Fin d))\n    (Q : EuclideanSpace ℝ (Fin d) → ℂ)\n    (hQ : ContDiff ℝ ∞ Q) (hQc : HasCompactSupport Q) :\n    ∃ C : ℝ, 0 < C ∧\n      ∀ Z u₀ rho₀ R : ℝ, 1 ≤ Z → 0 ≤ R →\n        (∀ t ∈ tsupport Q, |rho₀ * Real.exp (inner ℝ b t)| ≤ R) →\n        (∫ ξ : EuclideanSpace ℝ (Fin d),\n          ‖𝓕 (smoothReciprocityLogWeight a b c Q Z u₀ rho₀) ξ‖) ≤ C * (1 + R) ^ 4",
        "header_utf8_sha256": "9c20fa963747e52ab31dea94297e610f2cd23a6a6022bdd28230eabf99cb5c89"
      }
