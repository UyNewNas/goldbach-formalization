      "complete_header": "private theorem moebius_norm_sq_le_one (e : ℕ) :\n    ‖(ArithmeticFunction.moebius e : ℂ)‖ ^ 2 ≤ 1"
    },
    {
      "name": "character_eq_primitive_indicator",
      "kind": "theorem",
      "line": 74,
      "complete_header": "private theorem character_eq_primitive_indicator {q : ℕ} (hq : 0 < q)\n    (chi : DirichletCharacter ℂ q) (n : ℕ) :\n    chi (n : ZMod q) =\n      chi.primitiveCharacter (n : ZMod chi.conductor) *\n        (if n.Coprime q then (1 : ℂ) else 0)"
    },
    {
      "name": "sum_multiples",
      "kind": "theorem",
      "line": 91,
      "complete_header": "private theorem sum_multiples (N e : ℕ) (he : 0 < e) (f : ℕ → ℂ) :\n    (∑ n ∈ Finset.Icc 1 N with e ∣ n, f n) =\n      ∑ m ∈ Finset.Icc 1 (N / e), f (e * m)"
    },
    {
      "name": "sum_multiples_real",
      "kind": "theorem",
      "line": 114,
      "complete_header": "private theorem sum_multiples_real (N e : ℕ) (he : 0 < e) (f : ℕ → ℝ) :\n    (∑ n ∈ Finset.Icc 1 N with e ∣ n, f n) =\n      ∑ m ∈ Finset.Icc 1 (N / e), f (e * m)"
    },
    {
      "name": "divisible_auxiliary_sum",
      "kind": "theorem",
      "line": 121,
      "complete_header": "private theorem divisible_auxiliary_sum (N k e c : ℕ) (he : 0 < e)\n    (b : ℕ → ℂ) (psi : DirichletCharacter ℂ c) :\n    (∑ n ∈ Finset.Icc 1 N,\n      if e ∣ n then (if n.Coprime k then b n else 0) * psi (n : ZMod c) else 0) =\n      if e.Coprime k then\n        psi (e : ZMod c) *\n          ∑ m ∈ Finset.Icc 1 (N / e),\n            (if m.Coprime k then b (e * m) else 0) * psi (m : ZMod c)\n      else 0"
    },
    {
      "name": "auxiliary_character_sum_eq_moebius",
      "kind": "theorem",
      "line": 150,
      "complete_header": "private theorem auxiliary_character_sum_eq_moebius {q : ℕ} (hq : 0 < q)\n    (N k : ℕ) (b : ℕ → ℂ) (chi : DirichletCharacter ℂ q) :\n    (∑ n ∈ Finset.Icc 1 N,\n      (if n.Coprime k then b n else 0) * chi (n : ZMod q)) =\n      ∑ e ∈ q.divisors, (ArithmeticFunction.moebius e : ℂ) *\n        ∑ n ∈ Finset.Icc 1 N,\n          if e ∣ n then\n            (if n.Coprime k then b n else 0) *\n              chi.primitiveCharacter (n : ZMod chi.conductor)\n          else 0"
    },
    {
      "name": "auxiliary_character_sum_eq_moebius_quotient",
      "kind": "theorem",
      "line": 185,
      "complete_header": "private theorem auxiliary_character_sum_eq_moebius_quotient {q : ℕ}\n    (hq : 0 < q) (N k : ℕ) (b : ℕ → ℂ) (chi : DirichletCharacter ℂ q) :\n    (∑ n ∈ Finset.Icc 1 N,\n      (if n.Coprime k then b n else 0) * chi (n : ZMod q)) =\n      ∑ e ∈ q.divisors,\n        if e.Coprime (chi.conductor * k) then\n          (ArithmeticFunction.moebius e : ℂ) *\n            chi.primitiveCharacter (e : ZMod chi.conductor) *\n              ∑ m ∈ Finset.Icc 1 (N / e),\n                (if m.Coprime k then b (e * m) else 0) *\n                  chi.primitiveCharacter (m : ZMod chi.conductor)\n        else 0"
    },
    {
      "name": "auxiliary_character_sum_sq_le_moebius",
      "kind": "theorem",
      "line": 219,
      "complete_header": "private theorem auxiliary_character_sum_sq_le_moebius {q : ℕ}\n    (hq : 0 < q) (N k : ℕ) (b : ℕ → ℂ) (chi : DirichletCharacter ℂ q) :\n    ‖∑ n ∈ Finset.Icc 1 N,\n      (if n.Coprime k then b n else 0) * chi (n : ZMod q)‖ ^ 2 ≤\n      divisorTau q * ∑ e ∈ q.divisors,\n        if e.Coprime (chi.conductor * k) then\n          ‖∑ m ∈ Finset.Icc 1 (N / e),\n            (if m.Coprime k then b (e * m) else 0) *\n              chi.primitiveCharacter (m : ZMod chi.conductor)‖ ^ 2\n        else 0"
    },
    {
      "name": "auxiliary_multiple_energy_le",
      "kind": "theorem",
      "line": 246,
      "complete_header": "private theorem auxiliary_multiple_energy_le (N e k : ℕ) (he : 0 < e)\n    (b : ℕ → ℂ) (hb : ∀ n ∈ Finset.Icc 1 N, ‖b n‖ ≤ 1) :\n    (∑ m ∈ Finset.Icc 1 (N / e),\n      ‖if m.Coprime k then b (e * m) else 0‖ ^ 2) ≤ ((N / e : ℕ) : ℝ)"
    },
    {
      "name": "sum_tau_ratio_le",
      "kind": "theorem",
      "line": 265,
      "complete_header": "private theorem sum_tau_ratio_le (T : ℕ) :\n    (∑ r ∈ Finset.Icc 1 T, divisorTau r * ((r : ℝ) / (r.totient : ℝ))) ≤\n      (T : ℝ) * (1 + Real.log (T : ℝ)) ^ 3"
    },
    {
      "name": "tau_weighted_multiples_le",
      "kind": "theorem",
      "line": 292,
      "complete_header": "private theorem tau_weighted_multiples_le (Q c : ℕ) (hc : 0 < c) :\n    (∑ q ∈ Finset.Icc 1 Q with c ∣ q,\n      divisorTau q * ((q : ℝ) / (q.totient : ℝ))) ≤\n        divisorTau c * ((c : ℝ) / (c.totient : ℝ)) *\n          ((Q / c : ℕ) : ℝ) * (1 + Real.log ((Q / c : ℕ) : ℝ)) ^ 3"
    },
    {
      "name": "tau_weighted_product_fibre_le",
      "kind": "theorem",
      "line": 322,
      "complete_header": "private theorem tau_weighted_product_fibre_le (Q c e : ℕ)\n    (hQ : 0 < Q) (hc : 0 < c) (he : 0 < e) :\n    (∑ q ∈ Finset.Icc 1 Q with c * e ∣ q,\n      divisorTau q * ((q : ℝ) / (q.totient : ℝ))) ≤\n        (divisorTau c * ((c : ℝ) / (c.totient : ℝ))) *\n          (divisorTau e / (e.totient : ℝ)) * ((Q : ℝ) / (c : ℝ)) *\n            (1 + Real.log (Q : ℝ)) ^ 3"
    }
