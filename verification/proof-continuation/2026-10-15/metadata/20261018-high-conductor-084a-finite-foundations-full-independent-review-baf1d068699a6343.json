      "name": "coprime_indicator_complex",
      "kind": "theorem",
      "line": 54,
      "complete_header": "private theorem coprime_indicator_complex {q : ℕ} (hq : q ≠ 0) (n : ℕ) :\n    (if n.Coprime q then (1 : ℂ) else 0) =\n      ∑ e ∈ q.divisors,\n        if e ∣ n then (ArithmeticFunction.moebius e : ℂ) else 0"
    },
