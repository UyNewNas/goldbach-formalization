      {
        "line_1based": 186,
        "private": true,
        "complete_literal_header": "private theorem normalizedFourth_integral_norm_le\n    (f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ))\n    (K : Set (EuclideanSpace ℝ (Fin d))) (hK : IsCompact K)\n    (hsupport : tsupport f ⊆ K) (B : ℝ)\n    (hbound : ∀ x, ‖normalizedFourth f x‖ ≤ B) :\n    (∫ x, ‖normalizedFourth f x‖) ≤ B * volume.real K",
