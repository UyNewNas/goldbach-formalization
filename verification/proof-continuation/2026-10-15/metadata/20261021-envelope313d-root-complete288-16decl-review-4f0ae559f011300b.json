      {
        "line_1based": 163,
        "private": true,
        "complete_literal_header": "private theorem fourier_normalizedStep_apply (f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (ξ : EuclideanSpace ℝ (Fin d)) :\n    𝓕 (normalizedStep f) ξ = (1 + ‖ξ‖ ^ 2) • 𝓕 f ξ",
