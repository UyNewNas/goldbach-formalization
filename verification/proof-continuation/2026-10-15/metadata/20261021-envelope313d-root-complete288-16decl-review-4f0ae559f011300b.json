      },
      {
        "line_1based": 153,
        "private": true,
        "complete_literal_header": "private theorem fourier_laplacian_apply (f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (ξ : EuclideanSpace ℝ (Fin d)) :\n    𝓕 (Δ f) ξ = (-(2 * Real.pi) ^ 2 * ‖ξ‖ ^ 2) • 𝓕 f ξ",
