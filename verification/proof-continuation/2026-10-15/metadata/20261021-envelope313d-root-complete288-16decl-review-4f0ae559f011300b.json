      {
        "line_1based": 181,
        "private": true,
        "complete_literal_header": "private theorem fourier_normalizedFourth_apply (f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ)) (ξ : EuclideanSpace ℝ (Fin d)) :\n    𝓕 (normalizedFourth f) ξ = (1 + ‖ξ‖ ^ 2) ^ 2 • 𝓕 f ξ",
