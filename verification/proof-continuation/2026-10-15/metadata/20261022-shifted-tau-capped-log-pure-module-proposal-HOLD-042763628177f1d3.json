        "first_line": 157,
        "last_line": 165,
        "complete_written_type": "theorem shifted_tau_uniform_fixed_order (K : ℕ) (hK : 2 ≤ K) :\n    ∃ C : ℝ, 0 < C ∧ ∀ (x κ : ℝ), 1 ≤ x → 0 ≤ κ → κ ≤ 1 / (2 * (K : ℝ)) →\n      ∀ a : ℤ, |(a : ℝ)| ≤ x ^ (1 + κ) →\n        (∑ v ∈ (Ioc 0 ⌊6 * x⌋₊).filter (fun v => (v : ℤ) ≠ a),\n          (fouvryTau K ((v : ℤ) - a).natAbs : ℝ)) ≤\n          C * x * (1 + Real.log x) ^ (K - 1) := by\n",
