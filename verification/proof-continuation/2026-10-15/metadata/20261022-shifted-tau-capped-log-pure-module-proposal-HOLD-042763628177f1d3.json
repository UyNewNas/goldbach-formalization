        "complete_written_type": "theorem shifted_tau_Ioc_capped_log_sum_le {K : ℕ} (hK : 2 ≤ K) {x κ : ℝ}\n    (hx : 1 ≤ x) (hκ : 0 ≤ κ) (hcap : κ ≤ 1 / (2 * (K : ℝ)))\n    (a : ℤ) (ha : |(a : ℝ)| ≤ x ^ (1 + κ)) :\n    (∑ v ∈ (Ioc 0 ⌊6 * x⌋₊).filter (fun v => (v : ℤ) ≠ a),\n      (fouvryTau K ((v : ℤ) - a).natAbs : ℝ)) ≤\n      shiftedTauLogConstant K * x * (1 + Real.log x) ^ (K - 1) := by\n",
