        "complete_written_type": "theorem capped_shift_payment_le_constant {K : ℕ} (hK : 2 ≤ K) {x κ : ℝ}\n    (hx : 1 ≤ x) (hκ : 0 ≤ κ) (hcap : κ ≤ 1 / (2 * (K : ℝ))) :\n    2 * (K : ℝ) * (6 * x * (1 + Real.log (7 * x ^ (1 + κ))) ^ (K - 1) +\n      (7 * x ^ (1 + κ)) ^ (1 - 1 / (K : ℝ)) *\n        (1 + Real.log (7 * x ^ (1 + κ))) ^ (K - 2)) ≤\n      shiftedTauLogConstant K * x * (1 + Real.log x) ^ (K - 1) := by\n",
