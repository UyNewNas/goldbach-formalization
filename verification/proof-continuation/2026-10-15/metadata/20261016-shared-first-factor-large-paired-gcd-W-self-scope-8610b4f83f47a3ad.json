      "name": "MediumAtom.sharedLargePairedGCDW",
      "kind": "def",
      "private": false,
      "line": 25,
      "complete_header": "def MediumAtom.sharedLargePairedGCDW (d : MediumAtom) (Y : ℝ) : ℂ",
      "complete_definition": "def MediumAtom.sharedLargePairedGCDW (d : MediumAtom) (Y : ℝ) : ℂ :=\n  ∑ p ∈ d.primitiveFirstFactorCarrier,\n    (d.q1SliceAtom p).transposedAtom.commonLargeBetaGCDW Y"
    },
    {
      "name": "absoluteRow_le_tauFour_of_not_dvd",
      "kind": "theorem",
      "private": true,
      "line": 33,
      "complete_header": "private theorem absoluteRow_le_tauFour_of_not_dvd\n    {B : ℕ} {sigma kappa c0 : ℝ} {d : MediumAtom}\n    (hd : MediumAdmissible B sigma kappa c0 d) (m n : ℕ)\n    (hn : ¬(n : ℤ) ∣ d.residue) :\n    d.absoluteFactorModulusRow m n ≤\n      (fouvryTau 4 (((m : ℤ) * n - d.residue).natAbs) : ℝ)"
    },
    {
      "name": "one_le_scale",
      "kind": "theorem",
      "private": true,
      "line": 55,
      "complete_header": "private theorem one_le_scale\n    {B : ℕ} {sigma kappa c0 : ℝ} {d : MediumAtom}\n    (hd : MediumAdmissible B sigma kappa c0 d) : 1 ≤ d.scale"
    },
    {
      "name": "actual_difference_le_polynomial",
      "kind": "theorem",
      "private": true,
      "line": 63,
      "complete_header": "private theorem actual_difference_le_polynomial\n    {B : ℕ} {sigma kappa c0 : ℝ} {d : MediumAtom}\n    (hd : MediumAdmissible B sigma kappa c0 d) {m n : ℕ}\n    (hn : n ∈ d.transposedAtom.betaCarrier)\n    (hm : d.transposedAtom.commonSmoothWeight m ≠ 0) :\n    (((m : ℤ) * n - d.residue).natAbs : ℝ) ≤\n      7 * d.scale ^ (max 1 (1 + kappa))"
    },
    {
      "name": "tauFour_difference_subpower",
      "kind": "theorem",
      "private": true,
      "line": 103,
      "complete_header": "private theorem tauFour_difference_subpower (kappa : ℝ) {epsilon : ℝ}\n    (hepsilon : 0 < epsilon) :\n    ∃ C : ℝ, 0 < C ∧ ∀ (B : ℕ) (sigma c0 : ℝ) (d : MediumAtom),\n      MediumAdmissible B sigma kappa c0 d → ∀ m n : ℕ,\n        n ∈ d.transposedAtom.betaCarrier → d.transposedAtom.commonSmoothWeight m ≠ 0 →\n          ¬(n : ℤ) ∣ d.residue →\n            (fouvryTau 4 (((m : ℤ) * n - d.residue).natAbs) : ℝ) ≤\n              C * d.scale ^ (epsilon / 2)"
    },
    {
      "name": "p_pos_lower",
      "kind": "theorem",
      "private": true,
      "line": 136,
      "complete_header": "private theorem p_pos_lower\n    {B : ℕ} {sigma kappa c0 : ℝ} {d : MediumAtom}\n    (hd : MediumAdmissible B sigma kappa c0 d) {p : ℕ}\n    (hp : p ∈ d.primitiveFirstFactorCarrier) : 0 < p ∧ d.Q1 ≤ (p : ℝ)"
    },
    {
      "name": "p_coprime_residue",
      "kind": "theorem",
      "private": true,
      "line": 145,
      "complete_header": "private theorem p_coprime_residue\n    {d : MediumAtom} {p : ℕ} (hp : p ∈ d.primitiveFirstFactorCarrier) :\n    Int.gcd d.residue p = 1"
    },
    {
      "name": "slice_gamma",
      "kind": "theorem",
      "private": true,
      "line": 150,
      "complete_header": "private theorem slice_gamma (d : MediumAtom) (p : ℕ) (r : ℕ × ℕ × ℕ) :\n    (d.q1SliceAtom p).transposedAtom.complexFactorGamma r =\n      (if r.1 = p then (1 : ℂ) else 0) * d.gamma2 r.2.1 * d.gamma3 r.2.2"
    },
    {
      "name": "absoluteRow_eq_zero_of_not_product",
      "kind": "theorem",
      "private": true,
      "line": 155,
      "complete_header": "private theorem absoluteRow_eq_zero_of_not_product (d : MediumAtom) (p m n : ℕ)\n    (hnot : ¬Int.ModEq p ((m : ℤ) * n) d.residue) :\n    (d.q1SliceAtom p).transposedAtom.absoluteFactorModulusRow m n = 0"
    },
    {
      "name": "coprime_of_product_congruent",
      "kind": "theorem",
      "private": true,
      "line": 177,
      "complete_header": "private theorem coprime_of_product_congruent {a : ℤ} {p n m : ℕ}\n    (ha : Int.gcd a p = 1) (h : Int.ModEq p ((n : ℤ) * m) a) :\n    n.Coprime p ∧ m.Coprime p"
    },
    {
      "name": "shared_conditions_of_products",
      "kind": "theorem",
      "private": true,
      "line": 186,
      "complete_header": "private theorem shared_conditions_of_products {a : ℤ} {p m n₁ n₂ : ℕ}\n    (hp : 0 < p) (ha : Int.gcd a p = 1)\n    (h₁ : Int.ModEq p ((m : ℤ) * n₁) a)\n    (h₂ : Int.ModEq p ((m : ℤ) * n₂) a) :\n    n₁.Coprime p ∧ n₂.Coprime p ∧ Nat.ModEq p n₁ n₂"
    },
    {
      "name": "sum_weight_product_le",
      "kind": "theorem",
      "private": true,
      "line": 201,
      "complete_header": "private theorem sum_weight_product_le\n    {d : MediumAtom} (hV : 1 ≤ d.V) {p n : ℕ}\n    (hp : 0 < p) (hn : n.Coprime p) (a : ℤ) :\n    (∑ m ∈ d.transposedAtom.commonSmoothCarrier,\n      if Int.ModEq p ((m : ℤ) * n) a then\n        d.transposedAtom.commonSmoothWeight m else 0) ≤ 4 * d.V / p + 1"
    },
    {
      "name": "sum_weight_two_products_le",
      "kind": "theorem",
      "private": true,
      "line": 232,
      "complete_header": "private theorem sum_weight_two_products_le\n    {d : MediumAtom} (hV : 1 ≤ d.V) {p : ℕ} (hp : 0 < p)\n    (ha : Int.gcd d.residue p = 1) (n₁ n₂ : ℕ) :\n    (∑ m ∈ d.transposedAtom.commonSmoothCarrier,\n      if Int.ModEq p ((m : ℤ) * n₁) d.residue ∧\n          Int.ModEq p ((m : ℤ) * n₂) d.residue then\n        d.transposedAtom.commonSmoothWeight m else 0) ≤\n      if n₁.Coprime p ∧ n₂.Coprime p ∧ Nat.ModEq p n₁ n₂ then\n        4 * d.V / p + 1 else 0"
    },
    {
      "name": "slice_factorPair_norm_subpower",
      "kind": "theorem",
      "private": true,
      "line": 264,
      "complete_header": "private theorem slice_factorPair_norm_subpower (kappa : ℝ) {epsilon : ℝ}\n    (hepsilon : 0 < epsilon) :\n    ∃ C : ℝ, 0 < C ∧ ∀ (B : ℕ) (sigma c0 : ℝ) (d : MediumAtom),\n      MediumAdmissible B sigma kappa c0 d → ∀ p : ℕ,\n        p ∈ d.primitiveFirstFactorCarrier → ∀ n₁ n₂ : ℕ,\n          n₁ ∈ d.transposedAtom.betaCarrier → n₂ ∈ d.transposedAtom.betaCarrier →\n            ¬(n₁ : ℤ) ∣ d.residue → ¬(n₂ : ℤ) ∣ d.residue →\n              ‖(d.q1SliceAtom p).transposedAtom.commonFactorPairWeight n₁ n₂‖ ≤\n                C * d.scale ^ epsilon *\n                  (if n₁.Coprime p ∧ n₂.Coprime p ∧ Nat.ModEq p n₁ n₂ then\n                    4 * d.V / p + 1 else 0)"
    },
    {
      "name": "cleaned_beta_norm_le_one",
      "kind": "theorem",
      "private": true,
      "line": 340,
      "complete_header": "private theorem cleaned_beta_norm_le_one\n    {B : ℕ} {sigma kappa c0 : ℝ} {d : MediumAtom}\n    (hd : MediumAdmissible B sigma kappa c0 d) (n : ℕ) :\n    ‖d.cleanedAlphaAtom.transposedAtom.beta n‖ ≤ 1"
    },
    {
      "name": "card_primitiveCarrier_le",
      "kind": "theorem",
      "private": true,
      "line": 353,
      "complete_header": "private theorem card_primitiveCarrier_le\n    {B : ℕ} {sigma kappa c0 : ℝ} {d : MediumAtom}\n    (hd : MediumAdmissible B sigma kappa c0 d) :\n    (d.primitiveFirstFactorCarrier.card : ℝ) ≤ 2 * d.Q1"
    },
    {
      "name": "cleanedAlpha_sharedLargePairedGCDW_bound",
      "kind": "theorem",
      "private": false,
      "line": 370,
      "complete_header": "theorem cleanedAlpha_sharedLargePairedGCDW_bound (kappa : ℝ) {epsilon : ℝ}\n    (hepsilon : 0 < epsilon) :\n    ∃ C : ℝ, 0 < C ∧ ∀ (B : ℕ) (sigma c0 : ℝ) (d : MediumAtom),\n      MediumAdmissible B sigma kappa c0 d → ∀ Y : ℝ, 1 ≤ Y →\n        ‖d.cleanedAlphaAtom.sharedLargePairedGCDW Y‖ ≤\n          C * d.scale ^ epsilon * (4 * d.V / d.Q1 + 1) *\n            (16 * d.U ^ 2 / Y + 4 * d.Q1 * d.U * (1 + Real.log (2 * d.U)))"
    }
