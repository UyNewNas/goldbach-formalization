  "complete_declarations": [
    {
      "name": "sharedPrimitiveLargeGCDPairs",
      "kind": "def",
      "private": false,
      "line": 23,
      "complete_header": "def sharedPrimitiveLargeGCDPairs (N : Finset ℕ) (p : ℕ) (Y : ℝ) :\n    Finset (ℕ × ℕ)",
      "complete_definition": "def sharedPrimitiveLargeGCDPairs (N : Finset ℕ) (p : ℕ) (Y : ℝ) :\n    Finset (ℕ × ℕ) :=\n  (N ×ˢ N).filter (fun z ↦ z.1.Coprime p ∧ z.2.Coprime p ∧\n    Nat.ModEq p z.1 z.2 ∧ Y < (z.1.gcd z.2 : ℝ))"
    },
    {
      "name": "congruentPairs",
      "kind": "def",
      "private": true,
      "line": 30,
      "complete_header": "private def congruentPairs (K p : ℕ) : Finset (ℕ × ℕ)",
      "complete_definition": "private def congruentPairs (K p : ℕ) : Finset (ℕ × ℕ) :=\n  (Ioc 0 K ×ˢ Ioc 0 K).filter (fun z ↦ Nat.ModEq p z.1 z.2)"
    },
    {
      "name": "divisibleCongruentPairs",
      "kind": "def",
      "private": true,
      "line": 33,
      "complete_header": "private def divisibleCongruentPairs (K p g : ℕ) : Finset (ℕ × ℕ)",
      "complete_definition": "private def divisibleCongruentPairs (K p g : ℕ) : Finset (ℕ × ℕ) :=\n  (Ioc 0 K ×ˢ Ioc 0 K).filter (fun z ↦\n    g ∣ z.1 ∧ g ∣ z.2 ∧ Nat.ModEq p z.1 z.2)"
    },
    {
      "name": "card_congruentPairs_le",
      "kind": "theorem",
      "private": true,
      "line": 38,
      "complete_header": "private theorem card_congruentPairs_le (K p : ℕ) :\n    (congruentPairs K p).card ≤ K * (K / p + 1)"
    },
    {
      "name": "card_divisibleCongruentPairs_le",
      "kind": "theorem",
      "private": true,
      "line": 60,
      "complete_header": "private theorem card_divisibleCongruentPairs_le (K p g : ℕ)\n    (hg : 0 < g) (hgp : g.Coprime p) :\n    (divisibleCongruentPairs K p g).card ≤ (K / g) * ((K / g) / p + 1)"
    },
    {
      "name": "sum_inv_sq_Icc_le",
      "kind": "theorem",
      "private": true,
      "line": 93,
      "complete_header": "private theorem sum_inv_sq_Icc_le (M K : ℕ) (hM : 0 < M) :\n    (∑ g ∈ Icc M K, ((g : ℝ)⁻¹) ^ 2) ≤ 2 / M"
    },
    {
      "name": "sum_inv_sq_large_le",
      "kind": "theorem",
      "private": true,
      "line": 130,
      "complete_header": "private theorem sum_inv_sq_large_le (T Y : ℝ) (hY : 1 ≤ Y)\n    (G : Finset ℕ) (hG : ∀ g ∈ G, g ≤ Nat.floor T ∧ Y < (g : ℝ)) :\n    (∑ g ∈ G, ((g : ℝ)⁻¹) ^ 2) ≤ 2 / Y"
    },
    {
      "name": "sum_inv_le_log",
      "kind": "theorem",
      "private": true,
      "line": 152,
      "complete_header": "private theorem sum_inv_le_log {T : ℝ} (hT : 1 ≤ T)\n    (G : Finset ℕ) (hG : G ⊆ Ioc 0 (Nat.floor T)) :\n    (∑ g ∈ G, (g : ℝ)⁻¹) ≤ 1 + Real.log T"
    },
    {
      "name": "card_le_sum_divisible",
      "kind": "theorem",
      "private": true,
      "line": 168,
      "complete_header": "private theorem card_le_sum_divisible (T Y : ℝ) (N : Finset ℕ) (p : ℕ)\n    (hN : N ⊆ Ioc 0 (Nat.floor T)) :\n    (sharedPrimitiveLargeGCDPairs N p Y).card ≤\n      ∑ g ∈ (Ioc 0 (Nat.floor T)).filter (fun g ↦ Y < (g : ℝ) ∧ g.Coprime p),\n        (divisibleCongruentPairs (Nat.floor T) p g).card"
    },
    {
      "name": "card_sharedPrimitiveLargeGCDPairs_le",
      "kind": "theorem",
      "private": false,
      "line": 209,
      "complete_header": "theorem card_sharedPrimitiveLargeGCDPairs_le\n    {T Y : ℝ} (hT : 1 ≤ T) (hY : 1 ≤ Y) {p : ℕ} (hp : 0 < p)\n    (N : Finset ℕ) (hN : N ⊆ Ioc 0 (Nat.floor T)) :\n    ((sharedPrimitiveLargeGCDPairs N p Y).card : ℝ) ≤\n      2 * T ^ 2 / ((p : ℝ) * Y) + T * (1 + Real.log T)"
    },
    {
      "name": "MediumAtom.card_sharedPrimitiveLargeGCDPairs_le",
      "kind": "theorem",
      "private": false,
      "line": 255,
      "complete_header": "theorem MediumAtom.card_sharedPrimitiveLargeGCDPairs_le\n    {d : MediumAtom} (hU : 1 ≤ d.U) {Y : ℝ} (hY : 1 ≤ Y)\n    {p : ℕ} (hp : 0 < p) :\n    ((sharedPrimitiveLargeGCDPairs d.transposedAtom.betaCarrier p Y).card : ℝ) ≤\n      8 * d.U ^ 2 / ((p : ℝ) * Y) + 2 * d.U * (1 + Real.log (2 * d.U))"
    }
  ],
