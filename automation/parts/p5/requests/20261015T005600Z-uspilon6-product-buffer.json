  "source_types_not_compiler_confirmed": {
    "currentChenUpsilon6RetainedSelector": "def currentChenUpsilon6RetainedSelector (N : ℕ) (E : ℕ × ℕ → Prop)\n    (eta : ℝ) : Finset (ℕ × ℕ)",
    "currentChenUpsilon6Retained": "def currentChenUpsilon6Retained (N : ℕ) (E : ℕ × ℕ → Prop) (eta : ℝ) : ℝ",
    "currentChenUpsilon6Retained_nonneg": "theorem currentChenUpsilon6Retained_nonneg (N : ℕ) (E : ℕ × ℕ → Prop)\n    (eta : ℝ) : 0 ≤ currentChenUpsilon6Retained N E eta",
    "currentChenUpsilon6Retained_add_discarded": "theorem currentChenUpsilon6Retained_add_discarded (N : ℕ)\n    (E : ℕ × ℕ → Prop) (eta : ℝ) :\n    currentChenUpsilon6Retained N E eta +\n      (∑ t ∈ ((chenY6PrimeSelector N ((N : ℝ) ^ (417 / 5000 : ℝ))\n          ((N : ℝ) ^ (19 / 125 : ℝ)) ((N : ℝ) ^ (59 / 250 : ℝ))).filter\n            (fun t => ¬ E t)).filter\n              (fun t => ¬ ((t.1 * t.2 : ℕ) : ℝ) ≤\n                (N : ℝ) ^ ((1 / 2 : ℝ) - 2 * (417 / 5000 : ℝ) - eta)),\n        ((chenSiftedQuotientPrimeSource N (t.1 * t.2)\n          ((N : ℝ) ^ (417 / 5000 : ℝ))).card : ℝ)) =\n      currentChenUpsilon6 N E",
    "currentChenUpsilon6Retained_le": "theorem currentChenUpsilon6Retained_le (N : ℕ) (E : ℕ × ℕ → Prop)\n    (eta : ℝ) : currentChenUpsilon6Retained N E eta ≤ currentChenUpsilon6 N E",
    "currentChenUpsilon6Retained_product_lt": "theorem currentChenUpsilon6Retained_product_lt {N : ℕ}\n    (hN : (1 : ℝ) < N) {E : ℕ × ℕ → Prop} {eta : ℝ} (heta : 0 < eta)\n    {t : ℕ × ℕ} (ht : t ∈ currentChenUpsilon6RetainedSelector N E eta) :\n    ((t.1 * t.2 : ℕ) : ℝ) <\n      (N : ℝ) ^ ((1 / 2 : ℝ) - 2 * (417 / 5000 : ℝ))",
    "eventually_currentChenUpsilon6_buffered_level": "theorem eventually_currentChenUpsilon6_buffered_level (B eta : ℝ)\n    (heta : 0 < eta) :\n    ∀ᶠ N : ℕ in atTop, ∀ b : ℕ, 0 < b →\n      (b : ℝ) ≤ (N : ℝ) ^ ((1 / 2 : ℝ) - 2 * (417 / 5000 : ℝ) - eta) →\n      b ≤ chenInitialLevelCap B N ∧\n      (N : ℝ) ^ (eta / 2) <\n        (chenQuotientRosserD B N b : ℝ) / ((N : ℝ) ^ (417 / 5000 : ℝ)) ^ 2 ∧\n      2 < chenQuotientRosserT B (417 / 5000 : ℝ) N b",
    "eventually_currentChenUpsilon6Retained_physical_gates": "theorem eventually_currentChenUpsilon6Retained_physical_gates (B eta : ℝ)\n    (heta : 0 < eta) :\n    ∀ᶠ N : ℕ in atTop, ∀ E : ℕ × ℕ → Prop,\n      ∀ t ∈ currentChenUpsilon6RetainedSelector N E eta,\n        t.1 * t.2 ≤ chenInitialLevelCap B N ∧\n        1 < (chenQuotientRosserD B N (t.1 * t.2) : ℝ) /\n          ((N : ℝ) ^ (417 / 5000 : ℝ)) ^ 2 ∧\n        2 < chenQuotientRosserT B (417 / 5000 : ℝ) N (t.1 * t.2)"
  },
