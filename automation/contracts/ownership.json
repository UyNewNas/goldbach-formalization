{
  "schema": "chen-ownership-v1",
  "rules": [
    "Each part owns automation/parts/pX/** in the shared control worktree and its own assigned source patterns in its worktree.",
    "No part edits another worktree source, common pins, public root or workflow.",
    "Unmapped or cross-part source edits need an explicit P0 allocation before editing.",
    "P0 publishes selected changes only; no git add of the whole workspace."
  ],
  "owners": {
    "p0": [
      "automation/control.json",
      "automation/integration.json",
      "automation/contracts/**",
      "ImbalancedChen.lean",
      "lean-toolchain",
      "lakefile.toml",
      "lake-manifest.json",
      ".github/workflows/**",
      "docs/PROOF_STATUS.md",
      "docs/PROGRESS_2026-10-13.md",
      "docs/EXTERNAL_REUSE.md",
      "verification/parts/p0/**"
    ],
    "p1": [
      "ImbalancedChen/FirstExitAdmittedFrontierTuples.lean",
      "ImbalancedChen/Historical*.lean",
      "ImbalancedChen/ActualHistorical*.lean",
      "ImbalancedChen/FirstExitHistorical*.lean"
    ],
    "p2": [
      "ImbalancedChen/Certificates/**",
      "ImbalancedChen/CurrentUpperEighteenBudget.lean",
      "ImbalancedChen/VariableEnvelopeTailFloor.lean",
      "verification/parts/p2/**"
    ],
    "p3": [
      "ImbalancedChen/Part3*.lean",
      "ImbalancedChen/ChenQuotientSieveRemainders.lean"
    ],
    "p4": [
      "ImbalancedChen/ActualUpper*.lean",
      "ImbalancedChen/ActualCompilerDensityReserve.lean",
      "ImbalancedChen/UpperCoefficientPerturbation.lean",
      "ImbalancedChen/RealPhysicalUpperWeightBridge.lean",
      "ImbalancedChen/RealUpperCountingAssembly.lean",
      "ImbalancedChen/ActualSieveGapTailDecay.lean",
      "ImbalancedChen/ActualSieveGapTailBounds.lean",
      "ImbalancedChen/ActualThirdPrefixTailIntegral.lean"
    ],
    "p5": [
      "ImbalancedChen/CurrentChen*.lean"
    ]
  }
}
