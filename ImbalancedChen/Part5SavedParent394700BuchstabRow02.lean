  | x :: _, 0 => x
  | _ :: xs, i + 1 => combinationColumn02 xs i

private theorem combinationColumn02_add (a b : List ℤ) (i : ℕ) :
    combinationColumn02 (addList a b) i =
      combinationColumn02 a i + combinationColumn02 b i := by
  induction a generalizing b i with
  | nil => simp [addList, combinationColumn02]
  | cons x xs ih =>
      cases b with
      | nil => simp [addList, combinationColumn02]
      | cons y ys =>
