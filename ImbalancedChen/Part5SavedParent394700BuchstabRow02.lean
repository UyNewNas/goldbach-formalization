private theorem combinationColumn02_scale (j : ℤ) (a : List ℤ) (i : ℕ) :
    combinationColumn02 (scaleList j a) i = j * combinationColumn02 a i := by
  induction a generalizing i with
  | nil => simp [scaleList, combinationColumn02]
  | cons x xs ih =>
      cases i with
      | zero => rfl
      | succ i =>
          change combinationColumn02 (scaleList j xs) i = j * combinationColumn02 xs i
          exact ih i

