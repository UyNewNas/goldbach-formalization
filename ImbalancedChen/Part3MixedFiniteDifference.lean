import Mathlib.Analysis.Calculus.ContDiff.Operations
import Mathlib.Analysis.Calculus.MeanValue
import Mathlib.Tactic

/-!
# Derivative bound for repeated finite differences

The steps may point in different directions. The hypothesis concerns
only the affine box generated by those steps from the evaluation point.
There is one step-length factor for each applied difference, including
the case of coincident sample points.
-/

namespace ImbalancedChen.Part3.RectangularAbel

noncomputable section

open Set Finset
open scoped ContDiff

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

/-- Backward-signed edge difference, matching the finite Abel kernel. -/
def stepDifference (v : E) (f : E → F) (x : E) : F := f x - f (x + v)

/-- Apply one signed difference for each step. -/
def listDifference : List E → (E → F) → E → F
  | [], f => f
  | v :: vs, f => listDifference vs (stepDifference v f)

/-- All displacements obtained by moving partway along each given step. -/
def displacementBox : List E → Set E
  | [] => {0}
  | v :: vs => {z | ∃ t ∈ Icc (0 : ℝ) 1, ∃ y ∈ displacementBox vs, z = t • v + y}

private theorem norm_step_iteratedFDeriv_le (f : E → F) (hf : ContDiff ℝ ∞ f)
    (v y : E) (j : ℕ) (C : ℝ)
    (hC : ∀ t ∈ Icc (0 : ℝ) 1, ‖iteratedFDeriv ℝ (j + 1) f (y + t • v)‖ ≤ C) :
    ‖iteratedFDeriv ℝ j (stepDifference v f) y‖ ≤ C * ‖v‖ := by
  have hshift : ContDiff ℝ ∞ (fun z => f (z + v)) :=
    hf.comp (contDiff_id.add contDiff_const)
  have hdiff : Differentiable ℝ (iteratedFDeriv ℝ j f) :=
    hf.differentiable_iteratedFDeriv (WithTop.coe_lt_coe.mpr (ENat.natCast_lt_top j))
  have hbound : ∀ z ∈ segment ℝ y (y + v), ‖fderiv ℝ (iteratedFDeriv ℝ j f) z‖ ≤ C := by
    intro z hz
    rw [segment_eq_image'] at hz
    obtain ⟨t, ht, rfl⟩ := hz
    rw [norm_fderiv_iteratedFDeriv, add_sub_cancel_left]
    exact hC t ht
  have hmv := (convex_segment (𝕜 := ℝ) y (y + v)).norm_image_sub_le_of_norm_fderiv_le
    (fun z _ => hdiff z) hbound (left_mem_segment ℝ y (y + v)) (right_mem_segment ℝ y (y + v))
  rw [add_sub_cancel_left] at hmv
  have hj : (j : WithTop ℕ∞) ≤ ∞ := WithTop.coe_le_coe.mpr le_top
  change ‖iteratedFDeriv ℝ j (f - fun z => f (z + v)) y‖ ≤ _
  rw [iteratedFDeriv_sub_apply (hf.contDiffAt.of_le hj) (hshift.contDiffAt.of_le hj),
    iteratedFDeriv_comp_add_right, norm_sub_rev]
  exact hmv

/-- Bounds on the iterated derivatives give a product bound for the mixed
difference, with no cardinality factor from the vertices of the box. -/
theorem norm_listDifference_le (steps : List E) (f : E → F) (hf : ContDiff ℝ ∞ f)
    (x : E) (S : Set E) (C : ℝ)
    (hbox : ∀ y ∈ displacementBox steps, x + y ∈ S)
    (hD : ∀ j ≤ steps.length, ∀ z ∈ S, ‖iteratedFDeriv ℝ j f z‖ ≤ C) :
    ‖listDifference steps f x‖ ≤ C * (steps.map norm).prod := by
  induction steps generalizing f S C with
  | nil =>
    have hx : x ∈ S := by simpa only [add_zero] using hbox 0 (by simp [displacementBox])
    simpa only [listDifference, List.map_nil, List.prod_nil, mul_one, norm_iteratedFDeriv_zero] using
      hD 0 (Nat.zero_le _) x hx
  | cons v vs ih =>
    have hdiff : ContDiff ℝ ∞ (stepDifference v f) :=
      hf.sub (hf.comp (contDiff_id.add contDiff_const))
    have hD' (j : ℕ) (hj : j ≤ vs.length) (z : E) (hz : z ∈ (fun y => x + y) '' displacementBox vs) :
        ‖iteratedFDeriv ℝ j (stepDifference v f) z‖ ≤ (C * ‖v‖) := by
      obtain ⟨y, hy, rfl⟩ := hz
      apply norm_step_iteratedFDeriv_le f hf v (x + y) j C
      intro t ht
      apply hD (j + 1) (by simpa only [List.length_cons] using Nat.succ_le_succ hj)
      have hm : t • v + y ∈ displacementBox (v :: vs) := ⟨t, ht, y, hy, rfl⟩
      have h := hbox _ hm
      rwa [← add_assoc, add_right_comm x] at h
    have h := ih (stepDifference v f) hdiff ((fun y => x + y) '' displacementBox vs) (C * ‖v‖)
      (fun y hy => mem_image_of_mem _ hy) hD'
    simpa only [listDifference, List.map_cons, List.prod_cons, ← mul_assoc] using h

omit [NormedSpace ℝ E] in
/-- A nodup list of coordinate directions gives the signed sum over all
subsets, even if several actual direction vectors are equal. -/
theorem listDifference_eq_sum_subsets {ι : Type*} [DecidableEq ι]
    (indices : List ι) (hnd : indices.Nodup) (v : ι → E) (f : E → F) (x : E) :
    listDifference (indices.map v) f x =
      ∑ T ∈ indices.toFinset.powerset, ((-1 : ℝ)^T.card) • f (x + ∑ i ∈ T, v i) := by
  induction indices generalizing f with
  | nil => simp [listDifference]
  | cons i I ih =>
    have hi : i ∉ I.toFinset := by simpa only [List.mem_toFinset] using (List.nodup_cons.mp hnd).1
    rw [List.map_cons, listDifference, ih (List.nodup_cons.mp hnd).2, List.toFinset_cons,
      sum_powerset_insert hi, ← sum_add_distrib]
    apply sum_congr rfl
    intro T hT
    have hiT : i ∉ T := fun h => hi (mem_powerset.mp hT h)
    rw [card_insert_of_notMem hiT, sum_insert hiT, stepDifference, smul_sub, pow_succ,
      mul_smul, neg_one_smul, smul_neg, sub_eq_add_neg, add_left_comm x (v i)]
    ac_rfl

/-- A convex set containing the sampled vertices contains the entire
affine box needed for the finite-difference derivative bound. -/
theorem displacementBox_mem_convex_of_vertices {ι : Type*} [DecidableEq ι]
    (indices : List ι) (hnd : indices.Nodup) (v : ι → E) (x : E)
    (S : Set E) (hconv : Convex ℝ S)
    (hverts : ∀ T ⊆ indices.toFinset, x + ∑ i ∈ T, v i ∈ S) :
    ∀ y ∈ displacementBox (indices.map v), x + y ∈ S := by
  induction indices generalizing x with
  | nil =>
    intro y hy
    have hy0 : y = 0 := mem_singleton_iff.mp hy
    simpa only [hy0, sum_empty] using hverts ∅ (empty_subset _)
  | cons i I ih =>
    intro y hy
    have hnd' := List.nodup_cons.mp hnd
    have hi : i ∉ I.toFinset := by simpa only [List.mem_toFinset] using hnd'.1
    obtain ⟨t, ht, z, hz, rfl⟩ : ∃ t ∈ Icc (0 : ℝ) 1, ∃ z ∈ displacementBox (I.map v),
        y = t • v i + z := hy
    have hhead (T : Finset ι) (hT : T ⊆ I.toFinset) : x + ∑ k ∈ T, v k ∈ S :=
      hverts T (hT.trans (by rw [List.toFinset_cons]; exact subset_insert _ _))
    have htail (T : Finset ι) (hT : T ⊆ I.toFinset) : (x + v i) + ∑ k ∈ T, v k ∈ S := by
      have hTi : insert i T ⊆ (i :: I).toFinset := by
        rw [List.toFinset_cons]
        exact insert_subset_insert _ hT
      have h := hverts (insert i T) hTi
      rw [sum_insert (fun h => hi (hT h)), ← add_assoc] at h
      exact h
    have hl := ih hnd'.2 x hhead z hz
    have hr := ih hnd'.2 (x + v i) htail z hz
    have hmid := hconv hl hr (sub_nonneg.mpr ht.2) ht.1 (sub_add_cancel 1 t)
    have hEq : (1 - t) • (x + z) + t • (x + v i + z) = x + (t • v i + z) := by
      module
    rwa [hEq] at hmid

end

end ImbalancedChen.Part3.RectangularAbel
