/- Each arithmetic leaf below computes one output coefficient, never a new
suffix list. These private structural lemmas contain no row constants. -/
private def combination07Coeff : List ℤ → ℕ → ℤ
  | [], _ => 0
  | x :: _, 0 => x
  | _ :: xs, i + 1 => combination07Coeff xs i

private theorem combination07Coeff_addList (a b : List ℤ) (i : ℕ) :
    combination07Coeff (addList a b) i =
      combination07Coeff a i + combination07Coeff b i := by
  induction a generalizing b i with
  | nil =>
    change combination07Coeff b i = 0 + combination07Coeff b i
    exact (zero_add _).symm
  | cons x xs ih =>
    cases b with
    | nil =>
      change combination07Coeff (x :: xs) i = combination07Coeff (x :: xs) i + 0
      exact (add_zero _).symm
    | cons y ys =>
      cases i with
      | zero => rfl
      | succ i =>
        change combination07Coeff (addList xs ys) i =
          combination07Coeff xs i + combination07Coeff ys i
        exact ih ys i

private theorem combination07Coeff_scaleList (c : ℤ) (a : List ℤ) (i : ℕ) :
    combination07Coeff (scaleList c a) i = c * combination07Coeff a i := by
  induction a generalizing i with
  | nil => cases i <;> simp [combination07Coeff, scaleList]
  | cons x xs ih =>
    cases i with
    | zero => rfl
    | succ i =>
      change combination07Coeff (scaleList c xs) i = c * combination07Coeff xs i
      exact ih i

private def combination07CoeffSum (n p : ℕ) : ℕ → List ℤ → ℤ :=
  fun k bs =>
    List.rec (motive := fun _ => ℕ → ℤ)
      (fun _ => 0)
      (fun b _bs ih j =>
        b * combination07Coeff (bernsteinList n j) p + ih (j + 1)) bs k

private theorem combination07Coeff_bernsteinSumFrom (n k p : ℕ) (bs : List ℤ) :
    combination07Coeff (bernsteinSumFrom n k bs) p =
      combination07CoeffSum n p k bs := by
  induction bs generalizing k with
  | nil => rfl
  | cons b bs ih =>
    change combination07Coeff
      (addList (scaleList b (bernsteinList n k))
        (bernsteinSumFrom n (k + 1) bs)) p = _
    rw [combination07Coeff_addList, combination07Coeff_scaleList, ih]
    rfl

private theorem combination07_length_addList (a b : List ℤ) :
    (addList a b).length = max a.length b.length := by
  induction a generalizing b with
  | nil => simp [addList]
  | cons x xs ih =>
    cases b with
    | nil => simp [addList]
    | cons y ys =>
      change (addList xs ys).length + 1 = max (xs.length + 1) (ys.length + 1)
      rw [ih]
      exact (Nat.succ_max_succ _ _).symm

private theorem combination07_length_scaleList (c : ℤ) (a : List ℤ) :
    (scaleList c a).length = a.length := by
  simp only [scaleList, List.length_map]

private theorem combination07_length :
    (bernsteinSumFrom 52 0 (bernsteinCoefficients (7:Fin 32))).length = 53 := by
  norm_num [bernsteinSumFrom, bernsteinCoefficients,
    combination07_length_addList, combination07_length_scaleList]

private theorem combination07_list_ext (a b : List ℤ)
    (hlen : a.length = b.length)
    (hcoeff : ∀ i, i < a.length → combination07Coeff a i = combination07Coeff b i) :
    a = b := by
  induction a generalizing b with
  | nil =>
    cases b with
    | nil => rfl
    | cons y ys => simp at hlen
  | cons x xs ih =>
    cases b with
    | nil => simp at hlen
    | cons y ys =>
      have hh : x = y := hcoeff 0 (by simp)
      have ht : xs = ys := by
        apply ih
        · simpa only [List.length_cons, Nat.succ.injEq] using hlen
        · intro i hi
          exact hcoeff (i + 1) (by simpa only [List.length_cons] using Nat.succ_lt_succ hi)
      exact congrArg₂ List.cons hh ht

