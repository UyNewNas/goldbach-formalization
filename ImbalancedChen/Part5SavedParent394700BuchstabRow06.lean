/- Each arithmetic leaf below computes one output coefficient, never a new
suffix list. These private structural lemmas contain no row constants. -/
private def combination06Coeff : List ℤ → ℕ → ℤ
  | [], _ => 0
  | x :: _, 0 => x
  | _ :: xs, i + 1 => combination06Coeff xs i

private theorem combination06Coeff_addList (a b : List ℤ) (i : ℕ) :
    combination06Coeff (addList a b) i =
      combination06Coeff a i + combination06Coeff b i := by
  induction a generalizing b i with
  | nil =>
    change combination06Coeff b i = 0 + combination06Coeff b i
    exact (zero_add _).symm
  | cons x xs ih =>
    cases b with
    | nil =>
      change combination06Coeff (x :: xs) i = combination06Coeff (x :: xs) i + 0
      exact (add_zero _).symm
    | cons y ys =>
      cases i with
      | zero => rfl
      | succ i =>
        change combination06Coeff (addList xs ys) i =
          combination06Coeff xs i + combination06Coeff ys i
        exact ih ys i

private theorem combination06Coeff_scaleList (c : ℤ) (a : List ℤ) (i : ℕ) :
    combination06Coeff (scaleList c a) i = c * combination06Coeff a i := by
  induction a generalizing i with
  | nil => cases i <;> simp [combination06Coeff, scaleList]
  | cons x xs ih =>
    cases i with
    | zero => rfl
    | succ i =>
      change combination06Coeff (scaleList c xs) i = c * combination06Coeff xs i
      exact ih i

private def combination06CoeffSum (n p : ℕ) : ℕ → List ℤ → ℤ :=
  fun k bs =>
    List.rec (motive := fun _ => ℕ → ℤ)
      (fun _ => 0)
      (fun b _bs ih j =>
        b * combination06Coeff (bernsteinList n j) p + ih (j + 1)) bs k

private theorem combination06Coeff_bernsteinSumFrom (n k p : ℕ) (bs : List ℤ) :
    combination06Coeff (bernsteinSumFrom n k bs) p =
      combination06CoeffSum n p k bs := by
  induction bs generalizing k with
  | nil => rfl
  | cons b bs ih =>
    change combination06Coeff
      (addList (scaleList b (bernsteinList n k))
        (bernsteinSumFrom n (k + 1) bs)) p = _
    rw [combination06Coeff_addList, combination06Coeff_scaleList, ih]
    rfl

private theorem combination06_length_addList (a b : List ℤ) :
    (addList a b).length = max a.length b.length := by
  induction a generalizing b with
  | nil => simp [addList]
  | cons x xs ih =>
    cases b with
    | nil => simp [addList]
    | cons y ys =>
      change (addList xs ys).length + 1 = max (xs.length + 1) (ys.length + 1)
      rw [ih]
      exact (Nat.succ_max_succ _ _).symm

private theorem combination06_length_scaleList (c : ℤ) (a : List ℤ) :
    (scaleList c a).length = a.length := by
  simp only [scaleList, List.length_map]

private theorem combination06_length :
    (bernsteinSumFrom 52 0 (bernsteinCoefficients (6:Fin 32))).length = 53 := by
  norm_num [bernsteinSumFrom, bernsteinCoefficients,
    combination06_length_addList, combination06_length_scaleList]

private theorem combination06_list_ext (a b : List ℤ)
    (hlen : a.length = b.length)
    (hcoeff : ∀ i, i < a.length → combination06Coeff a i = combination06Coeff b i) :
    a = b := by
  induction a generalizing b with
  | nil =>
    cases b with
    | nil => rfl
    | cons y ys => simp at hlen
  | cons x xs ih =>
    cases b with
    | nil => simp at hlen
    | cons y ys =>
      have hh : x = y := hcoeff 0 (by simp)
      have ht : xs = ys := by
        apply ih
        · simpa only [List.length_cons, Nat.succ.injEq] using hlen
        · intro i hi
          exact hcoeff (i + 1) (by simpa only [List.length_cons] using Nat.succ_lt_succ hi)
      exact congrArg₂ List.cons hh ht

