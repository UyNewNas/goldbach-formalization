      (fun _ => 0)
      (fun b _bs ih j =>
        b * combination19Coeff (bernsteinList n j) p + ih (j + 1)) bs k

private theorem combination19Coeff_bernsteinSumFrom (n k p : ℕ) (bs : List ℤ) :
    combination19Coeff (bernsteinSumFrom n k bs) p =
      combination19CoeffSum n p k bs := by
  induction bs generalizing k with
  | nil => rfl
  | cons b bs ih =>
    change combination19Coeff
      (addList (scaleList b (bernsteinList n k))
        (bernsteinSumFrom n (k + 1) bs)) p = _
    rw [combination19Coeff_addList, combination19Coeff_scaleList, ih]
    rfl

private theorem combination19_length_addList (a b : List ℤ) :
