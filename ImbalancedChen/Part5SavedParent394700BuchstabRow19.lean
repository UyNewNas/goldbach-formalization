private def combination19Coeff : List ℤ → ℕ → ℤ
  | [], _ => 0
  | x :: _, 0 => x
  | _ :: xs, i + 1 => combination19Coeff xs i

private theorem combination19Coeff_addList (a b : List ℤ) (i : ℕ) :
    combination19Coeff (addList a b) i =
      combination19Coeff a i + combination19Coeff b i := by
  induction a generalizing b i with
  | nil =>
    change combination19Coeff b i = 0 + combination19Coeff b i
    exact (zero_add _).symm
  | cons x xs ih =>
    cases b with
    | nil =>
      change combination19Coeff (x :: xs) i = combination19Coeff (x :: xs) i + 0
      exact (add_zero _).symm
    | cons y ys =>
      cases i with
      | zero => rfl
      | succ i =>
        change combination19Coeff (addList xs ys) i =
          combination19Coeff xs i + combination19Coeff ys i
        exact ih ys i

private theorem combination19Coeff_scaleList (c : ℤ) (a : List ℤ) (i : ℕ) :
    combination19Coeff (scaleList c a) i = c * combination19Coeff a i := by
  induction a generalizing i with
  | nil => cases i <;> simp [combination19Coeff, scaleList]
  | cons x xs ih =>
    cases i with
    | zero => rfl
    | succ i =>
      change combination19Coeff (scaleList c xs) i = c * combination19Coeff xs i
      exact ih i

private def combination19CoeffSum (n p : ℕ) : ℕ → List ℤ → ℤ :=
  fun k bs =>
