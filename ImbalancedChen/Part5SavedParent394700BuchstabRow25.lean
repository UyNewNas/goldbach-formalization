/- Each arithmetic leaf below computes one output coefficient, never a new
suffix list. These private structural lemmas contain no row constants. -/
private def combination25Coeff : List ℤ → ℕ → ℤ
  | [], _ => 0
  | x :: _, 0 => x
  | _ :: xs, i + 1 => combination25Coeff xs i

private theorem combination25Coeff_addList (a b : List ℤ) (i : ℕ) :
    combination25Coeff (addList a b) i =
      combination25Coeff a i + combination25Coeff b i := by
  induction a generalizing b i with
  | nil =>
    change combination25Coeff b i = 0 + combination25Coeff b i
    exact (zero_add _).symm
  | cons x xs ih =>
    cases b with
    | nil =>
      change combination25Coeff (x :: xs) i = combination25Coeff (x :: xs) i + 0
      exact (add_zero _).symm
    | cons y ys =>
      cases i with
      | zero => rfl
      | succ i =>
        change combination25Coeff (addList xs ys) i =
          combination25Coeff xs i + combination25Coeff ys i
        exact ih ys i

private theorem combination25Coeff_scaleList (c : ℤ) (a : List ℤ) (i : ℕ) :
    combination25Coeff (scaleList c a) i = c * combination25Coeff a i := by
  induction a generalizing i with
  | nil => cases i <;> simp [combination25Coeff, scaleList]
  | cons x xs ih =>
    cases i with
    | zero => rfl
    | succ i =>
      change combination25Coeff (scaleList c xs) i = c * combination25Coeff xs i
      exact ih i

private def combination25CoeffSum (n p : ℕ) : ℕ → List ℤ → ℤ :=
  fun k bs =>
    List.rec (motive := fun _ => ℕ → ℤ)
      (fun _ => 0)
      (fun b _bs ih j =>
        b * combination25Coeff (bernsteinList n j) p + ih (j + 1)) bs k

private theorem combination25Coeff_bernsteinSumFrom (n k p : ℕ) (bs : List ℤ) :
    combination25Coeff (bernsteinSumFrom n k bs) p =
      combination25CoeffSum n p k bs := by
  induction bs generalizing k with
  | nil => rfl
  | cons b bs ih =>
    change combination25Coeff
      (addList (scaleList b (bernsteinList n k))
        (bernsteinSumFrom n (k + 1) bs)) p = _
    rw [combination25Coeff_addList, combination25Coeff_scaleList, ih]
    rfl

private theorem combination25_length_addList (a b : List ℤ) :
    (addList a b).length = max a.length b.length := by
  induction a generalizing b with
  | nil => simp [addList]
  | cons x xs ih =>
    cases b with
    | nil => simp [addList]
    | cons y ys =>
      change (addList xs ys).length + 1 = max (xs.length + 1) (ys.length + 1)
      rw [ih]
      exact (Nat.succ_max_succ _ _).symm

private theorem combination25_length_scaleList (c : ℤ) (a : List ℤ) :
    (scaleList c a).length = a.length := by
  simp only [scaleList, List.length_map]

