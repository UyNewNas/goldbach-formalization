/- Each arithmetic leaf below computes one output coefficient, never a new
suffix list. These private structural lemmas contain no row constants. -/
private def combination17Coeff : List ℤ → ℕ → ℤ
  | [], _ => 0
  | x :: _, 0 => x
  | _ :: xs, i + 1 => combination17Coeff xs i

private theorem combination17Coeff_addList (a b : List ℤ) (i : ℕ) :
    combination17Coeff (addList a b) i =
      combination17Coeff a i + combination17Coeff b i := by
  induction a generalizing b i with
  | nil =>
    change combination17Coeff b i = 0 + combination17Coeff b i
    exact (zero_add _).symm
  | cons x xs ih =>
    cases b with
    | nil =>
      change combination17Coeff (x :: xs) i = combination17Coeff (x :: xs) i + 0
      exact (add_zero _).symm
    | cons y ys =>
      cases i with
      | zero => rfl
      | succ i =>
        change combination17Coeff (addList xs ys) i =
          combination17Coeff xs i + combination17Coeff ys i
        exact ih ys i

private theorem combination17Coeff_scaleList (c : ℤ) (a : List ℤ) (i : ℕ) :
    combination17Coeff (scaleList c a) i = c * combination17Coeff a i := by
  induction a generalizing i with
  | nil => cases i <;> simp [combination17Coeff, scaleList]
  | cons x xs ih =>
    cases i with
    | zero => rfl
    | succ i =>
      change combination17Coeff (scaleList c xs) i = c * combination17Coeff xs i
      exact ih i

private def combination17CoeffSum (n p : ℕ) : ℕ → List ℤ → ℤ :=
  fun k bs =>
    List.rec (motive := fun _ => ℕ → ℤ)
      (fun _ => 0)
      (fun b _bs ih j =>
        b * combination17Coeff (bernsteinList n j) p + ih (j + 1)) bs k

private theorem combination17Coeff_bernsteinSumFrom (n k p : ℕ) (bs : List ℤ) :
    combination17Coeff (bernsteinSumFrom n k bs) p =
      combination17CoeffSum n p k bs := by
  induction bs generalizing k with
  | nil => rfl
  | cons b bs ih =>
    change combination17Coeff
      (addList (scaleList b (bernsteinList n k))
        (bernsteinSumFrom n (k + 1) bs)) p = _
    rw [combination17Coeff_addList, combination17Coeff_scaleList, ih]
    rfl

private theorem combination17_length_addList (a b : List ℤ) :
    (addList a b).length = max a.length b.length := by
  induction a generalizing b with
  | nil => simp [addList]
  | cons x xs ih =>
    cases b with
    | nil => simp [addList]
    | cons y ys =>
      change (addList xs ys).length + 1 = max (xs.length + 1) (ys.length + 1)
      rw [ih]
      exact (Nat.succ_max_succ _ _).symm

private theorem combination17_length_scaleList (c : ℤ) (a : List ℤ) :
    (scaleList c a).length = a.length := by
  simp only [scaleList, List.length_map]

