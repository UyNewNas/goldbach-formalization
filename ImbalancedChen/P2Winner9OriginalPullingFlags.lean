-- End generated pulling data.

abbrev GateIndex := Fin 21

private def pointAt (ordinal : ℕ) : ℕ × (Fin 8 → ℤ) :=
  (pointPages[ordinal / 16]!)[ordinal % 16]!

/-- The integer supporting plane, regarded as a rational affine row. -/
def plane (g : GateIndex) : LiftingPlane :=
  ⟨(planeData[g.val]!).1, fun j => (planeData[g.val]!).2 j⟩

def mask (g : GateIndex) : ℕ := maskData[g.val]!

private def score (v : ℕ) (g : GateIndex) : ℤ :=
  (planeData[g.val]!).1 * (pointAt v).1 +
    ∑ j, (planeData[g.val]!).2 j * (pointAt v).2 j

private def vertexGuardAt (v : ℕ) : Prop :=
  (0 < (pointAt v).1 ∧
    ∀ j : Fin 8, coordinates[v]! j = ((pointAt v).2 j : ℚ) / (pointAt v).1) ∧
  ∀ g : GateIndex, 0 ≤ score v g ∧ ((mask g).testBit v = true ↔ score v g = 0)

-- Each chunk checks its rational coordinates and the integer sign table.
private def chunkSize (c : Fin 13) : ℕ := min 16 (201 - 16 * c.val)

private theorem guards_chunk (c : Fin 13) : ∀ i : Fin (chunkSize c),
    vertexGuardAt (16 * c.val + i.val) := by
  fin_cases c <;> unfold vertexGuardAt chunkSize <;> decide +kernel

private theorem vertex_guard (v : VertexIndex) : vertexGuardAt v.val := by
  let c : Fin 13 := ⟨v.val / 16, by have := v.isLt; omega⟩
  have he : 16 * c.val + v.val % 16 = v.val := Nat.div_add_mod v.val 16
  have hi : v.val % 16 < chunkSize c := by
    apply Nat.lt_min.mpr
    exact ⟨Nat.mod_lt _ (by decide), by have := v.isLt; omega⟩
  exact he ▸ guards_chunk c ⟨v.val % 16, hi⟩

private theorem score_eq (g : GateIndex) (v : VertexIndex) :
    (score v.val g : ℚ) = ((pointAt v.val).1 : ℚ) * (plane g).evalQ (originalPoint v) := by
  have hd : (0 : ℚ) < (pointAt v.val).1 := by
    exact_mod_cast (vertex_guard v).1.1
  simp only [score, plane, LiftingPlane.evalQ, originalPoint, Int.cast_add, Int.cast_mul,
    Int.cast_sum, Int.cast_natCast, mul_add, Finset.mul_sum]
  congr 1
  · ring
  · apply Finset.sum_congr rfl
    intro j _
    rw [(vertex_guard v).1.2 j]
    field_simp [hd.ne']

/-- A cached mask describes exactly the zero vertices of its checked plane. -/
theorem mask_correct (g : GateIndex) (v : VertexIndex) :
    (mask g).testBit v.val = true ↔ (plane g).evalQ (originalPoint v) = 0 := by
  have hd : (0 : ℚ) < (pointAt v.val).1 := by
    exact_mod_cast (vertex_guard v).1.1
  rw [(vertex_guard v).2 g |>.2, ← Int.cast_eq_zero (α := ℚ), score_eq, mul_eq_zero]
  simp [hd.ne']

theorem plane_nonneg (g : GateIndex) (v : VertexIndex) :
    0 ≤ (plane g).evalQ (originalPoint v) := by
  have hd : (0 : ℚ) < (pointAt v.val).1 := by
    exact_mod_cast (vertex_guard v).1.1
  apply (mul_nonneg_iff_of_pos_left hd).mp
  rw [← score_eq]
  exact_mod_cast (vertex_guard v).2 g |>.1

private def geometryWord (ordinal : ℕ) : ℕ :=
  (geometryPages[ordinal / 16]!)[ordinal % 16]!

private def orderedWord (rank : ℕ) : ℕ :=
  (orderedPages[rank / 16]!)[rank % 16]!

private def rankAt (ordinal : ℕ) : ℕ := geometryWord ordinal % 2^14
private def ordinalAt (rank : ℕ) : ℕ := orderedWord rank % 2^14
private def orderedKey (rank : ℕ) : ℕ := orderedWord rank >>> 14

def keyAt (ordinal : ℕ) : ℕ := orderedKey (rankAt ordinal)

def flagsAt (ordinal : ℕ) : List GateIndex :=
  List.ofFn fun j : Fin 8 =>
    Fin.ofNat 21 ((geometryWord ordinal >>> (14 + 5 * j.val)) % 32)

def rowID (row : RawRow) (k : Fin 9) : VertexIndex :=
  Fin.ofNat 201 (row.vertexIds k)

def checkedRow (ordinal : ℕ) (row : RawRow) : Bool :=
  (List.ofFn row.vertexIds).all (fun v => decide (v < 201)) &&
    pullingCheck mask (2^201 - 1) (rowID row 0) (rowTail (rowID row)) (flagsAt ordinal) &&
    decide (keyAt ordinal = vertexKey (rowID row) ∧ rankAt ordinal < 256 ∧
      ordinalAt (rankAt ordinal) = ordinal)

theorem checkedRow_sound {ordinal : ℕ} {row : RawRow} (h : checkedRow ordinal row = true) :
    (∀ k, (rowID row k).val = row.vertexIds k) ∧
      pullingCheck mask (2^201 - 1) (rowID row 0) (rowTail (rowID row)) (flagsAt ordinal) = true ∧
      keyAt ordinal = vertexKey (rowID row) ∧ rankAt ordinal < 256 ∧
      ordinalAt (rankAt ordinal) = ordinal := by
  simp only [checkedRow, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at h
  refine ⟨fun k => ?_, h.1.2, h.2⟩
  have hk := h.1.1 (row.vertexIds k) (List.mem_ofFn.mpr ⟨k, rfl⟩)
  exact Nat.mod_eq_of_lt hk

private def orderChunkSize (c : Fin 16) : ℕ := min 16 (255 - 16 * c.val)

private theorem order_checked_chunk (c : Fin 16) :
    ∀ i : Fin (orderChunkSize c), orderedKey (16 * c.val + i.val) <
      orderedKey (16 * c.val + i.val + 1) := by
  fin_cases c <;> unfold orderChunkSize <;> decide +kernel

private theorem orderedKeys_strictMono : StrictMono (fun i : Fin 256 => orderedKey i.val) := by
  apply Fin.strictMono_iff_lt_succ.mpr
  intro i
  change orderedKey i.val < orderedKey (i.val + 1)
  let c : Fin 16 := ⟨i.val / 16, by have := i.isLt; omega⟩
  have he : 16 * c.val + i.val % 16 = i.val := Nat.div_add_mod i.val 16
  have hi : i.val % 16 < orderChunkSize c := by
    apply Nat.lt_min.mpr
    exact ⟨Nat.mod_lt _ (by decide), by have := i.isLt; omega⟩
  simpa only [he] using order_checked_chunk c ⟨i.val % 16, hi⟩

/-- A checked ordinal is recovered from the unique rank of its key. -/
theorem checkedKeys_injective {a b : ℕ} {ra rb : RawRow}
    (ha : checkedRow a ra = true) (hb : checkedRow b rb = true)
    (he : keyAt a = keyAt b) : a = b := by
  let ia : Fin 256 := ⟨rankAt a, (checkedRow_sound ha).2.2.2.1⟩
  let ib : Fin 256 := ⟨rankAt b, (checkedRow_sound hb).2.2.2.1⟩
  have hindex : ia = ib := orderedKeys_strictMono.injective he
  have h : ordinalAt (rankAt a) = ordinalAt (rankAt b) :=
    congrArg (fun i : Fin 256 => ordinalAt i.val) hindex
  rwa [(checkedRow_sound ha).2.2.2.2, (checkedRow_sound hb).2.2.2.2] at h

/-- A checked archive interval has pairwise null closed physical intersections. -/
theorem archive_overlap_null {first count : ℕ} {rows : Array RawRow}
    (checked : Checked (fun ordinal row => checkedRow ordinal row = true) first count rows) :
    Pairwise fun i j : Fin count =>
      volume (cellSupport originalPoint (fun k => rowID rows[k.val]!) i ∩
        cellSupport originalPoint (fun k => rowID rows[k.val]!) j) = 0 := by
  apply checked_pulling_overlap_null originalPoint plane mask _ (fun i => flagsAt (first + i.val))
    mask_correct plane_nonneg
  · intro i
    exact (checkedRow_sound (checked.2 i)).2.1
  · intro i j hij
    apply Fin.val_injective
    have he : keyAt (first + i.val) = keyAt (first + j.val) := by
      rw [(checkedRow_sound (checked.2 i)).2.2.1, (checkedRow_sound (checked.2 j)).2.2.1]
      unfold vertexKey
      exact congrArg (fun s : Finset VertexIndex => ∑ v ∈ s, 2 ^ v.val) hij
    exact Nat.add_left_cancel (checkedKeys_injective (checked.2 i) (checked.2 j) he)

/-- The closed physical support with its raw archive coordinate lookups. -/
def originalSupport (row : RawRow) : Set P2Winner9PhysicalAffineTransfer.Ambient :=
  P2Winner9SelectedRowRealJacobian.sourceSupport (fun k => coordinates[row.vertexIds k]!)

theorem checkedRow_support {ordinal : ℕ} {row : RawRow} (h : checkedRow ordinal row = true) :
    P2Winner9SelectedRowRealJacobian.sourceSupport (fun k => originalPoint (rowID row k)) =
      originalSupport row := by
  unfold originalSupport
  congr 1
  funext k
  simp only [originalPoint, (checkedRow_sound h).1 k]

theorem archive_actual_overlap_null {first count : ℕ} {rows : Array RawRow}
    (checked : Checked (fun ordinal row => checkedRow ordinal row = true) first count rows) :
    Pairwise fun i j : Fin count =>
