noncomputable def blockChars : List Char := chunk0000Chars00
noncomputable def blockPush (acc : List SourceJson) : List SourceJson := chunk0000Push00 (acc)

theorem array_block (fuel : Nat) (tail : List Char) (acc : List SourceJson) :
    SourceJson.array (fuel + 99) (SourceJson.white (blockChars ++ tail)) acc =
      SourceJson.array (fuel + 97) (SourceJson.white tail) (blockPush acc) := by
  have hinput : blockChars ++ tail = chunk0000Chars00 ++ (tail) := by simp only [blockChars, List.append_assoc]
  calc
    SourceJson.array (fuel + 99) (SourceJson.white (blockChars ++ tail)) acc =
        SourceJson.array (fuel + 99) (SourceJson.white (chunk0000Chars00 ++ (tail))) acc :=
      congrArg (fun chars => SourceJson.array (fuel + 99) (SourceJson.white chars) acc) hinput
    _ = SourceJson.array (fuel + 97) (SourceJson.white tail) (blockPush acc) := array_chunk0000 fuel (tail) (acc)

