theorem block_original_prefix :
    (sourceRest 156649).take 626 = blockChars := by rfl

theorem block_original_split : sourceRest 156649 = blockChars ++ sourceRest 157275 := by
  calc
    sourceRest 156649 = (sourceRest 156649).take 626 ++ (sourceRest 156649).drop 626 :=
      (List.take_append_drop 626 (sourceRest 156649)).symm
    _ = blockChars ++ (sourceRest 156649).drop 626 :=
      congrArg (fun part => part ++ (sourceRest 156649).drop 626) block_original_prefix
    _ = blockChars ++ sourceRest 157275 :=
      congrArg (fun tail => blockChars ++ tail) (sourceRest_drop 156649 626)

theorem array_block_original (fuel : Nat) (acc : List SourceJson) :
    SourceJson.array (fuel + 99) (SourceJson.white (sourceRest 156649)) acc =
