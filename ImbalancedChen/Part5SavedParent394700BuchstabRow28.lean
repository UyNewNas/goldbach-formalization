private theorem combination28_getD_addList (a b : List ℤ) (i : ℕ) :
    (addList a b).getD i 0 = a.getD i 0 + b.getD i 0 := by
  induction a generalizing b i with
  | nil => simp [addList]
  | cons x xs ih =>
      cases b with
      | nil => simp [addList]
      | cons y ys =>
          cases i with
          | zero => simp [addList]
          | succ i =>
              simpa only [primitive_addList_cons_cons, List.getD_cons_succ] using ih ys i

