/- Row14-only coefficient projection staging.  All arithmetic below is scalar:
   each coordinate certificate has at most the original 53 summands.
   No new integer tail table is introduced.  This is uncompiled SOURCEONLY. -/
private theorem combination14_getD_addList (a b : List ℤ) (i : ℕ) :
    (addList a b).getD i 0 = a.getD i 0 + b.getD i 0 := by
  induction a generalizing b i with
  | nil => simp [addList]
  | cons x xs ih =>
      cases b with
      | nil => simp [addList]
      | cons y ys =>
          cases i with
          | zero => simp [addList]
          | succ i =>
              simpa only [primitive_addList_cons_cons, List.getD_cons_succ] using ih ys i

private theorem combination14_getD_scaleList (b : ℤ) (a : List ℤ) (i : ℕ) :
    (scaleList b a).getD i 0 = b * a.getD i 0 := by
  induction a generalizing i with
  | nil => simp [scaleList]
  | cons x xs ih =>
      cases i with
      | zero => simp [scaleList]
      | succ i =>
          simpa only [scaleList, List.map_cons, List.getD_cons_succ] using ih i

private def combination14Column (i : ℕ) : ℕ → List ℤ → ℤ :=
  fun k bs =>
    List.rec (motive := fun _ => ℕ → ℤ)
      (fun _ => 0)
      (fun b _bs ih j => b * (bernsteinList 52 j).getD i 0 + ih (j + 1))
      bs k

private theorem combination14_getD_sum (i k : ℕ) (bs : List ℤ) :
    (bernsteinSumFrom 52 k bs).getD i 0 = combination14Column i k bs := by
  induction bs generalizing k with
  | nil => simp [bernsteinSumFrom, combination14Column]
  | cons b bs ih =>
      change
        (addList (scaleList b (bernsteinList 52 k))
          (bernsteinSumFrom 52 (k + 1) bs)).getD i 0 =
        b * (bernsteinList 52 k).getD i 0 + combination14Column i (k + 1) bs
      rw [combination14_getD_addList, combination14_getD_scaleList, ih]

private theorem combination14_length_addList (a b : List ℤ) :
    (addList a b).length = max a.length b.length := by
  induction a generalizing b with
  | nil => simp [addList]
  | cons x xs ih =>
      cases b with
      | nil => simp [addList]
      | cons y ys =>
          simpa only [primitive_addList_cons_cons, List.length_cons,
            Nat.succ_max_succ] using congrArg Nat.succ (ih ys)

private theorem combination14_length_scaleList (b : ℤ) (a : List ℤ) :
    (scaleList b a).length = a.length := by
  simp only [scaleList, List.length_map]

private theorem combination14_length :
    (bernsteinSumFrom 52 0 (bernsteinCoefficients (14:Fin 32))).length = 53 := by
  norm_num [bernsteinSumFrom, bernsteinCoefficients,
    combination14_length_addList, combination14_length_scaleList]

private theorem combination14_ext (a b : List ℤ)
    (hlen : a.length = b.length)
    (h : ∀ i, i < a.length → a.getD i 0 = b.getD i 0) : a = b := by
  apply List.ext_getElem hlen
  intro i hia hib
  have hi := h i hia
  simpa only [List.getD_eq_getElem?_getD,
    List.getElem?_eq_getElem hia, List.getElem?_eq_getElem hib,
    Option.getD_some] using hi


