/- Each arithmetic leaf below computes one output coefficient, never a new
suffix list. These private structural lemmas contain no row constants. -/
private def combination24Coeff : List ℤ → ℕ → ℤ
  | [], _ => 0
  | x :: _, 0 => x
  | _ :: xs, i + 1 => combination24Coeff xs i

private theorem combination24Coeff_addList (a b : List ℤ) (i : ℕ) :
    combination24Coeff (addList a b) i =
      combination24Coeff a i + combination24Coeff b i := by
  induction a generalizing b i with
  | nil =>
    change combination24Coeff b i = 0 + combination24Coeff b i
    exact (zero_add _).symm
  | cons x xs ih =>
    cases b with
    | nil =>
      change combination24Coeff (x :: xs) i = combination24Coeff (x :: xs) i + 0
      exact (add_zero _).symm
    | cons y ys =>
      cases i with
      | zero => rfl
      | succ i =>
        change combination24Coeff (addList xs ys) i =
          combination24Coeff xs i + combination24Coeff ys i
        exact ih ys i

private theorem combination24Coeff_scaleList (c : ℤ) (a : List ℤ) (i : ℕ) :
    combination24Coeff (scaleList c a) i = c * combination24Coeff a i := by
  induction a generalizing i with
  | nil => cases i <;> simp [combination24Coeff, scaleList]
  | cons x xs ih =>
    cases i with
    | zero => rfl
    | succ i =>
      change combination24Coeff (scaleList c xs) i = c * combination24Coeff xs i
      exact ih i

private def combination24CoeffSum (n p : ℕ) : ℕ → List ℤ → ℤ :=
  fun k bs =>
    List.rec (motive := fun _ => ℕ → ℤ)
      (fun _ => 0)
      (fun b _bs ih j =>
        b * combination24Coeff (bernsteinList n j) p + ih (j + 1)) bs k

private theorem combination24Coeff_bernsteinSumFrom (n k p : ℕ) (bs : List ℤ) :
    combination24Coeff (bernsteinSumFrom n k bs) p =
      combination24CoeffSum n p k bs := by
  induction bs generalizing k with
  | nil => rfl
  | cons b bs ih =>
    change combination24Coeff
      (addList (scaleList b (bernsteinList n k))
        (bernsteinSumFrom n (k + 1) bs)) p = _
    rw [combination24Coeff_addList, combination24Coeff_scaleList, ih]
    rfl

private theorem combination24_length_addList (a b : List ℤ) :
    (addList a b).length = max a.length b.length := by
  induction a generalizing b with
  | nil => simp [addList]
  | cons x xs ih =>
    cases b with
    | nil => simp [addList]
    | cons y ys =>
      change (addList xs ys).length + 1 = max (xs.length + 1) (ys.length + 1)
      rw [ih]
      exact (Nat.succ_max_succ _ _).symm

private theorem combination24_length_scaleList (c : ℤ) (a : List ℤ) :
    (scaleList c a).length = a.length := by
  simp only [scaleList, List.length_map]

private theorem combination24_length :
    (bernsteinSumFrom 52 0 (bernsteinCoefficients (24:Fin 32))).length = 53 := by
  norm_num [bernsteinSumFrom, bernsteinCoefficients,
    combination24_length_addList, combination24_length_scaleList]

private theorem combination24_list_ext (a b : List ℤ)
    (hlen : a.length = b.length)
    (hcoeff : ∀ i, i < a.length → combination24Coeff a i = combination24Coeff b i) :
    a = b := by
  induction a generalizing b with
  | nil =>
    cases b with
    | nil => rfl
    | cons y ys => simp at hlen
  | cons x xs ih =>
    cases b with
    | nil => simp at hlen
    | cons y ys =>
      have hh : x = y := hcoeff 0 (by simp)
      have ht : xs = ys := by
        apply ih
        · simpa only [List.length_cons, Nat.succ.injEq] using hlen
        · intro i hi
          exact hcoeff (i + 1) (by simpa only [List.length_cons] using Nat.succ_lt_succ hi)
      exact congrArg₂ List.cons hh ht

