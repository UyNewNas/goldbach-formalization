    mulList (x :: xs) b = addList (scaleList x b) (0 :: mulList xs b) := by rfl

theorem primitive_powList_zero (a : List ℤ) : powList a 0 = [1] := by rfl

theorem primitive_powList_succ (a : List ℤ) (n : ℕ) :
    powList a (n + 1) = mulList a (powList a n) := by rfl

theorem primitive_homogeneousAffine_nil (A B D : ℤ) : homogeneousAffine A B D [] = [] := by rfl

theorem primitive_homogeneousAffine_cons (A B D c : ℤ) (cs : List ℤ) :
    homogeneousAffine A B D (c :: cs) =
      addList [c * D^(cs.length + 1)] (mulList [A, B] (homogeneousAffine A B D cs)) := by rfl

theorem primitive_bernsteinSumFrom_nil (n k : ℕ) : bernsteinSumFrom n k [] = [] := by rfl

theorem primitive_bernsteinSumFrom_cons (n k : ℕ) (b : ℤ) (bs : List ℤ) :
    bernsteinSumFrom n k (b :: bs) =
      addList (scaleList b (bernsteinList n k)) (bernsteinSumFrom n (k + 1) bs) := by rfl

theorem primitive_positiveList_nil : positiveList [] = true := by rfl

theorem primitive_positiveList_cons (b : ℤ) (bs : List ℤ) :
    positiveList (b :: bs) = (decide (0 < b) && positiveList bs) := by rfl

theorem primitive_derivativeFrom_nil (n : ℕ) : derivativeFrom n [] = [] := by rfl

theorem primitive_derivativeFrom_cons (n : ℕ) (x : ℤ) (xs : List ℤ) :
