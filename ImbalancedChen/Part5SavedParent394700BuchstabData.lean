def addList : List ℤ → List ℤ → List ℤ :=
  fun a b =>
    List.rec (motive := fun _ => List ℤ → List ℤ)
      (fun ys => ys)
      (fun x xs ih ys =>
        match ys with
        | [] => x :: xs
        | y :: rest => (x + y) :: ih rest)
      a b

def scaleList (j : ℤ) (a : List ℤ) : List ℤ := a.map (fun x => j * x)

def mulList : List ℤ → List ℤ → List ℤ :=
  fun a b =>
    List.rec (motive := fun _ => List ℤ → List ℤ)
      (fun _ => [])
      (fun x _xs ih ys => addList (scaleList x ys) (0 :: ih ys))
      a b

def powList (a : List ℤ) : ℕ → List ℤ :=
  Nat.rec (motive := fun _ => List ℤ) [1] (fun _n ih => mulList a ih)

def homogeneousAffine (A B D : ℤ) : List ℤ → List ℤ :=
  List.rec (motive := fun _ => List ℤ) []
    (fun c cs ih => addList [c * D^(cs.length + 1)] (mulList [A, B] ih))

def bernsteinList (n k : ℕ) : List ℤ :=
  scaleList ((Nat.fast_choose n k : ℕ) : ℤ)
    (mulList (powList [0, 1] k) (powList [1, -1] (n - k)))

def bernsteinSumFrom (n : ℕ) : ℕ → List ℤ → List ℤ :=
  fun k bs =>
    List.rec (motive := fun _ => ℕ → List ℤ)
      (fun _ => [])
      (fun b _bs ih j => addList (scaleList b (bernsteinList n j)) (ih (j + 1)))
      bs k

def positiveList : List ℤ → Bool :=
  List.rec (motive := fun _ => Bool) true (fun b _bs ih => decide (0 < b) && ih)

def derivativeFrom : ℕ → List ℤ → List ℤ :=
  fun n a =>
    List.rec (motive := fun _ => ℕ → List ℤ)
      (fun _ => [])
      (fun x _xs ih k => ((k : ℤ) * x) :: ih (k + 1))
      a n

def derivList (a : List ℤ) : List ℤ := derivativeFrom 1 a.tail

/-- Positive-delay residual. The delayed row has a MINUS sign here. -/
def residualList (j : ℤ) (a b : List ℤ) : List ℤ :=
  addList (addList (scaleList j (derivList a)) (0 :: derivList a))
    (scaleList (-1) b)

def absSum (a : List ℤ) : ℤ := (a.map abs).sum
def startValue (i : ℕ) : ℤ := ((row i).head?).getD 0
def endValue (i : ℕ) : ℤ := (row i).sum
def err (i : ℕ) : ℤ := ((2 : ℤ)^(i - 3) - 1) * residualBound

def cellIndex (k : Fin 32) : ℕ := if k.val < 16 then 10 else 11
def affineA (k : Fin 32) : ℤ :=
  if k.val < 16 then 247264 + 4905 * (k.val : ℤ)
  else 883 * ((k.val - 16 : ℕ) : ℤ)
def affineB (k : Fin 32) : ℤ := if k.val < 16 then 4905 else 883
def affineD (k : Fin 32) : ℤ := if k.val < 16 then 325744 else 160128

def barrierList (i : ℕ) : List ℤ :=
  addList [omegaHalf * (i : ℤ) - err i, omegaHalf] (scaleList (-1) (row i))

def BernsteinGood (k : Fin 32) : Prop :=
  positiveList (bernsteinCoefficients k) = true ∧
    0 < affineD k ∧ 0 < affineB k ∧
    absSum (addList
      (scaleList bernsteinMultiplier
        (homogeneousAffine (affineA k) (affineB k) (affineD k)
          (barrierList (cellIndex k))))
      (scaleList (-1) (bernsteinSumFrom 52 0 (bernsteinCoefficients k)))) = 0

instance (k : Fin 32) : Decidable (BernsteinGood k) := by
  unfold BernsteinGood
  infer_instance

theorem finiteGood : ∀ k : Fin 8,
    startValue (k.val + 4) = endValue (k.val + 3) ∧
      absSum (residualList ((k.val + 2 : ℕ) : ℤ)
        (row (k.val + 4)) (row (k.val + 2))) ≤ residualBound ∧
      err (k.val + 2) ≤ err (k.val + 3) ∧
      err (k.val + 4) = 2 * err (k.val + 3) + residualBound := by
  decide

theorem finiteNonneg : ∀ k : Fin 10, 0 ≤ err (k.val + 2) := by decide
