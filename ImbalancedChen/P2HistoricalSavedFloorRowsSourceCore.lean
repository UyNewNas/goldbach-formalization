/-- Defaulted access is harmless only after the source-index check below;
no claim about a missing row is inferred from its default zero numerator. -/
def frozenSavedRow (r : Row) : FrozenSavedRow :=
  (frozenSavedStrips r.1).getD r.2.val default

def rowTL (r : Row) : ℚ := tLower (indices r).1
def rowTR (r : Row) : ℚ := tUpper (indices r).1
def rowUL (r : Row) : ℚ := uLower (indices r).2
def rowUR (r : Row) : ℚ := uUpper (indices r).2

/-- Actual rational query operands of author pair_cell(False,False). -/
def rowLogQueries (r : Row) : ℚ × ℚ := (rowTR r / rowTL r, rowUR r / rowUL r)

def rowResidualRange (r : Row) : ℚ × ℚ :=
  ordinaryRanges (rowTL r) (rowTR r) (rowUL r) (rowUR r)

def rowBaseSfQuery (r : Row) : ℚ := (rowResidualRange r).1 / Certificates.P2HistoricQ80DefectLookup.a

def rowChordSfQueries (r : Row) (p : Plane) : ℚ × ℚ :=
  ((affineRange p (rowTL r) (rowTR r) (rowUL r) (rowUR r)).1 /
      Certificates.P2HistoricQ80DefectLookup.a,
    (affineRange p (rowTL r) (rowTR r) (rowUL r) (rowUR r)).2 /
      Certificates.P2HistoricQ80DefectLookup.a)

def rowChordEligible (r : Row) (p q : Plane) : Prop :=
  chordEligible p q (rowTL r) (rowTR r) (rowUL r) (rowUR r)

instance (r : Row) (p q : Plane) : Decidable (rowChordEligible r p q) := by
  unfold rowChordEligible
  infer_instance

/-- Precisely the primitive sf queries actually reached by the branch
guards; ineligible chords do not introduce numerical query obligations. -/
def rowSfQueries (r : Row) : List ℚ :=
  [rowBaseSfQuery r] ++
    (if rowChordEligible r ordinaryPlane₀ ordinaryPlane₁ then
      [(rowChordSfQueries r ordinaryPlane₀).1, (rowChordSfQueries r ordinaryPlane₀).2] else []) ++
    (if rowChordEligible r ordinaryPlane₁ ordinaryPlane₀ then
      [(rowChordSfQueries r ordinaryPlane₁).1, (rowChordSfQueries r ordinaryPlane₁).2] else [])

def rowOrdinaryOutput (sf logI : ℚ → I80) (r : Row) : ℤ :=
  savedOrdinaryRectangle sf logI (rowTL r) (rowTR r) (rowUL r) (rowUR r)

def rowDefectArgument (r : Row) : I80 :=
  I80.ofEnclosure ⟨(rowResidualRange r).1 / Certificates.P2HistoricQ80DefectLookup.a,
    (rowResidualRange r).2 / Certificates.P2HistoricQ80DefectLookup.a⟩

/-- The historical positive defect credit is separate from the ordinary
max-of-proofs.  It is not licensed as an ordinary lower-sieve value. -/
def rowDefectCredit (logI : ℚ → I80) (r : Row) : ℤ :=
  max 0 (((((I80.point 4).mul (bankDefectLookup (rowDefectArgument r))).mul
    (rectangleMass logI (rowTL r) (rowTR r) (rowUL r) (rowUR r))).div
      (I80.point (rowResidualRange r).2)).lo)

def rowSourceOutput (sf logI : ℚ → I80) (r : Row) : ℤ :=
  sourceSavedRectangle sf logI (rowTL r) (rowTR r) (rowUL r) (rowUR r)

theorem rowSourceOutput_eq_components (sf logI : ℚ → I80) (r : Row) :
    rowSourceOutput sf logI r = rowOrdinaryOutput sf logI r + rowDefectCredit logI r := by
  rfl

theorem rowDefectCredit_nonneg (logI : ℚ → I80) (r : Row) : 0 ≤ rowDefectCredit logI r :=
  le_max_left _ _

/-- Check source index binding and exact ORIGINAL output, including defect.
The ordinal is retained for provenance but never used as a grid index. -/
def sourceOutputCheck (sf logI : ℚ → I80) (r : Row) : Bool :=
  decide ((frozenSavedRow r).tIndex = (indices r).1 ∧
    (frozenSavedRow r).uIndex = (indices r).2 ∧
    (frozenSavedRow r).savedQ80 = rowSourceOutput sf logI r)


end

end ImbalancedChen.P2HistoricalSavedFloorRowsBinder
