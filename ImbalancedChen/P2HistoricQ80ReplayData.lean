def nodes (i : ℕ) : HistoricNode :=
  if i ≤ 32768 then initial else
    (chunks ⟨((i - 32769) / 64) % 64, Nat.mod_lt _ (by decide)⟩).getD
      ((i - 32769) % 64) initial

def ChunkChecked (b : Fin 64) : Prop :=
  ∀ j : Fin 64, nodes (32769 + 64 * b.val + j.val) =
    update 16384 (32769 + 64 * b.val + j.val) nodes

instance (b : Fin 64) : Decidable (ChunkChecked b) := by
  unfold ChunkChecked
  infer_instance

