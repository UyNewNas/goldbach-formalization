def seedTensors (s : SmoothSeed) : Fin s.1 → CompactTensor := fun i => (s.2 i).toCompactTensor

def seedOutput (N : ℕ) [NeZero N] (s : SmoothSeed) : QuotientL2 N :=
  quotientTensorLaplacianPoincareL2 N Finset.univ (seedTensors s)

def seedPair (N : ℕ) [NeZero N] (s : SmoothSeed) : QuotientL2 N × QuotientL2 N :=
  (seedVector N s,seedOutput N s)

/-- A submodule generated by the real analytic input/output pairs. -/
def coreGraph (N : ℕ) [NeZero N] : Submodule ℂ (QuotientL2 N × QuotientL2 N) :=
  Submodule.span ℂ (range (seedPair N))

def outputPullback (N : ℕ) [NeZero N] (v : QuotientL2 N) : reducedCarrier N → ℂ :=
  fun z => v (reducedProjection N z)

theorem smoothCoreMaass_zero (N : ℕ) [NeZero N] :
    smoothCoreMaass N (0 : smoothCore N) = 0 := by
  change upperMaass ((coreRepresentativeLinearMap N) 0) = 0
  rw [map_zero,upperMaass_zero]

theorem smoothCoreMaass_add (N : ℕ) [NeZero N] (u v : smoothCore N) :
    smoothCoreMaass N (u+v) = smoothCoreMaass N u + smoothCoreMaass N v := by
  unfold smoothCoreMaass
  rw [coreRepresentative_add]
  exact upperMaass_add _ _ ((coreRepresentative_cinfty N u).of_le (by norm_num))
    ((coreRepresentative_cinfty N v).of_le (by norm_num))

theorem smoothCoreMaass_smul (N : ℕ) [NeZero N] (c : ℂ) (u : smoothCore N) :
    smoothCoreMaass N (c • u) = c • smoothCoreMaass N u := by
  unfold smoothCoreMaass
  rw [coreRepresentative_smul,upperMaass_smul]

/-- The key seed identity uses the actual proved Delta/Poincare join,
not an assumed commutation or a whole-plane tensor output. -/
theorem seedOutput_actual (N : ℕ) [NeZero N] (s : SmoothSeed) :
    outputPullback N (seedOutput N s) =ᵐ[reducedCarrierMeasure N]
      (fun z : reducedCarrier N => smoothCoreMaass N (seedCoreElement N s) z) := by
  have hcoe := (reducedProjection_measurePreserving N).quasiMeasurePreserving.ae_eq
    (quotientTensorLaplacianPoincare_memLp_two N Finset.univ (seedTensors s)).coeFn_toLp
  filter_upwards [hcoe] with z hz
  change seedOutput N s (reducedProjection N z) = _
  calc
    _ = quotientTensorLaplacianPoincare N Finset.univ (seedTensors s)
        (reducedProjection N z) := hz
    _ = upperMaass (finiteCompactTensorPoincare N Finset.univ (seedTensors s)) z :=
      quotientTensorLaplacianPoincare_projection_eq_upperMaass N Finset.univ (seedTensors s) z
    _ = _ := by rw [smoothCoreMaass,coreRepresentative_seed]; rfl

/-- Every graph pair has the actual geometric differential identity on
the original reduced carrier, with input-core membership derived. -/
theorem coreGraph_actual (N : ℕ) [NeZero N] {p : QuotientL2 N × QuotientL2 N}
    (hp : p ∈ coreGraph N) :
    ∃ hu : p.1 ∈ smoothCore N,
      outputPullback N p.2 =ᵐ[reducedCarrierMeasure N]
        (fun z : reducedCarrier N => smoothCoreMaass N ⟨p.1,hu⟩ z) := by
  induction hp using Submodule.span_induction with
  | mem p hp =>
      obtain ⟨s,rfl⟩ := hp
      exact ⟨(seedCoreElement N s).property,seedOutput_actual N s⟩
  | zero =>
      refine ⟨(smoothCore N).zero_mem,?_⟩
      have hz := (reducedProjection_measurePreserving N).quasiMeasurePreserving.ae_eq
        (Lp.coeFn_zero ℂ 2 (carrierPushforward N))
      simpa only [smoothCoreMaass_zero] using hz
  | add p q hp hq ihp ihq =>
      obtain ⟨hu,hout⟩ := ihp
      obtain ⟨hv,hout'⟩ := ihq
      let u : smoothCore N := ⟨p.1,hu⟩
      let v : smoothCore N := ⟨q.1,hv⟩
      refine ⟨(smoothCore N).add_mem hu hv,?_⟩
      have hsum := (reducedProjection_measurePreserving N).quasiMeasurePreserving.ae_eq
        (Lp.coeFn_add p.2 q.2)
      filter_upwards [hsum,hout,hout'] with z hz hz1 hz2
      change (p.2+q.2) (reducedProjection N z) = smoothCoreMaass N (u+v) z
      rw [smoothCoreMaass_add]
      change p.2 (reducedProjection N z) = smoothCoreMaass N u z at hz1
      change q.2 (reducedProjection N z) = smoothCoreMaass N v z at hz2
      simpa only [Pi.add_apply,hz1,hz2] using hz
  | smul c p hp ih =>
      obtain ⟨hu,hout⟩ := ih
      let u : smoothCore N := ⟨p.1,hu⟩
      refine ⟨(smoothCore N).smul_mem c hu,?_⟩
      have hsmul := (reducedProjection_measurePreserving N).quasiMeasurePreserving.ae_eq
        (Lp.coeFn_smul c p.2)
      filter_upwards [hsmul,hout] with z hz hz1
      change (c • p.2) (reducedProjection N z) = smoothCoreMaass N (c • u) z
      rw [smoothCoreMaass_smul]
      change p.2 (reducedProjection N z) = smoothCoreMaass N u z at hz1
      simpa only [Pi.smul_apply,hz1] using hz

/-- Equality of actual reduced pullbacks detects equality of quotient L2
outputs by the previously proved genuine measure embedding. -/
theorem output_eq_of_pullback_ae (N : ℕ) [NeZero N] {v w : QuotientL2 N}
    (h : outputPullback N v =ᵐ[reducedCarrierMeasure N] outputPullback N w) : v = w := by
  apply Lp.ext
  rw [← reducedProjection_map_measure N,(reducedProjection_measurableEmbedding N).ae_map_iff]
  exact h

theorem coreGraph_right_unique (N : ℕ) [NeZero N] {u v w : QuotientL2 N}
    (hv : (u,v) ∈ coreGraph N) (hw : (u,w) ∈ coreGraph N) : v = w := by
  obtain ⟨hu,hvactual⟩ := coreGraph_actual N hv
  obtain ⟨hu',hwactual⟩ := coreGraph_actual N hw
  exact output_eq_of_pullback_ae N (hvactual.trans hwactual.symm)

/-- Every member of the actual smooth input span has a genuine quotient
L2 output in the generated analytic graph. -/
theorem exists_coreGraph_output (N : ℕ) [NeZero N] {u : QuotientL2 N}
    (hu : u ∈ smoothCore N) : ∃ v : QuotientL2 N, (u,v) ∈ coreGraph N := by
  induction hu using Submodule.span_induction with
  | mem u hu =>
      obtain ⟨s,rfl⟩ := hu
      exact ⟨seedOutput N s,Submodule.subset_span ⟨s,rfl⟩⟩
  | zero => exact ⟨0,(coreGraph N).zero_mem⟩
  | add u v hu hv ihu ihv =>
      obtain ⟨f,hf⟩ := ihu
      obtain ⟨g,hg⟩ := ihv
      exact ⟨f+g,(coreGraph N).add_mem hf hg⟩
  | smul c u hu ih =>
      obtain ⟨f,hf⟩ := ih
      exact ⟨c • f,(coreGraph N).smul_mem c hf⟩

/-- Exact domain equality, not an hDomain interface. -/
theorem coreGraph_domain_iff (N : ℕ) [NeZero N] (u : QuotientL2 N) :
    (∃ v : QuotientL2 N, (u,v) ∈ coreGraph N) ↔ u ∈ smoothCore N := by
  constructor
  · rintro ⟨v,hv⟩
    exact (coreGraph_actual N hv).choose
  · exact exists_coreGraph_output N

def graphOutput (N : ℕ) [NeZero N] (u : smoothCore N) : QuotientL2 N :=
  Classical.choose (exists_coreGraph_output N u.property)

theorem graphOutput_mem (N : ℕ) [NeZero N] (u : smoothCore N) :
    ((u : QuotientL2 N),graphOutput N u) ∈ coreGraph N :=
  Classical.choose_spec (exists_coreGraph_output N u.property)

theorem graphOutput_add (N : ℕ) [NeZero N] (u v : smoothCore N) :
    graphOutput N (u+v) = graphOutput N u + graphOutput N v :=
  coreGraph_right_unique N (graphOutput_mem N (u+v))
    ((coreGraph N).add_mem (graphOutput_mem N u) (graphOutput_mem N v))

theorem graphOutput_smul (N : ℕ) [NeZero N] (c : ℂ) (u : smoothCore N) :
    graphOutput N (c • u) = c • graphOutput N u :=
  coreGraph_right_unique N (graphOutput_mem N (c • u))
    ((coreGraph N).smul_mem c (graphOutput_mem N u))

/-- The genuine geometric Maass operator on the actual quotient smooth
core, with values in the SAME canonical quotient L2 Hilbert space. -/
def actualCoreLaplacian (N : ℕ) [NeZero N] : smoothCore N →ₗ[ℂ] QuotientL2 N where
  toFun := graphOutput N
  map_add' := graphOutput_add N
  map_smul' := graphOutput_smul N

theorem actualCoreLaplacian_actual (N : ℕ) [NeZero N] (u : smoothCore N) :
    outputPullback N (actualCoreLaplacian N u) =ᵐ[reducedCarrierMeasure N]
      (fun z : reducedCarrier N => upperMaass (coreRepresentative N u) z) := by
  obtain ⟨hu,hactual⟩ := coreGraph_actual N (graphOutput_mem N u)
  exact hactual

theorem actualCoreLaplacian_seed (N : ℕ) [NeZero N] (s : SmoothSeed) :
    actualCoreLaplacian N (seedCoreElement N s) = seedOutput N s :=
  coreGraph_right_unique N (graphOutput_mem N (seedCoreElement N s))
    (Submodule.subset_span ⟨s,rfl⟩)

theorem coreGraph_iff_operator (N : ℕ) [NeZero N] (u : smoothCore N) (v : QuotientL2 N) :
    ((u : QuotientL2 N),v) ∈ coreGraph N ↔ v = actualCoreLaplacian N u := by
  constructor
  · intro hv
    exact coreGraph_right_unique N hv (graphOutput_mem N u)
  · intro hv
    rw [hv]
    exact graphOutput_mem N u

end
