/- Coordinate staging of the original Row10 combination, SOURCEONLY.
   No new integer coefficient or tail table is introduced. Each coefficient
   proof below normalizes one scalar coordinate, after symbolic projection
   through the original 53-term recursor. Full-list arithmetic is absent. -/
private theorem combination10_getD_addList (a b : List ℤ) (i : ℕ) :
    (addList a b).getD i 0 = a.getD i 0 + b.getD i 0 := by
  induction a generalizing b i with
  | nil => simp [addList, List.getD]
  | cons x xs ih =>
    cases b with
    | nil => simp [addList, List.getD]
    | cons y ys =>
      cases i with
      | zero => rfl
      | succ i => exact ih ys i

private theorem combination10_getD_scaleList (b : ℤ) (a : List ℤ) (i : ℕ) :
    (scaleList b a).getD i 0 = b * a.getD i 0 := by
  induction a generalizing i with
  | nil => simp [scaleList, List.getD]
  | cons x xs ih =>
    cases i with
    | zero => rfl
    | succ i => exact ih i

private theorem combination10_getD_cons (n k i : ℕ) (b : ℤ) (bs : List ℤ) :
    (bernsteinSumFrom n k (b :: bs)).getD i 0 =
      b * (bernsteinList n k).getD i 0 +
        (bernsteinSumFrom n (k + 1) bs).getD i 0 := by
  rw [primitive_bernsteinSumFrom_cons, combination10_getD_addList,
    combination10_getD_scaleList]

private theorem combination10_length_addList (a b : List ℤ) :
    (addList a b).length = max a.length b.length := by
  induction a generalizing b with
  | nil => simp [addList]
  | cons x xs ih =>
    cases b with
    | nil => simp [addList]
    | cons y ys =>
      simp only [primitive_addList_cons_cons, List.length_cons, ih]
      omega

private theorem combination10_length_cons (n k : ℕ) (b : ℤ) (bs : List ℤ) :
    (bernsteinSumFrom n k (b :: bs)).length =
      max (bernsteinList n k).length (bernsteinSumFrom n (k + 1) bs).length := by
  rw [primitive_bernsteinSumFrom_cons, combination10_length_addList]
  simp only [scaleList, List.length_map]

