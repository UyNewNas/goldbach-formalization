/- Each arithmetic leaf below computes one output coefficient, never a new
suffix list. These private structural lemmas contain no row constants. -/
private def combination23Coeff : List ℤ → ℕ → ℤ
  | [], _ => 0
  | x :: _, 0 => x
  | _ :: xs, i + 1 => combination23Coeff xs i

private theorem combination23Coeff_addList (a b : List ℤ) (i : ℕ) :
    combination23Coeff (addList a b) i =
      combination23Coeff a i + combination23Coeff b i := by
  induction a generalizing b i with
  | nil =>
    change combination23Coeff b i = 0 + combination23Coeff b i
    exact (zero_add _).symm
  | cons x xs ih =>
    cases b with
    | nil =>
      change combination23Coeff (x :: xs) i = combination23Coeff (x :: xs) i + 0
      exact (add_zero _).symm
    | cons y ys =>
      cases i with
      | zero => rfl
      | succ i =>
        change combination23Coeff (addList xs ys) i =
          combination23Coeff xs i + combination23Coeff ys i
        exact ih ys i

private theorem combination23Coeff_scaleList (c : ℤ) (a : List ℤ) (i : ℕ) :
    combination23Coeff (scaleList c a) i = c * combination23Coeff a i := by
  induction a generalizing i with
  | nil => cases i <;> simp [combination23Coeff, scaleList]
  | cons x xs ih =>
    cases i with
    | zero => rfl
    | succ i =>
      change combination23Coeff (scaleList c xs) i = c * combination23Coeff xs i
      exact ih i

private def combination23CoeffSum (n p : ℕ) : ℕ → List ℤ → ℤ :=
  fun k bs =>
    List.rec (motive := fun _ => ℕ → ℤ)
      (fun _ => 0)
      (fun b _bs ih j =>
        b * combination23Coeff (bernsteinList n j) p + ih (j + 1)) bs k

private theorem combination23Coeff_bernsteinSumFrom (n k p : ℕ) (bs : List ℤ) :
    combination23Coeff (bernsteinSumFrom n k bs) p =
      combination23CoeffSum n p k bs := by
  induction bs generalizing k with
  | nil => rfl
  | cons b bs ih =>
    change combination23Coeff
      (addList (scaleList b (bernsteinList n k))
        (bernsteinSumFrom n (k + 1) bs)) p = _
    rw [combination23Coeff_addList, combination23Coeff_scaleList, ih]
    rfl

private theorem combination23_length_addList (a b : List ℤ) :
    (addList a b).length = max a.length b.length := by
  induction a generalizing b with
  | nil => simp [addList]
  | cons x xs ih =>
    cases b with
    | nil => simp [addList]
    | cons y ys =>
      change (addList xs ys).length + 1 = max (xs.length + 1) (ys.length + 1)
      rw [ih]
      exact (Nat.succ_max_succ _ _).symm

private theorem combination23_length_scaleList (c : ℤ) (a : List ℤ) :
    (scaleList c a).length = a.length := by
  simp only [scaleList, List.length_map]

