/- Each arithmetic leaf below computes one output coefficient, never a new
suffix list. These private structural lemmas contain no row constants. -/
private def combination29Coeff : List ℤ → ℕ → ℤ
  | [], _ => 0
  | x :: _, 0 => x
  | _ :: xs, i + 1 => combination29Coeff xs i

private theorem combination29Coeff_addList (a b : List ℤ) (i : ℕ) :
    combination29Coeff (addList a b) i =
      combination29Coeff a i + combination29Coeff b i := by
  induction a generalizing b i with
  | nil =>
    change combination29Coeff b i = 0 + combination29Coeff b i
    exact (zero_add _).symm
  | cons x xs ih =>
    cases b with
    | nil =>
      change combination29Coeff (x :: xs) i = combination29Coeff (x :: xs) i + 0
      exact (add_zero _).symm
    | cons y ys =>
      cases i with
      | zero => rfl
      | succ i =>
        change combination29Coeff (addList xs ys) i =
          combination29Coeff xs i + combination29Coeff ys i
        exact ih ys i

private theorem combination29Coeff_scaleList (c : ℤ) (a : List ℤ) (i : ℕ) :
    combination29Coeff (scaleList c a) i = c * combination29Coeff a i := by
  induction a generalizing i with
  | nil => cases i <;> simp [combination29Coeff, scaleList]
  | cons x xs ih =>
    cases i with
    | zero => rfl
    | succ i =>
      change combination29Coeff (scaleList c xs) i = c * combination29Coeff xs i
      exact ih i

private def combination29CoeffSum (n p : ℕ) : ℕ → List ℤ → ℤ :=
  fun k bs =>
    List.rec (motive := fun _ => ℕ → ℤ)
      (fun _ => 0)
      (fun b _bs ih j =>
        b * combination29Coeff (bernsteinList n j) p + ih (j + 1)) bs k

private theorem combination29Coeff_bernsteinSumFrom (n k p : ℕ) (bs : List ℤ) :
    combination29Coeff (bernsteinSumFrom n k bs) p =
      combination29CoeffSum n p k bs := by
  induction bs generalizing k with
  | nil => rfl
  | cons b bs ih =>
    change combination29Coeff
      (addList (scaleList b (bernsteinList n k))
        (bernsteinSumFrom n (k + 1) bs)) p = _
    rw [combination29Coeff_addList, combination29Coeff_scaleList, ih]
    rfl

private theorem combination29_length_addList (a b : List ℤ) :
    (addList a b).length = max a.length b.length := by
  induction a generalizing b with
  | nil => simp [addList]
  | cons x xs ih =>
    cases b with
    | nil => simp [addList]
    | cons y ys =>
      change (addList xs ys).length + 1 = max (xs.length + 1) (ys.length + 1)
      rw [ih]
      exact (Nat.succ_max_succ _ _).symm

private theorem combination29_length_scaleList (c : ℤ) (a : List ℤ) :
    (scaleList c a).length = a.length := by
  simp only [scaleList, List.length_map]

