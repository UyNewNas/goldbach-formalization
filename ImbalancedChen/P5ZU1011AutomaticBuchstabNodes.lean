import ImbalancedChen.P2BuchstabRationalSemantics

/-!
SOURCE ONLY / UNCOMPILED / NOT ROOT ACCEPTED.
Deterministic actual rational method-of-steps nodes. No input enclosure
list, passing check, sampled Buchstab value or node-bound supplier is
requested. The generated list satisfies the EXISTING rational recurrence
checker symbolically; its actual-function semantics is reused unchanged.
No finite instance is evaluated or claimed to pass a saved endpoint check.
-/

namespace ImbalancedChen.P5Z.AutomaticBuchstabNodes

open Set
open Certificates.P2BuchstabRationalSemantics

/-- Total deterministic recurrence. The zero-mesh branch is only a total
default; every semantic statement below uses m>0. Every delayed index of
the genuine positive-mesh branch is strictly earlier than its output. -/
def node (m k : ℕ) : NodeEnclosure :=
  if hm : m = 0 then ⟨0, 0⟩
  else if hk : k ≤ m then ⟨1, 1⟩
  else
    ⟨(node m (k - 1)).lower + (1 / (m : ℚ)) *
        ((node m (k - 1 - m)).lower / (grid m k - 1)),
      (node m (k - 1)).upper + (1 / (m : ℚ)) *
        ((node m (k - 1 - m + 1)).upper / (grid m (k - 1) - 1))⟩
termination_by k
decreasing_by all_goals omega

theorem node_initial (m k : ℕ) (hm : 0 < m) (hk : k ≤ m) : node m k = ⟨1, 1⟩ := by
  rw [node, dif_neg (Nat.ne_of_gt hm), dif_pos hk]

theorem node_step (m k : ℕ) (hm : 0 < m) (hk : m < k) : node m k =
    ⟨(node m (k - 1)).lower + (1 / (m : ℚ)) *
        ((node m (k - 1 - m)).lower / (grid m k - 1)),
      (node m (k - 1)).upper + (1 / (m : ℚ)) *
        ((node m (k - 1 - m + 1)).upper / (grid m (k - 1) - 1))⟩ := by
  rw [node, dif_neg (Nat.ne_of_gt hm), dif_neg (not_le.mpr hk)]

/-- Every output row, through the specified final node, is generated by
the same literal recurrence. No serialized external table is supplied. -/
def nodes (m last : ℕ) : List NodeEnclosure :=
  List.ofFn (fun k : Fin (last + 1) => node m k.val)

@[simp] theorem nodes_length (m last : ℕ) : (nodes m last).length = last + 1 := by
  simp only [nodes, List.length_ofFn]

theorem entry_nodes (m last k : ℕ) (hk : k ≤ last) : entry (nodes m last) k = node m k := by
  have hlt : k < last + 1 := by omega
  simp only [entry, nodes, List.getElem?_ofFn, dif_pos hlt, Option.getD_some]

/-- ACTUAL generated finite list satisfies all existing strict-delay
checker rows. This is a theorem about the construction, not an assumed
Boolean receipt for user-supplied node data. -/
theorem generated_valid (m last : ℕ) (hm : 0 < m) : Valid m (nodes m last) := by
  refine ⟨hm, ?_⟩
  intro k
  have hk : k.val ≤ last := by have hh := k.isLt; rw [nodes_length] at hh; omega
  by_cases hbase : k.val ≤ m
  · simp only [hbase, if_true, entry_nodes m last k.val hk, node_initial m k.val hm hbase]
    exact ⟨le_rfl, le_rfl⟩
  · simp only [hbase, if_false]
    rw [entry_nodes m last k.val hk,
      entry_nodes m last (k.val - 1) (by omega),
      entry_nodes m last (k.val - 1 - m) (by omega),
      entry_nodes m last (k.val - 1 - m + 1) (by omega)]
    rw [node_step m k.val hm (lt_of_not_ge hbase)]
    exact ⟨le_rfl, le_rfl⟩

theorem generated_check (m last : ℕ) (hm : 0 < m) : check m (nodes m last) = true := by
  rw [check, decide_eq_true_eq]
  exact generated_valid m last hm

noncomputable section

/-- The original actual psi(s)=s*omega(s) is enclosed by EVERY generated
node. Semantics comes from the existing native-equation checker theorem. -/
theorem actual_node_bounds (m k : ℕ) (hm : 0 < m) :
    ((node m k).lower : ℝ) ≤ weighted (grid m k) ∧
      weighted (grid m k) ≤ ((node m k).upper : ℝ) := by
  have hh := check_sound (generated_check m k hm) (k := k)
    (by rw [nodes_length]; omega)
  simpa only [entry_nodes m k k le_rfl] using hh

/-- Actual original omega on the WHOLE rational cell. The output remains
directed: left lower psi and right upper psi are divided by the actual
positive query, exactly as in the existing proved semantic API. -/
theorem actual_cell_bounds (m k : ℕ) (hm : 0 < m) {s : ℝ}
    (hs : s ∈ Icc (grid m k : ℝ) (grid m (k + 1) : ℝ)) :
    ((node m k).lower : ℝ) / s ≤ LiLiuPrereqBuchstab.buchstab s ∧
      LiLiuPrereqBuchstab.buchstab s ≤ ((node m (k + 1)).upper : ℝ) / s := by
  have hh := check_cell_sound (generated_check m (k + 1) hm) (k := k)
    (by rw [nodes_length]; omega) hs
  simpa only [entry_nodes m (k + 1) k (by omega),
    entry_nodes m (k + 1) (k + 1) le_rfl] using hh

/-- The deterministic generated bank includes the full switched query
window through eight. No mesh size or finite check is numerically run. -/
def originalWindowNodes (m : ℕ) : List NodeEnclosure := nodes m (7 * m)

theorem originalWindow_valid (m : ℕ) (hm : 0 < m) : Valid m (originalWindowNodes m) :=
  generated_valid m (7 * m) hm

theorem originalWindow_last (m : ℕ) (hm : 0 < m) : grid m (7 * m) = 8 := by
  have hm0 : (m : ℚ) ≠ 0 := by exact_mod_cast ne_of_gt hm
  unfold grid
  push_cast
  field_simp [hm0]
  <;> ring

end

end ImbalancedChen.P5Z.AutomaticBuchstabNodes
